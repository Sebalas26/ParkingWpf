<UserControl x:Class="Parking.Views.MonthlySubscriptionsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:conv="clr-namespace:Parking.Core.Converters"
             xmlns:enums="clr-namespace:Parking.Core.Enums"
             mc:Ignorable="d"
             d:DesignHeight="768" d:DesignWidth="1200"
             UseLayoutRounding="True"
             SnapsToDevicePixels="True"
             TextOptions.TextFormattingMode="Display"
             TextOptions.TextRenderingMode="ClearType">

    <UserControl.Resources>
        <conv:CurrencyConverter x:Key="CurrencyConv"/>
        <conv:VehicleTypeToStringConverter x:Key="VehicleTypeStrConv"/>
        <conv:VehicleTypeToIconConverter x:Key="VehicleIconConv"/>
        <conv:BooleanToVisibilityConverter x:Key="BoolToVis"/>
        <conv:NullToVisibilityConverter x:Key="NullToVis"/>
        <conv:EqualityToBooleanConverter x:Key="EqualityConv"/>
    </UserControl.Resources>

    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- 1. Header Section -->
        <Grid Grid.Row="0" Margin="0,0,0,18">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0">
                <TextBlock Text="Gestión de Mensualidades y Abonados" Style="{StaticResource TextHeaderLarge}"/>
                <TextBlock Text="Administración de clientes fijos, control de vigencias y renovación de mensualidades" FontSize="12" Foreground="{DynamicResource BrushTextMuted}" Margin="0,3,0,0"/>
            </StackPanel>

            <StackPanel Grid.Column="1" Orientation="Horizontal">
                <Button Command="{Binding LoadSubscriptionsCommand}"
                        Style="{StaticResource SecondaryButton}"
                        Padding="14,8"
                        Margin="0,0,10,0">
                    <StackPanel Orientation="Horizontal">
                        <Path Data="{StaticResource IconRefresh}" Fill="{DynamicResource BrushPrimary}" Width="14" Height="14" Stretch="Uniform" Margin="0,0,8,0" VerticalAlignment="Center"/>
                        <TextBlock Text="Actualizar" FontWeight="SemiBold" FontSize="12" Foreground="{DynamicResource BrushPrimary}" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>

                <Button Command="{Binding OpenNewFormCommand}"
                        Style="{StaticResource ModernButton}"
                        Padding="18,8">
                    <StackPanel Orientation="Horizontal">
                        <Path Data="{StaticResource IconCheck}" Fill="{DynamicResource BrushTextWhite}" Width="14" Height="14" Stretch="Uniform" Margin="0,0,8,0" VerticalAlignment="Center"/>
                        <TextBlock Text="+ Nueva Mensualidad" FontWeight="Bold" FontSize="12" Foreground="{DynamicResource BrushTextWhite}" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>
            </StackPanel>
        </Grid>

        <!-- 2. KPI Summary Cards -->
        <UniformGrid Grid.Row="1" Columns="4" Rows="1" Margin="0,0,0,18">
            <!-- Activos -->
            <Border Style="{StaticResource StatCard}" Margin="0,0,8,0">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" VerticalAlignment="Center">
                        <TextBlock Text="ABONADOS ACTIVOS" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource BrushTextSecondary}"/>
                        <TextBlock Text="{Binding ActiveCount}" FontSize="24" FontWeight="Black" Foreground="{DynamicResource BrushSuccess}" Margin="0,4,0,2"/>
                        <TextBlock Text="Suscripciones al día" FontSize="10" Foreground="{DynamicResource BrushTextMuted}"/>
                    </StackPanel>
                    <Border Grid.Column="1" Width="28" Height="28" CornerRadius="14" Background="{DynamicResource BrushSuccessBg}" VerticalAlignment="Top">
                        <Path Data="{StaticResource IconCheck}" Fill="{DynamicResource BrushSuccess}" Width="12" Height="12" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                </Grid>
            </Border>

            <!-- Por Vencer -->
            <Border Style="{StaticResource StatCard}" Margin="4,0,4,0">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" VerticalAlignment="Center">
                        <TextBlock Text="POR VENCER (5 DÍAS)" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource BrushTextSecondary}"/>
                        <TextBlock Text="{Binding ExpiringSoonCount}" FontSize="24" FontWeight="Black" Foreground="{DynamicResource BrushWarning}" Margin="0,4,0,2"/>
                        <TextBlock Text="Requieren cobro o aviso" FontSize="10" Foreground="{DynamicResource BrushTextMuted}"/>
                    </StackPanel>
                    <Border Grid.Column="1" Width="28" Height="28" CornerRadius="14" Background="{DynamicResource BrushWarningBg}" VerticalAlignment="Top">
                        <Path Data="{StaticResource IconClock}" Fill="{DynamicResource BrushWarning}" Width="12" Height="12" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                </Grid>
            </Border>

            <!-- Vencidos -->
            <Border Style="{StaticResource StatCard}" Margin="4,0,4,0">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" VerticalAlignment="Center">
                        <TextBlock Text="VENCIDOS / INACTIVOS" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource BrushTextSecondary}"/>
                        <TextBlock Text="{Binding ExpiredCount}" FontSize="24" FontWeight="Black" Foreground="{DynamicResource BrushDanger}" Margin="0,4,0,2"/>
                        <TextBlock Text="Sin vigencia activa" FontSize="10" Foreground="{DynamicResource BrushTextMuted}"/>
                    </StackPanel>
                    <Border Grid.Column="1" Width="28" Height="28" CornerRadius="14" Background="{DynamicResource BrushDangerBg}" VerticalAlignment="Top">
                        <Path Data="{StaticResource IconAlert}" Fill="{DynamicResource BrushDanger}" Width="12" Height="12" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                </Grid>
            </Border>

            <!-- Recaudo Mensual -->
            <Border Style="{StaticResource StatCard}" Margin="8,0,0,0">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" VerticalAlignment="Center">
                        <TextBlock Text="TOTAL RECAUDADO" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource BrushTextSecondary}"/>
                        <TextBlock Text="{Binding TotalMonthlyRevenue, Converter={StaticResource CurrencyConv}}" FontSize="20" FontWeight="Black" Foreground="{DynamicResource BrushPrimary}" Margin="0,4,0,2"/>
                        <TextBlock Text="Ingresos por mensualidades" FontSize="10" Foreground="{DynamicResource BrushTextMuted}"/>
                    </StackPanel>
                    <Border Grid.Column="1" Width="28" Height="28" CornerRadius="14" Background="{DynamicResource BrushPrimaryLight}" VerticalAlignment="Top">
                        <Path Data="{StaticResource IconCash}" Fill="{DynamicResource BrushPrimary}" Width="12" Height="12" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                </Grid>
            </Border>
        </UniformGrid>

        <!-- 3. Search and Quick Filters Bar -->
        <Border Grid.Row="2" Style="{StaticResource ModernCard}" Padding="14,10" Margin="0,0,0,14">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="320"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- Search Input -->
                <Grid Grid.Column="0">
                    <TextBox Text="{Binding SearchQuery, UpdateSourceTrigger=PropertyChanged}"
                             Style="{StaticResource ModernTextBox}"
                             Tag="Buscar por Placa, Cliente, Cédula..."
                             Height="38"
                             FontSize="12"/>
                </Grid>

                <!-- Status Filter Pills -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <RadioButton Content="Todos"
                                 IsChecked="{Binding SelectedFilter, Converter={StaticResource EqualityConv}, ConverterParameter='Todos', Mode=OneWay}"
                                 Command="{Binding FilterByCommand}"
                                 CommandParameter="Todos"
                                 Style="{StaticResource SegmentRadioButton}"/>
                    <RadioButton Content="Activos"
                                 IsChecked="{Binding SelectedFilter, Converter={StaticResource EqualityConv}, ConverterParameter='Activos', Mode=OneWay}"
                                 Command="{Binding FilterByCommand}"
                                 CommandParameter="Activos"
                                 Style="{StaticResource SegmentRadioButton}"/>
                    <RadioButton Content="Por Vencer"
                                 IsChecked="{Binding SelectedFilter, Converter={StaticResource EqualityConv}, ConverterParameter='PorVencer', Mode=OneWay}"
                                 Command="{Binding FilterByCommand}"
                                 CommandParameter="PorVencer"
                                 Style="{StaticResource SegmentRadioButton}"/>
                    <RadioButton Content="Vencidos"
                                 IsChecked="{Binding SelectedFilter, Converter={StaticResource EqualityConv}, ConverterParameter='Vencidos', Mode=OneWay}"
                                 Command="{Binding FilterByCommand}"
                                 CommandParameter="Vencidos"
                                 Style="{StaticResource SegmentRadioButton}"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- 4. Subscriptions DataGrid -->
        <Border Grid.Row="3" Style="{StaticResource ModernCard}" Padding="16">
            <DataGrid ItemsSource="{Binding Subscriptions}"
                      Style="{StaticResource ModernDataGrid}">
                <DataGrid.Columns>
                    <!-- Placa -->
                    <DataGridTemplateColumn Header="PLACA" Width="1.2*">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding PlateNumber}"
                                           FontFamily="{StaticResource FontFamilyMonospace}"
                                           FontWeight="Black"
                                           FontSize="15"
                                           Foreground="{DynamicResource BrushTextPrimary}"
                                           VerticalAlignment="Center"/>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <!-- Categoría -->
                    <DataGridTemplateColumn Header="CATEGORÍA" Width="1.3*">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <Border Width="24" Height="24" CornerRadius="6" Background="{DynamicResource BrushPrimary}" Margin="0,0,8,0">
                                        <Path Data="{Binding VehicleType, Converter={StaticResource VehicleIconConv}}"
                                              Fill="{DynamicResource BrushTextWhite}"
                                              Width="12" Height="12"
                                              Stretch="Uniform"
                                              HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                                    </Border>
                                    <TextBlock Text="{Binding VehicleType, Converter={StaticResource VehicleTypeStrConv}}"
                                               FontSize="11"
                                               FontWeight="SemiBold"
                                               Foreground="{DynamicResource BrushTextPrimary}"
                                               VerticalAlignment="Center"/>
                                </StackPanel>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <!-- Cliente -->
                    <DataGridTemplateColumn Header="CLIENTE / ABONADO" Width="1.8*">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="{Binding CustomerName}" FontWeight="Bold" FontSize="12" Foreground="{DynamicResource BrushTextPrimary}"/>
                                    <TextBlock Text="{Binding CustomerDocument, StringFormat='{}Doc: {0}'}" FontSize="10" Foreground="{DynamicResource BrushTextMuted}"/>
                                </StackPanel>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <!-- Contacto -->
                    <DataGridTextColumn Header="TELÉFONO" Binding="{Binding CustomerPhone}" Width="1.2*"/>

                    <!-- Vigencia -->
                    <DataGridTemplateColumn Header="VIGENCIA" Width="1.6*">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="{Binding EndDate, StringFormat='{}Hasta: {0:yyyy-MM-dd}'}" FontWeight="SemiBold" FontSize="11" Foreground="{DynamicResource BrushTextPrimary}"/>
                                    <TextBlock Text="{Binding StartDate, StringFormat='{}Desde: {0:yyyy-MM-dd}'}" FontSize="10" Foreground="{DynamicResource BrushTextMuted}"/>
                                </StackPanel>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <!-- Estado / Días Restantes -->
                    <DataGridTemplateColumn Header="ESTADO" Width="1.3*">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Border CornerRadius="8" Padding="8,3" HorizontalAlignment="Left" VerticalAlignment="Center">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Setter Property="Background" Value="{DynamicResource BrushSuccessBg}"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsCurrentlyValid}" Value="False">
                                                    <Setter Property="Background" Value="{DynamicResource BrushDangerBg}"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <TextBlock Text="{Binding StatusLabel}" FontWeight="Bold" FontSize="11">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Foreground" Value="{DynamicResource BrushSuccess}"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsCurrentlyValid}" Value="False">
                                                        <Setter Property="Foreground" Value="{DynamicResource BrushDanger}"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </Border>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <!-- Tarifa Mensual -->
                    <DataGridTemplateColumn Header="VALOR MES" Width="1.2*">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding MonthlyFee, Converter={StaticResource CurrencyConv}}"
                                           FontWeight="Bold"
                                           FontSize="12"
                                           Foreground="{DynamicResource BrushPrimary}"
                                           VerticalAlignment="Center"/>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <!-- Acciones -->
                    <DataGridTemplateColumn Header="ACCIONES" Width="1.6*">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <Button Command="{Binding DataContext.OpenRenewFormCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                            CommandParameter="{Binding}"
                                            Style="{StaticResource SecondaryButton}"
                                            Padding="8,4"
                                            Margin="0,0,6,0">
                                        <TextBlock Text="Renovar" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource BrushPrimary}"/>
                                    </Button>

                                    <Button Command="{Binding DataContext.CancelSubscriptionCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                            CommandParameter="{Binding}"
                                            Style="{StaticResource SecondaryButton}"
                                            Padding="8,4">
                                        <TextBlock Text="Cancelar" FontSize="10" Foreground="{DynamicResource BrushDanger}"/>
                                    </Button>
                                </StackPanel>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                </DataGrid.Columns>
            </DataGrid>
        </Border>

        <!-- 5. Modal / Slide-over Form for New/Renew Subscription -->
        <Grid Grid.RowSpan="4" Visibility="{Binding IsFormOpen, Converter={StaticResource BoolToVis}}" Background="#80000000">
            <Border Background="{DynamicResource BrushAppBackground}"
                    BorderBrush="{DynamicResource BrushBorderMedium}"
                    BorderThickness="1"
                    CornerRadius="16"
                    Padding="24"
                    Width="520"
                    MaxHeight="640"
                    VerticalAlignment="Center"
                    HorizontalAlignment="Center">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- Form Header -->
                    <Grid Grid.Row="0" Margin="0,0,0,16">
                        <StackPanel>
                            <TextBlock Text="Registrar Mensualidad / Abonado" FontSize="16" FontWeight="Bold" Foreground="{DynamicResource BrushTextPrimary}">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsRenewMode}" Value="True">
                                                <Setter Property="Text" Value="Renovar Mensualidad de Vehículo"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                            <TextBlock Text="Diligencie los datos del abonado para habilitar acceso libre al parqueadero" FontSize="11" Foreground="{DynamicResource BrushTextMuted}" Margin="0,2,0,0"/>
                        </StackPanel>
                        <Button HorizontalAlignment="Right"
                                Command="{Binding CloseFormCommand}"
                                Style="{StaticResource SecondaryButton}"
                                Padding="4"
                                Width="26"
                                Height="26">
                            <Path Data="{StaticResource IconClose}" Fill="{DynamicResource BrushTextSecondary}" Width="10" Height="10" Stretch="Uniform"/>
                        </Button>
                    </Grid>

                    <!-- Form Body -->
                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Margin="0,0,0,16">
                        <StackPanel>
                            <!-- Error message banner -->
                            <Border Background="{DynamicResource BrushDangerBg}" CornerRadius="8" Padding="12,8" Margin="0,0,0,12" Visibility="{Binding FormErrorMessage, Converter={StaticResource NullToVis}}">
                                <TextBlock Text="{Binding FormErrorMessage}" Foreground="{DynamicResource BrushDanger}" FontSize="11" FontWeight="Bold" TextWrapping="Wrap"/>
                            </Border>

                            <!-- Placa y Categoría -->
                            <Grid Margin="0,0,0,12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="1.2*"/>
                                    <ColumnDefinition Width="1*"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" Margin="0,0,8,0">
                                    <TextBlock Text="PLACA DEL VEHÍCULO *" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource BrushTextMuted}" Margin="0,0,0,4"/>
                                    <TextBox Text="{Binding FormPlateNumber, UpdateSourceTrigger=PropertyChanged}"
                                             CharacterCasing="Upper"
                                             FontFamily="{StaticResource FontFamilyMonospace}"
                                             FontSize="16"
                                             FontWeight="Bold"
                                             Style="{StaticResource ModernTextBox}"/>
                                </StackPanel>

                                <StackPanel Grid.Column="1">
                                    <TextBlock Text="CATEGORÍA" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource BrushTextMuted}" Margin="0,0,0,4"/>
                                    <ComboBox SelectedValue="{Binding FormVehicleType}"
                                              SelectedValuePath="Tag"
                                              Style="{StaticResource ModernComboBox}"
                                              Height="40">
                                        <ComboBoxItem Content="Automóvil" Tag="{x:Static enums:VehicleType.Car}" IsSelected="True"/>
                                        <ComboBoxItem Content="Motocicleta" Tag="{x:Static enums:VehicleType.Motorcycle}"/>
                                        <ComboBoxItem Content="Camioneta / SUV" Tag="{x:Static enums:VehicleType.Suv}"/>
                                        <ComboBoxItem Content="Furgón" Tag="{x:Static enums:VehicleType.Van}"/>
                                        <ComboBoxItem Content="Pesado" Tag="{x:Static enums:VehicleType.HeavyTruck}"/>
                                    </ComboBox>
                                </StackPanel>
                            </Grid>

                            <!-- Nombre Cliente y Cédula -->
                            <Grid Margin="0,0,0,12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="1.4*"/>
                                    <ColumnDefinition Width="1*"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" Margin="0,0,8,0">
                                    <TextBlock Text="NOMBRE DEL CLIENTE / ABONADO *" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource BrushTextMuted}" Margin="0,0,0,4"/>
                                    <TextBox Text="{Binding FormCustomerName, UpdateSourceTrigger=PropertyChanged}"
                                             Style="{StaticResource ModernTextBox}"/>
                                </StackPanel>

                                <StackPanel Grid.Column="1">
                                    <TextBlock Text="CÉDULA / NIT" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource BrushTextMuted}" Margin="0,0,0,4"/>
                                    <TextBox Text="{Binding FormCustomerDocument, UpdateSourceTrigger=PropertyChanged}"
                                             Style="{StaticResource ModernTextBox}"/>
                                </StackPanel>
                            </Grid>

                            <!-- Teléfono y Email -->
                            <Grid Margin="0,0,0,12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="1*"/>
                                    <ColumnDefinition Width="1.4*"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" Margin="0,0,8,0">
                                    <TextBlock Text="TELÉFONO DE CONTACTO *" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource BrushTextMuted}" Margin="0,0,0,4"/>
                                    <TextBox Text="{Binding FormCustomerPhone, UpdateSourceTrigger=PropertyChanged}"
                                             Style="{StaticResource ModernTextBox}"/>
                                </StackPanel>

                                <StackPanel Grid.Column="1">
                                    <TextBlock Text="CORREO ELECTRÓNICO (OPCIONAL)" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource BrushTextMuted}" Margin="0,0,0,4"/>
                                    <TextBox Text="{Binding FormCustomerEmail, UpdateSourceTrigger=PropertyChanged}"
                                             Style="{StaticResource ModernTextBox}"/>
                                </StackPanel>
                            </Grid>

                            <!-- Fechas de Vigencia -->
                            <Grid Margin="0,0,0,12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="1*"/>
                                    <ColumnDefinition Width="1*"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" Margin="0,0,8,0">
                                    <TextBlock Text="FECHA DE INICIO" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource BrushTextMuted}" Margin="0,0,0,4"/>
                                    <DatePicker SelectedDate="{Binding FormStartDate}" Height="38"/>
                                </StackPanel>

                                <StackPanel Grid.Column="1">
                                    <TextBlock Text="FECHA DE VENCIMIENTO" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource BrushTextMuted}" Margin="0,0,0,4"/>
                                    <DatePicker SelectedDate="{Binding FormEndDate}" Height="38"/>
                                </StackPanel>
                            </Grid>

                            <!-- Valor Pagado y Método de Pago -->
                            <Grid Margin="0,0,0,12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="1*"/>
                                    <ColumnDefinition Width="1.2*"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" Margin="0,0,8,0">
                                    <TextBlock Text="VALOR MENSUALIDAD ($) *" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource BrushTextMuted}" Margin="0,0,0,4"/>
                                    <TextBox Text="{Binding FormAmountPaid, UpdateSourceTrigger=PropertyChanged}"
                                             FontSize="15"
                                             FontWeight="Bold"
                                             Style="{StaticResource ModernTextBox}"/>
                                </StackPanel>

                                <StackPanel Grid.Column="1">
                                    <TextBlock Text="MÉTODO DE PAGO" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource BrushTextMuted}" Margin="0,0,0,4"/>
                                    <ComboBox SelectedValue="{Binding FormPaymentMethod}"
                                              SelectedValuePath="Tag"
                                              Style="{StaticResource ModernComboBox}"
                                              Height="40">
                                        <ComboBoxItem Content="Efectivo" Tag="{x:Static enums:PaymentMethod.Cash}" IsSelected="True"/>
                                        <ComboBoxItem Content="Tarjeta Débito" Tag="{x:Static enums:PaymentMethod.DebitCard}"/>
                                        <ComboBoxItem Content="Tarjeta Crédito" Tag="{x:Static enums:PaymentMethod.CreditCard}"/>
                                        <ComboBoxItem Content="Transferencia / QR" Tag="{x:Static enums:PaymentMethod.DigitalTransfer}"/>
                                    </ComboBox>
                                </StackPanel>
                            </Grid>

                            <!-- Observaciones -->
                            <StackPanel Margin="0,0,0,4">
                                <TextBlock Text="OBSERVACIONES / NOTAS (OPCIONAL)" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource BrushTextMuted}" Margin="0,0,0,4"/>
                                <TextBox Text="{Binding FormNotes, UpdateSourceTrigger=PropertyChanged}"
                                         Height="40"
                                         TextWrapping="Wrap"
                                         Style="{StaticResource ModernTextBox}"/>
                            </StackPanel>
                        </StackPanel>
                    </ScrollViewer>

                    <!-- Form Action Buttons -->
                    <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Content="Cancelar"
                                Command="{Binding CloseFormCommand}"
                                Style="{StaticResource SecondaryButton}"
                                Margin="0,0,10,0"
                                Padding="16,8"/>

                        <Button Content="Guardar Mensualidad"
                                Command="{Binding SaveSubscriptionCommand}"
                                Style="{StaticResource ModernButton}"
                                Padding="20,8"/>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>
