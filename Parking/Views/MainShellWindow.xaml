<Window x:Class="Parking.Views.MainShellWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:Parking.ViewModels"
        xmlns:views="clr-namespace:Parking.Views"
        xmlns:conv="clr-namespace:Parking.Core.Converters"
        xmlns:security="clr-namespace:Parking.Security"
        mc:Ignorable="d"
        Title="Parking Flow - Terminal POS de Control de Acceso y Caja"
        Icon="/Resources/parkpoint.ico"
        Height="900" Width="1440"
        MinHeight="720" MinWidth="1024"
        WindowStartupLocation="CenterScreen"
        WindowState="Maximized"
        Background="{DynamicResource BrushAppBackground}">

    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="38"
                      CornerRadius="0"
                      GlassFrameThickness="0"
                      NonClientFrameEdges="None"
                      ResizeBorderThickness="6"
                      UseAeroCaptionButtons="False"/>
    </WindowChrome.WindowChrome>

    <Window.Resources>
        <conv:BooleanToVisibilityConverter x:Key="BoolToVis"/>
        <conv:InverseBooleanConverter x:Key="InverseBoolConv"/>

        <!-- Estilos de Botones de Control de Ventana (Min, Max, Cerrar) -->
        <Style x:Key="TitleBarButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#94A3B8"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Width" Value="46"/>
            <Setter Property="Height" Value="38"/>
            <Setter Property="WindowChrome.IsHitTestVisibleInChrome" Value="True"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#2A3B42"/>
                                <Setter Property="Foreground" Value="#FFFFFF"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#354850"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="TitleBarCloseButtonStyle" TargetType="Button" BasedOn="{StaticResource TitleBarButtonStyle}">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#DC2626"/>
                                <Setter Property="Foreground" Value="#FFFFFF"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#B91C1C"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <DataTemplate DataType="{x:Type vm:CheckInViewModel}">
            <views:CheckInView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:CheckOutViewModel}">
            <views:CheckOutView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:MonthlySubscriptionsViewModel}">
            <views:MonthlySubscriptionsView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:RecentEntriesViewModel}">
            <views:RecentEntriesView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:AnalyticsViewModel}">
            <views:AnalyticsView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:ShiftClosureViewModel}">
            <views:ShiftClosureView/>
        </DataTemplate>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="38"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- ========================================================================= -->
        <!-- 1. BARRA DE TÍTULO MODERNA (CUSTOM TITLEBAR INTEGRADO PARKING FLOW)        -->
        <!-- ========================================================================= -->
        <Border Grid.Row="0"
                Background="#152024"
                BorderBrush="#25343B"
                BorderThickness="0,0,0,1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Left: Application Brand & Isotype -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" Margin="14,0,0,0">
                    <Border Background="#111827" CornerRadius="5" Width="22" Height="22" Margin="0,0,8,0" ClipToBounds="True">
                        <Image Source="/Resources/logo.jpeg" Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality"/>
                    </Border>
                    <TextBlock Text="PARKING FLOW" FontWeight="Black" FontSize="12" Foreground="{DynamicResource BrushTextWhite}" VerticalAlignment="Center"/>
                    <TextBlock Text=" • Terminal POS de Control de Acceso y Caja" FontSize="11" FontWeight="SemiBold" Foreground="#94A3B8" VerticalAlignment="Center"/>
                </StackPanel>

                <!-- Center: Drag Area -->
                <Grid Grid.Column="1" Background="Transparent"/>

                <!-- Right: Custom Modern Window Control Buttons -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Stretch">
                    <Button Click="MinimizeButton_Click" Style="{StaticResource TitleBarButtonStyle}" ToolTip="Minimizar">
                        <TextBlock Text="—" FontSize="12" FontWeight="Bold" Margin="0,-2,0,0"/>
                    </Button>
                    <Button Click="MaximizeButton_Click" Style="{StaticResource TitleBarButtonStyle}" ToolTip="Maximizar / Restaurar">
                        <TextBlock Text="▢" FontSize="14" FontWeight="Bold" Margin="0,-2,0,0"/>
                    </Button>
                    <Button Click="CloseButton_Click" Style="{StaticResource TitleBarCloseButtonStyle}" ToolTip="Cerrar Aplicación">
                        <TextBlock Text="✕" FontSize="12" FontWeight="Bold"/>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ========================================================================= -->
        <!-- 2. CONTENIDO PRINCIPAL (SIDEBAR + WORKSPACE AREA)                         -->
        <!-- ========================================================================= -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="260"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Left Sidebar en Grafito (#1E2A2F) -->
            <Border Grid.Column="0"
                    Background="{DynamicResource BrushSidebarBackground}"
                    BorderBrush="{DynamicResource BrushBorderSubtle}"
                    BorderThickness="0,0,1,0"
                    Padding="16,20">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- Sidebar Brand Header PARKING FLOW con Soporte de Logo Dinámico de Sede -->
                    <StackPanel Grid.Row="0" Margin="4,0,0,24">
                        <!-- Caso 1: Sede con logo personalizado (CurrentBranch.LogoBase64 != null) -->
                        <StackPanel Orientation="Horizontal"
                                    VerticalAlignment="Center"
                                    Visibility="{Binding CurrentBranch.LogoBase64, Converter={StaticResource NullToVis}}">
                            <Border Width="38" Height="38" CornerRadius="8" Margin="0,0,10,0" ClipToBounds="True" Background="#111827">
                                <Image Source="{Binding CurrentBranch.LogoBase64, Converter={StaticResource Base64ToImageConv}}"
                                       Stretch="UniformToFill"
                                       RenderOptions.BitmapScalingMode="HighQuality"/>
                            </Border>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="{Binding CurrentBranch.Name, FallbackValue='PARKING FLOW'}"
                                           FontSize="16"
                                           FontWeight="Black"
                                           Foreground="{DynamicResource BrushTextWhite}"
                                           TextTrimming="CharacterEllipsis"
                                           MaxWidth="170"/>
                                <TextBlock Text="SEDE ACTIVA" FontSize="9" FontWeight="Bold" Foreground="{DynamicResource BrushPrimaryLight}"/>
                            </StackPanel>
                        </StackPanel>

                        <!-- Caso 2: Logo Oficial Parking Flow por defecto (CurrentBranch.LogoBase64 == null) -->
                        <Border CornerRadius="10"
                                Background="#111827"
                                BorderBrush="#25343B"
                                BorderThickness="1"
                                Padding="8,4"
                                HorizontalAlignment="Left"
                                ClipToBounds="True">
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Setter Property="Visibility" Value="Visible"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding CurrentBranch.LogoBase64, Converter={StaticResource NullToVis}}" Value="Visible">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <Image Source="/Resources/logo.jpeg"
                                   Height="44"
                                   Stretch="Uniform"
                                   RenderOptions.BitmapScalingMode="HighQuality"/>
                        </Border>
                    </StackPanel>

                <!-- Navigation List: Módulos Operativos -->
                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel>
                        <StackPanel.Style>
                            <Style TargetType="StackPanel">
                                <Setter Property="Opacity" Value="1"/>
                                <Setter Property="IsEnabled" Value="True"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding CanOperateTerminal}" Value="False">
                                        <Setter Property="Opacity" Value="0.3"/>
                                        <Setter Property="IsEnabled" Value="False"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </StackPanel.Style>
                        <TextBlock Text="OPERACIÓN EN TERMINAL" FontSize="12" FontWeight="Bold" Foreground="{DynamicResource BrushSidebarText}" Margin="12,0,0,12"/>

                        <!-- 1. Ingreso de Vehículos -->
                        <RadioButton Content="Ingreso de Vehículos"
                                     Command="{Binding NavigateToCheckInCommand}"
                                     IsChecked="{Binding SelectedNavSection, Converter={StaticResource BoolToVis}, ConverterParameter=CheckIn, Mode=OneWay}"
                                     security:Authorize.Permission="checkin.create_ticket"
                                     Style="{StaticResource SidebarNavButton}"
                                     Margin="0,0,0,6">
                            <RadioButton.Tag>
                                <Path Data="{StaticResource IconCheckIn}" Fill="{DynamicResource BrushTextWhite}" Width="16" Height="16" Stretch="Uniform"/>
                            </RadioButton.Tag>
                        </RadioButton>

                        <!-- 2. Salida y Cobro / Caja -->
                        <RadioButton Content="Salida y Cobro / Caja"
                                     Command="{Binding NavigateToCheckOutCommand}"
                                     IsChecked="{Binding SelectedNavSection, Converter={StaticResource BoolToVis}, ConverterParameter=CheckOut, Mode=OneWay}"
                                     security:Authorize.Permission="checkout.process_payment"
                                     Style="{StaticResource SidebarNavButton}"
                                     Margin="0,0,0,6">
                            <RadioButton.Tag>
                                <Path Data="{StaticResource IconCheckOut}" Fill="{DynamicResource BrushTextWhite}" Width="16" Height="16" Stretch="Uniform"/>
                            </RadioButton.Tag>
                        </RadioButton>

                        <!-- 3. Mensualidades y Abonados -->
                        <RadioButton Content="Mensualidades"
                                     Command="{Binding NavigateToMonthlySubscriptionsCommand}"
                                     IsChecked="{Binding SelectedNavSection, Converter={StaticResource BoolToVis}, ConverterParameter=Subscriptions, Mode=OneWay}"
                                     security:Authorize.Permission="subscriptions.view_list"
                                     Style="{StaticResource SidebarNavButton}"
                                     Margin="0,0,0,6">
                            <RadioButton.Tag>
                                <Path Data="{StaticResource IconCalendar}" Fill="{DynamicResource BrushTextWhite}" Width="16" Height="16" Stretch="Uniform"/>
                            </RadioButton.Tag>
                        </RadioButton>

                        <!-- 4. Vehículos en Patio / Recientes -->
                        <RadioButton Content="Vehículos en Patio"
                                     Command="{Binding NavigateToRecentEntriesCommand}"
                                     IsChecked="{Binding SelectedNavSection, Converter={StaticResource BoolToVis}, ConverterParameter=RecentEntries, Mode=OneWay}"
                                     security:Authorize.Permission="monitoring.view_occupancy"
                                     Style="{StaticResource SidebarNavButton}"
                                     Margin="0,0,0,6">
                            <RadioButton.Tag>
                                <Path Data="{StaticResource IconClock}" Fill="{DynamicResource BrushTextWhite}" Width="16" Height="16" Stretch="Uniform"/>
                            </RadioButton.Tag>
                        </RadioButton>

                        <Border Height="1" Background="{DynamicResource BrushBorderSubtle}" Opacity="0.2" Margin="12,12,12,12"/>

                        <!-- 5. Control de Turnos y Caja -->
                        <RadioButton Content="Control de Turnos"
                                     Command="{Binding NavigateToShiftClosureCommand}"
                                     IsChecked="{Binding SelectedNavSection, Converter={StaticResource BoolToVis}, ConverterParameter=ShiftClosure, Mode=OneWay}"
                                     security:Authorize.Permission="shifts.view_current"
                                     Style="{StaticResource SidebarNavButton}"
                                     Margin="0,0,0,6">
                            <RadioButton.Tag>
                                <Path Data="{StaticResource IconCashRegister}" Fill="{DynamicResource BrushTextWhite}" Width="16" Height="16" Stretch="Uniform"/>
                            </RadioButton.Tag>
                        </RadioButton>

                        <!-- 6. Analítica y Finanzas -->
                        <RadioButton Content="Analítica y Finanzas"
                                     Command="{Binding NavigateToAnalyticsCommand}"
                                     IsChecked="{Binding SelectedNavSection, Converter={StaticResource BoolToVis}, ConverterParameter=Analytics, Mode=OneWay}"
                                     security:Authorize.Permission="analytics.view_dashboard"
                                     Style="{StaticResource SidebarNavButton}"
                                     Margin="0,0,0,6">
                            <RadioButton.Tag>
                                <Path Data="{StaticResource IconAnalytics}" Fill="{DynamicResource BrushTextWhite}" Width="16" Height="16" Stretch="Uniform"/>
                            </RadioButton.Tag>
                        </RadioButton>
                    </StackPanel>
                </ScrollViewer>

                <!-- Sidebar Footer: Operator Session Card & Logout -->
                <Border Grid.Row="2"
                        Background="#25343B"
                        BorderBrush="#354850"
                        BorderThickness="1"
                        CornerRadius="12"
                        Padding="12,10">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <!-- Avatar Badge -->
                        <Border Grid.Column="0"
                                Width="34" Height="34"
                                CornerRadius="17"
                                Background="{DynamicResource BrushPrimary}"
                                Margin="0,0,10,0">
                            <TextBlock Text="{Binding CurrentUser.FullName[0], FallbackValue='U'}"
                                       FontWeight="Bold"
                                       FontSize="16"
                                       Foreground="{DynamicResource BrushTextWhite}"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"/>
                        </Border>

                        <!-- User Info -->
                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock Text="{Binding CurrentUser.FullName, FallbackValue='Operador de Caja'}"
                                       FontWeight="Bold"
                                       FontSize="14"
                                       Foreground="{DynamicResource BrushTextWhite}"
                                       TextTrimming="CharacterEllipsis"/>
                            <TextBlock Text="{Binding CurrentUser.RoleName, FallbackValue='Cajero'}"
                                       FontSize="12"
                                       Foreground="{DynamicResource BrushSidebarText}"/>
                        </StackPanel>

                        <!-- Logout Button -->
                        <Button Grid.Column="2"
                                Command="{Binding LogoutCommand}"
                                Style="{StaticResource SecondaryButton}"
                                Width="28" Height="28"
                                Padding="0"
                                ToolTip="Cerrar Sesión">
                            <Path Data="{StaticResource IconLogout}"
                                  Fill="{DynamicResource BrushDanger}"
                                  Width="12" Height="12"
                                  Stretch="Uniform"/>
                        </Button>
                    </Grid>
                </Border>
            </Grid>
        </Border>

        <!-- Main Workspace Area -->
        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Top Header Bar with Live Network & Occupancy Telemetry -->
            <Border Grid.Row="0"
                    Background="{DynamicResource BrushSurfaceBackground}"
                    BorderBrush="{DynamicResource BrushBorderSubtle}"
                    BorderThickness="0,0,0,1"
                    Padding="16,6">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <!-- Left: Sede Activa + Nombre -->
                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                        <Path Data="{StaticResource IconBuilding}"
                              Fill="{DynamicResource BrushPrimary}"
                              Width="14" Height="14"
                              Stretch="Uniform"
                              Margin="0,0,8,0"
                              VerticalAlignment="Center"/>
                        <TextBlock FontSize="14" FontWeight="Bold" Foreground="{DynamicResource BrushTextPrimary}" VerticalAlignment="Center">
                            <Run Text="Sede " FontWeight="SemiBold" Foreground="{DynamicResource BrushTextSecondary}"/>
                            <Run Text="{Binding CurrentBranch.Name, Mode=OneWay, FallbackValue='Principal'}"/>
                        </TextBlock>

                        <!-- Botón Cambiar Sede -->
                        <Button Command="{Binding SwitchBranchCommand}"
                                Visibility="{Binding HasMultipleBranches, Converter={StaticResource BoolToVis}}"
                                Style="{StaticResource SecondaryButton}"
                                Height="24"
                                Padding="6,0"
                                Margin="10,0,0,0"
                                ToolTip="Cambiar Sede Activa">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Path Data="{StaticResource IconSettings}" Fill="{DynamicResource BrushTextSecondary}" Width="10" Height="10" Stretch="Uniform" Margin="0,0,4,0" VerticalAlignment="Center"/>
                                <TextBlock Text="Cambiar" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource BrushTextSecondary}" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                    </StackPanel>

                    <!-- Right: Sync + Occupancy + Clock (compacto en línea) -->
                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">

                        <!-- Sync Status Pill -->
                        <Border Background="{DynamicResource BrushInputBackground}"
                                BorderBrush="{DynamicResource BrushBorderSubtle}"
                                BorderThickness="1"
                                CornerRadius="12"
                                Padding="8,3"
                                Margin="0,0,6,0">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Ellipse Width="6" Height="6"
                                         Fill="{DynamicResource BrushSuccess}"
                                         Margin="0,0,5,0"
                                         VerticalAlignment="Center"/>
                                <TextBlock Text="{Binding SyncStatusText}"
                                           FontSize="11"
                                           FontWeight="SemiBold"
                                           Foreground="{DynamicResource BrushTextSecondary}"
                                           VerticalAlignment="Center"
                                           MaxWidth="200"
                                           TextTrimming="CharacterEllipsis"/>
                            </StackPanel>
                        </Border>

                        <!-- Sync Button -->
                        <Button Command="{Binding ForceSyncCommand}"
                                IsEnabled="{Binding IsSyncing, Converter={StaticResource InverseBoolConv}}"
                                Style="{StaticResource SecondaryButton}"
                                Height="24"
                                Padding="6,0"
                                Margin="0,0,6,0"
                                ToolTip="Sincronizar">
                            <Path Data="{StaticResource IconRefresh}"
                                  Fill="{DynamicResource BrushPrimary}"
                                  Width="11" Height="11"
                                  Stretch="Uniform"/>
                        </Button>

                        <!-- Occupancy Badge -->
                        <Border Background="{DynamicResource BrushSurfaceLight}"
                                BorderBrush="{DynamicResource BrushBorderSubtle}"
                                BorderThickness="1"
                                CornerRadius="12"
                                Padding="8,3"
                                Margin="0,0,6,0">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Ellipse Width="6" Height="6" Fill="{DynamicResource BrushSuccess}" Margin="0,0,5,0" VerticalAlignment="Center"/>
                                <TextBlock Text="{Binding Occupancy.OccupancySummary}"
                                           FontSize="11"
                                           FontWeight="Bold"
                                           Foreground="{DynamicResource BrushTextPrimary}"
                                           VerticalAlignment="Center"/>
                            </StackPanel>
                        </Border>

                        <!-- Clock Pill -->
                        <Border Background="{DynamicResource BrushInputBackground}"
                                BorderBrush="{DynamicResource BrushBorderSubtle}"
                                BorderThickness="1"
                                CornerRadius="12"
                                Padding="8,3">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Path Data="{StaticResource IconClock}" Fill="{DynamicResource BrushPrimary}" Width="10" Height="10" Stretch="Uniform" Margin="0,0,4,0" VerticalAlignment="Center"/>
                                <TextBlock Text="{Binding CurrentTimeString}"
                                           FontSize="11"
                                           FontWeight="SemiBold"
                                           Foreground="{DynamicResource BrushTextSecondary}"
                                           VerticalAlignment="Center"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Dynamic Active View -->
            <ContentControl Grid.Row="1" Content="{Binding ActiveView}"/>
        </Grid>
    </Grid>
</Grid>
</Window>
