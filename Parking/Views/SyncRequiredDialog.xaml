<Window x:Class="Parking.Views.SyncRequiredDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="Actualización de Sede Requerida"
        Width="480"
        SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Display"
        TextOptions.TextRenderingMode="ClearType">

    <Border Margin="16"
            Background="{DynamicResource BrushSurfaceBackground}"
            BorderBrush="{DynamicResource BrushBorderMedium}"
            BorderThickness="1"
            CornerRadius="16"
            Padding="24"
            SnapsToDevicePixels="True">
        <Border.Effect>
            <DropShadowEffect BlurRadius="28" ShadowDepth="8" Direction="270" Opacity="0.22" Color="#0B3C49"/>
        </Border.Effect>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Header with Badge Icon and Title -->
            <Grid Grid.Row="0" Margin="0,0,0,18">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- Dynamic Icon Badge Container -->
                <Border Grid.Column="0"
                        Width="48"
                        Height="48"
                        CornerRadius="24"
                        Background="{DynamicResource BrushWarningBg}"
                        BorderBrush="{DynamicResource BrushWarning}"
                        BorderThickness="1"
                        Margin="0,0,16,0"
                        VerticalAlignment="Center">
                    <Path Data="{StaticResource IconSync}"
                          Fill="{DynamicResource BrushWarningText}"
                          Width="22"
                          Height="22"
                          Stretch="Uniform"
                          HorizontalAlignment="Center"
                          VerticalAlignment="Center"/>
                </Border>

                <!-- Title & Tag -->
                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Border Background="{DynamicResource BrushWarningBg}" 
                                CornerRadius="6" 
                                Padding="8,2" 
                                Margin="0,0,8,0">
                            <TextBlock Text="⚡ SINCRONIZACIÓN EN TIEMPO REAL" 
                                       FontSize="10" 
                                       FontWeight="Bold" 
                                       Foreground="{DynamicResource BrushWarningText}"/>
                        </Border>
                    </StackPanel>

                    <TextBlock x:Name="TitleTextBlock"
                               Text="Actualización de Sede Detectada"
                               FontSize="16"
                               FontWeight="Bold"
                               Foreground="{DynamicResource BrushTextPrimary}"
                               Margin="0,4,0,0"
                               TextWrapping="Wrap"/>
                </StackPanel>
            </Grid>

            <!-- Body Message Area -->
            <StackPanel Grid.Row="1" Margin="0,0,0,20">
                <!-- Notification Detail Box -->
                <Border Background="{DynamicResource BrushAppBackground}"
                        BorderBrush="{DynamicResource BrushBorderSubtle}"
                        BorderThickness="1"
                        CornerRadius="10"
                        Padding="16,14"
                        Margin="0,0,0,12">
                    <StackPanel>
                        <TextBlock Text="Detalle del cambio recibido:" 
                                   FontSize="11" 
                                   FontWeight="SemiBold" 
                                   Foreground="{DynamicResource BrushTextMuted}" 
                                   Margin="0,0,0,4"/>
                        <TextBlock x:Name="MessageTextBlock"
                                   Text="Se detectaron modificaciones de configuración en la sede desde la plataforma web."
                                   FontSize="13"
                                   FontWeight="SemiBold"
                                   LineHeight="19"
                                   Foreground="{DynamicResource BrushTextPrimary}"
                                   TextWrapping="Wrap"/>
                    </StackPanel>
                </Border>

                <!-- Informative Guidance Note -->
                <Border Background="{DynamicResource BrushPrimaryLight}"
                        BorderBrush="{DynamicResource BrushPrimary}"
                        BorderThickness="1"
                        CornerRadius="8"
                        Padding="12,10">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Path Grid.Column="0" 
                              Data="{StaticResource IconInfo}" 
                              Fill="{DynamicResource BrushPrimary}" 
                              Width="16" 
                              Height="16" 
                              Stretch="Uniform" 
                              Margin="0,2,10,0" 
                              VerticalAlignment="Top"/>
                        <TextBlock Grid.Column="1"
                                   Text="Para garantizar que el control de acceso, cupos, novedades y tarifas operen con las reglas actualizadas, es necesario sincronizar los datos locales."
                                   FontSize="12"
                                   LineHeight="17"
                                   Foreground="{DynamicResource BrushTextPrimary}"
                                   TextWrapping="Wrap"/>
                    </Grid>
                </Border>
            </StackPanel>

            <!-- Action Buttons Area -->
            <Grid Grid.Row="2">
                <Button x:Name="SyncButton"
                        Content="⚡ Sincronizar Ahora"
                        Click="SyncButton_Click"
                        Style="{StaticResource ModernButton}"
                        HorizontalAlignment="Stretch"
                        Padding="20,12"
                        FontSize="14"
                        FontWeight="Bold"
                        IsDefault="True"/>
            </Grid>
        </Grid>
    </Border>
</Window>
