<UserControl x:Class="Parking.Views.AnalyticsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:conv="clr-namespace:Parking.Core.Converters"
             mc:Ignorable="d"
             d:DesignHeight="900" d:DesignWidth="1180">

    <UserControl.Resources>
        <conv:CurrencyConverter x:Key="CurrencyConv"/>
        <conv:DurationConverter x:Key="DurationConv"/>
        <conv:VehicleTypeToStringConverter x:Key="VehicleTypeStrConv"/>
        <conv:VehicleTypeToIconConverter x:Key="VehicleIconConv"/>
        <conv:TicketStatusToStringConverter x:Key="StatusStrConv"/>
        <conv:TicketStatusToColorConverter x:Key="StatusColorConv"/>
        <conv:BooleanToVisibilityConverter x:Key="BoolToVis"/>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <Grid Margin="24">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- 1. Top 4 KPI Metric Cards -->
            <UniformGrid Grid.Row="0" Columns="4" Rows="1" Margin="0,0,0,20">
                <!-- Total Recaudado Hoy -->
                <Border Style="{StaticResource StatCard}" Margin="0,0,12,0">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" VerticalAlignment="Center">
                            <TextBlock Text="TOTAL RECAUDADO HOY" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource BrushTextSecondary}"/>
                            <TextBlock Text="{Binding Summary.TotalRevenueToday, Converter={StaticResource CurrencyConv}}" FontSize="28" FontWeight="Black" Foreground="{DynamicResource BrushPrimary}" Margin="0,6,0,4"/>
                            <TextBlock Text="Cierre de caja y facturación del día" FontSize="11" Foreground="{DynamicResource BrushTextMuted}"/>
                        </StackPanel>
                        <Path Grid.Column="1" Data="{StaticResource IconCash}" Fill="{DynamicResource BrushPrimary}" Width="20" Height="20" Stretch="Uniform" VerticalAlignment="Top"/>
                    </Grid>
                </Border>

                <!-- Vehículos Adentro -->
                <Border Style="{StaticResource StatCard}" Margin="6,0,6,0">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,2">
                                <TextBlock Text="VEHÍCULOS ADENTRO" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource BrushTextSecondary}" VerticalAlignment="Center"/>
                                <Border Background="#E0F2FE" CornerRadius="10" Padding="6,2" Margin="8,0,0,0">
                                    <TextBlock Text="{Binding OccupancyPercentage, StringFormat='{}{0:F1}% Ocupación'}" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource BrushPrimary}"/>
                                </Border>
                            </StackPanel>
                            <TextBlock Text="{Binding OccupiedSpaces}" FontSize="28" FontWeight="Black" Foreground="{DynamicResource BrushTextPrimary}" Margin="0,4,0,4"/>
                            <TextBlock Text="{Binding OccupiedSpaces, StringFormat='{}{0} Vehículos activos en bahía'}" FontSize="11" Foreground="{DynamicResource BrushTextMuted}"/>
                        </StackPanel>
                        <Path Grid.Column="1" Data="{StaticResource IconCar}" Fill="{DynamicResource BrushCyan}" Width="20" Height="20" Stretch="Uniform" VerticalAlignment="Top"/>
                    </Grid>
                </Border>

                <!-- Capacidad Disponible -->
                <Border Style="{StaticResource StatCard}" Margin="6,0,6,0">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" VerticalAlignment="Center">
                            <TextBlock Text="CAPACIDAD DISPONIBLE" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource BrushTextSecondary}"/>
                            <TextBlock Text="{Binding AvailableSpaces}" FontSize="28" FontWeight="Black" Foreground="{DynamicResource BrushSuccess}" Margin="0,6,0,4"/>
                            <TextBlock Text="Cupos listos para nuevos ingresos" FontSize="11" Foreground="{DynamicResource BrushTextMuted}"/>
                        </StackPanel>
                        <Border Grid.Column="1" Width="24" Height="24" CornerRadius="12" Background="{DynamicResource BrushSuccessBg}" VerticalAlignment="Top">
                            <Path Data="{StaticResource IconCheck}" Fill="{DynamicResource BrushSuccess}" Width="12" Height="12" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </Grid>
                </Border>

                <!-- Entradas del Día -->
                <Border Style="{StaticResource StatCard}" Margin="12,0,0,0">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" VerticalAlignment="Center">
                            <TextBlock Text="ENTRADAS TOTALES DEL DÍA" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource BrushTextSecondary}"/>
                            <TextBlock Text="{Binding Summary.TotalEntriesToday}" FontSize="28" FontWeight="Black" Foreground="{DynamicResource BrushTextPrimary}" Margin="0,6,0,4"/>
                            <TextBlock Text="Tiquetes emitidos durante el turno" FontSize="11" Foreground="{DynamicResource BrushTextMuted}"/>
                        </StackPanel>
                        <Path Grid.Column="1" Data="{StaticResource IconReceipt}" Fill="{DynamicResource BrushTextMuted}" Width="20" Height="20" Stretch="Uniform" VerticalAlignment="Top"/>
                    </Grid>
                </Border>
            </UniformGrid>

            <!-- 2. Middle Section: Gráfica de Ocupación & Desglose de Tipos -->
            <Grid Grid.Row="1" Margin="0,0,0,24">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="1.4*"/>
                    <ColumnDefinition Width="1*"/>
                </Grid.ColumnDefinitions>

                <!-- Gráfica de Tendencia Semanal de Ocupación -->
                <Border Grid.Column="0" Style="{StaticResource ModernCard}" Margin="0,0,16,0" Padding="20">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="200"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <!-- Chart Header -->
                        <Grid Grid.Row="0" Margin="0,0,0,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="Ocupación y Flujo Semanal" FontSize="15" FontWeight="Bold" Foreground="{DynamicResource BrushTextPrimary}"/>
                                <TextBlock Text="Seguimiento histórico de cupos y afluencia de vehículos" FontSize="11" Foreground="{DynamicResource BrushTextMuted}" Margin="0,2,0,0"/>
                            </StackPanel>
                            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                <Ellipse Width="8" Height="8" Fill="{DynamicResource BrushPrimary}" Margin="0,0,6,0"/>
                                <TextBlock Text="Ocupación %" FontSize="11" Foreground="{DynamicResource BrushTextSecondary}"/>
                            </StackPanel>
                        </Grid>

                        <!-- Chart Curve -->
                        <Grid Grid.Row="1" Margin="0,8,0,8">
                            <Line X1="0" Y1="30" X2="1000" Y2="30" Stroke="{DynamicResource BrushBorderSubtle}" StrokeDashArray="3,3" StrokeThickness="1"/>
                            <Line X1="0" Y1="85" X2="1000" Y2="85" Stroke="{DynamicResource BrushBorderSubtle}" StrokeDashArray="3,3" StrokeThickness="1"/>
                            <Line X1="0" Y1="140" X2="1000" Y2="140" Stroke="{DynamicResource BrushBorderSubtle}" StrokeDashArray="3,3" StrokeThickness="1"/>

                            <Path Data="M 20 130 C 60 120, 100 100, 140 115 C 180 130, 220 155, 260 140 C 300 120, 340 80, 380 100 C 420 120, 460 145, 500 110 C 540 75, 580 95, 620 75 C 660 55, 700 65, 740 75"
                                  Stroke="{DynamicResource BrushPrimary}"
                                  StrokeThickness="3"
                                  Stretch="Fill"
                                  VerticalAlignment="Center"
                                  Height="130"
                                  Margin="10,0,10,0"/>
                        </Grid>

                        <!-- Chart Days in Spanish -->
                        <UniformGrid Grid.Row="2" Columns="7" Rows="1" Margin="10,4,10,0">
                            <TextBlock Text="Lun" HorizontalAlignment="Center" FontSize="11" Foreground="{DynamicResource BrushTextMuted}"/>
                            <TextBlock Text="Mar" HorizontalAlignment="Center" FontSize="11" Foreground="{DynamicResource BrushTextMuted}"/>
                            <TextBlock Text="Mié" HorizontalAlignment="Center" FontSize="11" Foreground="{DynamicResource BrushTextMuted}"/>
                            <TextBlock Text="Jue" HorizontalAlignment="Center" FontSize="11" Foreground="{DynamicResource BrushTextMuted}"/>
                            <TextBlock Text="Vie" HorizontalAlignment="Center" FontSize="11" Foreground="{DynamicResource BrushTextMuted}"/>
                            <TextBlock Text="Sáb" HorizontalAlignment="Center" FontSize="11" Foreground="{DynamicResource BrushTextMuted}"/>
                            <TextBlock Text="Dom" HorizontalAlignment="Center" FontSize="11" Foreground="{DynamicResource BrushTextMuted}"/>
                        </UniformGrid>
                    </Grid>
                </Border>

                <!-- Desglose por Tipo de Vehículo -->
                <Border Grid.Column="1" Style="{StaticResource ModernCard}" Padding="20">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0" Text="Desglose por Categoría" FontSize="15" FontWeight="Bold" Foreground="{DynamicResource BrushTextPrimary}" Margin="0,0,0,14"/>

                        <StackPanel Grid.Row="1" VerticalAlignment="Center">
                            <!-- Automóviles -->
                            <Grid Margin="0,0,0,12">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                <Grid Grid.Row="0" Margin="0,0,0,4">
                                    <TextBlock Text="Automóviles / Sedán" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource BrushTextPrimary}"/>
                                    <TextBlock Text="58%" FontSize="12" FontWeight="Bold" Foreground="{DynamicResource BrushPrimary}" HorizontalAlignment="Right"/>
                                </Grid>
                                <ProgressBar Grid.Row="1" Value="58" Height="6" Foreground="{DynamicResource BrushPrimary}" Background="{DynamicResource BrushInputBackground}"/>
                            </Grid>

                            <!-- Camionetas / SUV -->
                            <Grid Margin="0,0,0,12">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                <Grid Grid.Row="0" Margin="0,0,0,4">
                                    <TextBlock Text="Camionetas / SUV" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource BrushTextPrimary}"/>
                                    <TextBlock Text="24%" FontSize="12" FontWeight="Bold" Foreground="{DynamicResource BrushCyan}" HorizontalAlignment="Right"/>
                                </Grid>
                                <ProgressBar Grid.Row="1" Value="24" Height="6" Foreground="{DynamicResource BrushCyan}" Background="{DynamicResource BrushInputBackground}"/>
                            </Grid>

                            <!-- Motocicletas -->
                            <Grid Margin="0,0,0,12">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                <Grid Grid.Row="0" Margin="0,0,0,4">
                                    <TextBlock Text="Motocicletas" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource BrushTextPrimary}"/>
                                    <TextBlock Text="14%" FontSize="12" FontWeight="Bold" Foreground="{DynamicResource BrushSuccess}" HorizontalAlignment="Right"/>
                                </Grid>
                                <ProgressBar Grid.Row="1" Value="14" Height="6" Foreground="{DynamicResource BrushSuccess}" Background="{DynamicResource BrushInputBackground}"/>
                            </Grid>

                            <!-- Pesados / Otros -->
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                <Grid Grid.Row="0" Margin="0,0,0,4">
                                    <TextBlock Text="Vehículos Pesados / Vanes" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource BrushTextPrimary}"/>
                                    <TextBlock Text="4%" FontSize="12" FontWeight="Bold" Foreground="{DynamicResource BrushWarning}" HorizontalAlignment="Right"/>
                                </Grid>
                                <ProgressBar Grid.Row="1" Value="4" Height="6" Foreground="{DynamicResource BrushWarning}" Background="{DynamicResource BrushInputBackground}"/>
                            </Grid>
                        </StackPanel>
                    </Grid>
                </Border>
            </Grid>

            <!-- 3. Bottom Section: Historial de Transacciones con Filtros -->
            <Border Grid.Row="2" Style="{StaticResource ModernCard}" Padding="20">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="340"/>
                    </Grid.RowDefinitions>

                    <!-- Title & Actions Bar -->
                    <Grid Grid.Row="0" Margin="0,0,0,16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0">
                            <TextBlock Text="Historial de Transacciones y Auditoría" FontSize="16" FontWeight="Bold" Foreground="{DynamicResource BrushTextPrimary}"/>
                            <TextBlock Text="Registro detallado de ingresos, salidas, convenios aplicados y liquidaciones" FontSize="11" Foreground="{DynamicResource BrushTextMuted}" Margin="0,2,0,0"/>
                        </StackPanel>

                        <Button Grid.Column="1"
                                Command="{Binding ExportReportCommand}"
                                Style="{StaticResource ModernButton}"
                                Padding="14,8">
                            <StackPanel Orientation="Horizontal">
                                <Path Data="{StaticResource IconExport}" Fill="{DynamicResource BrushTextWhite}" Width="14" Height="14" Stretch="Uniform" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                <TextBlock Text="Exportar Auditoría" FontSize="12" FontWeight="Bold" Foreground="{DynamicResource BrushTextWhite}" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                    </Grid>

                    <!-- Filter Chips & Search Bar -->
                    <Grid Grid.Row="1" Margin="0,0,0,16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="260"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <!-- Search Box -->
                        <TextBox Grid.Column="0"
                                 Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                                 Style="{StaticResource SearchPillTextBox}"
                                 Margin="0,0,14,0"/>

                        <!-- Status Filter Chips -->
                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="Estado:" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource BrushTextSecondary}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                            <RadioButton Content="Todos" Command="{Binding FilterByStatusCommand}" CommandParameter="All" IsChecked="True" GroupName="AnalyticsStatus" Style="{StaticResource FilterChipRadioButton}"/>
                            <RadioButton Content="Activos" Command="{Binding FilterByStatusCommand}" CommandParameter="Active" GroupName="AnalyticsStatus" Style="{StaticResource FilterChipRadioButton}"/>
                            <RadioButton Content="Completados" Command="{Binding FilterByStatusCommand}" CommandParameter="Completed" GroupName="AnalyticsStatus" Style="{StaticResource FilterChipRadioButton}"/>
                        </StackPanel>

                        <!-- Clear Filters -->
                        <Button Grid.Column="2"
                                Content="Limpiar Filtros"
                                Command="{Binding ClearFiltersCommand}"
                                Style="{StaticResource SecondaryButton}"
                                Padding="12,6"
                                FontSize="11"/>
                    </Grid>

                    <!-- DataGrid -->
                    <DataGrid Grid.Row="2" ItemsSource="{Binding Transactions}" Style="{StaticResource ModernDataGrid}">
                        <DataGrid.Columns>
                            <!-- Placa -->
                            <DataGridTemplateColumn Header="PLACA" Width="1.3*">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding PlateNumber}"
                                                   FontFamily="{StaticResource FontFamilyMonospace}"
                                                   FontWeight="Bold"
                                                   FontSize="13"
                                                   Foreground="{DynamicResource BrushTextPrimary}"
                                                   VerticalAlignment="Center"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                            <!-- Tipo de Vehículo -->
                            <DataGridTemplateColumn Header="TIPO DE VEHÍCULO" Width="1.5*">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <Path Data="{Binding VehicleType, Converter={StaticResource VehicleIconConv}}"
                                                  Fill="{DynamicResource BrushTextMuted}"
                                                  Width="14" Height="14"
                                                  Stretch="Uniform"
                                                  Margin="0,0,8,0"
                                                  VerticalAlignment="Center"/>
                                            <TextBlock Text="{Binding VehicleType, Converter={StaticResource VehicleTypeStrConv}}"
                                                       FontSize="12"
                                                       Foreground="{DynamicResource BrushTextPrimary}"
                                                       VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                            <!-- Hora Entrada -->
                            <DataGridTextColumn Header="HORA ENTRADA" Binding="{Binding EntryTime, StringFormat='{}{0:yyyy-MM-dd HH:mm}'}" Width="1.4*"/>

                            <!-- Hora Salida -->
                            <DataGridTextColumn Header="HORA SALIDA" Binding="{Binding ExitTime, StringFormat='{}{0:yyyy-MM-dd HH:mm}'}" Width="1.4*"/>

                            <!-- Tiempo Total -->
                            <DataGridTemplateColumn Header="DURACIÓN" Width="1.2*">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding TotalDurationMinutes, Converter={StaticResource DurationConv}}"
                                                   FontSize="12"
                                                   Foreground="{DynamicResource BrushTextSecondary}"
                                                   VerticalAlignment="Center"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                            <!-- Total Cobrado -->
                            <DataGridTemplateColumn Header="TOTAL COBRADO" Width="1.3*">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding NetAmount, Converter={StaticResource CurrencyConv}}"
                                                   FontWeight="Bold"
                                                   FontSize="13"
                                                   Foreground="{DynamicResource BrushPrimary}"
                                                   VerticalAlignment="Center"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                            <!-- Estado Badge -->
                            <DataGridTemplateColumn Header="ESTADO" Width="1.1*">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Border CornerRadius="10" Padding="8,2" HorizontalAlignment="Left" VerticalAlignment="Center"
                                                Background="{Binding Status, Converter={StaticResource StatusColorConv}}">
                                            <TextBlock Text="{Binding Status, Converter={StaticResource StatusStrConv}}"
                                                       FontSize="10"
                                                       FontWeight="Bold"
                                                       Foreground="{DynamicResource BrushTextWhite}"/>
                                        </Border>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </Border>
        </Grid>
    </ScrollViewer>
</UserControl>
