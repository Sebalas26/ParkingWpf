<Window x:Class="Parking.Views.ReceiptPreviewDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:conv="clr-namespace:Parking.Core.Converters"
        mc:Ignorable="d"
        Title="Vista Previa del Tiquete"
        WindowStartupLocation="CenterOwner"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="#B3000000"
        ShowInTaskbar="False"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Display"
        TextOptions.TextRenderingMode="ClearType">

    <Window.Resources>
        <conv:CurrencyConverter x:Key="CurrencyConv"/>
        <conv:VehicleTypeToStringConverter x:Key="VehicleTypeStrConv"/>
        <conv:BooleanToVisibilityConverter x:Key="BoolToVis"/>
        <conv:NullToVisibilityConverter x:Key="NullToVis"/>
    </Window.Resources>

    <Grid Background="Transparent">
        <Border Width="490"
                MaxHeight="660"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Margin="24"
                Background="{DynamicResource BrushAppBackground}"
                BorderBrush="{DynamicResource BrushBorderMedium}"
                BorderThickness="1"
                CornerRadius="16"
                Padding="20">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- 1. Header Area -->
            <Grid Grid.Row="0" Margin="0,0,0,12">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Path Data="{StaticResource IconReceipt}" Fill="{DynamicResource BrushPrimary}" Width="16" Height="16" Stretch="Uniform" Margin="0,0,8,0"/>
                    <TextBlock Text="Vista Previa de Tiquete Térmico" FontSize="14" FontWeight="Bold" Foreground="{DynamicResource BrushTextPrimary}"/>
                </StackPanel>
                <Button HorizontalAlignment="Right"
                        Command="{Binding CloseCommand}"
                        Style="{StaticResource SecondaryButton}"
                        Padding="4"
                        Width="26"
                        Height="26">
                    <Path Data="{StaticResource IconClose}" Fill="{DynamicResource BrushTextSecondary}" Width="10" Height="10" Stretch="Uniform"/>
                </Button>
            </Grid>

            <!-- 2. Thermal Ticket Paper Container (Estilo POS Blanco y Negro) -->
            <Border Grid.Row="1"
                    Background="#FFFFFF"
                    BorderBrush="{DynamicResource BrushBorderMedium}"
                    BorderThickness="1"
                    CornerRadius="0"
                    Padding="16,20"
                    Margin="0,0,0,12"
                    MaxHeight="480">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
