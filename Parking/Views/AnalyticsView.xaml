<UserControl x:Class="Parking.Views.AnalyticsView"
              xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
              xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
              xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
              xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
              xmlns:conv="clr-namespace:Parking.Core.Converters"
              mc:Ignorable="d"
              d:DesignHeight="750" d:DesignWidth="1100">

    <UserControl.Resources>
        <conv:CurrencyConverter x:Key="CurrencyConv"/>
        <conv:DurationConverter x:Key="DurationConv"/>
        <conv:VehicleTypeToBadgeColorConverter x:Key="VehicleBadgeConv"/>
        <conv:VehicleTypeToStringConverter x:Key="VehicleTypeStrConv"/>
        <conv:TicketStatusToColorConverter x:Key="StatusColorConv"/>
        <conv:TicketStatusToStringConverter x:Key="StatusStrConv"/>
    </UserControl.Resources>

    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <UniformGrid Grid.Row="0" Columns="4" Rows="1" Margin="0,0,0,20">
            <Border Style="{StaticResource ModernCard}" Margin="0,0,12,0">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0">
                        <TextBlock Text="TOTAL RECAUDADO HOY" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource BrushTextMuted}"/>
                        <TextBlock Text="{Binding Summary.TotalRevenueToday, Converter={StaticResource CurrencyConv}}"
                                   FontSize="26"
                                   FontWeight="Black"
                                   Foreground="{DynamicResource BrushSuccess}"
                                   Margin="0,4,0,2"/>
                        <TextBlock Text="Caja liquidada acumulada" FontSize="11" Foreground="{DynamicResource BrushTextSecondary}"/>
                    </StackPanel>
                    <Border Grid.Column="1" Width="44" Height="44" CornerRadius="10" Background="{DynamicResource BrushSuccessBg}" VerticalAlignment="Top">
                        <Path Data="{StaticResource IconCash}" Fill="{DynamicResource BrushSuccess}" Width="20" Height="20" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                </Grid>
            </Border>

            <Border Style="{StaticResource ModernCard}" Margin="6,0,6,0">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0">
                        <TextBlock Text="VEHÍCULOS ADENTRO" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource BrushTextMuted}"/>
                        <TextBlock Text="{Binding Summary.ActiveVehiclesCount}"
                                   FontSize="26"
                                   FontWeight="Black"
                                   Foreground="{DynamicResource BrushPrimary}"
                                   Margin="0,4,0,2"/>
                        <TextBlock Text="Bahías ocupadas activas" FontSize="11" Foreground="{DynamicResource BrushTextSecondary}"/>
                    </StackPanel>
                    <Border Grid.Column="1" Width="44" Height="44" CornerRadius="10" Background="{DynamicResource BrushSurfaceElevated}" VerticalAlignment="Top">
                        <Path Data="{StaticResource IconCar}" Fill="{DynamicResource BrushPrimary}" Width="20" Height="20" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                </Grid>
            </Border>

            <Border Style="{StaticResource ModernCard}" Margin="6,0,6,0">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0">
                        <TextBlock Text="SALIDAS LIQUIDADAS" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource BrushTextMuted}"/>
                        <TextBlock Text="{Binding Summary.CompletedTransactionsToday}"
                                   FontSize="26"
                                   FontWeight="Black"
                                   Foreground="{DynamicResource BrushCyan}"
                                   Margin="0,4,0,2"/>
                        <TextBlock Text="Transacciones completadas" FontSize="11" Foreground="{DynamicResource BrushTextSecondary}"/>
                    </StackPanel>
                    <Border Grid.Column="1" Width="44" Height="44" CornerRadius="10" Background="{DynamicResource BrushSurfaceElevated}" VerticalAlignment="Top">
                        <Path Data="{StaticResource IconCheck}" Fill="{DynamicResource BrushCyan}" Width="20" Height="20" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                </Grid>
            </Border>

            <Border Style="{StaticResource ModernCard}" Margin="12,0,0,0">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0">
                        <TextBlock Text="DURACIÓN PROMEDIO" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource BrushTextMuted}"/>
                        <TextBlock Text="{Binding Summary.AverageDurationMinutes, Converter={StaticResource DurationConv}}"
                                   FontSize="26"
                                   FontWeight="Black"
                                   Foreground="{DynamicResource BrushWarning}"
                                   Margin="0,4,0,2"/>
                        <TextBlock Text="Tiempo medio de estancia" FontSize="11" Foreground="{DynamicResource BrushTextSecondary}"/>
                    </StackPanel>
                    <Border Grid.Column="1" Width="44" Height="44" CornerRadius="10" Background="{DynamicResource BrushWarningBg}" VerticalAlignment="Top">
                        <Path Data="{StaticResource IconClock}" Fill="{DynamicResource BrushWarning}" Width="20" Height="20" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                </Grid>
            </Border>
        </UniformGrid>

        <Border Grid.Row="1" Style="{StaticResource ModernCard}" Padding="16,12" Margin="0,0,0,16">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="280"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <Grid Grid.Column="0">
                    <TextBox Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                             Style="{StaticResource ModernTextBox}"
                             Padding="34,8,10,8"
                             FontSize="13"/>
                    <Path Data="{StaticResource IconSearch}"
                          Fill="{DynamicResource BrushTextMuted}"
                          Width="14"
                          Height="14"
                          Stretch="Uniform"
                          HorizontalAlignment="Left"
                          Margin="12,0,0,0"
                          VerticalAlignment="Center"
                          IsHitTestVisible="False"/>
                </Grid>

                <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="20,0,0,0" VerticalAlignment="Center">
                    <TextBlock Text="Estado:" Foreground="{DynamicResource BrushTextMuted}" FontSize="12" VerticalAlignment="Center" Margin="0,0,8,0"/>
                    <Button Content="Todos" Command="{Binding FilterByStatusCommand}" CommandParameter="All" Style="{StaticResource SecondaryButton}" Padding="10,4" FontSize="11" Margin="0,0,4,0"/>
                    <Button Content="Activos" Command="{Binding FilterByStatusCommand}" CommandParameter="Active" Style="{StaticResource SecondaryButton}" Padding="10,4" FontSize="11" Margin="0,0,4,0"/>
                    <Button Content="Completados" Command="{Binding FilterByStatusCommand}" CommandParameter="Completed" Style="{StaticResource SecondaryButton}" Padding="10,4" FontSize="11" Margin="0,0,16,0"/>

                    <TextBlock Text="Categoría:" Foreground="{DynamicResource BrushTextMuted}" FontSize="12" VerticalAlignment="Center" Margin="0,0,8,0"/>
                    <Button Content="Todos" Command="{Binding FilterByTypeCommand}" CommandParameter="All" Style="{StaticResource SecondaryButton}" Padding="10,4" FontSize="11" Margin="0,0,4,0"/>
                    <Button Content="Autos" Command="{Binding FilterByTypeCommand}" CommandParameter="Car" Style="{StaticResource SecondaryButton}" Padding="10,4" FontSize="11" Margin="0,0,4,0"/>
                    <Button Content="Camionetas" Command="{Binding FilterByTypeCommand}" CommandParameter="Suv" Style="{StaticResource SecondaryButton}" Padding="10,4" FontSize="11" Margin="0,0,4,0"/>
                    <Button Content="Motos" Command="{Binding FilterByTypeCommand}" CommandParameter="Motorcycle" Style="{StaticResource SecondaryButton}" Padding="10,4" FontSize="11" Margin="0,0,4,0"/>
                </StackPanel>

                <StackPanel Grid.Column="2" Orientation="Horizontal">
                    <Button Content="Exportar Auditoría"
                            Command="{Binding ExportReportCommand}"
                            Style="{StaticResource SecondaryButton}"
                            Padding="12,6"
                            FontSize="12"
                            Margin="0,0,8,0">
                        <Button.ContentTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal">
                                    <Path Data="{StaticResource IconReceipt}" Fill="{DynamicResource BrushTextSecondary}" Width="12" Height="12" Stretch="Uniform" Margin="0,0,6,0"/>
                                    <TextBlock Text="Exportar Auditoría" VerticalAlignment="Center"/>
                                </StackPanel>
                            </DataTemplate>
                        </Button.ContentTemplate>
                    </Button>

                    <Button Content="Actualizar"
                            Command="{Binding RefreshDataCommand}"
                            Style="{StaticResource SecondaryButton}"
                            Padding="12,6"
                            FontSize="12">
                        <Button.ContentTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal">
                                    <Path Data="{StaticResource IconRefresh}" Fill="{DynamicResource BrushTextSecondary}" Width="12" Height="12" Stretch="Uniform" Margin="0,0,6,0"/>
                                    <TextBlock Text="Actualizar" VerticalAlignment="Center"/>
                                </StackPanel>
                            </DataTemplate>
                        </Button.ContentTemplate>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <Border Grid.Row="2" Style="{StaticResource ModernCard}" Padding="0">
            <DataGrid ItemsSource="{Binding Transactions}" Style="{StaticResource ModernDataGrid}">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="TIQUETE #" Binding="{Binding TicketNumber}" Width="1.3*">
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock">
                                <Setter Property="FontFamily" Value="{StaticResource FontFamilyMonospace}"/>
                                <Setter Property="FontWeight" Value="SemiBold"/>
                                <Setter Property="Foreground" Value="{DynamicResource BrushTextPrimary}"/>
                                <Setter Property="VerticalAlignment" Value="Center"/>
                            </Style>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>

                    <DataGridTemplateColumn Header="PLACA" Width="1.2*">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding PlateNumber}"
                                           FontFamily="{StaticResource FontFamilyMonospace}"
                                           FontWeight="Black"
                                           FontSize="13"
                                           Foreground="{DynamicResource BrushTextPrimary}"
                                           VerticalAlignment="Center"/>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <DataGridTemplateColumn Header="TIPO DE VEHÍCULO" Width="1.3*">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Border Background="{Binding VehicleType, Converter={StaticResource VehicleBadgeConv}}"
                                        CornerRadius="6"
                                        Padding="8,3"
                                        HorizontalAlignment="Left"
                                        VerticalAlignment="Center">
                                    <TextBlock Text="{Binding VehicleType, Converter={StaticResource VehicleTypeStrConv}}"
                                               FontSize="11"
                                               FontWeight="Bold"
                                               Foreground="{DynamicResource BrushTextWhite}"/>
                                </Border>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <DataGridTextColumn Header="BAHÍA" Binding="{Binding BayNumber}" Width="0.8*">
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock">
                                <Setter Property="FontWeight" Value="Bold"/>
                                <Setter Property="Foreground" Value="{DynamicResource BrushPrimary}"/>
                                <Setter Property="VerticalAlignment" Value="Center"/>
                            </Style>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>

                    <DataGridTextColumn Header="HORA ENTRADA" Binding="{Binding EntryTime, StringFormat='{}{0:yyyy-MM-dd HH:mm}'}" Width="1.4*">
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock">
                                <Setter Property="Foreground" Value="{DynamicResource BrushTextSecondary}"/>
                                <Setter Property="VerticalAlignment" Value="Center"/>
                            </Style>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>

                    <DataGridTextColumn Header="HORA SALIDA" Binding="{Binding ExitTime, StringFormat='{}{0:yyyy-MM-dd HH:mm}'}" Width="1.4*">
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock">
                                <Setter Property="Foreground" Value="{DynamicResource BrushTextSecondary}"/>
                                <Setter Property="VerticalAlignment" Value="Center"/>
                            </Style>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>

                    <DataGridTemplateColumn Header="ESTADO" Width="1.1*">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <Ellipse Width="8" Height="8" Fill="{Binding Status, Converter={StaticResource StatusColorConv}}" Margin="0,0,6,0"/>
                                    <TextBlock Text="{Binding Status, Converter={StaticResource StatusStrConv}}" Foreground="{DynamicResource BrushTextPrimary}" FontSize="12" FontWeight="SemiBold"/>
                                </StackPanel>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <DataGridTextColumn Header="TOTAL COBRADO" Binding="{Binding TotalAmount, Converter={StaticResource CurrencyConv}}" Width="1*">
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock">
                                <Setter Property="FontWeight" Value="Bold"/>
                                <Setter Property="Foreground" Value="{DynamicResource BrushSuccess}"/>
                                <Setter Property="VerticalAlignment" Value="Center"/>
                            </Style>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>
                </DataGrid.Columns>
            </DataGrid>
        </Border>
    </Grid>
</UserControl>
