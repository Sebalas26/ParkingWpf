<Window x:Class="Parking.Views.ModernMessageDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="Notificación"
        WindowStartupLocation="CenterOwner"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="#B3000000"
        ShowInTaskbar="False"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Display"
        TextOptions.TextRenderingMode="ClearType"
        KeyDown="Window_KeyDown">

    <Grid Background="Transparent">
        <Border Width="440"
                MaxHeight="600"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Margin="24"
                Background="{DynamicResource BrushSurfaceBackground}"
                BorderBrush="{DynamicResource BrushBorderMedium}"
                BorderThickness="1"
                CornerRadius="16"
                Padding="24"
                SnapsToDevicePixels="True">
        <Border.Effect>
            <DropShadowEffect BlurRadius="24" ShadowDepth="6" Direction="270" Opacity="0.18" Color="#0B3C49"/>
        </Border.Effect>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Close 'X' Button -->
            <Button Grid.Row="0"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Top"
                    Click="CloseButton_Click"
                    Style="{StaticResource SecondaryButton}"
                    Padding="4"
                    Width="28"
                    Height="28"
                    Margin="0,-8,-8,0"
                    ToolTip="Cerrar (Esc)">
                <Path Data="{StaticResource IconClose}" Fill="{DynamicResource BrushTextSecondary}" Width="10" Height="10" Stretch="Uniform"/>
            </Button>

            <!-- Header with Badge Icon and Title -->
            <Grid Grid.Row="0" Margin="0,0,24,16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- Dynamic Icon Badge Container -->
                <Border x:Name="IconBadgeBorder"
                        Grid.Column="0"
                        Width="44"
                        Height="44"
                        CornerRadius="22"
                        Background="{DynamicResource BrushPrimaryLight}"
                        Margin="0,0,14,0"
                        VerticalAlignment="Center">
                    <Path x:Name="IconPath"
                          Data="{StaticResource IconInfo}"
                          Fill="{DynamicResource BrushPrimary}"
                          Width="20"
                          Height="20"
                          Stretch="Uniform"
                          HorizontalAlignment="Center"
                          VerticalAlignment="Center"/>
                </Border>

                <!-- Title -->
                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <TextBlock x:Name="TitleTextBlock"
                               Text="Título del Mensaje"
                               FontSize="16"
                               FontWeight="Bold"
                               Foreground="{DynamicResource BrushTextPrimary}"
                               TextWrapping="Wrap"/>
                    <TextBlock x:Name="CategoryTextBlock"
                               Text="Aviso del Sistema"
                               FontSize="11"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource BrushTextMuted}"
                               Margin="0,2,0,0"
                               Visibility="Collapsed"/>
                </StackPanel>
            </Grid>

            <!-- Body Message -->
            <Border Grid.Row="1"
                    Background="{DynamicResource BrushAppBackground}"
                    BorderBrush="{DynamicResource BrushBorderSubtle}"
                    BorderThickness="1"
                    CornerRadius="10"
                    Padding="14,12"
                    Margin="0,0,0,20">
                <TextBlock x:Name="MessageTextBlock"
                           Text="Contenido detallado de la notificación o pregunta para el usuario."
                           FontSize="13"
                           LineHeight="19"
                           Foreground="{DynamicResource BrushTextPrimary}"
                           TextWrapping="Wrap"/>
            </Border>

            <!-- Action Buttons Area -->
            <StackPanel Grid.Row="2"
                        Orientation="Horizontal"
                        HorizontalAlignment="Right">
                <!-- Cancel / No Button (for confirmations) -->
                <Button x:Name="CancelButton"
                        Content="Cancelar"
                        Click="CancelButton_Click"
                        Style="{StaticResource SecondaryButton}"
                        Padding="18,9"
                        Margin="0,0,10,0"
                        Visibility="Collapsed"
                        IsCancel="True"/>

                <!-- Confirm / Accept Button -->
                <Button x:Name="ConfirmButton"
                        Content="Entendido"
                        Click="ConfirmButton_Click"
                        Style="{StaticResource ModernButton}"
                        Padding="22,9"
                        IsDefault="True"/>
            </StackPanel>
        </Grid>
    </Border>
    </Grid>
</Window>
