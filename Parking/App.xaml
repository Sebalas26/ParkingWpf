<Application x:Class="Parking.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:conv="clr-namespace:Parking.Core.Converters">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Styles/Colors.xaml"/>
                <ResourceDictionary Source="Styles/Typography.xaml"/>
                <ResourceDictionary Source="Styles/Icons.xaml"/>
                <ResourceDictionary Source="Styles/Controls.xaml"/>
            </ResourceDictionary.MergedDictionaries>

            <!-- Global Converters for universal access across Views and DataGridColumns -->
            <conv:CurrencyConverter x:Key="CurrencyConv"/>
            <conv:BooleanToVisibilityConverter x:Key="BoolToVis"/>
            <conv:InverseBooleanConverter x:Key="InverseBoolConv"/>
            <conv:NullToVisibilityConverter x:Key="NullToVis"/>
            <conv:DurationConverter x:Key="DurationConv"/>
            <conv:VehicleTypeToStringConverter x:Key="VehicleTypeStrConv"/>
            <conv:VehicleTypeToIconConverter x:Key="VehicleIconConv"/>
            <conv:VehicleTypeToBadgeColorConverter x:Key="VehicleBadgeColorConv"/>
            <conv:TicketStatusToStringConverter x:Key="TicketStatusStrConv"/>
            <conv:TicketStatusToColorConverter x:Key="TicketStatusColorConv"/>
            <conv:OccupancyToColorConverter x:Key="OccupancyColorConv"/>
            <conv:ConnectionStatusToColorConverter x:Key="ConnColorConv"/>
            <conv:EqualityToBooleanConverter x:Key="EqualityConv"/>
            <conv:Base64ToImageConverter x:Key="Base64ToImageConv"/>
        </ResourceDictionary>
    </Application.Resources>
</Application>
