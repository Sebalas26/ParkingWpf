<UserControl x:Class="Parking.Views.RecentEntriesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:conv="clr-namespace:Parking.Core.Converters"
             mc:Ignorable="d"
             d:DesignHeight="850" d:DesignWidth="1180">

    <UserControl.Resources>
        <conv:CurrencyConverter x:Key="CurrencyConv"/>
        <conv:VehicleTypeToStringConverter x:Key="VehicleTypeStrConv"/>
        <conv:VehicleTypeToIconConverter x:Key="VehicleIconConv"/>
        <conv:BooleanToVisibilityConverter x:Key="BoolToVis"/>
        <conv:NullToVisibilityConverter x:Key="NullToVis"/>
    </UserControl.Resources>

    <Grid Margin="24">
        <Border Style="{StaticResource ModernCard}" Padding="24">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- 1. Header -->
                <Grid Grid.Row="0" Margin="0,0,0,16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0">
                        <TextBlock Text="Vehículos en Patio y Salidas" FontSize="20" FontWeight="Bold" Foreground="{DynamicResource BrushTextPrimary}"/>
                        <TextBlock Text="Monitoreo operativo de vehículos activos en patio y salidas liquidadas durante el turno actual" FontSize="12" Foreground="{DynamicResource BrushTextMuted}" Margin="0,4,0,0"/>
                    </StackPanel>

                    <!-- Global Counter Badge -->
                    <Border Grid.Column="1" Background="#E0F2FE" CornerRadius="12" Padding="14,6" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal">
                            <Ellipse Width="8" Height="8" Fill="{DynamicResource BrushPrimary}" Margin="0,0,8,0" VerticalAlignment="Center"/>
                            <TextBlock Text="{Binding ActiveTicketsCount, StringFormat='{}{0} Activos en Patio'}"
                                       FontSize="12"
                                       FontWeight="Bold"
                                       Foreground="{DynamicResource BrushPrimary}"
                                       VerticalAlignment="Center"/>
                        </StackPanel>
                    </Border>
                </Grid>

                <!-- 2. Submodule Pill Tabs (Activos en Patio vs Salidas del Turno) -->
                <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,16">
                    <RadioButton IsChecked="{Binding IsActiveTab, Mode=OneWay}"
                                 Command="{Binding SetTabCommand}"
                                 CommandParameter="0"
                                 Style="{StaticResource FilterChipRadioButton}"
                                 Padding="16,8">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Path Data="{StaticResource IconCar}" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}" Width="14" Height="14" Stretch="Uniform" Margin="0,0,8,0" VerticalAlignment="Center"/>
                            <TextBlock Text="Vehículos en Patio (Activos)" FontWeight="Bold" FontSize="12.5" VerticalAlignment="Center"/>
                            <Border Background="#E0F2FE" CornerRadius="10" Padding="8,2" Margin="8,0,0,0" VerticalAlignment="Center">
                                <TextBlock Text="{Binding ActiveTicketsCount}" FontSize="11" FontWeight="Black" Foreground="{DynamicResource BrushPrimary}"/>
                            </Border>
                        </StackPanel>
                    </RadioButton>

                    <RadioButton IsChecked="{Binding IsCompletedTab, Mode=OneWay}"
                                 Command="{Binding SetTabCommand}"
                                 CommandParameter="1"
                                 Style="{StaticResource FilterChipRadioButton}"
                                 Padding="16,8">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Path Data="{StaticResource IconCheckOut}" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}" Width="14" Height="14" Stretch="Uniform" Margin="0,0,8,0" VerticalAlignment="Center"/>
                            <TextBlock Text="Salidas / Liquidados en el Turno" FontWeight="Bold" FontSize="12.5" VerticalAlignment="Center"/>
                            <Border Background="#DCFCE7" CornerRadius="10" Padding="8,2" Margin="8,0,0,0" VerticalAlignment="Center">
                                <TextBlock Text="{Binding CompletedTicketsCount}" FontSize="11" FontWeight="Black" Foreground="{DynamicResource BrushSuccess}"/>
                            </Border>
                        </StackPanel>
                    </RadioButton>
                </StackPanel>

                <!-- 3. Search & Actions Bar -->
                <Grid Grid.Row="2" Margin="0,0,0,18">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <!-- Buscador Mejorado con Ícono de Lupa y Botón Limpiar -->
                    <Grid Grid.Column="0" Width="380" HorizontalAlignment="Left">
                        <Border Background="{DynamicResource BrushInputBackground}"
                                BorderBrush="{DynamicResource BrushBorderSubtle}"
                                BorderThickness="1.5"
                                CornerRadius="20"
                                Padding="12,4">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <!-- Ícono de Lupa -->
                                <Path Grid.Column="0"
                                      Data="{StaticResource IconSearch}"
                                      Fill="{DynamicResource BrushTextSecondary}"
                                      Width="14" Height="14"
                                      Stretch="Uniform"
                                      Margin="2,0,8,0"
                                      VerticalAlignment="Center"/>

                                <!-- Input de Búsqueda -->
                                <TextBox Grid.Column="1"
                                         Text="{Binding SearchQuery, UpdateSourceTrigger=PropertyChanged}"
                                         BorderThickness="0"
                                         Background="Transparent"
                                         FontSize="13"
                                         FontWeight="SemiBold"
                                         Foreground="{DynamicResource BrushTextPrimary}"
                                         CaretBrush="{DynamicResource BrushPrimary}"
                                         VerticalContentAlignment="Center"
                                         Padding="0,4"/>

                                <!-- Marca de Agua si está vacío -->
                                <TextBlock Grid.Column="1"
                                           Text="Buscar por placa o número de tiquete..."
                                           IsHitTestVisible="False"
                                           Foreground="{DynamicResource BrushTextMuted}"
                                           FontSize="13"
                                           VerticalAlignment="Center"
                                           Margin="2,0,0,0"
                                           Visibility="{Binding HasSearchQuery, Converter={StaticResource BoolToVis}, ConverterParameter=Invert}"/>

                                <!-- Botón Limpiar (X) si hay texto -->
                                <Button Grid.Column="2"
                                        Command="{Binding ClearSearchCommand}"
                                        Visibility="{Binding HasSearchQuery, Converter={StaticResource BoolToVis}}"
                                        Style="{StaticResource SecondaryButton}"
                                        Padding="3"
                                        Width="20" Height="20"
                                        Margin="4,0,0,0"
                                        VerticalAlignment="Center"
                                        ToolTip="Limpiar búsqueda">
                                    <Path Data="{StaticResource IconClose}"
                                          Fill="{DynamicResource BrushTextSecondary}"
                                          Width="9" Height="9"
                                          Stretch="Uniform"/>
                                </Button>
                            </Grid>
                        </Border>
                    </Grid>

                    <!-- Refresh Button -->
                    <Button Grid.Column="2"
                            Command="{Binding LoadEntriesCommand}"
                            Style="{StaticResource SecondaryButton}"
                            Padding="14,8">
                        <StackPanel Orientation="Horizontal">
                            <Path Data="{StaticResource IconRefresh}" Fill="{DynamicResource BrushTextPrimary}" Width="13" Height="13" Stretch="Uniform" Margin="0,0,8,0" VerticalAlignment="Center"/>
                            <TextBlock Text="Actualizar Lista" FontWeight="SemiBold" FontSize="12" Foreground="{DynamicResource BrushTextPrimary}" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                </Grid>

                <!-- 4. Pestaña 1: DataGrid de Vehículos en Patio (Activos) -->
                <DataGrid Grid.Row="3"
                          ItemsSource="{Binding ActiveEntries}"
                          Visibility="{Binding IsActiveTab, Converter={StaticResource BoolToVis}}"
                          Style="{StaticResource ModernDataGrid}"
                          IsReadOnly="True"
                          CanUserResizeColumns="True"
                          HorizontalScrollBarVisibility="Auto">
                    <DataGrid.Columns>
                        <!-- Placa -->
                        <DataGridTemplateColumn Header="PLACA" Width="105" MinWidth="95">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding PlateNumber}"
                                               FontFamily="{StaticResource FontFamilyMonospace}"
                                               FontWeight="Black"
                                               FontSize="15"
                                               Foreground="{DynamicResource BrushTextPrimary}"
                                               VerticalAlignment="Center"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <!-- Tipo de Vehículo -->
                        <DataGridTemplateColumn Header="CATEGORÍA" Width="120" MinWidth="110">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <Border Width="26" Height="26" CornerRadius="6" Background="{DynamicResource BrushPrimary}" Margin="0,0,8,0">
                                            <Path Data="{Binding VehicleType, Converter={StaticResource VehicleIconConv}}"
                                                  Fill="{DynamicResource BrushTextWhite}"
                                                  Width="13" Height="13"
                                                  Stretch="Uniform"
                                                  HorizontalAlignment="Center"
                                                  VerticalAlignment="Center"/>
                                        </Border>
                                        <TextBlock Text="{Binding VehicleType, Converter={StaticResource VehicleTypeStrConv}}"
                                                   FontSize="12"
                                                   FontWeight="SemiBold"
                                                   Foreground="{DynamicResource BrushTextPrimary}"
                                                   VerticalAlignment="Center"/>
                                    </StackPanel>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <!-- Número de Tiquete -->
                        <DataGridTemplateColumn Header="TIQUETE #" MinWidth="185" Width="1.8*">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding TicketNumber}"
                                               FontFamily="{StaticResource FontFamilyMonospace}"
                                               FontWeight="Bold"
                                               FontSize="13"
                                               Foreground="{DynamicResource BrushTextPrimary}"
                                               VerticalAlignment="Center"
                                               ToolTip="{Binding TicketNumber}"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <!-- Hora de Ingreso -->
                        <DataGridTextColumn Header="HORA INGRESO" Binding="{Binding EntryTime, Mode=OneWay, StringFormat='{}{0:yyyy-MM-dd HH:mm:ss}'}" MinWidth="155" Width="1.5*"/>

                        <!-- Tiempo Transcurrido -->
                        <DataGridTemplateColumn Header="TIEMPO EN PATIO" MinWidth="120" Width="1.2*">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <Path Data="{StaticResource IconClock}" Fill="{DynamicResource BrushTextSecondary}" Width="12" Height="12" Stretch="Uniform" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                        <TextBlock Text="{Binding FormattedDuration}"
                                                   FontWeight="SemiBold"
                                                   FontSize="12"
                                                   Foreground="{DynamicResource BrushTextPrimary}"
                                                   VerticalAlignment="Center"/>
                                    </StackPanel>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <!-- Valor Estimado Acumulado -->
                        <DataGridTemplateColumn Header="VALOR ACUMULADO" MinWidth="125" Width="1.2*">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding CurrentEstimatedAmount, Converter={StaticResource CurrencyConv}}"
                                               FontWeight="Black"
                                               FontSize="13"
                                               Foreground="{DynamicResource BrushSuccess}"
                                               VerticalAlignment="Center"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <!-- Operador -->
                        <DataGridTextColumn Header="OPERADOR EN TURNO" Binding="{Binding OperatorName, Mode=OneWay}" MinWidth="140" Width="1.3*"/>

                        <!-- Acción: Reimprimir Tiquete -->
                        <DataGridTemplateColumn Header="ACCIONES" MinWidth="160" Width="Auto">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Button Command="{Binding DataContext.ReprintTicketCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                            CommandParameter="{Binding}"
                                            Style="{StaticResource SecondaryButton}"
                                            Padding="10,5"
                                            VerticalAlignment="Center">
                                        <StackPanel Orientation="Horizontal">
                                            <Path Data="{StaticResource IconReceipt}" Fill="{DynamicResource BrushPrimary}" Width="12" Height="12" Stretch="Uniform" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                            <TextBlock Text="Reimprimir Tiquete" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource BrushPrimary}" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </Button>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>

                <!-- 5. Pestaña 2: DataGrid de Salidas / Liquidados en el Turno -->
                <DataGrid Grid.Row="3"
                          ItemsSource="{Binding CompletedEntries}"
                          Visibility="{Binding IsCompletedTab, Converter={StaticResource BoolToVis}}"
                          Style="{StaticResource ModernDataGrid}"
                          IsReadOnly="True"
                          CanUserResizeColumns="True"
                          HorizontalScrollBarVisibility="Auto">
                    <DataGrid.Columns>
                        <!-- Placa -->
                        <DataGridTemplateColumn Header="PLACA" Width="105" MinWidth="95">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding PlateNumber}"
                                               FontFamily="{StaticResource FontFamilyMonospace}"
                                               FontWeight="Black"
                                               FontSize="15"
                                               Foreground="{DynamicResource BrushTextPrimary}"
                                               VerticalAlignment="Center"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <!-- Tipo de Vehículo -->
                        <DataGridTemplateColumn Header="CATEGORÍA" Width="120" MinWidth="110">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <Border Width="26" Height="26" CornerRadius="6" Background="{DynamicResource BrushPrimary}" Margin="0,0,8,0">
                                            <Path Data="{Binding VehicleType, Converter={StaticResource VehicleIconConv}}"
                                                  Fill="{DynamicResource BrushTextWhite}"
                                                  Width="13" Height="13"
                                                  Stretch="Uniform"
                                                  HorizontalAlignment="Center"
                                                  VerticalAlignment="Center"/>
                                        </Border>
                                        <TextBlock Text="{Binding VehicleType, Converter={StaticResource VehicleTypeStrConv}}"
                                                   FontSize="12"
                                                   FontWeight="SemiBold"
                                                   Foreground="{DynamicResource BrushTextPrimary}"
                                                   VerticalAlignment="Center"/>
                                    </StackPanel>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <!-- Tiquete / Factura -->
                        <DataGridTemplateColumn Header="TIQUETE / FACTURA" MinWidth="175" Width="1.6*">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock Text="{Binding InvoiceNumber}"
                                                   FontFamily="{StaticResource FontFamilyMonospace}"
                                                   FontWeight="Bold"
                                                   FontSize="12.5"
                                                   Foreground="{DynamicResource BrushPrimary}"
                                                   Visibility="{Binding InvoiceNumber, Converter={StaticResource NullToVis}}"/>
                                        <TextBlock Text="{Binding TicketNumber}"
                                                   FontFamily="{StaticResource FontFamilyMonospace}"
                                                   FontSize="11.5"
                                                   Foreground="{DynamicResource BrushTextSecondary}"/>
                                    </StackPanel>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <!-- Hora Ingreso -->
                        <DataGridTextColumn Header="INGRESO" Binding="{Binding EntryTime, Mode=OneWay, StringFormat='{}{0:HH:mm:ss}'}" MinWidth="90" Width="0.9*"/>

                        <!-- Hora Salida -->
                        <DataGridTextColumn Header="SALIDA" Binding="{Binding ExitTime, Mode=OneWay, StringFormat='{}{0:HH:mm:ss}'}" MinWidth="90" Width="0.9*"/>

                        <!-- Tiempo Total -->
                        <DataGridTemplateColumn Header="DURACIÓN" MinWidth="110" Width="1*">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding FormattedDuration}"
                                               FontWeight="SemiBold"
                                               FontSize="12"
                                               Foreground="{DynamicResource BrushTextPrimary}"
                                               VerticalAlignment="Center"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <!-- Total Cobrado -->
                        <DataGridTemplateColumn Header="TOTAL COBRADO" MinWidth="125" Width="1.2*">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding NetAmount, Converter={StaticResource CurrencyConv}}"
                                               FontWeight="Black"
                                               FontSize="13"
                                               Foreground="{DynamicResource BrushSuccess}"
                                               VerticalAlignment="Center"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <!-- Operador -->
                        <DataGridTextColumn Header="OPERADOR" Binding="{Binding OperatorName, Mode=OneWay}" MinWidth="130" Width="1.2*"/>

                        <!-- Acción: Reimprimir Recibo -->
                        <DataGridTemplateColumn Header="ACCIONES" MinWidth="160" Width="Auto">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Button Command="{Binding DataContext.ReprintTicketCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                            CommandParameter="{Binding}"
                                            Style="{StaticResource SecondaryButton}"
                                            Padding="10,5"
                                            VerticalAlignment="Center">
                                        <StackPanel Orientation="Horizontal">
                                            <Path Data="{StaticResource IconReceipt}" Fill="{DynamicResource BrushPrimary}" Width="12" Height="12" Stretch="Uniform" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                            <TextBlock Text="Reimprimir Recibo" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource BrushPrimary}" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </Button>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>
            </Grid>
        </Border>
    </Grid>
</UserControl>
