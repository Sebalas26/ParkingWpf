<Window x:Class="Parking.Views.MainShellWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:Parking.ViewModels"
        xmlns:views="clr-namespace:Parking.Views"
        xmlns:conv="clr-namespace:Parking.Core.Converters"
        xmlns:security="clr-namespace:Parking.Security"
        mc:Ignorable="d"
        Title="Park Point - Terminal POS de Control de Acceso y Caja"
        Height="900" Width="1440"
        MinHeight="720" MinWidth="1024"
        WindowStartupLocation="CenterScreen"
        WindowState="Maximized"
        Background="{DynamicResource BrushAppBackground}">

    <Window.Resources>
        <conv:BooleanToVisibilityConverter x:Key="BoolToVis"/>
        <conv:InverseBooleanConverter x:Key="InverseBoolConv"/>

        <DataTemplate DataType="{x:Type vm:CheckInViewModel}">
            <views:CheckInView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:CheckOutViewModel}">
            <views:CheckOutView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:MonthlySubscriptionsViewModel}">
            <views:MonthlySubscriptionsView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:RecentEntriesViewModel}">
            <views:RecentEntriesView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:AnalyticsViewModel}">
            <views:AnalyticsView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:ShiftClosureViewModel}">
            <views:ShiftClosureView/>
        </DataTemplate>
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="260"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Left Sidebar en Grafito PARK POINT (#1E2A2F) -->
        <Border Grid.Column="0"
                Background="{DynamicResource BrushSidebarBackground}"
                BorderBrush="{DynamicResource BrushBorderSubtle}"
                BorderThickness="0,0,1,0"
                Padding="16,20">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Sidebar Brand Header PARK POINT -->
                <StackPanel Grid.Row="0" Margin="4,0,0,28">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Border Background="{DynamicResource BrushPrimary}" CornerRadius="8" Width="38" Height="38" Margin="0,0,10,0">
                            <Path Data="{StaticResource IconCar}" Fill="{DynamicResource BrushTextWhite}" Width="20" Height="20" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="PARK POINT" FontSize="19" FontWeight="Black" Foreground="{DynamicResource BrushTextWhite}"/>
                            <TextBlock Text="TU PUNTO DE LLEGADA" FontSize="8" FontWeight="Bold" Foreground="{DynamicResource BrushPrimaryLight}"/>
                        </StackPanel>
                    </StackPanel>
                </StackPanel>

                <!-- Navigation List: Módulos Operativos -->
                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel>
                        <TextBlock Text="OPERACIÓN EN TERMINAL" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource BrushSidebarText}" Margin="12,0,0,12"/>

                        <!-- 1. Ingreso de Vehículos -->
                        <RadioButton Content="Ingreso de Vehículos"
                                     Command="{Binding NavigateToCheckInCommand}"
                                     IsChecked="{Binding SelectedNavSection, Converter={StaticResource BoolToVis}, ConverterParameter=CheckIn, Mode=OneWay}"
                                     security:Authorize.Permission="checkin.view"
                                     Style="{StaticResource SidebarNavButton}"
                                     Margin="0,0,0,6">
                            <RadioButton.Tag>
                                <Path Data="{StaticResource IconCheckIn}" Fill="{DynamicResource BrushTextWhite}" Width="16" Height="16" Stretch="Uniform"/>
                            </RadioButton.Tag>
                        </RadioButton>

                        <!-- 2. Salida y Cobro / Caja -->
                        <RadioButton Content="Salida y Cobro / Caja"
                                     Command="{Binding NavigateToCheckOutCommand}"
                                     IsChecked="{Binding SelectedNavSection, Converter={StaticResource BoolToVis}, ConverterParameter=CheckOut, Mode=OneWay}"
                                     security:Authorize.Permission="checkout.view"
                                     Style="{StaticResource SidebarNavButton}"
                                     Margin="0,0,0,6">
                            <RadioButton.Tag>
                                <Path Data="{StaticResource IconCheckOut}" Fill="{DynamicResource BrushTextWhite}" Width="16" Height="16" Stretch="Uniform"/>
                            </RadioButton.Tag>
                        </RadioButton>

                        <!-- 3. Mensualidades y Abonados -->
                        <RadioButton Content="Mensualidades"
                                     Command="{Binding NavigateToMonthlySubscriptionsCommand}"
                                     IsChecked="{Binding SelectedNavSection, Converter={StaticResource BoolToVis}, ConverterParameter=Subscriptions, Mode=OneWay}"
                                     security:Authorize.Permission="subscriptions.view"
                                     Style="{StaticResource SidebarNavButton}"
                                     Margin="0,0,0,6">
                            <RadioButton.Tag>
                                <Path Data="{StaticResource IconCalendar}" Fill="{DynamicResource BrushTextWhite}" Width="16" Height="16" Stretch="Uniform"/>
                            </RadioButton.Tag>
                        </RadioButton>

                        <!-- 4. Vehículos en Patio / Recientes -->
                        <RadioButton Content="Vehículos en Patio"
                                     Command="{Binding NavigateToRecentEntriesCommand}"
                                     IsChecked="{Binding SelectedNavSection, Converter={StaticResource BoolToVis}, ConverterParameter=RecentEntries, Mode=OneWay}"
                                     security:Authorize.Permission="recent_entries.view"
                                     Style="{StaticResource SidebarNavButton}"
                                     Margin="0,0,0,6">
                            <RadioButton.Tag>
                                <Path Data="{StaticResource IconClock}" Fill="{DynamicResource BrushTextWhite}" Width="16" Height="16" Stretch="Uniform"/>
                            </RadioButton.Tag>
                        </RadioButton>

                        <Border Height="1" Background="{DynamicResource BrushBorderSubtle}" Opacity="0.2" Margin="12,12,12,12"/>

                        <!-- 5. Control de Turnos y Caja -->
                        <RadioButton Content="Control de Turnos"
                                     Command="{Binding NavigateToShiftClosureCommand}"
                                     IsChecked="{Binding SelectedNavSection, Converter={StaticResource BoolToVis}, ConverterParameter=ShiftClosure, Mode=OneWay}"
                                     security:Authorize.Permission="shift.view"
                                     Style="{StaticResource SidebarNavButton}"
                                     Margin="0,0,0,6">
                            <RadioButton.Tag>
                                <Path Data="{StaticResource IconCashRegister}" Fill="{DynamicResource BrushTextWhite}" Width="16" Height="16" Stretch="Uniform"/>
                            </RadioButton.Tag>
                        </RadioButton>

                        <!-- 6. Analítica y Finanzas -->
                        <RadioButton Content="Analítica y Finanzas"
                                     Command="{Binding NavigateToAnalyticsCommand}"
                                     IsChecked="{Binding SelectedNavSection, Converter={StaticResource BoolToVis}, ConverterParameter=Analytics, Mode=OneWay}"
                                     security:Authorize.Permission="analytics.view"
                                     Style="{StaticResource SidebarNavButton}"
                                     Margin="0,0,0,6">
                            <RadioButton.Tag>
                                <Path Data="{StaticResource IconAnalytics}" Fill="{DynamicResource BrushTextWhite}" Width="16" Height="16" Stretch="Uniform"/>
                            </RadioButton.Tag>
                        </RadioButton>
                    </StackPanel>
                </ScrollViewer>

                <!-- Sidebar Footer: Operator Session Card & Logout -->
                <Border Grid.Row="2"
                        Background="#25343B"
                        BorderBrush="#354850"
                        BorderThickness="1"
                        CornerRadius="12"
                        Padding="12,10">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <!-- Avatar Badge -->
                        <Border Grid.Column="0"
                                Width="34" Height="34"
                                CornerRadius="17"
                                Background="{DynamicResource BrushPrimary}"
                                Margin="0,0,10,0">
                            <TextBlock Text="{Binding CurrentUser.FullName[0], FallbackValue='U'}"
                                       FontWeight="Bold"
                                       FontSize="14"
                                       Foreground="{DynamicResource BrushTextWhite}"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"/>
                        </Border>

                        <!-- User Info -->
                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock Text="{Binding CurrentUser.FullName, FallbackValue='Operador de Caja'}"
                                       FontWeight="Bold"
                                       FontSize="12"
                                       Foreground="{DynamicResource BrushTextWhite}"
                                       TextTrimming="CharacterEllipsis"/>
                            <TextBlock Text="{Binding CurrentUser.RoleName, FallbackValue='Cajero'}"
                                       FontSize="10"
                                       Foreground="{DynamicResource BrushSidebarText}"/>
                        </StackPanel>

                        <!-- Logout Button -->
                        <Button Grid.Column="2"
                                Command="{Binding LogoutCommand}"
                                Style="{StaticResource SecondaryButton}"
                                Width="28" Height="28"
                                Padding="0"
                                ToolTip="Cerrar Sesión">
                            <Path Data="{StaticResource IconLogout}"
                                  Fill="{DynamicResource BrushDanger}"
                                  Width="12" Height="12"
                                  Stretch="Uniform"/>
                        </Button>
                    </Grid>
                </Border>
            </Grid>
        </Border>

        <!-- Main Workspace Area -->
        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Top Header Bar with Live Network & Occupancy Telemetry -->
            <Border Grid.Row="0"
                    Background="{DynamicResource BrushSurfaceBackground}"
                    BorderBrush="{DynamicResource BrushBorderSubtle}"
                    BorderThickness="0,0,0,1"
                    Padding="20,10">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <!-- Left: Current Section Title -->
                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                        <Border Background="{DynamicResource BrushSurfaceLight}"
                                CornerRadius="8"
                                Padding="8,5"
                                Margin="0,0,12,0">
                            <Path Data="{StaticResource IconBuilding}"
                                  Fill="{DynamicResource BrushPrimary}"
                                  Width="14" Height="14"
                                  Stretch="Uniform"/>
                        </Border>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="ESTACIÓN DE TRABAJO"
                                       FontSize="9"
                                       FontWeight="Bold"
                                       Foreground="{DynamicResource BrushTextSecondary}"/>
                            <TextBlock Text="{Binding CurrentBranch.Name, FallbackValue='Sede Principal'}"
                                       FontSize="13"
                                       FontWeight="Bold"
                                       Foreground="{DynamicResource BrushTextPrimary}"/>
                        </StackPanel>
                    </StackPanel>

                    <!-- Center: Sync Status & Connectivity Indicator -->
                    <StackPanel Grid.Column="1"
                                Orientation="Horizontal"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center">
                        
                        <!-- Network Pulse Pill -->
                        <Border Background="{DynamicResource BrushInputBackground}"
                                BorderBrush="{DynamicResource BrushBorderSubtle}"
                                BorderThickness="1"
                                CornerRadius="14"
                                Padding="10,4"
                                Margin="0,0,10,0">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Ellipse Width="7" Height="7"
                                         Fill="{Binding IsOnlineMode, Converter={StaticResource BoolToVis}, ConverterParameter=BrushSuccess, FallbackValue={StaticResource BrushSuccess}}"
                                         Margin="0,0,6,0"
                                         VerticalAlignment="Center"/>
                                <TextBlock Text="{Binding SyncStatusText}"
                                           FontSize="11"
                                           FontWeight="SemiBold"
                                           Foreground="{DynamicResource BrushTextSecondary}"
                                           VerticalAlignment="Center"/>
                            </StackPanel>
                        </Border>

                        <!-- Force Sync Manual Button -->
                        <Button Command="{Binding ForceSyncCommand}"
                                IsEnabled="{Binding IsSyncing, Converter={StaticResource InverseBoolConv}}"
                                Style="{StaticResource SecondaryButton}"
                                Height="28"
                                Padding="8,0"
                                ToolTip="Forzar Sincronización Inmediata">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Path Data="{StaticResource IconRefresh}"
                                      Fill="{DynamicResource BrushPrimary}"
                                      Width="11" Height="11"
                                      Stretch="Uniform"
                                      Margin="0,0,5,0"
                                      VerticalAlignment="Center"/>
                                <TextBlock Text="Sincronizar"
                                           FontSize="11"
                                           Foreground="{DynamicResource BrushPrimary}"
                                           FontWeight="SemiBold"
                                           VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                    </StackPanel>

                    <!-- Right Telemetry: Sede Activa, Ocupación y Reloj en Vivo -->
                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                        
                        <!-- 1. Píldora de Sede Activa (Multi-Sede) -->
                        <Border Background="{DynamicResource BrushSurfaceLight}"
                                BorderBrush="{DynamicResource BrushPrimary}"
                                BorderThickness="1"
                                CornerRadius="14"
                                Padding="10,4"
                                Margin="0,0,8,0">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Path Data="{StaticResource IconBuilding}" Fill="{DynamicResource BrushPrimary}" Width="12" Height="12" Stretch="Uniform" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                <TextBlock Text="{Binding CurrentBranch.Name, FallbackValue='Sede Principal'}"
                                           FontSize="11"
                                           FontWeight="Bold"
                                           Foreground="{DynamicResource BrushPrimary}"
                                           VerticalAlignment="Center"/>
                            </StackPanel>
                        </Border>

                        <!-- 2. Botón Cambiar Sede (Visible si el usuario tiene más de 1 sede) -->
                        <Button Command="{Binding SwitchBranchCommand}"
                                Visibility="{Binding HasMultipleBranches, Converter={StaticResource BoolToVis}}"
                                Style="{StaticResource SecondaryButton}"
                                Height="28"
                                Padding="8,0"
                                Margin="0,0,8,0"
                                ToolTip="Cambiar Sede Activa">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Path Data="{StaticResource IconSettings}" Fill="{DynamicResource BrushTextSecondary}" Width="11" Height="11" Stretch="Uniform" Margin="0,0,4,0" VerticalAlignment="Center"/>
                                <TextBlock Text="Cambiar Sede" FontSize="10" FontWeight="SemiBold" Foreground="{DynamicResource BrushTextSecondary}" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>

                        <!-- 3. Occupancy Quick Badge -->
                        <Border Background="{DynamicResource BrushSurfaceLight}"
                                BorderBrush="{DynamicResource BrushBorderSubtle}"
                                BorderThickness="1"
                                CornerRadius="14"
                                Padding="10,4"
                                Margin="0,0,8,0">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Ellipse Width="7" Height="7" Fill="{DynamicResource BrushSuccess}" Margin="0,0,5,0" VerticalAlignment="Center"/>
                                <TextBlock Text="{Binding Occupancy.OccupancySummary}"
                                           FontSize="11"
                                           FontWeight="Bold"
                                           Foreground="{DynamicResource BrushTextPrimary}"
                                           VerticalAlignment="Center"/>
                            </StackPanel>
                        </Border>

                        <!-- 4. Live Clock Pill -->
                        <Border Background="{DynamicResource BrushInputBackground}"
                                BorderBrush="{DynamicResource BrushBorderSubtle}"
                                BorderThickness="1"
                                CornerRadius="14"
                                Padding="10,4">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Path Data="{StaticResource IconClock}" Fill="{DynamicResource BrushPrimary}" Width="11" Height="11" Stretch="Uniform" Margin="0,0,5,0" VerticalAlignment="Center"/>
                                <TextBlock Text="{Binding CurrentTimeString}"
                                           FontSize="11"
                                           FontWeight="SemiBold"
                                           Foreground="{DynamicResource BrushTextSecondary}"
                                           VerticalAlignment="Center"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Dynamic Active View -->
            <ContentControl Grid.Row="1" Content="{Binding ActiveView}"/>
        </Grid>
    </Grid>
</Window>
