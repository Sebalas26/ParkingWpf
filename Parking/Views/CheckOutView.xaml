<UserControl x:Class="Parking.Views.CheckOutView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:conv="clr-namespace:Parking.Core.Converters"
             xmlns:enums="clr-namespace:Parking.Core.Enums"
             mc:Ignorable="d"
             d:DesignHeight="850" d:DesignWidth="1180">

    <UserControl.Resources>
        <conv:CurrencyConverter x:Key="CurrencyConv"/>
        <conv:VehicleTypeToStringConverter x:Key="VehicleTypeStrConv"/>
        <conv:VehicleTypeToIconConverter x:Key="VehicleIconConv"/>
        <conv:BooleanToVisibilityConverter x:Key="BoolToVis"/>
        <conv:NullToVisibilityConverter x:Key="NullToVis"/>

        <!-- Estilo de Botón de Búsqueda Circular Dinámico (Gris inactivo / Verde activo) -->
        <Style x:Key="CircularSearchButton" TargetType="Button">
            <Setter Property="Background" Value="{DynamicResource BrushPrimary}"/>
            <Setter Property="Foreground" Value="{DynamicResource BrushTextWhite}"/>
            <Setter Property="Width" Value="150"/>
            <Setter Property="Height" Value="150"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border"
                                Background="{TemplateBinding Background}"
                                BorderThickness="0"
                                CornerRadius="75"
                                SnapsToDevicePixels="True">
                            <Border.Effect>
                                <DropShadowEffect BlurRadius="14" Direction="270" ShadowDepth="3" Opacity="0.18" Color="#0B3C49"/>
                            </Border.Effect>
                            <Path x:Name="IconSearchPath"
                                  Data="{StaticResource IconSearch}"
                                  Fill="{TemplateBinding Foreground}"
                                  Width="56" Height="56"
                                  Stretch="Uniform"
                                  HorizontalAlignment="Center"
                                  VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="{DynamicResource BrushPrimaryHover}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Background" Value="{DynamicResource BrushPrimaryActive}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="border" Property="Background" Value="#CBD5E1"/>
                                <Setter TargetName="IconSearchPath" Property="Fill" Value="#94A3B8"/>
                                <Setter TargetName="border" Property="Effect" Value="{x:Null}"/>
                                <Setter Property="Cursor" Value="Arrow"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <!-- Fila Superior: Captura de Placa / Búsqueda de Tiquete (Zona Verde) -->
            <RowDefinition Height="Auto"/>
            <!-- Fila Inferior: Listado / Historial de Vehículos Activos en Patio (Zona Roja) -->
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- ========================================================================= -->
        <!-- ZONA SUPERIOR: Formulario Panorámico de Ingreso y Búsqueda de Placa -->
        <!-- ========================================================================= -->
        <Border Grid.Row="0"
                Style="{StaticResource ModernCard}"
                Margin="0,0,0,16"
                Padding="22">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- 1. Título y Descripción -->
                <Grid Grid.Row="0" Margin="0,0,0,14">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0">
                        <TextBlock Text="Liquidación y Salida" FontSize="20" FontWeight="Bold" Foreground="{DynamicResource BrushTextPrimary}"/>
                        <TextBlock Text="Escanee el código de barras del tiquete o digite la placa para procesar el cobro" FontSize="13" Foreground="{DynamicResource BrushTextMuted}" Margin="0,3,0,0"/>
                    </StackPanel>

                    <Border Grid.Column="1"
                            Background="#F0FDF4"
                            BorderBrush="#86EFAC"
                            BorderThickness="1"
                            CornerRadius="10"
                            Padding="12,6"
                            VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal">
                            <Path Data="{StaticResource IconCheck}" Fill="{DynamicResource BrushSuccess}" Width="14" Height="14" Stretch="Uniform" Margin="0,0,6,0" VerticalAlignment="Center"/>
                            <TextBlock Text="Terminal Lista para Cobro" FontSize="12" FontWeight="Bold" Foreground="{DynamicResource BrushSuccess}" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Border>
                </Grid>

                <!-- 2. Caja de Búsqueda de Placa / Escaneo -->
                <Grid Grid.Row="1">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBox x:Name="SearchTextBox"
                             Grid.Column="0"
                             Text="{Binding SearchQuery, UpdateSourceTrigger=PropertyChanged}"
                             Style="{StaticResource CheckoutSearchTextBox}"
                             Height="160"
                             FontSize="90"
                             Margin="0,0,16,0">
                        <TextBox.InputBindings>
                            <KeyBinding Key="Return" Command="{Binding SearchTicketCommand}"/>
                            <KeyBinding Key="Enter" Command="{Binding SearchTicketCommand}"/>
                        </TextBox.InputBindings>
                    </TextBox>
                    <Button Grid.Column="1"
                            Command="{Binding SearchTicketCommand}"
                            Style="{StaticResource CircularSearchButton}"
                            VerticalAlignment="Center"
                            ToolTip="Buscar tiquete o placa (Enter)"/>
                </Grid>
            </Grid>
        </Border>

        <!-- ========================================================================= -->
        <!-- ZONA INFERIOR: Historial y Listado de Vehículos Activos en Patio -->
        <!-- ========================================================================= -->
        <Border Grid.Row="1"
                Style="{StaticResource ModernCard}"
                Padding="22">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- Encabezado de la Sección de Activos -->
                <Grid Grid.Row="0" Margin="0,0,0,16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <!-- Izquierda: Título de Sección -->
                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                        <Path Data="{StaticResource IconCar}" Fill="{DynamicResource BrushPrimary}" Width="18" Height="18" Stretch="Uniform" Margin="0,0,8,0" VerticalAlignment="Center"/>
                        <TextBlock Text="VEHÍCULOS ACTIVOS ADENTRO"
                                   FontSize="15"
                                   FontWeight="Black"
                                   Foreground="{DynamicResource BrushTextPrimary}"
                                   VerticalAlignment="Center"/>
                    </StackPanel>

                    <!-- Derecha: Badge de Vehículos en Patio -->
                    <Border Grid.Column="1" Background="#F0F0F0" BorderBrush="#398d78ff" BorderThickness="1" CornerRadius="12" Padding="12,4" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Ellipse Width="8" Height="8" Fill="{DynamicResource BrushPrimary}" Margin="0,0,6,0" VerticalAlignment="Center"/>
                            <TextBlock Text="{Binding ActiveVehicles.Count, StringFormat='{}{0} en Patio'}"
                                       FontSize="13"
                                       FontWeight="Bold"
                                       Foreground="{DynamicResource BrushPrimary}"
                                       VerticalAlignment="Center"/>
                        </StackPanel>
                    </Border>
                </Grid>

                <!-- Listado Dinámico de Vehículos -->
                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <ItemsControl ItemsSource="{Binding ActiveVehicles}" VerticalAlignment="Top">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <UniformGrid Columns="3" VerticalAlignment="Top"/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border HorizontalAlignment="Stretch"
                                        VerticalAlignment="Top"
                                        Background="#F0F0F0"
                                        BorderBrush="{DynamicResource BrushBorderSubtle}"
                                        BorderThickness="1.5"
                                        CornerRadius="14"
                                        Padding="14,10"
                                        Margin="0,0,10,10"
                                        Cursor="Hand">
                                    <Border.InputBindings>
                                        <MouseBinding Gesture="LeftClick"
                                                      Command="{Binding DataContext.SelectActiveVehicleCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                      CommandParameter="{Binding}"/>
                                    </Border.InputBindings>
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Setter Property="Background" Value="#F0F0F0"/>
                                            <Style.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter Property="Background" Value="#E4E4E4"/>
                                                    <Setter Property="BorderBrush" Value="{DynamicResource BrushPrimary}"/>
                                                </Trigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                        </Grid.RowDefinitions>

                                        <!-- Fila 1: Icono + Placa (Izquierda) y Categoría (Derecha) -->
                                        <Grid Grid.Row="0" Margin="0,0,0,8">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>

                                            <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                                                <Border Width="38"
                                                        Height="38"
                                                        CornerRadius="8"
                                                        Background="{DynamicResource BrushPrimary}"
                                                        Margin="0,0,10,0"
                                                        VerticalAlignment="Center">
                                                    <Path Data="{Binding VehicleType, Converter={StaticResource VehicleIconConv}}"
                                                          Fill="{DynamicResource BrushTextWhite}"
                                                          Width="18" Height="18"
                                                          Stretch="Uniform"
                                                          HorizontalAlignment="Center"
                                                          VerticalAlignment="Center"/>
                                                </Border>
                                                <TextBlock Text="{Binding PlateNumber}"
                                                           FontFamily="{StaticResource FontFamilyMonospace}"
                                                           FontWeight="Black"
                                                           FontSize="20"
                                                           Foreground="{DynamicResource BrushTextPrimary}"
                                                           VerticalAlignment="Center"/>
                                            </StackPanel>

                                            <!-- Badge de Categoría -->
                                            <Border Grid.Column="1" Background="#E0F2FE" BorderBrush="#BAE6FD" BorderThickness="1" CornerRadius="6" Padding="8,3" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding VehicleType, Converter={StaticResource VehicleTypeStrConv}}"
                                                           FontWeight="Bold"
                                                           FontSize="11"
                                                           Foreground="{DynamicResource BrushPrimary}"/>
                                            </Border>
                                        </Grid>

                                        <!-- Fila 2: Tiempos de permanencia (Izquierda) y Botón Liquidar (Derecha) -->
                                        <Grid Grid.Row="1">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>

                                            <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding EntryTime, StringFormat='{}Entrada: {0:HH:mm}'}"
                                                               FontSize="12"
                                                               FontWeight="SemiBold"
                                                               Foreground="{DynamicResource BrushTextMuted}"
                                                               VerticalAlignment="Center"/>
                                                    <Border Background="#F1F5F9" CornerRadius="6" Padding="6,2" Margin="8,0,0,0" VerticalAlignment="Center">
                                                        <TextBlock Text="{Binding FormattedDuration}"
                                                                   FontSize="11"
                                                                   FontWeight="Bold"
                                                                   Foreground="{DynamicResource BrushPrimary}"/>
                                                    </Border>
                                                </StackPanel>
                                            </StackPanel>

                                            <!-- Botón Liquidar -->
                                            <Button Grid.Column="1"
                                                    Content="Liquidar"
                                                    Command="{Binding DataContext.SelectActiveVehicleCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                    CommandParameter="{Binding}"
                                                    Style="{StaticResource SuccessButton}"
                                                    Padding="14,4"
                                                    FontSize="12"
                                                    FontWeight="Bold"
                                                    Height="32"
                                                    VerticalAlignment="Center"/>
                                        </Grid>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </Grid>
        </Border>
    </Grid>
</UserControl>