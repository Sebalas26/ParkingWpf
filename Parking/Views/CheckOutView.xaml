<UserControl x:Class="Parking.Views.CheckOutView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:conv="clr-namespace:Parking.Core.Converters"
             xmlns:enums="clr-namespace:Parking.Core.Enums"
             mc:Ignorable="d"
             d:DesignHeight="850" d:DesignWidth="1180">

    <UserControl.Resources>
        <conv:CurrencyConverter x:Key="CurrencyConv"/>
        <conv:VehicleTypeToStringConverter x:Key="VehicleTypeStrConv"/>
        <conv:VehicleTypeToIconConverter x:Key="VehicleIconConv"/>
        <conv:BooleanToVisibilityConverter x:Key="BoolToVis"/>
        <conv:NullToVisibilityConverter x:Key="NullToVis"/>
    </UserControl.Resources>

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <!-- Fila Superior: Captura de Placa / Búsqueda de Tiquete (Zona Verde) -->
            <RowDefinition Height="Auto"/>
            <!-- Fila Inferior: Listado / Historial de Vehículos Activos en Patio (Zona Roja) -->
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- ========================================================================= -->
        <!-- ZONA SUPERIOR: Formulario Panorámico de Ingreso y Búsqueda de Placa -->
        <!-- ========================================================================= -->
        <Border Grid.Row="0"
                Style="{StaticResource ModernCard}"
                Margin="0,0,0,16"
                Padding="22">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- 1. Título y Descripción -->
                <Grid Grid.Row="0" Margin="0,0,0,14">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0">
                        <TextBlock Text="Liquidación y Salida" FontSize="20" FontWeight="Bold" Foreground="{DynamicResource BrushTextPrimary}"/>
                        <TextBlock Text="Escanee el código de barras del tiquete o digite la placa para procesar el cobro" FontSize="13" Foreground="{DynamicResource BrushTextMuted}" Margin="0,3,0,0"/>
                    </StackPanel>

                    <Border Grid.Column="1"
                            Background="#F0FDF4"
                            BorderBrush="#86EFAC"
                            BorderThickness="1"
                            CornerRadius="10"
                            Padding="12,6"
                            VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal">
                            <Path Data="{StaticResource IconCheck}" Fill="{DynamicResource BrushSuccess}" Width="14" Height="14" Stretch="Uniform" Margin="0,0,6,0" VerticalAlignment="Center"/>
                            <TextBlock Text="Terminal Lista para Cobro" FontSize="12" FontWeight="Bold" Foreground="{DynamicResource BrushSuccess}" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Border>
                </Grid>

                <!-- 2. Alerta de Feedback -->
                <Border Grid.Row="1"
                        Visibility="{Binding HasFeedback, Converter={StaticResource BoolToVis}}"
                        CornerRadius="10"
                        Padding="14,10"
                        Margin="0,0,0,14">
                    <Border.Style>
                        <Style TargetType="Border">
                            <Setter Property="Background" Value="{DynamicResource BrushSuccessBg}"/>
                            <Setter Property="BorderBrush" Value="{DynamicResource BrushSuccess}"/>
                            <Setter Property="BorderThickness" Value="1"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsSuccessFeedback}" Value="False">
                                    <Setter Property="Background" Value="{DynamicResource BrushWarningBg}"/>
                                    <Setter Property="BorderBrush" Value="{DynamicResource BrushWarning}"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <TextBlock Text="{Binding FeedbackMessage}" FontSize="14" FontWeight="Bold" TextWrapping="Wrap">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Foreground" Value="{DynamicResource BrushSuccessText}"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsSuccessFeedback}" Value="False">
                                        <Setter Property="Foreground" Value="{DynamicResource BrushWarningText}"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </Border>

                <!-- 3. Caja de Búsqueda de Placa / Escaneo -->
                <Grid Grid.Row="2">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBox x:Name="SearchTextBox"
                             Grid.Column="0"
                             Text="{Binding SearchQuery, UpdateSourceTrigger=PropertyChanged}"
                             Style="{StaticResource CheckoutSearchTextBox}"
                             Margin="0,0,16,0"/>
                    <Button Grid.Column="1"
                            Command="{Binding SearchTicketCommand}"
                            Style="{StaticResource ModernButton}"
                            MinWidth="210"
                            Height="100"
                            Padding="24,0"
                            ToolTip="Buscar tiquete o placa (Enter)">
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                            <Path Data="{StaticResource IconSearch}" Fill="{DynamicResource BrushTextWhite}" Width="22" Height="22" Stretch="Uniform" Margin="0,0,10,0" VerticalAlignment="Center"/>
                            <TextBlock Text="Buscar" FontSize="16" FontWeight="Bold" Foreground="{DynamicResource BrushTextWhite}" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                </Grid>
            </Grid>
        </Border>

        <!-- ========================================================================= -->
        <!-- ZONA INFERIOR: Historial y Listado de Vehículos Activos en Patio -->
        <!-- ========================================================================= -->
        <Border Grid.Row="1"
                Style="{StaticResource ModernCard}"
                Padding="22">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- Encabezado de la Sección de Activos -->
                <Grid Grid.Row="0" Margin="0,0,0,16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <!-- Izquierda: Título de Sección -->
                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                        <Path Data="{StaticResource IconCar}" Fill="{DynamicResource BrushPrimary}" Width="18" Height="18" Stretch="Uniform" Margin="0,0,8,0" VerticalAlignment="Center"/>
                        <TextBlock Text="VEHÍCULOS ACTIVOS ADENTRO"
                                   FontSize="15"
                                   FontWeight="Black"
                                   Foreground="{DynamicResource BrushTextPrimary}"
                                   VerticalAlignment="Center"/>
                    </StackPanel>

                    <!-- Centro-Izquierda: Selector/Indicador de Resolución DIAN de la Sede -->
                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="24,0,16,0">
                        <Border Background="#F8FAFC"
                                BorderBrush="{DynamicResource BrushBorderMedium}"
                                BorderThickness="1"
                                CornerRadius="10"
                                Padding="10,4"
                                VerticalAlignment="Center"
                                Visibility="{Binding HasResolutions, Converter={StaticResource BoolToVis}}">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Path Data="{StaticResource IconDocument}" Fill="{DynamicResource BrushPrimary}" Width="14" Height="14" Stretch="Uniform" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                <TextBlock Text="Resolución:" FontSize="12" FontWeight="Bold" Foreground="{DynamicResource BrushTextSecondary}" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                <ComboBox ItemsSource="{Binding AvailableResolutions}"
                                          SelectedItem="{Binding SelectedResolution}"
                                          BorderThickness="0"
                                          Background="Transparent"
                                          FontSize="12"
                                          FontWeight="Bold"
                                          Foreground="{DynamicResource BrushPrimary}"
                                          VerticalAlignment="Center"
                                          MinWidth="220">
                                    <ComboBox.ItemTemplate>
                                        <DataTemplate>
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="{Binding DocumentType}" FontWeight="Bold"/>
                                                <TextBlock Text="{Binding Prefix, StringFormat='{} - Pref. {0}'}" Foreground="{DynamicResource BrushTextMuted}" Margin="4,0,0,0"/>
                                                <TextBlock Text="{Binding CurrentNumber, StringFormat='{} (#{0})'}" Foreground="{DynamicResource BrushTextSecondary}" Margin="4,0,0,0"/>
                                            </StackPanel>
                                        </DataTemplate>
                                    </ComboBox.ItemTemplate>
                                </ComboBox>
                            </StackPanel>
                        </Border>

                        <!-- Mensaje si no hay resoluciones configuradas -->
                        <Border Background="#FEF3C7"
                                BorderBrush="#FDE68A"
                                BorderThickness="1"
                                CornerRadius="10"
                                Padding="8,4"
                                VerticalAlignment="Center"
                                Visibility="{Binding HasResolutions, Converter={StaticResource BoolToVis}, ConverterParameter=Invert}">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="⚠️ Sin Resolución DIAN Activa" FontSize="11" FontWeight="Bold" Foreground="#B45309" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <!-- Derecha: Badge de Vehículos en Patio -->
                    <Border Grid.Column="2" Background="#ffffffff" BorderBrush="#398d78ff" BorderThickness="1" CornerRadius="12" Padding="12,4" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Ellipse Width="8" Height="8" Fill="{DynamicResource BrushPrimary}" Margin="0,0,6,0" VerticalAlignment="Center"/>
                            <TextBlock Text="{Binding ActiveVehicles.Count, StringFormat='{}{0} en Patio'}"
                                       FontSize="13"
                                       FontWeight="Bold"
                                       Foreground="{DynamicResource BrushPrimary}"
                                       VerticalAlignment="Center"/>
                        </StackPanel>
                    </Border>
                </Grid>

                <!-- Listado Dinámico de Vehículos -->
                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <ItemsControl ItemsSource="{Binding ActiveVehicles}" VerticalAlignment="Top">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <UniformGrid Columns="2" VerticalAlignment="Top"/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border HorizontalAlignment="Stretch"
                                        VerticalAlignment="Top"
                                        Background="{DynamicResource BrushInputBackground}"
                                        BorderBrush="{DynamicResource BrushBorderSubtle}"
                                        BorderThickness="1.5"
                                        CornerRadius="14"
                                        Padding="14,10"
                                        Margin="0,0,10,10"
                                        Cursor="Hand">
                                    <Border.InputBindings>
                                        <MouseBinding Gesture="LeftClick"
                                                      Command="{Binding DataContext.SelectActiveVehicleCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                      CommandParameter="{Binding}"/>
                                    </Border.InputBindings>
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Setter Property="Background" Value="{DynamicResource BrushInputBackground}"/>
                                            <Style.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter Property="Background" Value="#F1F5F9"/>
                                                    <Setter Property="BorderBrush" Value="{DynamicResource BrushPrimary}"/>
                                                </Trigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                        </Grid.RowDefinitions>

                                        <!-- Fila 1: Icono + Placa (Izquierda) y Categoría (Derecha) -->
                                        <Grid Grid.Row="0" Margin="0,0,0,8">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>

                                            <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                                                <Border Width="38"
                                                        Height="38"
                                                        CornerRadius="8"
                                                        Background="{DynamicResource BrushPrimary}"
                                                        Margin="0,0,10,0"
                                                        VerticalAlignment="Center">
                                                    <Path Data="{Binding VehicleType, Converter={StaticResource VehicleIconConv}}"
                                                          Fill="{DynamicResource BrushTextWhite}"
                                                          Width="18" Height="18"
                                                          Stretch="Uniform"
                                                          HorizontalAlignment="Center"
                                                          VerticalAlignment="Center"/>
                                                </Border>
                                                <TextBlock Text="{Binding PlateNumber}"
                                                           FontFamily="{StaticResource FontFamilyMonospace}"
                                                           FontWeight="Black"
                                                           FontSize="20"
                                                           Foreground="{DynamicResource BrushTextPrimary}"
                                                           VerticalAlignment="Center"/>
                                            </StackPanel>

                                            <!-- Badge de Categoría -->
                                            <Border Grid.Column="1" Background="#E0F2FE" BorderBrush="#BAE6FD" BorderThickness="1" CornerRadius="6" Padding="8,3" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding VehicleType, Converter={StaticResource VehicleTypeStrConv}}"
                                                           FontWeight="Bold"
                                                           FontSize="11"
                                                           Foreground="{DynamicResource BrushPrimary}"/>
                                            </Border>
                                        </Grid>

                                        <!-- Fila 2: Tiempos de permanencia (Izquierda) y Botón Liquidar (Derecha) -->
                                        <Grid Grid.Row="1">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>

                                            <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding EntryTime, StringFormat='{}Entrada: {0:HH:mm}'}"
                                                               FontSize="12"
                                                               FontWeight="SemiBold"
                                                               Foreground="{DynamicResource BrushTextMuted}"
                                                               VerticalAlignment="Center"/>
                                                    <Border Background="#F1F5F9" CornerRadius="6" Padding="6,2" Margin="8,0,0,0" VerticalAlignment="Center">
                                                        <TextBlock Text="{Binding FormattedDuration}"
                                                                   FontSize="11"
                                                                   FontWeight="Bold"
                                                                   Foreground="{DynamicResource BrushPrimary}"/>
                                                    </Border>
                                                </StackPanel>
                                            </StackPanel>

                                            <!-- Botón Liquidar -->
                                            <Button Grid.Column="1"
                                                    Content="Liquidar"
                                                    Command="{Binding DataContext.SelectActiveVehicleCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                    CommandParameter="{Binding}"
                                                    Style="{StaticResource SuccessButton}"
                                                    Padding="14,4"
                                                    FontSize="12"
                                                    FontWeight="Bold"
                                                    Height="32"
                                                    VerticalAlignment="Center"/>
                                        </Grid>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </Grid>
        </Border>
    </Grid>
</UserControl>