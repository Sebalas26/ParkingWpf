                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="Vehículos en Patio:" FontSize="10" FontFamily="{StaticResource FontFamilyMonospace}" Foreground="#000000"/>
                                    <TextBlock Grid.Column="1" Text="{Binding ShiftVehiclesInYardCount}" FontSize="10" FontWeight="Bold" FontFamily="{StaticResource FontFamilyMonospace}" Foreground="#000000"/>
                                </Grid>

                                <Rectangle Height="1" Fill="#000000" HorizontalAlignment="Stretch" Margin="0,0,0,6"/>

                                <!-- 9. Arqueo y Cuadre de Caja -->
                                <TextBlock Text="ARQUEO Y CUADRE DE CAJA" FontSize="10.5" FontWeight="Bold" FontFamily="{StaticResource FontFamilyMonospace}" Foreground="#000000" Margin="0,0,0,4"/>
                                <Grid Margin="0,1">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="Base Inicial:" FontSize="10" FontFamily="{StaticResource FontFamilyMonospace}" Foreground="#000000"/>
                                    <TextBlock Grid.Column="1" Text="{Binding ShiftBaseAmountStr}" FontSize="10" FontFamily="{StaticResource FontFamilyMonospace}" Foreground="#000000"/>
                                </Grid>
                                <Grid Margin="0,1">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="Total Esperado:" FontSize="10" FontFamily="{StaticResource FontFamilyMonospace}" Foreground="#000000"/>
                                    <TextBlock Grid.Column="1" Text="{Binding ShiftExpectedCashStr}" FontSize="10" FontWeight="Bold" FontFamily="{StaticResource FontFamilyMonospace}" Foreground="#000000"/>
                                </Grid>
                                <Grid Margin="0,1">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="Total Contado:" FontSize="10" FontFamily="{StaticResource FontFamilyMonospace}" Foreground="#000000"/>
                                    <TextBlock Grid.Column="1" Text="{Binding ShiftActualCashStr}" FontSize="10" FontWeight="Bold" FontFamily="{StaticResource FontFamilyMonospace}" Foreground="#000000"/>
                                </Grid>
                                <Grid Margin="0,1">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="Diferencia:" FontSize="10" FontWeight="Bold" FontFamily="{StaticResource FontFamilyMonospace}" Foreground="#000000"/>
                                    <TextBlock Grid.Column="1" Text="{Binding ShiftDifferenceStr}" FontSize="10" FontWeight="Bold" FontFamily="{StaticResource FontFamilyMonospace}" Foreground="#000000"/>
                                </Grid>
                                <Grid Margin="0,1,0,6">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="Estado Arqueo:" FontSize="10" FontWeight="Bold" FontFamily="{StaticResource FontFamilyMonospace}" Foreground="#000000"/>
                                    <TextBlock Grid.Column="1" Text="{Binding ShiftArqueoStatusText}" FontSize="10.5" FontWeight="Black" FontFamily="{StaticResource FontFamilyMonospace}" Foreground="#000000"/>
                                </Grid>

                                <Rectangle Height="1" Fill="#000000" HorizontalAlignment="Stretch" Margin="0,0,0,6"/>

                                <!-- 10. Observaciones -->
                                <StackPanel Visibility="{Binding HasShiftNotes, Converter={StaticResource BoolToVis}}" Margin="0,0,0,6">
                                    <TextBlock Text="OBSERVACIONES:" FontSize="10" FontWeight="Bold" FontFamily="{StaticResource FontFamilyMonospace}" Foreground="#000000"/>
                                    <TextBlock Text="{Binding ShiftNotes}" FontSize="9.5" FontFamily="{StaticResource FontFamilyMonospace}" Foreground="#000000" TextWrapping="Wrap" Margin="0,2,0,6"/>
                                    <Rectangle Height="1" Fill="#000000" HorizontalAlignment="Stretch" Margin="0,0,0,6"/>
                                </StackPanel>

                                <!-- 11. Firmas y Pie -->
                                <StackPanel HorizontalAlignment="Center" Margin="0,14,0,8">
                                    <TextBlock Text="___________________________" FontSize="10" FontFamily="{StaticResource FontFamilyMonospace}" Foreground="#000000" HorizontalAlignment="Center"/>
                                    <TextBlock Text="Firma Responsable de Caja" FontSize="9.5" FontWeight="Bold" FontFamily="{StaticResource FontFamilyMonospace}" Foreground="#000000" HorizontalAlignment="Center" Margin="0,2,0,1"/>
                                    <TextBlock Text="C.C. _____________________" FontSize="9" FontFamily="{StaticResource FontFamilyMonospace}" Foreground="#000000" HorizontalAlignment="Center"/>
                                </StackPanel>

                                <TextBlock Text="ParkingFlow POS" FontSize="9.5" FontWeight="Bold" FontFamily="{StaticResource FontFamilyMonospace}" Foreground="#000000" HorizontalAlignment="Center" Margin="0,4,0,1"/>
                                <TextBlock Text="Software de Gestión y Control" FontSize="8.5" FontFamily="{StaticResource FontFamilyMonospace}" Foreground="#000000" HorizontalAlignment="Center" Margin="0,0,0,8"/>

                            </StackPanel>

                        </Grid>
                    </ScrollViewer>
                </Border>

                <!-- 3. Bottom Action Buttons -->
                <Grid Grid.Row="2">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" Visibility="{Binding PrintSuccess, Converter={StaticResource BoolToVis}}">
                        <Path Data="{StaticResource IconCheck}" Fill="{DynamicResource BrushSuccess}" Width="14" Height="14" Stretch="Uniform" Margin="0,0,6,0"/>
                        <TextBlock Text="Tiquete enviado a impresión" Foreground="{DynamicResource BrushSuccess}" FontSize="11" VerticalAlignment="Center"/>
                    </StackPanel>

                    <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Command="{Binding PrintTicketCommand}"
                                Click="PrintButton_Click"
                                Style="{StaticResource ModernButton}"
                                Margin="0,0,8,0"
                                Padding="16,6">
                            <Button.ContentTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal">
                                        <Path Data="{StaticResource IconPrint}" Fill="{DynamicResource BrushTextWhite}" Width="13" Height="13" Stretch="Uniform" Margin="0,0,6,0"/>
                                        <TextBlock Text="Imprimir Tiquete" Foreground="{DynamicResource BrushTextWhite}" FontWeight="Bold" FontSize="12" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </DataTemplate>
                            </Button.ContentTemplate>
                        </Button>
                        <Button Content="Cerrar"
                                Command="{Binding CloseCommand}"
                                Style="{StaticResource SecondaryButton}"
                                Padding="16,6"
                                FontSize="12"/>
                    </StackPanel>
                </Grid>
            </Grid>
        </Border>
    </Grid>
</Window>
