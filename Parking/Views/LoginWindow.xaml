<Window x:Class="Parking.Views.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:Parking.ViewModels"
        xmlns:conv="clr-namespace:Parking.Core.Converters"
        mc:Ignorable="d"
        Title="Parking Flow - Control de Acceso y Caja"
        Icon="/Resources/parkpoint.ico"
        Height="620"
        Width="960"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent">

    <Window.Resources>
        <conv:BooleanToVisibilityConverter x:Key="BoolToVis"/>
        <conv:InverseBooleanConverter x:Key="InverseBoolConv"/>
    </Window.Resources>

    <Window.InputBindings>
        <KeyBinding Key="Enter" Command="{Binding LoginCommand}"/>
    </Window.InputBindings>

    <Border Background="{DynamicResource BrushAppBackground}"
            BorderBrush="{DynamicResource BrushBorderMedium}"
            BorderThickness="1"
            CornerRadius="16">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1.1*"/>
                <ColumnDefinition Width="1.2*"/>
            </Grid.ColumnDefinitions>

            <!-- Banner Izquierdo PARKING FLOW (Hero Inmersivo en Alta Resolución) -->
            <Border Grid.Column="0"
                    Background="#111822"
                    CornerRadius="16,0,0,16"
                    ClipToBounds="True"
                    Padding="32,40">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- Centro Visual: Logotipo Completo en Gran Formato -->
                    <StackPanel Grid.Row="0" VerticalAlignment="Center" HorizontalAlignment="Center">
                        <Border MaxWidth="380"
                                HorizontalAlignment="Center"
                                CornerRadius="12"
                                ClipToBounds="True">
                            <Image Source="/Resources/logo.jpeg"
                                   Stretch="Uniform"
                                   RenderOptions.BitmapScalingMode="HighQuality"/>
                        </Border>

                        <!-- Píldora Elegante de Terminal POS -->
                        <Border Background="#1A2332"
                                BorderBrush="#2A384C"
                                BorderThickness="1"
                                CornerRadius="20"
                                Padding="16,7"
                                HorizontalAlignment="Center"
                                Margin="0,24,0,0">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Ellipse Width="7" Height="7" Fill="{DynamicResource BrushPrimary}" Margin="0,0,8,0"/>
                                <TextBlock Text="Terminal POS • Control de Acceso y Recaudación"
                                           Foreground="#94A3B8"
                                           FontSize="11"
                                           FontWeight="SemiBold"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <!-- Pie de Marca Minimalista -->
                    <TextBlock Grid.Row="1"
                               Text="© Parking Flow • Tu punto de llegada"
                               FontSize="11"
                               FontWeight="Medium"
                               Foreground="#64748B"
                               HorizontalAlignment="Center"/>
                </Grid>
            </Border>

            <!-- Lado Derecho: Formulario de Autenticación con Loader -->
            <Grid Grid.Column="1" Margin="40,30,40,30">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Barra Superior con Indicador de Estado de Conexión + Controles de Ventana -->
                <Grid Grid.Row="0">
                    <!-- Píldora de Estado de Red / Modo Offline -->
                    <Border HorizontalAlignment="Left"
                            VerticalAlignment="Center"
                            Background="{DynamicResource BrushSurfaceLight}"
                            BorderBrush="{DynamicResource BrushBorderSubtle}"
                            BorderThickness="1"
                            CornerRadius="14"
                            Padding="12,5">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Ellipse Width="8" Height="8" Margin="0,0,8,0">
                                <Ellipse.Style>
                                    <Style TargetType="Ellipse">
                                        <Setter Property="Fill" Value="#10B981"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsOnline}" Value="False">
                                                <Setter Property="Fill" Value="#06B6D4"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Ellipse.Style>
                            </Ellipse>
                            <TextBlock Text="{Binding NetworkStatusText, FallbackValue='Comprobando servidor...'}"
                                       FontSize="11"
                                       FontWeight="SemiBold"
                                       Foreground="{DynamicResource BrushTextSecondary}"
                                       VerticalAlignment="Center"/>
                        </StackPanel>
                    </Border>

                    <!-- Botones de Control de Ventana (Minimizar y Cerrar) -->
                    <StackPanel HorizontalAlignment="Right" Orientation="Horizontal">
                        <Button Width="32" Height="32" Click="MinimizeButton_Click" Style="{StaticResource SecondaryButton}" Padding="0" Margin="0,0,8,0">
                            <Rectangle Width="10" Height="2" Fill="{DynamicResource BrushTextSecondary}"/>
                        </Button>
                        <Button Width="32" Height="32" Click="CloseButton_Click" Style="{StaticResource SecondaryButton}" Padding="0">
                            <Path Data="{StaticResource IconClose}" Fill="{DynamicResource BrushTextSecondary}" Width="10" Height="10" Stretch="Uniform"/>
                        </Button>
                    </StackPanel>
                </Grid>

                <StackPanel Grid.Row="1" VerticalAlignment="Center" MaxWidth="380" HorizontalAlignment="Stretch">
                    <TextBlock Text="Iniciar Sesión" Style="{StaticResource TextHeaderLarge}" Margin="0,0,0,6"/>
                    <TextBlock Text="Ingrese sus credenciales de operador para iniciar estación" Style="{StaticResource TextBodySecondary}" Margin="0,0,0,24"/>

                    <Border Background="{DynamicResource BrushDangerBg}"
                            BorderBrush="{DynamicResource BrushDanger}"
                            BorderThickness="1"
                            CornerRadius="8"
                            Padding="12,10"
                            Margin="0,0,0,16"
                            Visibility="{Binding HasError, Converter={StaticResource BoolToVis}}">
                        <TextBlock Text="{Binding ErrorMessage}" Foreground="{DynamicResource BrushDanger}" FontSize="12" TextWrapping="Wrap"/>
                    </Border>

                    <TextBlock Text="Usuario / ID de Operador" Style="{StaticResource TextHeaderSmall}" Margin="0,0,0,8"/>
                    <TextBox Text="{Binding Username, UpdateSourceTrigger=PropertyChanged}"
                             IsEnabled="{Binding IsBusy, Converter={StaticResource InverseBoolConv}}"
                             Style="{StaticResource ModernTextBox}"
                             Margin="0,0,0,18"/>

                    <TextBlock Text="Contraseña" Style="{StaticResource TextHeaderSmall}" Margin="0,0,0,8"/>
                    <PasswordBox x:Name="UserPasswordBox"
                                 IsEnabled="{Binding IsBusy, Converter={StaticResource InverseBoolConv}}"
                                 Style="{StaticResource ModernPasswordBox}"
                                 PasswordChanged="UserPasswordBox_PasswordChanged"
                                 KeyDown="UserPasswordBox_KeyDown"
                                 Margin="0,0,0,24"/>

                    <!-- Botón de Acceso -->
                    <Button Command="{Binding LoginCommand}"
                            IsDefault="True"
                            IsEnabled="{Binding IsBusy, Converter={StaticResource InverseBoolConv}}"
                            Style="{StaticResource ModernButton}"
                            Height="46"
                            Margin="0,0,0,16">
                        <Button.ContentTemplate>
                            <DataTemplate>
                                <TextBlock Text="Acceder a Estación de Trabajo" Foreground="{DynamicResource BrushTextWhite}" FontSize="14" FontWeight="Bold"/>
                            </DataTemplate>
                        </Button.ContentTemplate>
                    </Button>

                    <!-- Loader Visual y Barra de Progreso de Sincronización en Vivo -->
                    <Border Visibility="{Binding IsBusy, Converter={StaticResource BoolToVis}}"
                            Background="{DynamicResource BrushSurfaceLight}"
                            BorderBrush="{DynamicResource BrushBorderSubtle}"
                            BorderThickness="1"
                            CornerRadius="10"
                            Padding="16,14"
                            Margin="0,6,0,0">
                        <StackPanel HorizontalAlignment="Stretch" VerticalAlignment="Center">
                            <Grid Margin="0,0,0,8">
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" VerticalAlignment="Center">
                                    <Path Data="{StaticResource IconRefresh}" Fill="{DynamicResource BrushPrimary}" Width="14" Height="14" Stretch="Uniform" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                    <TextBlock Text="{Binding BusyMessage, FallbackValue='Validando y sincronizando estación...'}"
                                               Foreground="{DynamicResource BrushTextPrimary}"
                                               FontSize="12"
                                               FontWeight="Bold"
                                               VerticalAlignment="Center"/>
                                </StackPanel>
                                <TextBlock Text="{Binding SyncProgressPercentage, StringFormat='{}{0}%'}"
                                           Visibility="{Binding IsSyncing, Converter={StaticResource BoolToVis}}"
                                           HorizontalAlignment="Right"
                                           FontSize="12"
                                           FontWeight="Black"
                                           Foreground="{DynamicResource BrushPrimary}"/>
                            </Grid>

                            <!-- Barra de progreso indeterminada durante validación y determinada durante sincronización -->
                            <ProgressBar Value="{Binding SyncProgressPercentage}"
                                         Minimum="0"
                                         Maximum="100"
                                         IsIndeterminate="{Binding IsSyncing, Converter={StaticResource InverseBoolConv}}"
                                         Height="6"
                                         Foreground="{DynamicResource BrushPrimary}"
                                         Background="{DynamicResource BrushInputBackground}"
                                         BorderThickness="0"
                                         Margin="0,0,0,8"/>

                            <TextBlock Text="{Binding SyncStepDescription, FallbackValue='Conectando estación...'}"
                                       Visibility="{Binding IsSyncing, Converter={StaticResource BoolToVis}}"
                                       Foreground="{DynamicResource BrushTextSecondary}"
                                       FontSize="11"
                                       TextTrimming="CharacterEllipsis"
                                       HorizontalAlignment="Center"/>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <TextBlock Grid.Row="2"
                           Text="Protegido por Control de Acceso • PARKING FLOW"
                           HorizontalAlignment="Center"
                           Style="{StaticResource TextCaption}"/>
            </Grid>
        </Grid>
    </Border>
</Window>
