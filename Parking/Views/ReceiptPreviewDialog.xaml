<Window x:Class="Parking.Views.ReceiptPreviewDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:conv="clr-namespace:Parking.Core.Converters"
        mc:Ignorable="d"
        Title="Vista Previa del Tiquete"
        WindowStartupLocation="CenterOwner"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="#B3000000"
        ShowInTaskbar="False"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Display"
        TextOptions.TextRenderingMode="ClearType">

    <Window.Resources>
        <conv:CurrencyConverter x:Key="CurrencyConv"/>
        <conv:VehicleTypeToStringConverter x:Key="VehicleTypeStrConv"/>
        <conv:BooleanToVisibilityConverter x:Key="BoolToVis"/>
        <conv:NullToVisibilityConverter x:Key="NullToVis"/>
    </Window.Resources>

    <Grid Background="Transparent">
        <Border Width="{Binding DialogWindowWidth}"
                MaxHeight="680"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Margin="24"
                Background="{DynamicResource BrushAppBackground}"
                BorderBrush="{DynamicResource BrushBorderMedium}"
                BorderThickness="1"
                CornerRadius="16"
                Padding="20">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- 1. Header Area -->
                <Grid Grid.Row="0" Margin="0,0,0,12">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Path Data="{StaticResource IconReceipt}" Fill="{DynamicResource BrushPrimary}" Width="16" Height="16" Stretch="Uniform" Margin="0,0,8,0"/>
                        <TextBlock Text="Vista Previa de Tiquete Térmico" FontSize="14" FontWeight="Bold" Foreground="{DynamicResource BrushTextPrimary}" Margin="0,0,8,0"/>
                        <Border Background="#DCFCE7" CornerRadius="4" Padding="6,2" VerticalAlignment="Center">
                            <TextBlock Text="{Binding PaperWidthBadgeText}" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource BrushPrimary}"/>
                        </Border>
                    </StackPanel>
                    <Button HorizontalAlignment="Right"
                            Command="{Binding CloseCommand}"
                            Style="{StaticResource SecondaryButton}"
                            Padding="4"
                            Width="26"
                            Height="26">
                        <Path Data="{StaticResource IconClose}" Fill="{DynamicResource BrushTextSecondary}" Width="10" Height="10" Stretch="Uniform"/>
                    </Button>
                </Grid>

                <!-- 2. Thermal Ticket Paper Container (Estilo POS Blanco y Negro) -->
                <Border Grid.Row="1"
                        Width="{Binding PaperContainerWidth}"
                        HorizontalAlignment="Center"
                        Background="#FFFFFF"
                        BorderBrush="{DynamicResource BrushBorderMedium}"
                        BorderThickness="1"
                        CornerRadius="0"
                        Padding="14,18"
                        Margin="0,0,0,12"
                        MaxHeight="480">
                    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                        <Grid HorizontalAlignment="Stretch" Margin="0,0">

                            <!-- ============================================================= -->
                            <!-- A. PLANTILLA RECIBO DE PAGO POS ESTÁNDAR                      -->
                            <!-- ============================================================= -->
                            <StackPanel Visibility="{Binding IsStandardExitReceipt, Converter={StaticResource BoolToVis}}"
                                        HorizontalAlignment="Stretch" Margin="0,0">

                                <!-- 1. Encabezado de Empresa / Sede -->
                                <TextBlock Text="{Binding BranchName}" FontSize="15" FontWeight="Bold" FontFamily="{StaticResource FontFamilyMonospace}" Foreground="#000000" HorizontalAlignment="Center"/>
                                <TextBlock Text="{Binding BranchNit}" FontSize="12" FontFamily="{StaticResource FontFamilyMonospace}" Foreground="#000000" HorizontalAlignment="Center" Margin="0,1"/>
                                <TextBlock Text="{Binding BranchAddress}" FontSize="11" FontFamily="{StaticResource FontFamilyMonospace}" Foreground="#000000" HorizontalAlignment="Center" Margin="0,1"/>
                                <TextBlock Text="{Binding BranchPhone}" FontSize="11" FontFamily="{StaticResource FontFamilyMonospace}" Foreground="#000000" HorizontalAlignment="Center" Margin="0,1,0,6"/>

                                <!-- Línea divisoria continua -->
                                <Rectangle Height="1" Fill="#000000" HorizontalAlignment="Stretch" Margin="6,0,6,8"/>

                                <!-- 2. Recibo POS y Consecutivo -->
                                <Grid Margin="0,0,0,4">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="RECIBO DE CAJA / POS:" FontSize="11" FontWeight="Bold" FontFamily="{StaticResource FontFamilyMonospace}" Foreground="#000000"/>
                                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding InvoiceNumberText}" FontSize="13" FontWeight="Bold" FontFamily="{StaticResource FontFamilyMonospace}" Foreground="#000000"/>
                                    </StackPanel>
                                </Grid>

                                <!-- Fecha y Hora -->
                                <Grid Margin="0,2,0,4">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="FECHA:   " FontSize="11" FontWeight="Bold" FontFamily="{StaticResource FontFamilyMonospace}" Foreground="#000000"/>
                                    <TextBlock Grid.Column="1" Text="{Binding InvoiceDateStr}" FontSize="11" FontWeight="Bold" FontFamily="{StaticResource FontFamilyMonospace}" Foreground="#000000"/>
                                    <TextBlock Grid.Column="2" Text="{Binding InvoiceTimeStr}" FontSize="11" FontWeight="Bold" FontFamily="{StaticResource FontFamilyMonospace}" Foreground="#000000"/>
                                </Grid>

                                <!-- Cliente, NIT, Dir -->
                                <Grid Margin="0,1">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="65"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="CLIENTE:" FontSize="11" FontWeight="Bold" FontFamily="{StaticResource FontFamilyMonospace}" Foreground="#000000"/>
                                    <TextBlock Grid.Column="1" Text="{Binding CustomerName}" FontSize="11" FontWeight="Bold" FontFamily="{StaticResource FontFamilyMonospace}" Foreground="#000000"/>
                                </Grid>

                                <Grid Margin="0,1">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="65"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="NIT:" FontSize="11" FontWeight="Bold" FontFamily="{StaticResource FontFamilyMonospace}" Foreground="#000000"/>
                                    <TextBlock Grid.Column="1" Text="{Binding CustomerNit}" FontSize="11" FontWeight="Bold" FontFamily="{StaticResource FontFamilyMonospace}" Foreground="#000000"/>
                                </Grid>

                                <Grid Margin="0,1,0,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="65"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="DIR:" FontSize="11" FontWeight="Bold" FontFamily="{StaticResource FontFamilyMonospace}" Foreground="#000000"/>
                                    <TextBlock Grid.Column="1" Text="{Binding CustomerAddress}" FontSize="11" FontWeight="Bold" FontFamily="{StaticResource FontFamilyMonospace}" Foreground="#000000"/>
                                </Grid>

                                <!-- 3. Bloque Central de la Placa -->
                                <TextBlock Text="{Binding Ticket.PlateNumber, StringFormat='{}PLACA:  {0}'}"
                                           FontSize="16"
                                           FontWeight="Black"
                                           FontFamily="{StaticResource FontFamilyMonospace}"
                                           Foreground="#000000"
                                           HorizontalAlignment="Center"
                                           Margin="0,4,0,8"/>

                                <!-- Entrada, Salida, Tiempo -->
                                <Grid Margin="0,1">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="ENTRADA:" FontSize="11" FontFamily="{StaticResource FontFamilyMonospace}" Foreground="#000000"/>
                                    <TextBlock Grid.Column="1" Text="{Binding EntryTimeStr}" FontSize="11" FontFamily="{StaticResource FontFamilyMonospace}" Foreground="#000000" Margin="10,0,0,0"/>
                                    <TextBlock Grid.Column="2" Text="{Binding EntryDateStr}" FontSize="11" FontFamily="{StaticResource FontFamilyMonospace}" Foreground="#000000"/>
                                </Grid>

                                <Grid Margin="0,1">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="SALIDA: " FontSize="11" FontFamily="{StaticResource FontFamilyMonospace}" Foreground="#000000"/>
                                    <TextBlock Grid.Column="1" Text="{Binding ExitTimeStr}" FontSize="11" FontFamily="{StaticResource FontFamilyMonospace}" Foreground="#000000" Margin="10,0,0,0"/>
                                    <TextBlock Grid.Column="2" Text="{Binding ExitDateStr}" FontSize="11" FontFamily="{StaticResource FontFamilyMonospace}" Foreground="#000000"/>
                                </Grid>

                                <Grid Margin="0,1,0,6">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="TIEMPO: " FontSize="11" FontFamily="{StaticResource FontFamilyMonospace}" Foreground="#000000"/>
                                    <TextBlock Grid.Column="1" Text="{Binding DurationMinutesStr}" FontSize="11" FontFamily="{StaticResource FontFamilyMonospace}" Foreground="#000000" HorizontalAlignment="Right" Margin="0,0,10,0"/>
                                </Grid>

                                <Rectangle Height="1" Fill="#000000" HorizontalAlignment="Stretch" Margin="0,0,0,6"/>

                                <!-- 4. Liquidación Económica (Base Gravable, IVA 19%, TOTAL) -->
                                <Grid Margin="0,2">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="BASE GRAVABLE:" FontSize="12" FontWeight="Bold" FontFamily="{StaticResource FontFamilyMonospace}" Foreground="#000000"/>
                                    <TextBlock Grid.Column="1" Text="{Binding BaseGravableStr}" FontSize="12" FontWeight="Bold" FontFamily="{StaticResource FontFamilyMonospace}" Foreground="#000000"/>
                                </Grid>

                                <Grid Margin="0,2">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="  IVA 19%" FontSize="12" FontFamily="{StaticResource FontFamilyMonospace}" Foreground="#000000"/>
                                    <TextBlock Grid.Column="1" Text="{Binding Iva19Str}" FontSize="12" FontFamily="{StaticResource FontFamilyMonospace}" Foreground="#000000"/>
                                </Grid>

                                <!-- Línea discontinua a la derecha -->
                                <TextBlock Text="-----------------------" FontSize="11" FontFamily="{StaticResource FontFamilyMonospace}" Foreground="#000000" HorizontalAlignment="Right" Margin="0,1"/>

                                <Grid Margin="0,2,0,6">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="TOTAL:" FontSize="14" FontWeight="Black" FontFamily="{StaticResource FontFamilyMonospace}" Foreground="#000000"/>
                                    <TextBlock Grid.Column="1" Text="{Binding TotalStr}" FontSize="14" FontWeight="Black" FontFamily="{StaticResource FontFamilyMonospace}" Foreground="#000000"/>
                                </Grid>

                                <Rectangle Height="1" Fill="#000000" HorizontalAlignment="Stretch" Margin="0,0,0,8"/>

                                <!-- 5. QR Code y Bloque Atendido Por (2 Columnas) -->
                                <Grid Margin="0,0,0,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>

                                    <Image Grid.Column="0"
                                           Source="{Binding ConsultationQrCodeImage}"
                                           Width="{Binding QrCodeWidth}" Height="{Binding QrCodeWidth}"
                                           Stretch="Uniform"
                                           RenderOptions.BitmapScalingMode="NearestNeighbor"
                                           HorizontalAlignment="Left"
                                           VerticalAlignment="Center"/>

                                    <StackPanel Grid.Column="1" Margin="14,0,0,0" VerticalAlignment="Center">
                                        <TextBlock Text="Cant Items: 1" FontSize="11" FontFamily="{StaticResource FontFamilyMonospace}" Foreground="#000000" Margin="0,0,0,10"/>
                                        <TextBlock Text="Atendido por:" FontSize="11" FontFamily="{StaticResource FontFamilyMonospace}" Foreground="#000000"/>
                                        <TextBlock Text="{Binding AttendedBy}" FontSize="11" FontWeight="Bold" FontFamily="{StaticResource FontFamilyMonospace}" Foreground="#000000"/>
                                    </StackPanel>
                                </Grid>

                                <Rectangle Height="1" Fill="#000000" HorizontalAlignment="Stretch" Margin="0,0,0,4"/>

                                <!-- 6. Forma de Pago -->
                                <TextBlock Text="{Binding PaymentMethodName, StringFormat='{}FORMA DE PAGO: {0}'}"
                                           FontSize="11"
                                           FontFamily="{StaticResource FontFamilyMonospace}"
                                           Foreground="#000000"
                                           HorizontalAlignment="Center"
                                           Margin="0,2,0,6"/>

                            </StackPanel>

                            <!-- ============================================================= -->
                            <!-- B. PLANTILLA TIQUETE DE INGRESO (CHECK-IN)                    -->
                            <!-- ============================================================= -->
                            <StackPanel Visibility="{Binding IsEntryTicket, Converter={StaticResource BoolToVis}}"
                                        HorizontalAlignment="Stretch" Margin="0,0">

                                <!-- Encabezado de Empresa / Sede -->
                                <TextBlock Text="{Binding BranchName}" FontSize="15" FontWeight="Bold" FontFamily="{StaticResource FontFamilyMonospace}" Foreground="#000000" HorizontalAlignment="Center"/>
                                <TextBlock Text="{Binding BranchNit}" FontSize="12" FontFamily="{StaticResource FontFamilyMonospace}" Foreground="#000000" HorizontalAlignment="Center" Margin="0,1"/>
                                <TextBlock Text="{Binding BranchAddress}" FontSize="11" FontFamily="{StaticResource FontFamilyMonospace}" Foreground="#000000" HorizontalAlignment="Center" Margin="0,1"/>
                                <TextBlock Text="{Binding BranchPhone}" FontSize="11" FontFamily="{StaticResource FontFamilyMonospace}" Foreground="#000000" HorizontalAlignment="Center" Margin="0,1,0,6"/>

                                <!-- Línea divisoria continua -->
                                <Rectangle Height="1" Fill="#000000" HorizontalAlignment="Stretch" Margin="6,0,6,8"/>

                                <!-- Tiquete de Entrada y Consecutivo -->
                                <Grid Margin="0,0,0,4">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="TIQUETE DE INGRESO:" FontSize="11" FontWeight="Bold" FontFamily="{StaticResource FontFamilyMonospace}" Foreground="#000000"/>
                                    <TextBlock Grid.Column="1" Text="{Binding InvoiceNumberText}" FontSize="13" FontWeight="Bold" FontFamily="{StaticResource FontFamilyMonospace}" Foreground="#000000"/>
                                </Grid>

                                <!-- Fecha y Hora -->
                                <Grid Margin="0,2,0,6">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="FECHA:   " FontSize="11" FontWeight="Bold" FontFamily="{StaticResource FontFamilyMonospace}" Foreground="#000000"/>
                                    <TextBlock Grid.Column="1" Text="{Binding InvoiceDateStr}" FontSize="11" FontWeight="Bold" FontFamily="{StaticResource FontFamilyMonospace}" Foreground="#000000"/>
                                    <TextBlock Grid.Column="2" Text="{Binding InvoiceTimeStr}" FontSize="11" FontWeight="Bold" FontFamily="{StaticResource FontFamilyMonospace}" Foreground="#000000"/>
                                </Grid>

                                <!-- Placa del Vehículo -->
                                <TextBlock Text="{Binding Ticket.PlateNumber, StringFormat='{}PLACA:  {0}'}"
                                           FontSize="16"
                                           FontWeight="Black"
                                           FontFamily="{StaticResource FontFamilyMonospace}"
                                           Foreground="#000000"
                                           HorizontalAlignment="Center"
                                           Margin="0,4,0,6"/>

                                <TextBlock Text="{Binding FormattedRateText}" FontSize="12" FontWeight="Bold" FontFamily="{StaticResource FontFamilyMonospace}" Foreground="#000000" HorizontalAlignment="Center" Margin="0,2,0,8"/>

                                <!-- Código de Barras / QR -->
                                <Image Source="{Binding BarcodeImage}"
                                       Width="{Binding BarcodeWidth}" Height="80"
                                       Stretch="Uniform"
                                       RenderOptions.BitmapScalingMode="NearestNeighbor"
                                       HorizontalAlignment="Center"
                                       Margin="0,4,0,8"/>

                                <Rectangle Height="1" Fill="#000000" HorizontalAlignment="Stretch" Margin="0,4,0,6"/>

                                <!-- Atendido por -->
                                <TextBlock Text="{Binding AttendedBy, StringFormat='{}Atendido por: {0}'}"
                                           FontSize="11"
                                           FontFamily="{StaticResource FontFamilyMonospace}"
                                           Foreground="#000000"
                                           HorizontalAlignment="Center"
                                           Margin="0,2,0,4"/>

                                <TextBlock Text="Conserve este tiquete para retirar su vehículo." FontSize="9.5" FontFamily="{StaticResource FontFamilyMonospace}" Foreground="#000000" HorizontalAlignment="Center" Margin="0,1,0,4"/>

                                <!-- Código QR Pequeño de Consulta / Web -->
                                <Image Source="{Binding ConsultationQrCodeImage}"
                                       Width="70" Height="70"
                                       Stretch="Uniform"
                                       RenderOptions.BitmapScalingMode="NearestNeighbor"
                                       HorizontalAlignment="Center"
                                       Margin="0,4,0,2"/>

                                <TextBlock Text="www.parking-flow.com"
                                           FontSize="8.5"
                                           FontFamily="{StaticResource FontFamilyMonospace}"
                                           Foreground="#000000"
                                           HorizontalAlignment="Center"
                                           Margin="0,0,0,6"/>
                            </StackPanel>

                            <!-- ============================================================= -->
                            <!-- B. PLANTILLA FACTURA DE VENTA ELECTRÓNICA (RESOLUCIÓN FVM)    -->
                            <!-- ============================================================= -->
                            <StackPanel Visibility="{Binding IsFvmInvoice, Converter={StaticResource BoolToVis}}"
                                        HorizontalAlignment="Stretch" Margin="0,0">
                                
                                <!-- 1. Encabezado de Empresa / Sede -->
                                <TextBlock Text="{Binding BranchName}" FontSize="15" FontWeight="Bold" FontFamily="{StaticResource FontFamilyMonospace}" Foreground="#000000" HorizontalAlignment="Center"/>
                                <TextBlock Text="{Binding BranchNit}" FontSize="12" FontFamily="{StaticResource FontFamilyMonospace}" Foreground="#000000" HorizontalAlignment="Center" Margin="0,1"/>
                                <TextBlock Text="{Binding BranchAddress}" FontSize="11" FontFamily="{StaticResource FontFamilyMonospace}" Foreground="#000000" HorizontalAlignment="Center" Margin="0,1"/>
                                <TextBlock Text="{Binding BranchPhone}" FontSize="11" FontFamily="{StaticResource FontFamilyMonospace}" Foreground="#000000" HorizontalAlignment="Center" Margin="0,1,0,6"/>

                                <!-- Línea divisoria continua -->
                                <Rectangle Height="1" Fill="#000000" HorizontalAlignment="Stretch" Margin="6,0,6,8"/>

                                <!-- 2. Factura de Venta Electrónica y Consecutivo -->
                                <Grid Margin="0,0,0,4">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="FACTURA DE VENTA:" FontSize="11" FontWeight="Bold" FontFamily="{StaticResource FontFamilyMonospace}" Foreground="#000000"/>
                                        <TextBlock Text="ELECTRONICA" FontSize="11" FontWeight="Bold" FontFamily="{StaticResource FontFamilyMonospace}" Foreground="#000000"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding InvoicePrefix, StringFormat='{}{0}-'}" FontSize="13" FontWeight="Bold" FontFamily="{StaticResource FontFamilyMonospace}" Foreground="#000000" Margin="0,0,8,0"/>
                                        <TextBlock Text="{Binding InvoiceNumberStr}" FontSize="13" FontWeight="Bold" FontFamily="{StaticResource FontFamilyMonospace}" Foreground="#000000"/>
                                    </StackPanel>
                                </Grid>

                                <!-- Fecha y Hora -->
                                <Grid Margin="0,2,0,4">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="FECHA:   " FontSize="11" FontWeight="Bold" FontFamily="{StaticResource FontFamilyMonospace}" Foreground="#000000"/>
                                    <TextBlock Grid.Column="1" Text="{Binding InvoiceDateStr}" FontSize="11" FontWeight="Bold" FontFamily="{StaticResource FontFamilyMonospace}" Foreground="#000000"/>
                                    <TextBlock Grid.Column="2" Text="{Binding InvoiceTimeStr}" FontSize="11" FontWeight="Bold" FontFamily="{StaticResource FontFamilyMonospace}" Foreground="#000000"/>
                                </Grid>

                                <!-- Cliente, NIT, Dir -->
                                <Grid Margin="0,1">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="65"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="CLIENTE:" FontSize="11" FontWeight="Bold" FontFamily="{StaticResource FontFamilyMonospace}" Foreground="#000000"/>
                                    <TextBlock Grid.Column="1" Text="{Binding CustomerName}" FontSize="11" FontWeight="Bold" FontFamily="{StaticResource FontFamilyMonospace}" Foreground="#000000"/>
                                </Grid>

                                <Grid Margin="0,1">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="65"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="NIT:" FontSize="11" FontWeight="Bold" FontFamily="{StaticResource FontFamilyMonospace}" Foreground="#000000"/>
                                    <TextBlock Grid.Column="1" Text="{Binding CustomerNit}" FontSize="11" FontWeight="Bold" FontFamily="{StaticResource FontFamilyMonospace}" Foreground="#000000"/>
                                </Grid>

                                <Grid Margin="0,1,0,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="65"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="DIR:" FontSize="11" FontWeight="Bold" FontFamily="{StaticResource FontFamilyMonospace}" Foreground="#000000"/>
                                    <TextBlock Grid.Column="1" Text="{Binding CustomerAddress}" FontSize="11" FontWeight="Bold" FontFamily="{StaticResource FontFamilyMonospace}" Foreground="#000000"/>
                                </Grid>

                                <!-- 3. Bloque Central de la Placa -->
                                <TextBlock Text="{Binding Ticket.PlateNumber, StringFormat='{}PLACA:  {0}'}"
                                           FontSize="16"
                                           FontWeight="Black"
                                           FontFamily="{StaticResource FontFamilyMonospace}"
                                           Foreground="#000000"
                                           HorizontalAlignment="Center"
                                           Margin="0,4,0,8"/>

                                <!-- Entrada, Salida, Tiempo -->
                                <Grid Margin="0,1">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="ENTRADA:" FontSize="11" FontFamily="{StaticResource FontFamilyMonospace}" Foreground="#000000"/>
                                    <TextBlock Grid.Column="1" Text="{Binding EntryTimeStr}" FontSize="11" FontFamily="{StaticResource FontFamilyMonospace}" Foreground="#000000" Margin="10,0,0,0"/>
                                    <TextBlock Grid.Column="2" Text="{Binding EntryDateStr}" FontSize="11" FontFamily="{StaticResource FontFamilyMonospace}" Foreground="#000000"/>
                                </Grid>

                                <Grid Margin="0,1">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="SALIDA: " FontSize="11" FontFamily="{StaticResource FontFamilyMonospace}" Foreground="#000000"/>
                                    <TextBlock Grid.Column="1" Text="{Binding ExitTimeStr}" FontSize="11" FontFamily="{StaticResource FontFamilyMonospace}" Foreground="#000000" Margin="10,0,0,0"/>
                                    <TextBlock Grid.Column="2" Text="{Binding ExitDateStr}" FontSize="11" FontFamily="{StaticResource FontFamilyMonospace}" Foreground="#000000"/>
                                </Grid>

                                <Grid Margin="0,1,0,6">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="TIEMPO: " FontSize="11" FontFamily="{StaticResource FontFamilyMonospace}" Foreground="#000000"/>
                                    <TextBlock Grid.Column="1" Text="{Binding DurationMinutesStr}" FontSize="11" FontFamily="{StaticResource FontFamilyMonospace}" Foreground="#000000" HorizontalAlignment="Right" Margin="0,0,10,0"/>
                                </Grid>

                                <Rectangle Height="1" Fill="#000000" HorizontalAlignment="Stretch" Margin="0,0,0,6"/>

                                <!-- 4. Liquidación Fiscal (Base Gravable, IVA 19%, TOTAL) -->
                                <Grid Margin="0,2">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="BASE GRAVABLE:" FontSize="12" FontWeight="Bold" FontFamily="{StaticResource FontFamilyMonospace}" Foreground="#000000"/>
                                    <TextBlock Grid.Column="1" Text="{Binding BaseGravableStr}" FontSize="12" FontWeight="Bold" FontFamily="{StaticResource FontFamilyMonospace}" Foreground="#000000"/>
                                </Grid>

                                <Grid Margin="0,2">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="  IVA 19%" FontSize="12" FontFamily="{StaticResource FontFamilyMonospace}" Foreground="#000000"/>
                                    <TextBlock Grid.Column="1" Text="{Binding Iva19Str}" FontSize="12" FontFamily="{StaticResource FontFamilyMonospace}" Foreground="#000000"/>
                                </Grid>

                                <!-- Línea discontinua a la derecha -->
                                <TextBlock Text="-----------------------" FontSize="11" FontFamily="{StaticResource FontFamilyMonospace}" Foreground="#000000" HorizontalAlignment="Right" Margin="0,1"/>

                                <Grid Margin="0,2,0,6">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="TOTAL:" FontSize="14" FontWeight="Black" FontFamily="{StaticResource FontFamilyMonospace}" Foreground="#000000"/>
                                    <TextBlock Grid.Column="1" Text="{Binding TotalStr}" FontSize="14" FontWeight="Black" FontFamily="{StaticResource FontFamilyMonospace}" Foreground="#000000"/>
                                </Grid>

                                <Rectangle Height="1" Fill="#000000" HorizontalAlignment="Stretch" Margin="0,0,0,8"/>

                                <!-- 5. QR Code y Bloque Atendido Por (2 Columnas) -->
                                <Grid Margin="0,0,0,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>

                                    <Image Grid.Column="0"
                                           Source="{Binding ConsultationQrCodeImage}"
                                           Width="{Binding QrCodeWidth}" Height="{Binding QrCodeWidth}"
                                           Stretch="Uniform"
                                           RenderOptions.BitmapScalingMode="NearestNeighbor"
                                           HorizontalAlignment="Left"
                                           VerticalAlignment="Center"/>

                                    <StackPanel Grid.Column="1" Margin="14,0,0,0" VerticalAlignment="Center">
                                        <TextBlock Text="Cant Items: 1" FontSize="11" FontFamily="{StaticResource FontFamilyMonospace}" Foreground="#000000" Margin="0,0,0,10"/>
                                        <TextBlock Text="Atendido por:" FontSize="11" FontFamily="{StaticResource FontFamilyMonospace}" Foreground="#000000"/>
                                        <TextBlock Text="{Binding AttendedBy}" FontSize="11" FontWeight="Bold" FontFamily="{StaticResource FontFamilyMonospace}" Foreground="#000000"/>
                                    </StackPanel>
                                </Grid>

                                <Rectangle Height="1" Fill="#000000" HorizontalAlignment="Stretch" Margin="0,0,0,4"/>

                                <!-- 6. Forma de Pago -->
                                <TextBlock Text="{Binding PaymentMethodName, StringFormat='{}FORMA DE PAGO: {0}'}"
                                           FontSize="11"
                                           FontFamily="{StaticResource FontFamilyMonospace}"
                                           Foreground="#000000"
                                           HorizontalAlignment="Center"
                                           Margin="0,2"/>

                                <Rectangle Height="1" Fill="#000000" HorizontalAlignment="Stretch" Margin="0,4,0,4"/>

                                <!-- 7. CUFE -->
                                <TextBlock Text="{Binding Cufe, StringFormat='{}CUFE: {0}'}"
                                           FontSize="8"
                                           FontFamily="{StaticResource FontFamilyMonospace}"
                                           Foreground="#000000"
                                           TextWrapping="Wrap"
                                           Margin="0,2,0,8"/>

                                <!-- 8. Pie Legal y Resolución DIAN -->
                                <TextBlock Text="IVA REGIMEN COMUN" FontSize="9" FontFamily="{StaticResource FontFamilyMonospace}" Foreground="#000000" HorizontalAlignment="Center" Margin="0,1"/>
                                <TextBlock Text="NO SOMOS GRANDES CONTRIBUYENTES" FontSize="9" FontFamily="{StaticResource FontFamilyMonospace}" Foreground="#000000" HorizontalAlignment="Center" Margin="0,1"/>
                                <TextBlock Text="{Binding DianResolutionText}" FontSize="8.5" FontFamily="{StaticResource FontFamilyMonospace}" Foreground="#000000" HorizontalAlignment="Center" Margin="0,1"/>
                                <TextBlock Text="{Binding DianRangeText}" FontSize="8.5" FontFamily="{StaticResource FontFamilyMonospace}" Foreground="#000000" HorizontalAlignment="Center" Margin="0,1"/>
                                <TextBlock Text="ESTA FACTURA DE VENTA SE ASIMILA EN TODOS" FontSize="8.5" FontFamily="{StaticResource FontFamilyMonospace}" Foreground="#000000" HorizontalAlignment="Center" Margin="0,1"/>
                                <TextBlock Text="SUS EFECTOS LEGALES A LA LETRA DE CAMBIO ART. 774 CC" FontSize="8.5" FontFamily="{StaticResource FontFamilyMonospace}" Foreground="#000000" HorizontalAlignment="Center" Margin="0,1"/>
                                <TextBlock Text="Factura electrónica o por computador generada por" FontSize="8.5" FontFamily="{StaticResource FontFamilyMonospace}" Foreground="#000000" HorizontalAlignment="Center" Margin="0,2,0,0"/>
                                <TextBlock Text="Mersoft S.A.S NIT 901.190.597-7" FontSize="8.5" FontFamily="{StaticResource FontFamilyMonospace}" Foreground="#000000" HorizontalAlignment="Center" Margin="0,1"/>
                                <TextBlock Text="Software MERLIN" FontSize="9" FontWeight="Bold" FontFamily="{StaticResource FontFamilyMonospace}" Foreground="#000000" HorizontalAlignment="Center" Margin="0,1"/>
                                <TextBlock Text="www.merlin.com.co" FontSize="8.5" FontFamily="{StaticResource FontFamilyMonospace}" Foreground="#000000" HorizontalAlignment="Center" Margin="0,1"/>
                                <TextBlock Text="Proveedor tecnológico The factory HKA Colombia SAS" FontSize="8" FontFamily="{StaticResource FontFamilyMonospace}" Foreground="#000000" HorizontalAlignment="Center" Margin="0,2,0,0"/>
                                <TextBlock Text="NIT 900390126-6" FontSize="8" FontFamily="{StaticResource FontFamilyMonospace}" Foreground="#000000" HorizontalAlignment="Center" Margin="0,1,0,8"/>

                            </StackPanel>

                        </Grid>
                    </ScrollViewer>
                </Border>

                <!-- 3. Bottom Action Buttons -->
                <Grid Grid.Row="2">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" Visibility="{Binding PrintSuccess, Converter={StaticResource BoolToVis}}">
                        <Path Data="{StaticResource IconCheck}" Fill="{DynamicResource BrushSuccess}" Width="14" Height="14" Stretch="Uniform" Margin="0,0,6,0"/>
                        <TextBlock Text="Tiquete enviado a impresión" Foreground="{DynamicResource BrushSuccess}" FontSize="11" VerticalAlignment="Center"/>
                    </StackPanel>

                    <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Command="{Binding PrintTicketCommand}"
                                Style="{StaticResource ModernButton}"
                                Margin="0,0,8,0"
                                Padding="16,6">
                            <Button.ContentTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal">
                                        <Path Data="{StaticResource IconPrint}" Fill="{DynamicResource BrushTextWhite}" Width="13" Height="13" Stretch="Uniform" Margin="0,0,6,0"/>
                                        <TextBlock Text="Imprimir Tiquete" Foreground="{DynamicResource BrushTextWhite}" FontWeight="Bold" FontSize="12" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </DataTemplate>
                            </Button.ContentTemplate>
                        </Button>
                        <Button Content="Cerrar"
                                Command="{Binding CloseCommand}"
                                Style="{StaticResource SecondaryButton}"
                                Padding="16,6"
                                FontSize="12"/>
                    </StackPanel>
                </Grid>
            </Grid>
        </Border>
    </Grid>
</Window>
