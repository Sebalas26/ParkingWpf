<Window x:Class="Parking.Views.CheckOutDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:conv="clr-namespace:Parking.Core.Converters"
        mc:Ignorable="d"
        Title="Detalle de Cobro"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="#B3000000"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False">
    
    <Window.Resources>
        <conv:CurrencyConverter x:Key="CurrencyConv"/>
        <conv:VehicleTypeToStringConverter x:Key="VehicleTypeStrConv"/>
        <conv:BooleanToVisibilityConverter x:Key="BoolToVis"/>
        <conv:EqualityToBooleanConverter x:Key="EqualityConv"/>

        <!-- Estilo de Botón de Billete Rápido -->
        <Style x:Key="CashPresetButton" TargetType="Button">
            <Setter Property="Background" Value="#F1F5F9"/>
            <Setter Property="Foreground" Value="{DynamicResource BrushPrimary}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BrushBorderMedium}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Height" Value="28"/>
            <Setter Property="Margin" Value="2,0"/>
            <Setter Property="Padding" Value="4,2"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6"
                                SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="{DynamicResource BrushPrimary}"/>
                                <Setter Property="Foreground" Value="{DynamicResource BrushTextWhite}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Background" Value="{DynamicResource BrushSidebarItemActive}"/>
                                <Setter Property="Foreground" Value="{DynamicResource BrushTextWhite}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>
    
    <!-- Para poder cerrar el modal clickeando fuera de él -->
    <Grid Background="Transparent" MouseDown="Grid_MouseDown">
        <Border Style="{StaticResource ModernCard}"
                Width="550"
                MaxHeight="700"
                Padding="24"
                VerticalAlignment="Center"
                HorizontalAlignment="Center"
                MouseDown="Border_MouseDown">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Detalle desplazable -->
                <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto" Margin="0,0,0,10">
                    <StackPanel Margin="0,0,4,0">
                        <!-- Header con Placa Seleccionada -->
                        <Grid Margin="0,0,0,16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0">
                                <TextBlock Text="Detalle de Cobro y Liquidación" FontSize="20" FontWeight="Bold" Foreground="{DynamicResource BrushTextPrimary}"/>
                                <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                                    <TextBlock Text="Placa: " FontSize="16" FontWeight="SemiBold" Foreground="{DynamicResource BrushTextSecondary}"/>
                                    <TextBlock Text="{Binding SelectedTicket.PlateNumber}" FontSize="18" FontWeight="Black" FontFamily="{StaticResource FontFamilyMonospace}" Foreground="{DynamicResource BrushPrimary}"/>
                                    <TextBlock Text="{Binding SelectedTicket.VehicleType, Converter={StaticResource VehicleTypeStrConv}, StringFormat='{} • {0}'}" FontSize="15" FontWeight="Bold" Foreground="{DynamicResource BrushTextMuted}"/>
                                </StackPanel>
                            </StackPanel>

                            <Button Grid.Column="1"
                                    Content="Cancelar Selección"
                                    Click="CancelButton_Click"
                                    Style="{StaticResource SecondaryButton}"
                                    Padding="10,6"
                                    FontSize="13"
                                    VerticalAlignment="Top"/>
                        </Grid>

                        <!-- Feedback Alert -->
                        <Border Visibility="{Binding HasFeedback, Converter={StaticResource BoolToVis}}"
                                CornerRadius="8"
                                Padding="12,10"
                                Margin="0,0,0,16">
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Setter Property="Background" Value="{DynamicResource BrushSuccessBg}"/>
                                    <Setter Property="BorderBrush" Value="{DynamicResource BrushSuccess}"/>
                                    <Setter Property="BorderThickness" Value="1"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsSuccessFeedback}" Value="False">
                                            <Setter Property="Background" Value="{DynamicResource BrushWarningBg}"/>
                                            <Setter Property="BorderBrush" Value="{DynamicResource BrushWarning}"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <TextBlock Text="{Binding FeedbackMessage}" FontSize="14" FontWeight="SemiBold" TextWrapping="Wrap">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Foreground" Value="{DynamicResource BrushSuccess}"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsSuccessFeedback}" Value="False">
                                                <Setter Property="Foreground" Value="{DynamicResource BrushWarningText}"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </Border>

                        <!-- Banner de Vehículo con Mensualidad Activa -->
                        <Border Visibility="{Binding IsMonthlyTicket, Converter={StaticResource BoolToVis}}"
                                Background="{DynamicResource BrushSuccessBg}"
                                BorderBrush="{DynamicResource BrushSuccess}"
                                BorderThickness="1.5"
                                CornerRadius="10"
                                Padding="14,10"
                                Margin="0,0,0,16">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <Border Grid.Column="0" Width="26" Height="26" CornerRadius="13" Background="{DynamicResource BrushSuccess}" Margin="0,0,10,0" VerticalAlignment="Center">
                                    <Path Data="{StaticResource IconCheck}" Fill="{DynamicResource BrushTextWhite}" Width="12" Height="12" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <TextBlock Text="VEHÍCULO CON MENSUALIDAD AL DÍA" FontWeight="Black" FontSize="14" Foreground="{DynamicResource BrushSuccess}"/>
                                    <TextBlock Text="Acceso con tarifa preferencial de mensualidad • Cobro actual: $0.00" FontSize="13" Foreground="{DynamicResource BrushTextPrimary}"/>
                                </StackPanel>
                                <Border Grid.Column="2" Background="{DynamicResource BrushSuccess}" CornerRadius="6" Padding="10,4" VerticalAlignment="Center">
                                    <TextBlock Text="TARIFA $0.00" FontSize="14" FontWeight="Black" Foreground="{DynamicResource BrushTextWhite}"/>
                                </Border>
                            </Grid>
                        </Border>

                        <!-- 3 Métricas: Hora Entrada, Tiempo Transcurrido (Timer), Subtotal -->
                        <Border Background="#F1F5F9" CornerRadius="10" Padding="16" Margin="0,0,0,20">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="1.2*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="HORA DE INGRESO" FontSize="12" FontWeight="Bold" Foreground="{DynamicResource BrushTextMuted}"/>
                                    <TextBlock Text="{Binding SelectedTicket.EntryTime, StringFormat='{}{0:HH:mm:ss}'}" FontSize="16" FontWeight="Bold" Foreground="{DynamicResource BrushTextPrimary}" Margin="0,4,0,0"/>
                                </StackPanel>

                                <StackPanel Grid.Column="1" HorizontalAlignment="Center">
                                    <TextBlock Text="TIEMPO TRANSCURRIDO" FontSize="12" FontWeight="Bold" Foreground="{DynamicResource BrushPrimary}" HorizontalAlignment="Center"/>
                                    <TextBlock Text="{Binding ElapsedTimeString}" FontSize="17" FontWeight="Black" Foreground="{DynamicResource BrushPrimary}" Margin="0,4,0,0" HorizontalAlignment="Center"/>
                                </StackPanel>

                                <StackPanel Grid.Column="2" HorizontalAlignment="Right">
                                    <TextBlock Text="VALOR MINUTO" FontSize="12" FontWeight="Bold" Foreground="{DynamicResource BrushTextMuted}" HorizontalAlignment="Right"/>
                                    <TextBlock Text="{Binding MinuteRate, Converter={StaticResource CurrencyConv}, StringFormat='{}{0} / min'}" FontSize="17" FontWeight="Bold" Foreground="{DynamicResource BrushTextPrimary}" Margin="0,4,0,0" HorizontalAlignment="Right"/>
                                </StackPanel>
                            </Grid>
                        </Border>

                        <!-- Sección de Convenios y Comercios Aliados -->
                        <Border BorderBrush="{DynamicResource BrushBorderSubtle}" BorderThickness="1" CornerRadius="10" Padding="16" Margin="0,0,0,20">
                            <StackPanel>
                                <Grid Margin="0,0,0,12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    
                                    <CheckBox Grid.Column="0" Content="Aplicar Convenio de Comercio Aliado"
                                              IsChecked="{Binding HasAgreementDiscount}"
                                              Foreground="{DynamicResource BrushTextPrimary}"
                                              FontWeight="Bold"
                                              FontSize="15"
                                              VerticalAlignment="Center"/>

                                    <!-- Logos de los convenios cargados -->
                                    <ItemsControl Grid.Column="1" ItemsSource="{Binding BranchAgreements}" Margin="12,0,0,0" VerticalAlignment="Center" HorizontalAlignment="Left">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <StackPanel Orientation="Horizontal"/>
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border BorderBrush="{DynamicResource BrushBorderMedium}" BorderThickness="1" CornerRadius="6" Background="#FFFFFF" Width="60" Height="36" Margin="0,0,8,0" Padding="4" ToolTip="{Binding Name}">
                                                    <Image Source="{Binding ImageUrl, TargetNullValue='/Resources/logo.jpeg', FallbackValue='/Resources/logo.jpeg'}" Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality"/>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </Grid>

                                <StackPanel Visibility="{Binding HasAgreementDiscount, Converter={StaticResource BoolToVis}}">
                                    <!-- Selector de Almacén Aliado -->
                                    <TextBlock Text="ALMACÉN ALIADO *" FontSize="12" FontWeight="Bold" Foreground="{DynamicResource BrushTextMuted}" Margin="0,0,0,4"/>
                                    <ComboBox ItemsSource="{Binding AvailableStores}"
                                              SelectedItem="{Binding SelectedStore}"
                                              DisplayMemberPath="Name"
                                              Style="{StaticResource ModernComboBox}"
                                              Margin="0,0,0,12"/>

                                    <!-- Selector de Convenio -->
                                    <TextBlock Text="REGLA DE CONVENIO *" FontSize="12" FontWeight="Bold" Foreground="{DynamicResource BrushTextMuted}" Margin="0,0,0,4"/>
                                    <ComboBox ItemsSource="{Binding AvailableAgreements}"
                                              SelectedItem="{Binding SelectedAgreement}"
                                              DisplayMemberPath="Name"
                                              Style="{StaticResource ModernComboBox}"
                                              Margin="0,0,0,12"/>

                                    <Grid Margin="0,0,0,10">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>

                                        <!-- Valor de Compra -->
                                        <StackPanel Grid.Column="0" Margin="0,0,8,0">
                                            <TextBlock Text="VALOR COMPRA CLIENTE ($) *" FontSize="12" FontWeight="Bold" Foreground="{DynamicResource BrushTextMuted}" Margin="0,0,0,4"/>
                                            <TextBox Text="{Binding CustomerPurchaseAmount, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource ModernTextBox}"/>
                                        </StackPanel>

                                        <!-- Número de Factura -->
                                        <StackPanel Grid.Column="1" Margin="8,0,0,0">
                                            <TextBlock Text="NÚMERO DE FACTURA COMERCIO *" FontSize="12" FontWeight="Bold" Foreground="{DynamicResource BrushTextMuted}" Margin="0,0,0,4"/>
                                            <TextBox Text="{Binding InvoiceNumber, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource ModernTextBox}"/>
                                        </StackPanel>
                                    </Grid>

                                    <!-- Descuento Calculado -->
                                    <Border Background="#FEF3C7" CornerRadius="8" Padding="10,6" Margin="0,4,0,0">
                                        <Grid>
                                            <TextBlock Text="Descuento por Convenio Aplicado:" FontSize="13" FontWeight="Bold" Foreground="#B45309" VerticalAlignment="Center"/>
                                            <TextBlock Text="{Binding DiscountAmount, Converter={StaticResource CurrencyConv}, StringFormat='{}-{0}'}" FontSize="15" FontWeight="Bold" Foreground="#B45309" HorizontalAlignment="Right"/>
                                        </Grid>
                                    </Border>
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <!-- Selector de Medios de Pago Dinámicos de la BD -->
                        <TextBlock Text="MÉTODO DE PAGO *" FontSize="13" FontWeight="Bold" Foreground="{DynamicResource BrushTextMuted}" Margin="0,0,0,8"/>

                        <!-- Aviso si NO existen medios de pago configurados en la sede -->
                        <Border Visibility="{Binding HasPaymentMethods, Converter={StaticResource BoolToVis}, ConverterParameter=Invert}"
                                Background="{DynamicResource BrushDangerBg}"
                                BorderBrush="{DynamicResource BrushDanger}"
                                BorderThickness="1"
                                CornerRadius="10"
                                Padding="14,10"
                                Margin="0,0,0,16">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="⚠️" FontSize="16" Margin="0,0,10,0" VerticalAlignment="Center"/>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="Sin Medios de Pago Habilitados" FontWeight="Bold" FontSize="13" Foreground="{DynamicResource BrushDangerText}"/>
                                    <TextBlock Text="No hay medios de pago registrados para esta sede en la base de datos. Configure y asigne medios de pago desde el panel web de administración."
                                               FontSize="11" Foreground="{DynamicResource BrushTextPrimary}" TextWrapping="Wrap"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <ItemsControl ItemsSource="{Binding AvailablePaymentMethods}" Margin="0,0,0,16"
                                      Visibility="{Binding HasPaymentMethods, Converter={StaticResource BoolToVis}}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <UniformGrid Columns="2" Rows="0"/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <RadioButton GroupName="PaymentMethodGroup"
                                                 Margin="4"
                                                 Cursor="Hand"
                                                 Command="{Binding DataContext.SelectPaymentMethodCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                 CommandParameter="{Binding}">
                                        <RadioButton.IsChecked>
                                            <MultiBinding Converter="{StaticResource EqualityConv}" Mode="OneWay">
                                                <Binding Path="Id"/>
                                                <Binding Path="DataContext.SelectedPaymentMethodEntity.Id" RelativeSource="{RelativeSource AncestorType=Window}"/>
                                            </MultiBinding>
                                        </RadioButton.IsChecked>
                                        <RadioButton.Template>
                                            <ControlTemplate TargetType="RadioButton">
                                                <Border x:Name="border"
                                                        Background="{DynamicResource BrushSurfaceBackground}"
                                                        BorderBrush="{DynamicResource BrushBorderMedium}"
                                                        BorderThickness="1.5"
                                                        CornerRadius="10"
                                                        Padding="12,10"
                                                        SnapsToDevicePixels="True">
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="Auto"/>
                                                            <ColumnDefinition Width="*"/>
                                                            <ColumnDefinition Width="Auto"/>
                                                        </Grid.ColumnDefinitions>
                                                        <Path x:Name="icon" Grid.Column="0" Data="{StaticResource IconCash}" Fill="{DynamicResource BrushPrimary}" Width="16" Height="16" Stretch="Uniform" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                                        <TextBlock x:Name="txt" Grid.Column="1" Text="{Binding Name}" FontWeight="Bold" FontSize="14" Foreground="{DynamicResource BrushTextPrimary}" VerticalAlignment="Center"/>
                                                        <Path x:Name="check" Grid.Column="2" Data="{StaticResource IconCheck}" Fill="{DynamicResource BrushPrimary}" Width="12" Height="12" Stretch="Uniform" Visibility="Collapsed" VerticalAlignment="Center"/>
                                                    </Grid>
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsChecked" Value="True">
                                                        <Setter TargetName="border" Property="Background" Value="#EBF6F8"/>
                                                        <Setter TargetName="border" Property="BorderBrush" Value="{DynamicResource BrushPrimary}"/>
                                                        <Setter TargetName="border" Property="BorderThickness" Value="2"/>
                                                        <Setter TargetName="txt" Property="Foreground" Value="{DynamicResource BrushPrimary}"/>
                                                        <Setter TargetName="txt" Property="FontWeight" Value="Black"/>
                                                        <Setter TargetName="check" Property="Visibility" Value="Visible"/>
                                                    </Trigger>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter TargetName="border" Property="BorderBrush" Value="{DynamicResource BrushPrimary}"/>
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </RadioButton.Template>
                                    </RadioButton>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <!-- Total Neto y Módulo de Caja Mejorado -->
                        <Border Background="#F8FAFC" BorderBrush="{DynamicResource BrushBorderMedium}" BorderThickness="1.5" CornerRadius="12" Padding="16" Margin="0,0,0,16">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <!-- Fila Superior: Total a Pagar e Input de Efectivo -->
                                <Grid Grid.Row="0" Margin="0,0,0,12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="1*"/>
                                        <ColumnDefinition Width="1.35*"/>
                                    </Grid.ColumnDefinitions>

                                    <!-- Total a Cobrar en Grande -->
                                    <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,14,0">
                                        <TextBlock Text="TOTAL NETO A PAGAR" FontSize="13" FontWeight="Black" Foreground="{DynamicResource BrushPrimary}"/>
                                        <TextBlock Text="{Binding CalculatedFee, Converter={StaticResource CurrencyConv}}" FontSize="34" FontWeight="Black" Foreground="{DynamicResource BrushPrimary}" Margin="0,2,0,0"/>
                                    </StackPanel>

                                    <!-- Input de Efectivo Recibido en Grande con Billetes Rápidos -->
                                    <StackPanel Grid.Column="1">
                                        <TextBlock Text="MONTO EN EFECTIVO RECIBIDO ($) *" FontSize="12" FontWeight="Bold" Foreground="{DynamicResource BrushTextMuted}" Margin="0,0,0,4"/>
                                        <TextBox Text="{Binding AmountTendered, UpdateSourceTrigger=PropertyChanged, StringFormat='{}{0:N0}'}"
                                                 IsEnabled="{Binding SelectedPaymentMethodEntity.RequiresCashTender, FallbackValue=True}"
                                                 Style="{StaticResource ModernTextBox}"
                                                 Height="48"
                                                 FontSize="26"
                                                 FontWeight="Black"
                                                 FontFamily="{StaticResource FontFamilyMonospace}"
                                                 HorizontalContentAlignment="Center"
                                                 VerticalContentAlignment="Center"
                                                 Margin="0,0,0,6"/>

                                        <!-- Botones de Billetes Rápidos -->
                                        <UniformGrid Columns="6" Rows="1">
                                            <Button Content="Exacto" Style="{StaticResource CashPresetButton}" Command="{Binding ExactCashCommand}" Background="#E0F2FE" Foreground="#0369A1" FontWeight="Black"/>
                                            <Button Content="$5K" Style="{StaticResource CashPresetButton}" Command="{Binding QuickCashCommand}" CommandParameter="5000"/>
                                            <Button Content="$10K" Style="{StaticResource CashPresetButton}" Command="{Binding QuickCashCommand}" CommandParameter="10000"/>
                                            <Button Content="$20K" Style="{StaticResource CashPresetButton}" Command="{Binding QuickCashCommand}" CommandParameter="20000"/>
                                            <Button Content="$50K" Style="{StaticResource CashPresetButton}" Command="{Binding QuickCashCommand}" CommandParameter="50000"/>
                                            <Button Content="$100K" Style="{StaticResource CashPresetButton}" Command="{Binding QuickCashCommand}" CommandParameter="100000"/>
                                        </UniformGrid>
                                    </StackPanel>
                                </Grid>

                                <!-- Fila Inferior: Tarjeta de CAMBIO / DEVUELTA en Grande -->
                                <Border Grid.Row="1" Background="#DCFCE7" BorderBrush="#86EFAC" BorderThickness="1.5" CornerRadius="10" Padding="14,8">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                            <TextBlock Text="CAMBIO / DEVUELTA AL CLIENTE" FontSize="13" FontWeight="Black" Foreground="#166534"/>
                                            <TextBlock Text="Entregar este valor al conductor" FontSize="12" Foreground="#15803D" Margin="0,1,0,0"/>
                                        </StackPanel>
                                        <TextBlock Grid.Column="1"
                                                   Text="{Binding ChangeDue, Converter={StaticResource CurrencyConv}}"
                                                   FontSize="28"
                                                   FontWeight="Black"
                                                   FontFamily="{StaticResource FontFamilyMonospace}"
                                                   Foreground="#15803D"
                                                   VerticalAlignment="Center"/>
                                    </Grid>
                                </Border>
                            </Grid>
                        </Border>

                        <!-- Campo de Observaciones / Novedades de Salida -->
                        <TextBlock Text="OBSERVACIONES / NOVEDADES DE SALIDA (OPCIONAL)" FontSize="12" FontWeight="Bold" Foreground="{DynamicResource BrushTextMuted}" Margin="0,0,0,4"/>
                        <TextBox Text="{Binding ExitNotes, UpdateSourceTrigger=PropertyChanged}"
                                 Height="44"
                                 TextWrapping="Wrap"
                                 Style="{StaticResource ModernTextBox}"
                                 Margin="0,0,0,12"/>
                    </StackPanel>
                </ScrollViewer>

                <!-- Pie de Página Estático con Botón de Pago Principal -->
                <Border Grid.Row="1"
                        BorderBrush="{DynamicResource BrushBorderSubtle}"
                        BorderThickness="0,1,0,0"
                        Padding="0,12,0,0"
                        Background="{DynamicResource BrushAppBackground}">
                    <Button Command="{Binding ProcessPaymentCommand}"
                            Style="{StaticResource ModernButton}"
                            Height="48"
                            FontSize="16">
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                            <Path Data="{StaticResource IconCheck}" Fill="{DynamicResource BrushTextWhite}" Width="16" Height="16" Stretch="Uniform" Margin="0,0,10,0"/>
                            <TextBlock Text="Cobrar y Registrar Salida" FontWeight="Bold" Foreground="{DynamicResource BrushTextWhite}"/>
                        </StackPanel>
                    </Button>
                </Border>
            </Grid>
        </Border>
    </Grid>
</Window>
