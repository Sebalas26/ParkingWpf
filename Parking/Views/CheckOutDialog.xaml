<Window x:Class="Parking.Views.CheckOutDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:conv="clr-namespace:Parking.Core.Converters"
        mc:Ignorable="d"
        Title="Detalle de Cobro"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="#B3000000"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False">
    
    <Window.Resources>
        <conv:CurrencyConverter x:Key="CurrencyConv"/>
        <conv:VehicleTypeToStringConverter x:Key="VehicleTypeStrConv"/>
        <conv:BooleanToVisibilityConverter x:Key="BoolToVis"/>
        <conv:EqualityToBooleanConverter x:Key="EqualityConv"/>

        <!-- Estilo de Botón de Billete Rápido -->
        <Style x:Key="CashPresetButton" TargetType="Button">
            <Setter Property="Background" Value="#F1F5F9"/>
            <Setter Property="Foreground" Value="{DynamicResource BrushPrimary}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BrushBorderMedium}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Height" Value="28"/>
            <Setter Property="Margin" Value="2,0"/>
            <Setter Property="Padding" Value="4,2"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6"
                                SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="{DynamicResource BrushPrimary}"/>
                                <Setter Property="Foreground" Value="{DynamicResource BrushTextWhite}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Background" Value="{DynamicResource BrushSidebarItemActive}"/>
                                <Setter Property="Foreground" Value="{DynamicResource BrushTextWhite}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>
    
    <!-- Para poder cerrar el modal clickeando fuera de él -->
    <Grid Background="Transparent" MouseDown="Grid_MouseDown">
        <Border Style="{StaticResource ModernCard}"
                Width="800"
                MaxHeight="750"
                Padding="24"
                VerticalAlignment="Center"
                HorizontalAlignment="Center"
                MouseDown="Border_MouseDown">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Detalle desplazable -->
                <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto" Margin="0,0,0,10">
                    <StackPanel Margin="0,0,4,0">
                        <!-- Header con Placa Seleccionada -->
                        <Grid Margin="0,0,0,16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0">
                                <TextBlock Text="Detalle de Cobro y Liquidación" FontSize="20" FontWeight="Bold" Foreground="{DynamicResource BrushTextPrimary}"/>
                                <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                                    <TextBlock Text="Placa: " FontSize="16" FontWeight="SemiBold" Foreground="{DynamicResource BrushTextSecondary}"/>
                                    <TextBlock Text="{Binding SelectedTicket.PlateNumber}" FontSize="18" FontWeight="Black" FontFamily="{StaticResource FontFamilyMonospace}" Foreground="{DynamicResource BrushPrimary}"/>
                                    <TextBlock Text="{Binding SelectedTicket.VehicleType, Converter={StaticResource VehicleTypeStrConv}, StringFormat='{} • {0}'}" FontSize="15" FontWeight="Bold" Foreground="{DynamicResource BrushTextMuted}"/>
                                </StackPanel>
                            </StackPanel>

                            <Button Grid.Column="1"
                                    Content="Cancelar Selección"
                                    Click="CancelButton_Click"
                                    Background="{DynamicResource BrushDangerBg}"
                                    Foreground="{DynamicResource BrushDangerText}"
                                    BorderBrush="#FCA5A5"
                                    BorderThickness="1"
                                    FontWeight="Bold"
                                    Padding="14,6"
                                    FontSize="13"
                                    VerticalAlignment="Top"
                                    Cursor="Hand">
                                <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                        <Border x:Name="btnBorder"
                                                Background="{TemplateBinding Background}"
                                                BorderBrush="{TemplateBinding BorderBrush}"
                                                BorderThickness="{TemplateBinding BorderThickness}"
                                                CornerRadius="8"
                                                Padding="{TemplateBinding Padding}"
                                                SnapsToDevicePixels="True">
                                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="btnBorder" Property="Background" Value="#FECACA"/>
                                                <Setter TargetName="btnBorder" Property="BorderBrush" Value="{DynamicResource BrushDanger}"/>
                                            </Trigger>
                                            <Trigger Property="IsPressed" Value="True">
                                                <Setter TargetName="btnBorder" Property="Background" Value="#FCA5A5"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Button.Template>
                            </Button>
                        </Grid>

                        <!-- Feedback Alert -->
                        <Border Visibility="{Binding HasFeedback, Converter={StaticResource BoolToVis}}"
                                CornerRadius="8"
                                Padding="12,10"
                                Margin="0,0,0,16">
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Setter Property="Background" Value="{DynamicResource BrushSuccessBg}"/>
                                    <Setter Property="BorderBrush" Value="{DynamicResource BrushSuccess}"/>
                                    <Setter Property="BorderThickness" Value="1"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsSuccessFeedback}" Value="False">
                                            <Setter Property="Background" Value="{DynamicResource BrushWarningBg}"/>
                                            <Setter Property="BorderBrush" Value="{DynamicResource BrushWarning}"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <TextBlock Text="{Binding FeedbackMessage}" FontSize="14" FontWeight="SemiBold" TextWrapping="Wrap">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Foreground" Value="{DynamicResource BrushSuccess}"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsSuccessFeedback}" Value="False">
                                                <Setter Property="Foreground" Value="{DynamicResource BrushWarningText}"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </Border>

                        <!-- 3 Métricas: Hora Entrada, Tiempo Transcurrido (Timer), Subtotal -->
                        <Border Background="#F1F5F9" CornerRadius="10" Padding="16" Margin="0,0,0,16">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="1.2*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="HORA DE INGRESO" FontSize="12" FontWeight="Bold" Foreground="{DynamicResource BrushTextMuted}"/>
                                    <TextBlock Text="{Binding SelectedTicket.EntryTime, StringFormat='{}{0:HH:mm:ss}'}" FontSize="16" FontWeight="Bold" Foreground="{DynamicResource BrushTextPrimary}" Margin="0,4,0,0"/>
                                </StackPanel>

                                <StackPanel Grid.Column="1" HorizontalAlignment="Center">
                                    <TextBlock Text="TIEMPO TRANSCURRIDO" FontSize="12" FontWeight="Bold" Foreground="{DynamicResource BrushPrimary}" HorizontalAlignment="Center"/>
                                    <TextBlock Text="{Binding ElapsedTimeString}" FontSize="17" FontWeight="Black" Foreground="{DynamicResource BrushPrimary}" Margin="0,4,0,0" HorizontalAlignment="Center"/>
                                </StackPanel>

                                <StackPanel Grid.Column="2" HorizontalAlignment="Right">
                                    <TextBlock Text="VALOR MINUTO" FontSize="12" FontWeight="Bold" Foreground="{DynamicResource BrushTextMuted}" HorizontalAlignment="Right"/>
                                    <TextBlock Text="{Binding MinuteRate, Converter={StaticResource CurrencyConv}, StringFormat='{}{0} / min'}" FontSize="17" FontWeight="Bold" Foreground="{DynamicResource BrushTextPrimary}" Margin="0,4,0,0" HorizontalAlignment="Right"/>
                                </StackPanel>
                            </Grid>
                        </Border>

                        <!-- Sección de Convenios y Comercios Aliados con Logos como Botón + Ojo Informativo -->
                        <Border BorderBrush="{DynamicResource BrushBorderSubtle}" BorderThickness="1" CornerRadius="12" Padding="14,10" Margin="0,0,0,16">
                            <StackPanel>
                                <Grid Margin="0,0,0,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    
                                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                                        <Path Data="{StaticResource IconStore}" Fill="{DynamicResource BrushPrimary}" Width="15" Height="15" Stretch="Uniform" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                        <TextBlock Text="CONVENIOS Y COMERCIOS ALIADOS"
                                                   FontSize="12"
                                                   FontWeight="Bold"
                                                   Foreground="{DynamicResource BrushTextPrimary}"
                                                   VerticalAlignment="Center"/>
                                        <TextBlock Text="(Clic en el logo para aplicar descuento)"
                                                   FontSize="11"
                                                   Foreground="{DynamicResource BrushTextMuted}"
                                                   Margin="8,0,0,0"
                                                   VerticalAlignment="Center"/>
                                    </StackPanel>

                                    <!-- Badge de Descuento si hay uno seleccionado -->
                                    <Border Grid.Column="1"
                                            Visibility="{Binding HasAgreementDiscount, Converter={StaticResource BoolToVis}}"
                                            Background="#FEF3C7"
                                            BorderBrush="#FDE68A"
                                            BorderThickness="1"
                                            CornerRadius="8"
                                            Padding="8,3"
                                            VerticalAlignment="Center">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="{Binding SelectedAgreement.Name, StringFormat='{}Descuento: {0}'}" FontSize="12" FontWeight="Bold" Foreground="#B45309" Margin="0,0,6,0"/>
                                            <TextBlock Text="{Binding DiscountAmount, Converter={StaticResource CurrencyConv}, StringFormat='{}-{0}'}" FontSize="13" FontWeight="Black" Foreground="#B45309"/>
                                        </StackPanel>
                                    </Border>
                                </Grid>

                                <!-- Galería de Botones de Convenios -->
                                <ItemsControl ItemsSource="{Binding BranchAgreements}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <WrapPanel Orientation="Horizontal"/>
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Grid Margin="0,0,12,6">
                                                <!-- Botón Principal con Logo del Convenio -->
                                                <Button Command="{Binding DataContext.ToggleSelectAgreementCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                        CommandParameter="{Binding}"
                                                        Padding="0"
                                                        Cursor="Hand"
                                                        Height="50"
                                                        MinWidth="85">
                                                    <Button.Template>
                                                        <ControlTemplate TargetType="Button">
                                                            <Border x:Name="btnBorder"
                                                                    Background="#FFFFFF"
                                                                    BorderBrush="{DynamicResource BrushBorderMedium}"
                                                                    BorderThickness="1.5"
                                                                    CornerRadius="10"
                                                                    Padding="8,4"
                                                                    SnapsToDevicePixels="True">
                                                                <Grid>
                                                                    <Image Source="{Binding ImageUrl, Converter={StaticResource Base64ToImageConv}, TargetNullValue='/Resources/logo.jpeg', FallbackValue='/Resources/logo.jpeg'}"
                                                                           Stretch="Uniform"
                                                                           Height="36"
                                                                           RenderOptions.BitmapScalingMode="HighQuality"
                                                                           HorizontalAlignment="Center"
                                                                           VerticalAlignment="Center"/>
                                                                    <Path x:Name="selectedCheck"
                                                                          Data="{StaticResource IconCheck}"
                                                                          Fill="{DynamicResource BrushPrimary}"
                                                                          Width="14" Height="14"
                                                                          Stretch="Uniform"
                                                                          HorizontalAlignment="Left"
                                                                          VerticalAlignment="Top"
                                                                          Margin="0,0,0,0"
                                                                          Visibility="Collapsed"/>
                                                                </Grid>
                                                            </Border>
                                                            <ControlTemplate.Triggers>
                                                                <DataTrigger Value="True">
                                                                    <DataTrigger.Binding>
                                                                        <MultiBinding Converter="{StaticResource EqualityConv}">
                                                                            <Binding Path="AgreementId"/>
                                                                            <Binding Path="DataContext.SelectedAgreement.AgreementId" RelativeSource="{RelativeSource AncestorType=Window}"/>
                                                                        </MultiBinding>
                                                                    </DataTrigger.Binding>
                                                                    <Setter TargetName="btnBorder" Property="BorderBrush" Value="{DynamicResource BrushPrimary}"/>
                                                                    <Setter TargetName="btnBorder" Property="BorderThickness" Value="2.5"/>
                                                                    <Setter TargetName="btnBorder" Property="Background" Value="#EBF6F8"/>
                                                                    <Setter TargetName="selectedCheck" Property="Visibility" Value="Visible"/>
                                                                </DataTrigger>
                                                                <Trigger Property="IsMouseOver" Value="True">
                                                                    <Setter TargetName="btnBorder" Property="BorderBrush" Value="{DynamicResource BrushPrimary}"/>
                                                                </Trigger>
                                                            </ControlTemplate.Triggers>
                                                        </ControlTemplate>
                                                    </Button.Template>
                                                </Button>

                                                <!-- Botón Icono Ojo en la Esquina Superior Derecha -->
                                                <Button Command="{Binding DataContext.ShowAgreementDetailsCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                        CommandParameter="{Binding}"
                                                        ToolTip="Ver descripción y reglas del convenio"
                                                        HorizontalAlignment="Right"
                                                        VerticalAlignment="Top"
                                                        Margin="0,-5,-5,0"
                                                        Width="22"
                                                        Height="22"
                                                        Cursor="Hand"
                                                        Background="{DynamicResource BrushPrimary}"
                                                        BorderThickness="0">
                                                    <Button.Template>
                                                        <ControlTemplate TargetType="Button">
                                                            <Border Background="{TemplateBinding Background}" CornerRadius="11" SnapsToDevicePixels="True">
                                                                <Path Data="{StaticResource IconEye}" Fill="{DynamicResource BrushTextWhite}" Width="12" Height="12" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                            </Border>
                                                        </ControlTemplate>
                                                    </Button.Template>
                                                </Button>
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Border>

                        <!-- Fila Única: Método de Pago (Izquierda) y Resolución / Doc (Derecha) -->
                        <Grid Margin="0,0,0,16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="14"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <!-- Columna Izquierda: Método de Pago -->
                            <StackPanel Grid.Column="0">
                                <Grid Margin="0,0,0,6">
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <Path Data="{StaticResource IconCash}" Fill="{DynamicResource BrushPrimary}" Width="14" Height="14" Stretch="Uniform" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                        <TextBlock Text="MÉTODO DE PAGO *" FontSize="12" FontWeight="Bold" Foreground="{DynamicResource BrushTextMuted}" VerticalAlignment="Center"/>
                                    </StackPanel>

                                    <!-- Advertencia Roja si no se selecciona -->
                                    <Border HorizontalAlignment="Right"
                                            Background="#FEE2E2"
                                            BorderBrush="#EF4444"
                                            BorderThickness="1"
                                            CornerRadius="4"
                                            Padding="6,1"
                                            Visibility="{Binding ShowPaymentMethodWarning, Converter={StaticResource BoolToVis}}">
                                        <TextBlock Text="⚠️ Seleccione método" FontSize="11" FontWeight="Bold" Foreground="#DC2626"/>
                                    </Border>
                                </Grid>

                                <ComboBox ItemsSource="{Binding AvailablePaymentMethods}"
                                          SelectedItem="{Binding SelectedPaymentMethodEntity}"
                                          Style="{StaticResource ModernComboBox}"
                                          Height="44">
                                    <ComboBox.ItemTemplate>
                                        <DataTemplate>
                                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                <Path Data="{StaticResource IconCash}" Fill="{DynamicResource BrushPrimary}" Width="14" Height="14" Stretch="Uniform" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                                <TextBlock Text="{Binding Name}" FontWeight="Bold" FontSize="13" Foreground="{DynamicResource BrushTextPrimary}" VerticalAlignment="Center"/>
                                            </StackPanel>
                                        </DataTemplate>
                                    </ComboBox.ItemTemplate>
                                </ComboBox>
                            </StackPanel>

                            <!-- Columna Derecha: Resolución / Tipo de Documento -->
                            <StackPanel Grid.Column="2">
                                <Grid Margin="0,0,0,6">
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <Path Data="{StaticResource IconDocument}" Fill="{DynamicResource BrushPrimary}" Width="14" Height="14" Stretch="Uniform" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                        <TextBlock Text="RESOLUCIÓN / DOC *" FontSize="12" FontWeight="Bold" Foreground="{DynamicResource BrushTextMuted}" VerticalAlignment="Center"/>
                                    </StackPanel>

                                    <!-- Advertencia Roja si no se selecciona -->
                                    <Border HorizontalAlignment="Right"
                                            Background="#FEE2E2"
                                            BorderBrush="#EF4444"
                                            BorderThickness="1"
                                            CornerRadius="4"
                                            Padding="6,1"
                                            Visibility="{Binding ShowResolutionWarning, Converter={StaticResource BoolToVis}}">
                                        <TextBlock Text="⚠️ Seleccione resolución" FontSize="11" FontWeight="Bold" Foreground="#DC2626"/>
                                    </Border>
                                </Grid>

                                <ComboBox ItemsSource="{Binding AvailableResolutions}"
                                          SelectedItem="{Binding SelectedResolution}"
                                          Style="{StaticResource ModernComboBox}"
                                          Height="44">
                                    <ComboBox.ItemTemplate>
                                        <DataTemplate>
                                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                <Path Data="{StaticResource IconDocument}" Fill="{DynamicResource BrushPrimary}" Width="13" Height="13" Stretch="Uniform" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                                <TextBlock Text="{Binding Prefix}" FontWeight="Black" FontSize="13" Foreground="{DynamicResource BrushPrimary}" VerticalAlignment="Center"/>
                                            </StackPanel>
                                        </DataTemplate>
                                    </ComboBox.ItemTemplate>
                                </ComboBox>
                            </StackPanel>
                        </Grid>

                        <!-- Total Neto y Módulo de Caja Mejorado -->
                        <Border Background="#F8FAFC" BorderBrush="{DynamicResource BrushBorderMedium}" BorderThickness="1.5" CornerRadius="12" Padding="16" Margin="0,0,0,16">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <!-- Fila Superior: Total a Pagar e Input de Efectivo -->
                                <Grid Grid.Row="0" Margin="0,0,0,12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="1*"/>
                                        <ColumnDefinition Width="1.35*"/>
                                    </Grid.ColumnDefinitions>

                                    <!-- Total a Cobrar en Grande -->
                                    <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,14,0">
                                        <TextBlock Text="TOTAL NETO A PAGAR" FontSize="13" FontWeight="Black" Foreground="{DynamicResource BrushPrimary}"/>
                                        <TextBlock Text="{Binding CalculatedFee, Converter={StaticResource CurrencyConv}}" FontSize="34" FontWeight="Black" Foreground="{DynamicResource BrushPrimary}" Margin="0,2,0,0"/>
                                    </StackPanel>

                                    <!-- Input de Efectivo Recibido en Grande con Billetes Rápidos -->
                                    <StackPanel Grid.Column="1">
                                        <TextBlock Text="MONTO EN EFECTIVO RECIBIDO ($) *" FontSize="12" FontWeight="Bold" Foreground="{DynamicResource BrushTextMuted}" Margin="0,0,0,4"/>
                                        <TextBox Text="{Binding AmountTendered, UpdateSourceTrigger=PropertyChanged, StringFormat='{}{0:N0}'}"
                                                 IsEnabled="{Binding SelectedPaymentMethodEntity.RequiresCashTender, FallbackValue=True}"
                                                 Style="{StaticResource ModernTextBox}"
                                                 Height="48"
                                                 FontSize="26"
                                                 FontWeight="Black"
                                                 FontFamily="{StaticResource FontFamilyMonospace}"
                                                 HorizontalContentAlignment="Center"
                                                 VerticalContentAlignment="Center"
                                                 Margin="0,0,0,6"/>

                                        <!-- Botones de Billetes Rápidos -->
                                        <UniformGrid Columns="4" Rows="1">
                                            <Button Content="Exacto" Style="{StaticResource CashPresetButton}" Command="{Binding ExactCashCommand}" Background="#E0F2FE" Foreground="#0369A1" FontWeight="Black"/>
                                            <Button Content="$5K" Style="{StaticResource CashPresetButton}" Command="{Binding QuickCashCommand}" CommandParameter="5000"/>
                                            <Button Content="$10K" Style="{StaticResource CashPresetButton}" Command="{Binding QuickCashCommand}" CommandParameter="10000"/>
                                            <Button Content="$50K" Style="{StaticResource CashPresetButton}" Command="{Binding QuickCashCommand}" CommandParameter="50000"/>
                                        </UniformGrid>
                                    </StackPanel>
                                </Grid>

                                <!-- Fila Inferior: Tarjeta de CAMBIO / DEVUELTA en Grande -->
                                <Border Grid.Row="1" Background="#b2e5f3ff" BorderBrush="#36c8f1ff" BorderThickness="1.5" CornerRadius="10" Padding="14,8">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                            <TextBlock Text="CAMBIO / DEVUELTA AL CLIENTE" FontSize="13" FontWeight="Black" Foreground="#166534"/>
                                            <TextBlock Text="Entregar este valor al conductor" FontSize="12" Foreground="#15803D" Margin="0,1,0,0"/>
                                        </StackPanel>
                                        <TextBlock Grid.Column="1"
                                                   Text="{Binding ChangeDue, Converter={StaticResource CurrencyConv}}"
                                                   FontSize="28"
                                                   FontWeight="Black"
                                                   FontFamily="{StaticResource FontFamilyMonospace}"
                                                   Foreground="#15803D"
                                                   VerticalAlignment="Center"/>
                                    </Grid>
                                </Border>
                            </Grid>
                        </Border>

                        <!-- Campo de Observaciones / Novedades de Salida -->
                        <TextBlock Text="OBSERVACIONES / NOVEDADES DE SALIDA (OPCIONAL)" FontSize="12" FontWeight="Bold" Foreground="{DynamicResource BrushTextMuted}" Margin="0,0,0,4"/>
                        <TextBox Text="{Binding ExitNotes, UpdateSourceTrigger=PropertyChanged}"
                                 Height="44"
                                 TextWrapping="Wrap"
                                 Style="{StaticResource ModernTextBox}"
                                 Margin="0,0,0,12"/>
                    </StackPanel>
                </ScrollViewer>

                <!-- Pie de Página Estático con Botón de Pago Principal -->
                <Border Grid.Row="1"
                        BorderBrush="{DynamicResource BrushBorderSubtle}"
                        BorderThickness="0,1,0,0"
                        Padding="0,12,0,0"
                        Background="{DynamicResource BrushAppBackground}">
                    <Button Command="{Binding ProcessPaymentCommand}"
                            Style="{StaticResource ModernButton}"
                            Height="48"
                            FontSize="16">
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                            <Path Data="{StaticResource IconCheck}" Fill="{DynamicResource BrushTextWhite}" Width="16" Height="16" Stretch="Uniform" Margin="0,0,10,0"/>
                            <TextBlock Text="Cobrar y Registrar Salida" FontWeight="Bold" Foreground="{DynamicResource BrushTextWhite}"/>
                        </StackPanel>
                    </Button>
                </Border>
            </Grid>
        </Border>

        <!-- Pop-up Flotante de Información de Convenio (Auto-cierre en 6s, compacto y elegante) -->
        <Border Visibility="{Binding IsAgreementPopupOpen, Converter={StaticResource BoolToVis}}"
                Background="#FFFFFF"
                BorderBrush="{DynamicResource BrushPrimary}"
                BorderThickness="2"
                CornerRadius="12"
                Padding="16"
                Width="380"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Panel.ZIndex="999">
            <Border.Effect>
                <DropShadowEffect BlurRadius="25" ShadowDepth="4" Opacity="0.35" Color="#000000"/>
            </Border.Effect>
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Header del Pop-up -->
                <Grid Grid.Row="0" Margin="0,0,0,8">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Path Data="{StaticResource IconStore}" Fill="{DynamicResource BrushPrimary}" Width="15" Height="15" Stretch="Uniform" Margin="0,0,6,0"/>
                        <TextBlock Text="Detalles del Convenio" FontSize="14" FontWeight="Black" Foreground="{DynamicResource BrushPrimary}"/>
                    </StackPanel>
                    <Button HorizontalAlignment="Right"
                            Command="{Binding CloseAgreementPopupCommand}"
                            Style="{StaticResource SecondaryButton}"
                            Padding="2"
                            Width="24"
                            Height="24">
                        <Path Data="{StaticResource IconClose}" Fill="{DynamicResource BrushTextSecondary}" Width="9" Height="9" Stretch="Uniform"/>
                    </Button>
                </Grid>

                <!-- Cuerpo de Información -->
                <StackPanel Grid.Row="1" Margin="0,4,0,10">
                    <TextBlock Text="{Binding PopupAgreement.Name}" FontSize="15" FontWeight="Bold" Foreground="{DynamicResource BrushTextPrimary}" Margin="0,0,0,4"/>
                    <TextBlock Text="{Binding PopupAgreement.Store.Name, StringFormat='{}Comercio Asociado: {0}'}" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource BrushTextSecondary}" Margin="0,0,0,6"/>
                    <Border Background="#F1F5F9" CornerRadius="8" Padding="10,8" Margin="0,2,0,0">
                        <TextBlock Text="{Binding PopupDiscountSummary}" FontSize="12" FontWeight="Bold" Foreground="{DynamicResource BrushPrimary}" TextWrapping="Wrap"/>
                    </Border>
                </StackPanel>

                <!-- Pie con Notificación de Cierre Automático -->
                <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Center">
                    <TextBlock Text="⏱️ Este aviso se cerrará automáticamente en 6 segundos" FontSize="11" Foreground="{DynamicResource BrushTextMuted}"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
