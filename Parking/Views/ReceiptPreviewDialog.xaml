<Window x:Class="Parking.Views.ReceiptPreviewDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:conv="clr-namespace:Parking.Core.Converters"
        mc:Ignorable="d"
        Title="Vista Previa del Tiquete"
        MaxHeight="650"
        Width="490"
        SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Display"
        TextOptions.TextRenderingMode="ClearType">

    <Window.Resources>
        <conv:CurrencyConverter x:Key="CurrencyConv"/>
        <conv:VehicleTypeToStringConverter x:Key="VehicleTypeStrConv"/>
        <conv:BooleanToVisibilityConverter x:Key="BoolToVis"/>
        <conv:NullToVisibilityConverter x:Key="NullToVis"/>
    </Window.Resources>

    <Border Background="{DynamicResource BrushAppBackground}"
            BorderBrush="{DynamicResource BrushBorderMedium}"
            BorderThickness="1"
            CornerRadius="16"
            Padding="20"
            MaxHeight="640">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- 1. Header Area -->
            <Grid Grid.Row="0" Margin="0,0,0,12">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Path Data="{StaticResource IconReceipt}" Fill="{DynamicResource BrushPrimary}" Width="16" Height="16" Stretch="Uniform" Margin="0,0,8,0"/>
                    <TextBlock Text="Vista Previa de Tiquete Térmico" FontSize="14" FontWeight="Bold" Foreground="{DynamicResource BrushTextPrimary}"/>
                </StackPanel>
                <Button HorizontalAlignment="Right"
                        Command="{Binding CloseCommand}"
                        Style="{StaticResource SecondaryButton}"
                        Padding="4"
                        Width="26"
                        Height="26">
                    <Path Data="{StaticResource IconClose}" Fill="{DynamicResource BrushTextSecondary}" Width="10" Height="10" Stretch="Uniform"/>
                </Button>
            </Grid>

            <!-- 2. Thermal Ticket Paper Container -->
            <Border Grid.Row="1"
                    Background="{DynamicResource BrushSurfaceBackground}"
                    BorderBrush="{DynamicResource BrushBorderSubtle}"
                    BorderThickness="1"
                    CornerRadius="10"
                    Padding="14,12"
                    Margin="0,0,0,12"
                    MaxHeight="480">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel HorizontalAlignment="Stretch" Margin="4,0">
                        <StackPanel HorizontalAlignment="Center" Margin="0,0,0,8">
                            <TextBlock Text="PARKING FLOW" FontSize="15" FontWeight="Black" Foreground="{DynamicResource BrushTextPrimary}" HorizontalAlignment="Center"/>
                            <TextBlock Text="TU PUNTO DE LLEGADA" FontSize="9" FontWeight="Bold" Foreground="{DynamicResource BrushPrimary}" HorizontalAlignment="Center" Margin="0,1,0,0"/>
                            <TextBlock Text="Terminal 01 • Estación de Control" FontSize="10" Foreground="{DynamicResource BrushTextSecondary}" HorizontalAlignment="Center"/>
                        </StackPanel>

                        <Border Height="1" Background="{DynamicResource BrushBorderSubtle}" Margin="0,2,0,8"/>

                        <!-- Placa y Categoría -->
                        <Border Background="{DynamicResource BrushInputBackground}"
                                BorderBrush="{DynamicResource BrushBorderMedium}"
                                BorderThickness="1"
                                CornerRadius="8"
                                Padding="12,8"
                                Margin="0,0,0,10">
                            <StackPanel HorizontalAlignment="Center">
                                <TextBlock Text="PLACA DEL VEHÍCULO" FontSize="9" FontWeight="Bold" Foreground="{DynamicResource BrushTextMuted}" HorizontalAlignment="Center"/>
                                <TextBlock Text="{Binding Ticket.PlateNumber}" FontSize="22" FontWeight="Black" FontFamily="{StaticResource FontFamilyMonospace}" Foreground="{DynamicResource BrushTextPrimary}" HorizontalAlignment="Center"/>
                                <TextBlock Text="{Binding Ticket.VehicleType, Converter={StaticResource VehicleTypeStrConv}}" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource BrushCyan}" HorizontalAlignment="Center" Margin="0,2,0,0"/>
                            </StackPanel>
                        </Border>

                        <Grid Margin="0,0,0,6">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="Tiquete #:" Foreground="{DynamicResource BrushTextSecondary}" FontSize="11"/>
                            <TextBlock Grid.Column="1" Text="{Binding Ticket.TicketNumber}" Foreground="{DynamicResource BrushTextPrimary}" FontWeight="Bold" FontFamily="{StaticResource FontFamilyMonospace}" FontSize="11"/>
                        </Grid>

                        <Grid Margin="0,0,0,6">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="Fecha y Hora Ingreso:" Foreground="{DynamicResource BrushTextSecondary}" FontSize="11"/>
                            <TextBlock Grid.Column="1" Text="{Binding Ticket.EntryTime, StringFormat='{}{0:yyyy-MM-dd HH:mm:ss}'}" Foreground="{DynamicResource BrushTextPrimary}" FontWeight="SemiBold" FontSize="11"/>
                        </Grid>

                        <Grid Margin="0,0,0,6" Visibility="{Binding Ticket.ExitTime, Converter={StaticResource NullToVis}}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="Fecha y Hora Salida:" Foreground="{DynamicResource BrushTextSecondary}" FontSize="11"/>
                            <TextBlock Grid.Column="1" Text="{Binding Ticket.ExitTime, StringFormat='{}{0:yyyy-MM-dd HH:mm:ss}'}" Foreground="{DynamicResource BrushTextPrimary}" FontWeight="SemiBold" FontSize="11"/>
                        </Grid>

                        <Grid Margin="0,0,0,6" Visibility="{Binding Ticket.ExitTime, Converter={StaticResource NullToVis}}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="Duración Total:" Foreground="{DynamicResource BrushTextSecondary}" FontSize="11"/>
                            <TextBlock Grid.Column="1" Text="{Binding Ticket.FormattedDuration}" Foreground="{DynamicResource BrushTextPrimary}" FontWeight="Bold" FontSize="11"/>
                        </Grid>

                        <Grid Margin="0,0,0,6">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="Tarifa Base por Hora:" Foreground="{DynamicResource BrushTextSecondary}" FontSize="11"/>
                            <TextBlock Grid.Column="1" Text="{Binding Ticket.HourlyRate, Converter={StaticResource CurrencyConv}}" Foreground="{DynamicResource BrushTextPrimary}" FontWeight="SemiBold" FontSize="11"/>
                        </Grid>

                        <Grid Margin="0,0,0,6" Visibility="{Binding Ticket.ExitTime, Converter={StaticResource NullToVis}}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="Total Pagado:" Foreground="{DynamicResource BrushTextSecondary}" FontSize="12" FontWeight="Bold"/>
                            <TextBlock Grid.Column="1" Text="{Binding Ticket.TotalAmount, Converter={StaticResource CurrencyConv}}" Foreground="{DynamicResource BrushSuccess}" FontWeight="Black" FontSize="14"/>
                        </Grid>

                        <Grid Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="Operador en Turno:" Foreground="{DynamicResource BrushTextSecondary}" FontSize="11"/>
                            <TextBlock Grid.Column="1" Text="{Binding Ticket.OperatorName}" Foreground="{DynamicResource BrushTextPrimary}" FontWeight="SemiBold" FontSize="11"/>
                        </Grid>

                        <Border Height="1" Background="{DynamicResource BrushBorderSubtle}" Margin="0,2,0,10"/>

                        <!-- SECCIÓN EXCLUSIVA: CÓDIGO QR 2D CENTRADO (Para lectura con pistola de caja y consulta) -->
                        <Border Background="#FFFFFF"
                                BorderBrush="{DynamicResource BrushBorderMedium}"
                                BorderThickness="1.5"
                                CornerRadius="10"
                                Padding="16,12"
                                Margin="0,4,0,12"
                                HorizontalAlignment="Center">
                            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                <TextBlock Text="CÓDIGO DE ACCESO Y SALIDA (QR)"
                                           FontSize="10"
                                           FontWeight="Black"
                                           Foreground="{DynamicResource BrushPrimary}"
                                           HorizontalAlignment="Center"
                                           Margin="0,0,0,8"/>
                                <!-- QR Code Image de Alta Definición -->
                                <Image Source="{Binding QrCodeImage}"
                                       Width="140" Height="140"
                                       Stretch="Uniform"
                                       RenderOptions.BitmapScalingMode="NearestNeighbor"
                                       HorizontalAlignment="Center"
                                       Margin="0,0,0,8"/>
                                <TextBlock Text="{Binding Ticket.TicketNumber}"
                                           FontSize="13"
                                           FontWeight="Black"
                                           FontFamily="{StaticResource FontFamilyMonospace}"
                                           Foreground="#000000"
                                           HorizontalAlignment="Center"/>
                                <TextBlock Text="Escanee con lector de caja para liquidar y salida"
                                           FontSize="9"
                                           Foreground="#64748B"
                                           HorizontalAlignment="Center"
                                           Margin="0,3,0,0"/>
                            </StackPanel>
                        </Border>


                        <TextBlock Text="Conserve este tiquete para retirar su vehículo. En caso de pérdida se cobrará tarifa plena más reposición."
                                   FontSize="9"
                                   Foreground="{DynamicResource BrushTextMuted}"
                                   TextWrapping="Wrap"
                                   TextAlignment="Center"
                                   Margin="0,2,0,0"/>
                    </StackPanel>
                </ScrollViewer>
            </Border>

            <!-- 3. Bottom Action Buttons -->
            <Grid Grid.Row="2">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" Visibility="{Binding PrintSuccess, Converter={StaticResource BoolToVis}}">
                    <Path Data="{StaticResource IconCheck}" Fill="{DynamicResource BrushSuccess}" Width="14" Height="14" Stretch="Uniform" Margin="0,0,6,0"/>
                    <TextBlock Text="Tiquete enviado a impresión" Foreground="{DynamicResource BrushSuccess}" FontSize="11" VerticalAlignment="Center"/>
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Command="{Binding PrintTicketCommand}"
                            Style="{StaticResource ModernButton}"
                            Margin="0,0,8,0"
                            Padding="16,6">
                        <Button.ContentTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal">
                                    <Path Data="{StaticResource IconPrint}" Fill="{DynamicResource BrushTextWhite}" Width="13" Height="13" Stretch="Uniform" Margin="0,0,6,0"/>
                                    <TextBlock Text="Imprimir Tiquete" Foreground="{DynamicResource BrushTextWhite}" FontWeight="Bold" FontSize="12" VerticalAlignment="Center"/>
                                </StackPanel>
                            </DataTemplate>
                        </Button.ContentTemplate>
                    </Button>
                    <Button Content="Cerrar"
                            Command="{Binding CloseCommand}"
                            Style="{StaticResource SecondaryButton}"
                            Padding="16,6"
                            FontSize="12"/>
                </StackPanel>
            </Grid>
        </Grid>
    </Border>
</Window>
