<Window x:Class="Parking.Views.AppUpdateDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="Actualización del Sistema - ParkFlow"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="#B3000000"
        ShowInTaskbar="False"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        Width="640" Height="560">

    <Grid Background="Transparent">
        <Border HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Margin="20"
                Background="{DynamicResource BrushSurfaceBackground}"
                BorderBrush="{DynamicResource BrushBorderMedium}"
                BorderThickness="1"
                CornerRadius="18"
                Padding="28"
                Width="580"
                SnapsToDevicePixels="True">
            <Border.Effect>
                <DropShadowEffect BlurRadius="30" ShadowDepth="8" Direction="270" Opacity="0.25" Color="#1E2A2F"/>
            </Border.Effect>

            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Encabezado -->
                <Grid Grid.Row="0" Margin="0,0,0,16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0"
                            Width="48"
                            Height="48"
                            CornerRadius="24"
                            Background="{DynamicResource BrushPrimaryLight}"
                            Margin="0,0,16,0"
                            VerticalAlignment="Center">
                        <Path Data="{StaticResource IconDownload}"
                              Fill="{DynamicResource BrushPrimary}"
                              Width="22"
                              Height="22"
                              Stretch="Uniform"
                              HorizontalAlignment="Center"
                              VerticalAlignment="Center"/>
                    </Border>

                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="Actualización Disponible"
                                       FontSize="20"
                                       FontWeight="Bold"
                                       Foreground="{DynamicResource BrushTextPrimary}"
                                       VerticalAlignment="Center"/>
                            <Border Margin="12,0,0,0"
                                    Padding="8,3"
                                    CornerRadius="6"
                                    Background="{DynamicResource BrushPrimaryLight}"
                                    VerticalAlignment="Center">
                                <TextBlock Text="{Binding ReleaseInfo.LatestVersion, StringFormat='v{0}'}"
                                           FontSize="12"
                                           FontWeight="Bold"
                                           Foreground="{DynamicResource BrushPrimary}"/>
                            </Border>
                        </StackPanel>
                        <TextBlock Text="{Binding StatusMessage}"
                                   FontSize="13"
                                   Foreground="{DynamicResource BrushTextSecondary}"
                                   TextWrapping="Wrap"
                                   Margin="0,4,0,0"/>
                    </StackPanel>
                </Grid>

                <!-- Aviso de Obligatoriedad o Seguridad -->
                <Border Grid.Row="1"
                        Background="{DynamicResource BrushSurfaceBackgroundLight}"
                        BorderBrush="{DynamicResource BrushBorderSubtle}"
                        BorderThickness="1"
                        CornerRadius="10"
                        Padding="14,10"
                        Margin="0,0,0,16">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Path Grid.Column="0"
                              Data="{StaticResource IconShield}"
                              Fill="{DynamicResource BrushSuccess}"
                              Width="18"
                              Height="18"
                              Stretch="Uniform"
                              Margin="0,0,10,0"
                              VerticalAlignment="Center"/>
                        <TextBlock Grid.Column="1"
                                   Text="Protección activa: Su base de datos local y transacciones se respaldan de forma preventiva antes de aplicar la actualización."
                                   FontSize="12"
                                   Foreground="{DynamicResource BrushTextSecondary}"
                                   TextWrapping="Wrap"/>
                    </Grid>
                </Border>

                <!-- Notas de la Versión -->
                <Border Grid.Row="2"
                        Background="{DynamicResource BrushSurfaceBackgroundLight}"
                        BorderBrush="{DynamicResource BrushBorderSubtle}"
                        BorderThickness="1"
                        CornerRadius="12"
                        Padding="16"
                        Margin="0,0,0,16">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0"
                                   Text="Novedades y Mejoras:"
                                   FontSize="13"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource BrushTextPrimary}"
                                   Margin="0,0,0,8"/>

                        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                            <TextBlock Text="{Binding ReleaseInfo.ReleaseNotes}"
                                       FontSize="12"
                                       Foreground="{DynamicResource BrushTextSecondary}"
                                       TextWrapping="Wrap"
                                       LineHeight="18"/>
                        </ScrollViewer>
                    </Grid>
                </Border>

                <!-- Barra de Progreso durante la Actualización -->
                <StackPanel Grid.Row="3" Margin="0,0,0,20" Visibility="{Binding IsUpdating, Converter={StaticResource BoolToVis}}">
                    <Grid Margin="0,0,0,6">
                        <TextBlock Text="{Binding StatusMessage}"
                                   FontSize="12"
                                   Foreground="{DynamicResource BrushTextSecondary}"/>
                        <TextBlock Text="{Binding ProgressPercentage, StringFormat='{}{0}%'}"
                                   FontSize="12"
                                   FontWeight="Bold"
                                   Foreground="{DynamicResource BrushPrimary}"
                                   HorizontalAlignment="Right"/>
                    </Grid>
                    <ProgressBar Height="8"
                                 Value="{Binding ProgressPercentage}"
                                 Minimum="0"
                                 Maximum="100"
                                 Foreground="{DynamicResource BrushPrimary}"
                                 Background="{DynamicResource BrushSurfaceBackgroundLight}"/>
                </StackPanel>

                <!-- Mensaje de Error si falla -->
                <Border Grid.Row="3"
                        Background="#2B1D20"
                        BorderBrush="#EF4444"
                        BorderThickness="1"
                        CornerRadius="8"
                        Padding="12,10"
                        Margin="0,0,0,16"
                        Visibility="{Binding ErrorMessage, Converter={StaticResource NullToVis}}">
                    <StackPanel Orientation="Horizontal">
                        <Path Data="{StaticResource IconAlertTriangle}"
                              Fill="#EF4444"
                              Width="16"
                              Height="16"
                              Stretch="Uniform"
                              Margin="0,0,8,0"
                              VerticalAlignment="Center"/>
                        <TextBlock Text="{Binding ErrorMessage}"
                                   Foreground="#EF4444"
                                   FontSize="12"
                                   TextWrapping="Wrap"/>
                    </StackPanel>
                </Border>

                <!-- Botones de Acción -->
                <Grid Grid.Row="4">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <Button Grid.Column="0"
                            Style="{StaticResource SecondaryButton}"
                            Content="Posponer"
                            Height="42"
                            Margin="0,0,12,0"
                            Visibility="{Binding CanCancel, Converter={StaticResource BoolToVis}}"
                            Command="{Binding CancelCommand}"/>

                    <Button Grid.Column="1"
                            Style="{StaticResource ModernButton}"
                            Content="Actualizar Ahora"
                            Height="42"
                            MinWidth="200"
                            Command="{Binding StartUpdateCommand}"/>
                </Grid>
            </Grid>
        </Border>
    </Grid>
</Window>
