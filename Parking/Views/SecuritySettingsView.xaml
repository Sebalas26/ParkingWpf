<UserControl x:Class="Parking.Views.SecuritySettingsView"
              xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
              xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
              xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
              xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
              xmlns:conv="clr-namespace:Parking.Core.Converters"
              mc:Ignorable="d"
              d:DesignHeight="750" d:DesignWidth="1050">

    <UserControl.Resources>
        <conv:BooleanToVisibilityConverter x:Key="BoolToVis"/>
    </UserControl.Resources>

    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,16">
            <TextBlock Text="Usuarios, Roles y Matriz de Permisos" Style="{StaticResource TextHeaderMedium}"/>
            <TextBlock Text="Administre el acceso, usuarios del sistema y configure permisos granulares por módulo y acción" Style="{StaticResource TextBodySecondary}" Margin="0,4,0,0"/>
        </StackPanel>

        <TabControl Grid.Row="1" Background="Transparent" BorderThickness="0">
            <TabControl.Resources>
                <Style TargetType="TabItem">
                    <Setter Property="Background" Value="Transparent"/>
                    <Setter Property="Foreground" Value="{DynamicResource BrushTextSecondary}"/>
                    <Setter Property="FontSize" Value="14"/>
                    <Setter Property="FontWeight" Value="SemiBold"/>
                    <Setter Property="Padding" Value="16,10"/>
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="TabItem">
                                <Border x:Name="TabBorder"
                                        Background="{TemplateBinding Background}"
                                        BorderBrush="Transparent"
                                        BorderThickness="0,0,0,3"
                                        Padding="{TemplateBinding Padding}"
                                        Margin="0,0,8,12"
                                        Cursor="Hand">
                                    <ContentPresenter ContentSource="Header" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsSelected" Value="True">
                                        <Setter TargetName="TabBorder" Property="BorderBrush" Value="{DynamicResource BrushPrimary}"/>
                                        <Setter Property="Foreground" Value="{DynamicResource BrushPrimary}"/>
                                        <Setter Property="FontWeight" Value="Bold"/>
                                    </Trigger>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter Property="Foreground" Value="{DynamicResource BrushPrimary}"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Style>
            </TabControl.Resources>

            <TabItem Header="Gestión de Usuarios">
                <Grid Margin="0,12,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="1*"/>
                        <ColumnDefinition Width="1.5*"/>
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0" Style="{StaticResource ModernCard}" Margin="0,0,16,0">
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <StackPanel>
                                <TextBlock Text="DATOS DEL USUARIO" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource BrushTextMuted}" Margin="0,0,0,16"/>

                                <StackPanel Margin="0,0,0,14">
                                    <TextBlock Text="Nombre Completo *" Style="{StaticResource TextBodySecondary}" Margin="0,0,0,6"/>
                                    <TextBox Text="{Binding FullName, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource ModernTextBox}"/>
                                </StackPanel>

                                <StackPanel Margin="0,0,0,14">
                                    <TextBlock Text="Nombre de Usuario (Login) *" Style="{StaticResource TextBodySecondary}" Margin="0,0,0,6"/>
                                    <TextBox Text="{Binding Username, UpdateSourceTrigger=PropertyChanged}"
                                             IsEnabled="{Binding IsEditingUser, Converter={StaticResource BoolToVis}, ConverterParameter=Inverse, FallbackValue=True}"
                                             Style="{StaticResource ModernTextBox}"/>
                                </StackPanel>

                                <StackPanel Margin="0,0,0,14">
                                    <TextBlock Text="Contraseña *" Style="{StaticResource TextBodySecondary}" Margin="0,0,0,6"/>
                                    <TextBox Text="{Binding Password, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource ModernTextBox}"/>
                                    <TextBlock Text="Deje vacío para mantener contraseña actual al editar" FontSize="10" Foreground="{DynamicResource BrushTextMuted}" Margin="0,4,0,0" Visibility="{Binding IsEditingUser, Converter={StaticResource BoolToVis}}"/>
                                </StackPanel>

                                <StackPanel Margin="0,0,0,14">
                                    <TextBlock Text="Correo Electrónico (Opcional)" Style="{StaticResource TextBodySecondary}" Margin="0,0,0,6"/>
                                    <TextBox Text="{Binding Email, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource ModernTextBox}"/>
                                </StackPanel>

                                <StackPanel Margin="0,0,0,14">
                                    <TextBlock Text="Rol Asignado *" Style="{StaticResource TextBodySecondary}" Margin="0,0,0,6"/>
                                    <ComboBox ItemsSource="{Binding Roles}"
                                              SelectedItem="{Binding SelectedRole}"
                                              DisplayMemberPath="Name"
                                              Style="{StaticResource ModernComboBox}"/>
                                </StackPanel>

                                <CheckBox Content="Usuario Habilitado / Activo"
                                          IsChecked="{Binding IsUserActive}"
                                          Foreground="{DynamicResource BrushTextPrimary}"
                                          FontSize="13"
                                          Margin="0,6,0,20"/>

                                <Border Visibility="{Binding HasFeedback, Converter={StaticResource BoolToVis}}"
                                        CornerRadius="8"
                                        Padding="12"
                                        Margin="0,0,0,16">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Setter Property="Background" Value="{DynamicResource BrushSuccessBg}"/>
                                            <Setter Property="BorderBrush" Value="{DynamicResource BrushSuccess}"/>
                                            <Setter Property="BorderThickness" Value="1"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsSuccessFeedback}" Value="False">
                                                    <Setter Property="Background" Value="{DynamicResource BrushDangerBg}"/>
                                                    <Setter Property="BorderBrush" Value="{DynamicResource BrushDanger}"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <TextBlock Text="{Binding FeedbackMessage}" FontSize="12" TextWrapping="Wrap">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Foreground" Value="{DynamicResource BrushSuccess}"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsSuccessFeedback}" Value="False">
                                                        <Setter Property="Foreground" Value="{DynamicResource BrushDanger}"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </Border>

                                <Button Command="{Binding SaveUserCommand}"
                                        Style="{StaticResource ModernButton}"
                                        Height="44"
                                        Margin="0,0,0,10">
                                    <Button.ContentTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="Guardar Usuario" Foreground="{DynamicResource BrushTextWhite}" FontWeight="Bold"/>
                                        </DataTemplate>
                                    </Button.ContentTemplate>
                                </Button>

                                <Button Content="Limpiar Formulario"
                                        Command="{Binding ClearUserFormCommand}"
                                        Style="{StaticResource SecondaryButton}"
                                        Height="38"/>
                            </StackPanel>
                        </ScrollViewer>
                    </Border>

                    <Border Grid.Column="1" Style="{StaticResource ModernCard}">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>

                            <TextBlock Grid.Row="0" Text="USUARIOS REGISTRADOS" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource BrushTextMuted}" Margin="0,0,0,14"/>

                            <DataGrid Grid.Row="1"
                                      ItemsSource="{Binding Users}"
                                      SelectedItem="{Binding SelectedUser}"
                                      Style="{StaticResource ModernDataGrid}">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="NOMBRE COMPLETO" Binding="{Binding FullName}" Width="1.5*"/>
                                    <DataGridTextColumn Header="USUARIO" Binding="{Binding Username}" Width="*"/>
                                    <DataGridTextColumn Header="ROL" Binding="{Binding Role.Name}" Width="1.2*"/>
                                    <DataGridTemplateColumn Header="ESTADO" Width="Auto">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <Border CornerRadius="4" Padding="8,3" HorizontalAlignment="Center">
                                                    <Border.Style>
                                                        <Style TargetType="Border">
                                                            <Setter Property="Background" Value="{DynamicResource BrushSuccessBg}"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsActive}" Value="False">
                                                                    <Setter Property="Background" Value="{DynamicResource BrushDangerBg}"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Border.Style>
                                                    <TextBlock FontSize="11" FontWeight="Bold">
                                                        <TextBlock.Style>
                                                            <Style TargetType="TextBlock">
                                                                <Setter Property="Text" Value="ACTIVO"/>
                                                                <Setter Property="Foreground" Value="{DynamicResource BrushSuccess}"/>
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding IsActive}" Value="False">
                                                                        <Setter Property="Text" Value="INACTIVO"/>
                                                                        <Setter Property="Foreground" Value="{DynamicResource BrushDanger}"/>
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </TextBlock.Style>
                                                    </TextBlock>
                                                </Border>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                </DataGrid.Columns>
                            </DataGrid>
                        </Grid>
                    </Border>
                </Grid>
            </TabItem>

            <TabItem Header="Roles y Matriz de Permisos">
                <Grid Margin="0,12,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="1*"/>
                        <ColumnDefinition Width="1.8*"/>
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0" Style="{StaticResource ModernCard}" Margin="0,0,16,0">
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <StackPanel>
                                <TextBlock Text="SELECCIONAR ROL A CONFIGURAR" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource BrushTextMuted}" Margin="0,0,0,12"/>

                                <ComboBox ItemsSource="{Binding Roles}"
                                          SelectedItem="{Binding SelectedRoleForMatrix}"
                                          DisplayMemberPath="Name"
                                          Style="{StaticResource ModernComboBox}"
                                          Margin="0,0,0,20"/>

                                <Border Height="1" Background="{DynamicResource BrushBorderSubtle}" Margin="0,0,0,20"/>

                                <TextBlock Text="CREAR NUEVO ROL PERSONALIZADO" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource BrushTextMuted}" Margin="0,0,0,14"/>

                                <StackPanel Margin="0,0,0,14">
                                    <TextBlock Text="Nombre del Rol *" Style="{StaticResource TextBodySecondary}" Margin="0,0,0,6"/>
                                    <TextBox Text="{Binding NewRoleName, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource ModernTextBox}"/>
                                </StackPanel>

                                <StackPanel Margin="0,0,0,20">
                                    <TextBlock Text="Descripción (Opcional)" Style="{StaticResource TextBodySecondary}" Margin="0,0,0,6"/>
                                    <TextBox Text="{Binding NewRoleDescription, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource ModernTextBox}"/>
                                </StackPanel>

                                <Button Content="Crear Rol"
                                        Command="{Binding CreateRoleCommand}"
                                        Style="{StaticResource SecondaryButton}"
                                        Height="40"/>
                            </StackPanel>
                        </ScrollViewer>
                    </Border>

                    <Border Grid.Column="1" Style="{StaticResource ModernCard}">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <Grid Grid.Row="0" Margin="0,0,0,14">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBlock Text="MATRIZ DE ACCIONES PERMITIDAS PARA: " FontSize="11" FontWeight="Bold" Foreground="{DynamicResource BrushTextMuted}"/>
                                    <TextBlock Text="{Binding SelectedRoleForMatrix.Name}" FontSize="12" FontWeight="Black" Foreground="{DynamicResource BrushPrimary}"/>
                                </StackPanel>
                            </Grid>

                            <DataGrid Grid.Row="1"
                                      ItemsSource="{Binding PermissionsMatrix}"
                                      Style="{StaticResource ModernDataGrid}">
                                <DataGrid.Columns>
                                    <DataGridTemplateColumn Header="CONCEDIDO" Width="Auto">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <CheckBox IsChecked="{Binding IsGranted, UpdateSourceTrigger=PropertyChanged}"
                                                          HorizontalAlignment="Center"
                                                          VerticalAlignment="Center"/>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                    <DataGridTextColumn Header="MÓDULO" Binding="{Binding ModuleDisplayName}" FontWeight="Bold" Width="1.2*"/>
                                    <DataGridTextColumn Header="ACCIÓN PERMITIDA" Binding="{Binding ActionDisplayName}" Width="1.5*"/>
                                    <DataGridTextColumn Header="DESCRIPCIÓN DE ACCIÓN" Binding="{Binding Description}" Width="1.8*"/>
                                </DataGrid.Columns>
                            </DataGrid>

                            <Button Grid.Row="2"
                                    Command="{Binding SaveRolePermissionsCommand}"
                                    Style="{StaticResource ModernButton}"
                                    Height="44"
                                    Margin="0,16,0,0">
                                <Button.ContentTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="Guardar Matriz de Permisos del Rol" Foreground="{DynamicResource BrushTextWhite}" FontWeight="Bold"/>
                                    </DataTemplate>
                                </Button.ContentTemplate>
                            </Button>
                        </Grid>
                    </Border>
                </Grid>
            </TabItem>
        </TabControl>
    </Grid>
</UserControl>
