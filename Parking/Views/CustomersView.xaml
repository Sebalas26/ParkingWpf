<UserControl x:Class="Parking.Views.CustomersView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:conv="clr-namespace:Parking.Core.Converters"
             mc:Ignorable="d"
             d:DesignHeight="850" d:DesignWidth="1180">

    <UserControl.Resources>
        <conv:BooleanToVisibilityConverter x:Key="BoolToVis"/>
        <conv:NullToVisibilityConverter x:Key="NullToVis"/>
    </UserControl.Resources>

    <Grid Margin="24">
        <!-- Main Content Card -->
        <Border Style="{StaticResource ModernCard}" Padding="24">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- 1. Header -->
                <Grid Grid.Row="0" Margin="0,0,0,18">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0">
                        <TextBlock Text="Directorio de Clientes de Facturación Electrónica" FontSize="20" FontWeight="Bold" Foreground="{DynamicResource BrushTextPrimary}"/>
                        <TextBlock Text="Gestión centralizada de adquirentes y terceros fiscales para emisión de comprobantes DIAN" FontSize="12" Foreground="{DynamicResource BrushTextMuted}" Margin="0,4,0,0"/>
                    </StackPanel>

                    <Border Grid.Column="1" Background="#E0F2FE" CornerRadius="12" Padding="14,6" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal">
                            <Ellipse Width="8" Height="8" Fill="{DynamicResource BrushPrimary}" Margin="0,0,8,0" VerticalAlignment="Center"/>
                            <TextBlock Text="{Binding TotalCustomersCount, StringFormat='{}{0} Clientes Registrados'}"
                                       FontSize="12"
                                       FontWeight="Bold"
                                       Foreground="{DynamicResource BrushPrimary}"
                                       VerticalAlignment="Center"/>
                        </StackPanel>
                    </Border>
                </Grid>

                <!-- 2. Search & Action Toolbar -->
                <Grid Grid.Row="1" Margin="0,0,0,18">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="380"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <!-- Search Input with Magnifier -->
                    <Border Grid.Column="0"
                            Background="{DynamicResource BrushInputBackground}"
                            BorderBrush="{DynamicResource BrushBorderSubtle}"
                            BorderThickness="1.5"
                            CornerRadius="20"
                            Padding="12,4">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <Path Grid.Column="0"
                                  Data="{StaticResource IconSearch}"
                                  Fill="{DynamicResource BrushTextSecondary}"
                                  Width="14" Height="14"
                                  Stretch="Uniform"
                                  Margin="2,0,8,0"
                                  VerticalAlignment="Center"/>

                            <TextBox Grid.Column="1"
                                     Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                                     BorderThickness="0"
                                     Background="Transparent"
                                     FontSize="13"
                                     FontWeight="SemiBold"
                                     Foreground="{DynamicResource BrushTextPrimary}"
                                     CaretBrush="{DynamicResource BrushPrimary}"
                                     VerticalContentAlignment="Center"
                                     Padding="0,4"/>

                            <TextBlock Grid.Column="1"
                                       Text="Buscar por documento, nombre o email..."
                                       IsHitTestVisible="False"
                                       Foreground="{DynamicResource BrushTextMuted}"
                                       FontSize="13"
                                       VerticalAlignment="Center"
                                       Margin="2,0,0,0"
                                       Visibility="{Binding HasSearchText, Converter={StaticResource BoolToVis}, ConverterParameter=Invert}"/>

                            <Button Grid.Column="2"
                                    Command="{Binding ClearSearchCommand}"
                                    Visibility="{Binding HasSearchText, Converter={StaticResource BoolToVis}}"
                                    Style="{StaticResource SecondaryButton}"
                                    Padding="3"
                                    Width="20" Height="20"
                                    Margin="4,0,0,0"
                                    VerticalAlignment="Center"
                                    ToolTip="Limpiar búsqueda">
                                <Path Data="{StaticResource IconClose}"
                                      Fill="{DynamicResource BrushTextSecondary}"
                                      Width="9" Height="9"
                                      Stretch="Uniform"/>
                            </Button>
                        </Grid>
                    </Border>

                    <!-- Action Buttons -->
                    <StackPanel Grid.Column="2" Orientation="Horizontal">
                        <Button Command="{Binding LoadCustomersCommand}"
                                Style="{StaticResource SecondaryButton}"
                                Padding="14,8"
                                Margin="0,0,10,0">
                            <StackPanel Orientation="Horizontal">
                                <Path Data="{StaticResource IconRefresh}" Fill="{DynamicResource BrushTextPrimary}" Width="13" Height="13" Stretch="Uniform" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                <TextBlock Text="Actualizar" FontWeight="SemiBold" FontSize="12" Foreground="{DynamicResource BrushTextPrimary}" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>

                        <Button Command="{Binding OpenCreateCustomerCommand}"
                                Style="{StaticResource ModernButton}"
                                Padding="16,8">
                            <StackPanel Orientation="Horizontal">
                                <Path Data="{StaticResource IconPlus}" Fill="{DynamicResource BrushTextWhite}" Width="13" Height="13" Stretch="Uniform" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                <TextBlock Text="Nuevo Cliente" FontWeight="Bold" FontSize="12" Foreground="{DynamicResource BrushTextWhite}" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </Grid>

                <!-- 3. Customers DataGrid -->
                <DataGrid Grid.Row="2"
                          ItemsSource="{Binding Customers}"
                          SelectedItem="{Binding SelectedCustomer}"
                          Style="{StaticResource ModernDataGrid}"
                          IsReadOnly="True"
                          CanUserResizeColumns="True"
                          HorizontalScrollBarVisibility="Auto">
                    <DataGrid.Columns>
                        <!-- Documento / NIT -->
                        <DataGridTemplateColumn Header="DOCUMENTO" MinWidth="130" Width="1.2*">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel VerticalAlignment="Center">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="{Binding DocumentNumber}"
                                                       FontFamily="{StaticResource FontFamilyMonospace}"
                                                       FontWeight="Black"
                                                       FontSize="13.5"
                                                       Foreground="{DynamicResource BrushTextPrimary}"/>
                                            <TextBlock Text="{Binding CheckDigit, StringFormat='-{0}'}"
                                                       FontFamily="{StaticResource FontFamilyMonospace}"
                                                       FontWeight="Bold"
                                                       FontSize="13.5"
                                                       Foreground="{DynamicResource BrushPrimary}"
                                                       Visibility="{Binding CheckDigit, Converter={StaticResource NullToVis}}"/>
                                        </StackPanel>
                                        <TextBlock Text="{Binding PersonType}"
                                                   FontSize="10.5"
                                                   FontWeight="SemiBold"
                                                   Foreground="{DynamicResource BrushTextMuted}"/>
                                    </StackPanel>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <!-- Nombre Completo / Razón Social -->
                        <DataGridTemplateColumn Header="NOMBRE / RAZÓN SOCIAL" MinWidth="220" Width="2.5*">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock Text="{Binding FullName}"
                                                   FontWeight="Bold"
                                                   FontSize="13"
                                                   Foreground="{DynamicResource BrushTextPrimary}"
                                                   TextTrimming="CharacterEllipsis"/>
                                        <TextBlock Text="{Binding TradeName}"
                                                   FontSize="11"
                                                   Foreground="{DynamicResource BrushTextSecondary}"
                                                   TextTrimming="CharacterEllipsis"
                                                   Visibility="{Binding TradeName, Converter={StaticResource NullToVis}}"/>
                                    </StackPanel>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <!-- Correo Electrónico -->
                        <DataGridTemplateColumn Header="CORREO DIAN" MinWidth="180" Width="2*">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding Email}"
                                               FontSize="12.5"
                                               FontWeight="SemiBold"
                                               Foreground="{DynamicResource BrushTextPrimary}"
                                               VerticalAlignment="Center"
                                               TextTrimming="CharacterEllipsis"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <!-- Teléfono -->
                        <DataGridTextColumn Header="TELÉFONO" Binding="{Binding Phone}" MinWidth="120" Width="1.2*"/>

                        <!-- Dirección / Ubicación -->
                        <DataGridTemplateColumn Header="DIRECCIÓN / CIUDAD" MinWidth="160" Width="1.8*">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Address}"
                                                   FontSize="12"
                                                   Foreground="{DynamicResource BrushTextPrimary}"
                                                   TextTrimming="CharacterEllipsis"/>
                                        <TextBlock Text="{Binding CityCode}"
                                                   FontSize="10.5"
                                                   Foreground="{DynamicResource BrushTextMuted}"/>
                                    </StackPanel>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <!-- Acciones -->
                        <DataGridTemplateColumn Header="ACCIONES" MinWidth="170" Width="Auto">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <Button Command="{Binding DataContext.OpenEditCustomerCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                CommandParameter="{Binding}"
                                                Style="{StaticResource SecondaryButton}"
                                                Padding="10,5"
                                                Margin="0,0,6,0">
                                            <StackPanel Orientation="Horizontal">
                                                <Path Data="{StaticResource IconSettings}" Fill="{DynamicResource BrushPrimary}" Width="12" Height="12" Stretch="Uniform" Margin="0,0,4,0" VerticalAlignment="Center"/>
                                                <TextBlock Text="Editar" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource BrushPrimary}" VerticalAlignment="Center"/>
                                            </StackPanel>
                                        </Button>

                                        <Button Command="{Binding DataContext.DeleteCustomerCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                CommandParameter="{Binding}"
                                                Style="{StaticResource DangerButton}"
                                                Padding="8,5">
                                            <Path Data="{StaticResource IconClose}" Fill="{DynamicResource BrushTextWhite}" Width="10" Height="10" Stretch="Uniform" VerticalAlignment="Center"/>
                                        </Button>
                                    </StackPanel>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>
            </Grid>
        </Border>

        <!-- Modal Overlay for Create / Edit Customer -->
        <Grid Visibility="{Binding IsFormOpen, Converter={StaticResource BoolToVis}}"
              Background="#99000000">
            <Border HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Width="640"
                    MaxHeight="720"
                    Background="{DynamicResource BrushSurfaceBackground}"
                    BorderBrush="{DynamicResource BrushBorderMedium}"
                    BorderThickness="1"
                    CornerRadius="18"
                    Padding="26">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="32" ShadowDepth="10" Direction="270" Opacity="0.3" Color="#1E2A2F"/>
                </Border.Effect>

                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <!-- Modal Title -->
                        <Grid Margin="0,0,0,16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0">
                                <TextBlock Text="Datos Fiscales del Cliente" FontSize="18" FontWeight="Bold" Foreground="{DynamicResource BrushTextPrimary}"/>
                                <TextBlock Text="Configure los campos exigidos por la DIAN para emisión válida de factura electrónica" FontSize="12" Foreground="{DynamicResource BrushTextMuted}" Margin="0,2,0,0"/>
                            </StackPanel>

                            <Button Grid.Column="1"
                                    Command="{Binding CloseFormCommand}"
                                    Style="{StaticResource SecondaryButton}"
                                    Width="30" Height="30"
                                    Padding="0">
                                <Path Data="{StaticResource IconClose}" Fill="{DynamicResource BrushTextSecondary}" Width="11" Height="11" Stretch="Uniform"/>
                            </Button>
                        </Grid>

                        <!-- Row 1: Tipo Documento + Número + DV -->
                        <Grid Margin="0,0,0,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="1.5*"/>
                                <ColumnDefinition Width="2*"/>
                                <ColumnDefinition Width="0.6*"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0" Margin="0,0,10,0">
                                <TextBlock Text="Tipo Documento *" FontSize="11.5" FontWeight="Bold" Foreground="{DynamicResource BrushTextSecondary}" Margin="0,0,0,4"/>
                                <ComboBox ItemsSource="{Binding IdentificationTypes}"
                                          SelectedValue="{Binding FormIdentificationTypeId}"
                                          SelectedValuePath="Id"
                                          DisplayMemberPath="Name"
                                          Height="36"/>
                            </StackPanel>

                            <StackPanel Grid.Column="1" Margin="0,0,10,0">
                                <TextBlock Text="Número Documento *" FontSize="11.5" FontWeight="Bold" Foreground="{DynamicResource BrushTextSecondary}" Margin="0,0,0,4"/>
                                <TextBox Text="{Binding FormDocumentNumber, UpdateSourceTrigger=PropertyChanged}"
                                         Height="36"
                                         Padding="10,6"
                                         Background="{DynamicResource BrushInputBackground}"
                                         BorderBrush="{DynamicResource BrushBorderSubtle}"
                                         Foreground="{DynamicResource BrushTextPrimary}"/>
                                <TextBlock Text="{Binding FormDocumentError}"
                                           FontSize="11"
                                           Foreground="{DynamicResource BrushDanger}"
                                           Margin="0,2,0,0"
                                           Visibility="{Binding FormDocumentError, Converter={StaticResource NullToVis}}"/>
                            </StackPanel>

                            <StackPanel Grid.Column="2">
                                <TextBlock Text="DV" FontSize="11.5" FontWeight="Bold" Foreground="{DynamicResource BrushTextSecondary}" Margin="0,0,0,4"/>
                                <TextBox Text="{Binding FormCheckDigit, UpdateSourceTrigger=PropertyChanged}"
                                         IsEnabled="{Binding IsNitSelected}"
                                         MaxLength="1"
                                         Height="36"
                                         HorizontalContentAlignment="Center"
                                         FontWeight="Bold"
                                         Background="{DynamicResource BrushInputBackground}"
                                         BorderBrush="{DynamicResource BrushBorderSubtle}"
                                         Foreground="{DynamicResource BrushTextPrimary}"/>
                            </StackPanel>
                        </Grid>

                        <!-- Row 2: Nombre o Razón Social -->
                        <StackPanel Margin="0,0,0,12">
                            <TextBlock Text="Nombre o Razón Social *" FontSize="11.5" FontWeight="Bold" Foreground="{DynamicResource BrushTextSecondary}" Margin="0,0,0,4"/>
                            <TextBox Text="{Binding FormFullName, UpdateSourceTrigger=PropertyChanged}"
                                     Height="36"
                                     Padding="10,6"
                                     Background="{DynamicResource BrushInputBackground}"
                                     BorderBrush="{DynamicResource BrushBorderSubtle}"
                                     Foreground="{DynamicResource BrushTextPrimary}"/>
                            <TextBlock Text="{Binding FormFullNameError}"
                                       FontSize="11"
                                       Foreground="{DynamicResource BrushDanger}"
                                       Margin="0,2,0,0"
                                       Visibility="{Binding FormFullNameError, Converter={StaticResource NullToVis}}"/>
                        </StackPanel>

                        <!-- Row 3: Nombre Comercial -->
                        <StackPanel Margin="0,0,0,12">
                            <TextBlock Text="Nombre Comercial (Opcional)" FontSize="11.5" FontWeight="Bold" Foreground="{DynamicResource BrushTextSecondary}" Margin="0,0,0,4"/>
                            <TextBox Text="{Binding FormTradeName, UpdateSourceTrigger=PropertyChanged}"
                                     Height="36"
                                     Padding="10,6"
                                     Background="{DynamicResource BrushInputBackground}"
                                     BorderBrush="{DynamicResource BrushBorderSubtle}"
                                     Foreground="{DynamicResource BrushTextPrimary}"/>
                        </StackPanel>

                        <!-- Row 4: Correo Electrónico + Teléfono -->
                        <Grid Margin="0,0,0,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="1.5*"/>
                                <ColumnDefinition Width="1*"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0" Margin="0,0,10,0">
                                <TextBlock Text="Correo Electrónico (Requerido DIAN) *" FontSize="11.5" FontWeight="Bold" Foreground="{DynamicResource BrushTextSecondary}" Margin="0,0,0,4"/>
                                <TextBox Text="{Binding FormEmail, UpdateSourceTrigger=PropertyChanged}"
                                         Height="36"
                                         Padding="10,6"
                                         Background="{DynamicResource BrushInputBackground}"
                                         BorderBrush="{DynamicResource BrushBorderSubtle}"
                                         Foreground="{DynamicResource BrushTextPrimary}"/>
                                <TextBlock Text="{Binding FormEmailError}"
                                           FontSize="11"
                                           Foreground="{DynamicResource BrushDanger}"
                                           Margin="0,2,0,0"
                                           Visibility="{Binding FormEmailError, Converter={StaticResource NullToVis}}"/>
                            </StackPanel>

                            <StackPanel Grid.Column="1">
                                <TextBlock Text="Teléfono Móvil / Fijo" FontSize="11.5" FontWeight="Bold" Foreground="{DynamicResource BrushTextSecondary}" Margin="0,0,0,4"/>
                                <TextBox Text="{Binding FormPhone, UpdateSourceTrigger=PropertyChanged}"
                                         Height="36"
                                         Padding="10,6"
                                         Background="{DynamicResource BrushInputBackground}"
                                         BorderBrush="{DynamicResource BrushBorderSubtle}"
                                         Foreground="{DynamicResource BrushTextPrimary}"/>
                            </StackPanel>
                        </Grid>

                        <!-- Row 5: Dirección + Municipio -->
                        <Grid Margin="0,0,0,16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="1.5*"/>
                                <ColumnDefinition Width="1*"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0" Margin="0,0,10,0">
                                <TextBlock Text="Dirección Fiscal *" FontSize="11.5" FontWeight="Bold" Foreground="{DynamicResource BrushTextSecondary}" Margin="0,0,0,4"/>
                                <TextBox Text="{Binding FormAddress, UpdateSourceTrigger=PropertyChanged}"
                                         Height="36"
                                         Padding="10,6"
                                         Background="{DynamicResource BrushInputBackground}"
                                         BorderBrush="{DynamicResource BrushBorderSubtle}"
                                         Foreground="{DynamicResource BrushTextPrimary}"/>
                                <TextBlock Text="{Binding FormAddressError}"
                                           FontSize="11"
                                           Foreground="{DynamicResource BrushDanger}"
                                           Margin="0,2,0,0"
                                           Visibility="{Binding FormAddressError, Converter={StaticResource NullToVis}}"/>
                            </StackPanel>

                            <StackPanel Grid.Column="1">
                                <TextBlock Text="Municipio / Código DANE *" FontSize="11.5" FontWeight="Bold" Foreground="{DynamicResource BrushTextSecondary}" Margin="0,0,0,4"/>
                                <TextBox Text="{Binding FormCityCode, UpdateSourceTrigger=PropertyChanged}"
                                         Height="36"
                                         Padding="10,6"
                                         Background="{DynamicResource BrushInputBackground}"
                                         BorderBrush="{DynamicResource BrushBorderSubtle}"
                                         Foreground="{DynamicResource BrushTextPrimary}"/>
                                <TextBlock Text="{Binding FormCityCodeError}"
                                           FontSize="11"
                                           Foreground="{DynamicResource BrushDanger}"
                                           Margin="0,2,0,0"
                                           Visibility="{Binding FormCityCodeError, Converter={StaticResource NullToVis}}"/>
                            </StackPanel>
                        </Grid>

                        <!-- Feedback General de Error -->
                        <TextBlock Text="{Binding FormGeneralError}"
                                   FontSize="12"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource BrushDanger}"
                                   Margin="0,0,0,14"
                                   Visibility="{Binding FormGeneralError, Converter={StaticResource NullToVis}}"/>

                        <!-- Action Buttons -->
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                            <Button Content="Cancelar"
                                    Command="{Binding CloseFormCommand}"
                                    Style="{StaticResource SecondaryButton}"
                                    Padding="18,9"
                                    Margin="0,0,10,0"/>
                            <Button Content="Guardar Cliente"
                                    Command="{Binding SaveCustomerCommand}"
                                    Style="{StaticResource ModernButton}"
                                    Padding="22,9"
                                    FontWeight="Bold"/>
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>
    </Grid>
</UserControl>
