<UserControl x:Class="Parking.Views.CheckOutView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:conv="clr-namespace:Parking.Core.Converters"
             xmlns:enums="clr-namespace:Parking.Core.Enums"
             xmlns:helpers="clr-namespace:Parking.Core.Helpers"
             mc:Ignorable="d"
             d:DesignHeight="850" d:DesignWidth="1180">

    <UserControl.Resources>
        <conv:CurrencyConverter x:Key="CurrencyConv"/>
        <conv:VehicleTypeToStringConverter x:Key="VehicleTypeStrConv"/>
        <conv:VehicleTypeToIconConverter x:Key="VehicleIconConv"/>
        <conv:BooleanToVisibilityConverter x:Key="BoolToVis"/>
        <conv:NullToVisibilityConverter x:Key="NullToVis"/>

        <!-- Estilo de Botón de Búsqueda Circular Dinámico (Gris inactivo / Verde activo) -->
        <Style x:Key="CircularSearchButton" TargetType="Button">
            <Setter Property="Background" Value="{DynamicResource BrushPrimary}"/>
            <Setter Property="Foreground" Value="{DynamicResource BrushTextWhite}"/>
            <Setter Property="Width" Value="150"/>
            <Setter Property="Height" Value="150"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border"
                                Background="{TemplateBinding Background}"
                                BorderThickness="0"
                                CornerRadius="75"
                                SnapsToDevicePixels="True">
                            <Border.Effect>
                                <DropShadowEffect BlurRadius="14" Direction="270" ShadowDepth="3" Opacity="0.18" Color="#0B3C49"/>
                            </Border.Effect>
                            <Path x:Name="IconSearchPath"
                                  Data="{StaticResource IconSearch}"
                                  Fill="{TemplateBinding Foreground}"
                                  Width="56" Height="56"
                                  Stretch="Uniform"
                                  HorizontalAlignment="Center"
                                  VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="{DynamicResource BrushPrimaryHover}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Background" Value="{DynamicResource BrushPrimaryActive}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="border" Property="Background" Value="#CBD5E1"/>
                                <Setter TargetName="IconSearchPath" Property="Fill" Value="#94A3B8"/>
                                <Setter TargetName="border" Property="Effect" Value="{x:Null}"/>
                                <Setter Property="Cursor" Value="Arrow"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Estilo de Tecla Virtual Táctil -->
        <Style x:Key="TouchKeyButton" TargetType="Button">
            <Setter Property="Background" Value="{DynamicResource BrushSurfaceBackground}"/>
            <Setter Property="Foreground" Value="{DynamicResource BrushTextPrimary}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BrushBorderMedium}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontSize" Value="17"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Height" Value="40"/>
            <Setter Property="Margin" Value="2"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6"
                                SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="{DynamicResource BrushPrimary}"/>
                                <Setter Property="Foreground" Value="{DynamicResource BrushTextWhite}"/>
                                <Setter TargetName="border" Property="BorderBrush" Value="{DynamicResource BrushPrimary}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Background" Value="{DynamicResource BrushSidebarItemActive}"/>
                                <Setter Property="Foreground" Value="{DynamicResource BrushTextWhite}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="TouchKeyActionButton" TargetType="Button" BasedOn="{StaticResource TouchKeyButton}">
            <Setter Property="Background" Value="#F1F5F9"/>
            <Setter Property="Foreground" Value="{DynamicResource BrushPrimary}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BrushBorderMedium}"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="Black"/>
        </Style>
    </UserControl.Resources>

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <!-- Fila Superior: Captura de Placa / Búsqueda de Tiquete (Zona Verde) -->
            <RowDefinition Height="Auto"/>
            <!-- Fila Inferior: Listado / Historial de Vehículos Activos en Patio (Zona Roja) -->
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- ========================================================================= -->
        <!-- ZONA SUPERIOR: Formulario Panorámico de Ingreso y Búsqueda de Placa -->
        <!-- ========================================================================= -->
        <Border Grid.Row="0"
                Style="{StaticResource ModernCard}"
                Margin="0,0,0,16"
                Padding="22">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- 1. Título, Botón Teclado Táctil y Estado de Terminal -->
                <Grid Grid.Row="0" Margin="0,0,0,14">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0">
                        <TextBlock Text="Liquidación y Salida" FontSize="20" FontWeight="Bold" Foreground="{DynamicResource BrushTextPrimary}"/>
                        <TextBlock Text="Escanee el código de barras del tiquete o digite la placa para procesar el cobro" FontSize="13" Foreground="{DynamicResource BrushTextMuted}" Margin="0,3,0,0"/>
                    </StackPanel>

                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                        <!-- Botón Teclado Táctil -->
                        <Button Command="{Binding ToggleVirtualKeyboardCommand}"
                                Style="{StaticResource SecondaryButton}"
                                Padding="10,6"
                                Margin="0,0,10,0"
                                ToolTip="Abrir o cerrar teclado virtual para pantalla táctil">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Path Data="{StaticResource IconKeyboard}" Fill="{DynamicResource BrushPrimary}" Width="15" Height="15" Stretch="Uniform" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                <TextBlock Text="Teclado Táctil" FontSize="13" FontWeight="Bold" Foreground="{DynamicResource BrushPrimary}" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>

                        <Border Background="#F0FDF4"
                                BorderBrush="#86EFAC"
                                BorderThickness="1"
                                CornerRadius="10"
                                Padding="12,6"
                                VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal">
                                <Path Data="{StaticResource IconCheck}" Fill="{DynamicResource BrushSuccess}" Width="14" Height="14" Stretch="Uniform" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                <TextBlock Text="Terminal Lista para Cobro" FontSize="12" FontWeight="Bold" Foreground="{DynamicResource BrushSuccess}" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Grid>

                <!-- 2. Alerta de Feedback (Informativo / Advertencia en Amarillo Institucional) -->
                <Border Grid.Row="1"
                        Visibility="{Binding HasFeedback, Converter={StaticResource BoolToVis}}"
                        CornerRadius="10"
                        Padding="14,10"
                        Margin="0,0,0,14">
                    <Border.Style>
                        <Style TargetType="Border">
                            <Setter Property="Background" Value="{DynamicResource BrushSuccessBg}"/>
                            <Setter Property="BorderBrush" Value="{DynamicResource BrushSuccess}"/>
                            <Setter Property="BorderThickness" Value="1"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsSuccessFeedback}" Value="False">
                                    <Setter Property="Background" Value="{DynamicResource BrushWarningBg}"/>
                                    <Setter Property="BorderBrush" Value="{DynamicResource BrushWarning}"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Path Grid.Column="0"
                              Data="{StaticResource IconAlertTriangle}"
                              Fill="{DynamicResource BrushWarning}"
                              Width="18" Height="18"
                              Stretch="Uniform"
                              VerticalAlignment="Center"
                              Margin="0,0,10,0">
                            <Path.Style>
                                <Style TargetType="Path">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsSuccessFeedback}" Value="True">
                                            <Setter Property="Data" Value="{StaticResource IconCheck}"/>
                                            <Setter Property="Fill" Value="{DynamicResource BrushSuccess}"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Path.Style>
                        </Path>
                        <TextBlock Grid.Column="1" Text="{Binding FeedbackMessage}" FontSize="14" FontWeight="Bold" TextWrapping="Wrap" VerticalAlignment="Center">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Foreground" Value="{DynamicResource BrushSuccessText}"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsSuccessFeedback}" Value="False">
                                            <Setter Property="Foreground" Value="{DynamicResource BrushWarningText}"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </Grid>
                </Border>

                <!-- 3. Caja de Búsqueda de Placa / Escaneo -->
                <Grid Grid.Row="2">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBox x:Name="SearchTextBox"
                             helpers:AutoShrinkFontHelper.IsEnabled="True"
                             helpers:AutoShrinkFontHelper.MaxFontSize="90"
                             helpers:AutoShrinkFontHelper.MinFontSize="28"
                             Grid.Column="0"
                             Text="{Binding SearchQuery, UpdateSourceTrigger=PropertyChanged}"
                             Style="{StaticResource CheckoutSearchTextBox}"
                             Height="160"
                             FontSize="90"
                             Margin="0,0,16,0">
                        <TextBox.InputBindings>
                            <KeyBinding Key="Return" Command="{Binding SearchTicketCommand}"/>
                            <KeyBinding Key="Enter" Command="{Binding SearchTicketCommand}"/>
                        </TextBox.InputBindings>
                    </TextBox>
                    <Button Grid.Column="1"
                            Command="{Binding SearchTicketCommand}"
                            Style="{StaticResource CircularSearchButton}"
                            VerticalAlignment="Center"
                            ToolTip="Buscar tiquete o placa (Enter)"/>
                </Grid>

                <!-- 4. Teclado Virtual en Pantalla (Desplegable) -->
                <Border Grid.Row="3"
                        Visibility="{Binding IsVirtualKeyboardVisible, Converter={StaticResource BoolToVis}}"
                        Background="#EDF2F7"
                        BorderBrush="{DynamicResource BrushBorderMedium}"
                        BorderThickness="1"
                        CornerRadius="10"
                        Padding="8"
                        Margin="0,14,0,0">
                    <StackPanel>
                        <!-- Fila de Números -->
                        <UniformGrid Columns="10" Rows="1">
                            <Button Content="1" Style="{StaticResource TouchKeyButton}" Command="{Binding AppendVirtualKeyCommand}" CommandParameter="1"/>
                            <Button Content="2" Style="{StaticResource TouchKeyButton}" Command="{Binding AppendVirtualKeyCommand}" CommandParameter="2"/>
                            <Button Content="3" Style="{StaticResource TouchKeyButton}" Command="{Binding AppendVirtualKeyCommand}" CommandParameter="3"/>
                            <Button Content="4" Style="{StaticResource TouchKeyButton}" Command="{Binding AppendVirtualKeyCommand}" CommandParameter="4"/>
                            <Button Content="5" Style="{StaticResource TouchKeyButton}" Command="{Binding AppendVirtualKeyCommand}" CommandParameter="5"/>
                            <Button Content="6" Style="{StaticResource TouchKeyButton}" Command="{Binding AppendVirtualKeyCommand}" CommandParameter="6"/>
                            <Button Content="7" Style="{StaticResource TouchKeyButton}" Command="{Binding AppendVirtualKeyCommand}" CommandParameter="7"/>
                            <Button Content="8" Style="{StaticResource TouchKeyButton}" Command="{Binding AppendVirtualKeyCommand}" CommandParameter="8"/>
                            <Button Content="9" Style="{StaticResource TouchKeyButton}" Command="{Binding AppendVirtualKeyCommand}" CommandParameter="9"/>
                            <Button Content="0" Style="{StaticResource TouchKeyButton}" Command="{Binding AppendVirtualKeyCommand}" CommandParameter="0"/>
                        </UniformGrid>

                        <!-- Fila Q - P -->
                        <UniformGrid Columns="10" Rows="1">
                            <Button Content="Q" Style="{StaticResource TouchKeyButton}" Command="{Binding AppendVirtualKeyCommand}" CommandParameter="Q"/>
                            <Button Content="W" Style="{StaticResource TouchKeyButton}" Command="{Binding AppendVirtualKeyCommand}" CommandParameter="W"/>
                            <Button Content="E" Style="{StaticResource TouchKeyButton}" Command="{Binding AppendVirtualKeyCommand}" CommandParameter="E"/>
                            <Button Content="R" Style="{StaticResource TouchKeyButton}" Command="{Binding AppendVirtualKeyCommand}" CommandParameter="R"/>
                            <Button Content="T" Style="{StaticResource TouchKeyButton}" Command="{Binding AppendVirtualKeyCommand}" CommandParameter="T"/>
                            <Button Content="Y" Style="{StaticResource TouchKeyButton}" Command="{Binding AppendVirtualKeyCommand}" CommandParameter="Y"/>
                            <Button Content="U" Style="{StaticResource TouchKeyButton}" Command="{Binding AppendVirtualKeyCommand}" CommandParameter="U"/>
                            <Button Content="I" Style="{StaticResource TouchKeyButton}" Command="{Binding AppendVirtualKeyCommand}" CommandParameter="I"/>
                            <Button Content="O" Style="{StaticResource TouchKeyButton}" Command="{Binding AppendVirtualKeyCommand}" CommandParameter="O"/>
                            <Button Content="P" Style="{StaticResource TouchKeyButton}" Command="{Binding AppendVirtualKeyCommand}" CommandParameter="P"/>
                        </UniformGrid>

                        <!-- Fila A - L -->
                        <UniformGrid Columns="9" Rows="1" Margin="14,0,14,0">
                            <Button Content="A" Style="{StaticResource TouchKeyButton}" Command="{Binding AppendVirtualKeyCommand}" CommandParameter="A"/>
                            <Button Content="S" Style="{StaticResource TouchKeyButton}" Command="{Binding AppendVirtualKeyCommand}" CommandParameter="S"/>
                            <Button Content="D" Style="{StaticResource TouchKeyButton}" Command="{Binding AppendVirtualKeyCommand}" CommandParameter="D"/>
                            <Button Content="F" Style="{StaticResource TouchKeyButton}" Command="{Binding AppendVirtualKeyCommand}" CommandParameter="F"/>
                            <Button Content="G" Style="{StaticResource TouchKeyButton}" Command="{Binding AppendVirtualKeyCommand}" CommandParameter="G"/>
                            <Button Content="H" Style="{StaticResource TouchKeyButton}" Command="{Binding AppendVirtualKeyCommand}" CommandParameter="H"/>
                            <Button Content="J" Style="{StaticResource TouchKeyButton}" Command="{Binding AppendVirtualKeyCommand}" CommandParameter="J"/>
                            <Button Content="K" Style="{StaticResource TouchKeyButton}" Command="{Binding AppendVirtualKeyCommand}" CommandParameter="K"/>
                            <Button Content="L" Style="{StaticResource TouchKeyButton}" Command="{Binding AppendVirtualKeyCommand}" CommandParameter="L"/>
                        </UniformGrid>

                        <!-- Fila Z - M + Acciones -->
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="1.3*"/>
                                <ColumnDefinition Width="7*"/>
                                <ColumnDefinition Width="1.3*"/>
                            </Grid.ColumnDefinitions>

                            <Button Grid.Column="0" Content="Limpiar" Style="{StaticResource TouchKeyActionButton}" Command="{Binding AppendVirtualKeyCommand}" CommandParameter="CLEAR"/>

                            <UniformGrid Grid.Column="1" Columns="7" Rows="1">
                                <Button Content="Z" Style="{StaticResource TouchKeyButton}" Command="{Binding AppendVirtualKeyCommand}" CommandParameter="Z"/>
                                <Button Content="X" Style="{StaticResource TouchKeyButton}" Command="{Binding AppendVirtualKeyCommand}" CommandParameter="X"/>
                                <Button Content="C" Style="{StaticResource TouchKeyButton}" Command="{Binding AppendVirtualKeyCommand}" CommandParameter="C"/>
                                <Button Content="V" Style="{StaticResource TouchKeyButton}" Command="{Binding AppendVirtualKeyCommand}" CommandParameter="V"/>
                                <Button Content="B" Style="{StaticResource TouchKeyButton}" Command="{Binding AppendVirtualKeyCommand}" CommandParameter="B"/>
                                <Button Content="N" Style="{StaticResource TouchKeyButton}" Command="{Binding AppendVirtualKeyCommand}" CommandParameter="N"/>
                                <Button Content="M" Style="{StaticResource TouchKeyButton}" Command="{Binding AppendVirtualKeyCommand}" CommandParameter="M"/>
                            </UniformGrid>

                            <Button Grid.Column="2" Content="⌫ Borrar" Style="{StaticResource TouchKeyActionButton}" Command="{Binding AppendVirtualKeyCommand}" CommandParameter="BACKSPACE"/>
                        </Grid>
                    </StackPanel>
                </Border>
            </Grid>
        </Border>

        <!-- ========================================================================= -->
        <!-- ZONA INFERIOR: Historial y Listado de Vehículos Activos en Patio -->
        <!-- ========================================================================= -->
        <Border Grid.Row="1"
                Style="{StaticResource ModernCard}"
                Padding="22">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- Encabezado de la Sección de Activos -->
                <Grid Grid.Row="0" Margin="0,0,0,16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <!-- Izquierda: Título de Sección -->
                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                        <Path Data="{StaticResource IconCar}" Fill="{DynamicResource BrushPrimary}" Width="18" Height="18" Stretch="Uniform" Margin="0,0,8,0" VerticalAlignment="Center"/>
                        <TextBlock Text="VEHÍCULOS ACTIVOS ADENTRO"
                                   FontSize="15"
                                   FontWeight="Black"
                                   Foreground="{DynamicResource BrushTextPrimary}"
                                   VerticalAlignment="Center"/>
                    </StackPanel>

                    <!-- Derecha: Badge de Vehículos en Patio -->
                    <Border Grid.Column="1" Background="#F0F0F0" BorderBrush="#398d78ff" BorderThickness="1" CornerRadius="12" Padding="12,4" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Ellipse Width="8" Height="8" Fill="{DynamicResource BrushPrimary}" Margin="0,0,6,0" VerticalAlignment="Center"/>
                            <TextBlock Text="{Binding ActiveVehicles.Count, StringFormat='{}{0} en Patio'}"
                                       FontSize="13"
                                       FontWeight="Bold"
                                       Foreground="{DynamicResource BrushPrimary}"
                                       VerticalAlignment="Center"/>
                        </StackPanel>
                    </Border>
                </Grid>

                <!-- Listado Dinámico de Vehículos -->
                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <ItemsControl ItemsSource="{Binding ActiveVehicles}" VerticalAlignment="Top">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <UniformGrid Columns="4" VerticalAlignment="Top"/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border HorizontalAlignment="Stretch"
                                        VerticalAlignment="Top"
                                        Background="#F0F0F0"
                                        BorderBrush="{DynamicResource BrushBorderSubtle}"
                                        BorderThickness="1.5"
                                        CornerRadius="12"
                                        Padding="10,8"
                                        Margin="0,0,8,8"
                                        Cursor="Hand">
                                    <Border.InputBindings>
                                        <MouseBinding Gesture="LeftClick"
                                                      Command="{Binding DataContext.SelectActiveVehicleCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                      CommandParameter="{Binding}"/>
                                    </Border.InputBindings>
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Setter Property="Background" Value="#F0F0F0"/>
                                            <Style.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter Property="Background" Value="#E4E4E4"/>
                                                    <Setter Property="BorderBrush" Value="{DynamicResource BrushPrimary}"/>
                                                </Trigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                        </Grid.RowDefinitions>

                                        <!-- Fila 1: Icono + Placa (Izquierda) y Categoría (Derecha) -->
                                        <Grid Grid.Row="0" Margin="0,0,0,6">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>

                                            <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                                                <Border Width="32"
                                                        Height="32"
                                                        CornerRadius="7"
                                                        Background="{DynamicResource BrushPrimary}"
                                                        Margin="0,0,6,0"
                                                        VerticalAlignment="Center">
                                                    <Path Data="{Binding VehicleType, Converter={StaticResource VehicleIconConv}}"
                                                          Fill="{DynamicResource BrushTextWhite}"
                                                          Width="16" Height="16"
                                                          Stretch="Uniform"
                                                          HorizontalAlignment="Center"
                                                          VerticalAlignment="Center"/>
                                                </Border>
                                                <TextBlock Text="{Binding PlateNumber}"
                                                           FontFamily="{StaticResource FontFamilyMonospace}"
                                                           FontWeight="Black"
                                                           FontSize="17"
                                                           Foreground="{DynamicResource BrushTextPrimary}"
                                                           VerticalAlignment="Center"/>
                                            </StackPanel>

                                            <!-- Badge de Categoría -->
                                            <Border Grid.Column="1" Background="#E0F2FE" BorderBrush="#BAE6FD" BorderThickness="1" CornerRadius="6" Padding="6,2" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding VehicleType, Converter={StaticResource VehicleTypeStrConv}}"
                                                           FontWeight="Bold"
                                                           FontSize="10.5"
                                                           Foreground="{DynamicResource BrushPrimary}"/>
                                            </Border>
                                        </Grid>

                                        <!-- Fila 2: Tiempos de permanencia (Izquierda) y Botón Liquidar (Derecha) -->
                                        <Grid Grid.Row="1">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>

                                            <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding EntryTime, StringFormat='{}Entrada: {0:HH:mm}'}"
                                                               FontSize="11"
                                                               FontWeight="SemiBold"
                                                               Foreground="{DynamicResource BrushTextMuted}"
                                                               VerticalAlignment="Center"/>
                                                    <Border Background="#F1F5F9" CornerRadius="5" Padding="5,2" Margin="6,0,0,0" VerticalAlignment="Center">
                                                        <TextBlock Text="{Binding FormattedDuration}"
                                                                   FontSize="10.5"
                                                                   FontWeight="Bold"
                                                                   Foreground="{DynamicResource BrushPrimary}"/>
                                                    </Border>
                                                </StackPanel>
                                            </StackPanel>

                                            <!-- Botón Liquidar -->
                                            <Button Grid.Column="1"
                                                    Content="Liquidar"
                                                    Command="{Binding DataContext.SelectActiveVehicleCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                    CommandParameter="{Binding}"
                                                    Style="{StaticResource SuccessButton}"
                                                    Padding="10,2"
                                                    FontSize="11.5"
                                                    FontWeight="Bold"
                                                    Height="30"
                                                    VerticalAlignment="Center"/>
                                        </Grid>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </Grid>
        </Border>
    </Grid>
</UserControl>