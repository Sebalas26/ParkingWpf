<Window x:Class="Parking.Views.BranchSelectionDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="Seleccionar Sede de Trabajo"
        Width="580"
        SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Display"
        TextOptions.TextRenderingMode="ClearType">

    <Border Margin="16"
            Background="{DynamicResource BrushSurfaceBackground}"
            BorderBrush="{DynamicResource BrushBorderMedium}"
            BorderThickness="1"
            CornerRadius="18"
            Padding="24"
            SnapsToDevicePixels="True">
        <Border.Effect>
            <DropShadowEffect BlurRadius="28" ShadowDepth="8" Direction="270" Opacity="0.22" Color="#0B3C49"/>
        </Border.Effect>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- 1. Header -->
            <Grid Grid.Row="0" Margin="0,0,0,16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0"
                        Width="48"
                        Height="48"
                        CornerRadius="24"
                        Background="{DynamicResource BrushPrimaryLight}"
                        Margin="0,0,16,0"
                        VerticalAlignment="Center">
                    <Path Data="{StaticResource IconCheckIn}"
                          Fill="{DynamicResource BrushPrimary}"
                          Width="22"
                          Height="22"
                          Stretch="Uniform"
                          HorizontalAlignment="Center"
                          VerticalAlignment="Center"/>
                </Border>

                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <TextBlock Text="Seleccionar Sede de Trabajo"
                               FontSize="18"
                               FontWeight="Black"
                               Foreground="{DynamicResource BrushTextPrimary}"/>
                    <TextBlock Text="Tienes acceso a múltiples parqueaderos. Elige la estación donde operarás:"
                               FontSize="12"
                               Foreground="{DynamicResource BrushTextMuted}"
                               Margin="0,3,0,0"
                               TextWrapping="Wrap"/>
                </StackPanel>
            </Grid>

            <!-- 2. Divider -->
            <Border Grid.Row="1" Height="1" Background="{DynamicResource BrushBorderSubtle}" Margin="0,0,0,16"/>

            <!-- 3. List of Branches Cards -->
            <ScrollViewer Grid.Row="2" MaxHeight="380" VerticalScrollBarVisibility="Auto" Margin="0,0,0,20">
                <ItemsControl x:Name="BranchesList">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Margin="0,0,0,10"
                                    Background="{DynamicResource BrushSurfaceElevated}"
                                    BorderBrush="{DynamicResource BrushBorderSubtle}"
                                    BorderThickness="1.5"
                                    CornerRadius="12"
                                    Padding="16,14"
                                    Cursor="Hand"
                                    MouseLeftButtonUp="OnBranchCardClicked">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Setter Property="Background" Value="{DynamicResource BrushSurfaceElevated}"/>
                                        <Style.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter Property="BorderBrush" Value="{DynamicResource BrushPrimary}"/>
                                                <Setter Property="Background" Value="{DynamicResource BrushPrimaryLight}"/>
                                            </Trigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>

                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <!-- Branch Icon -->
                                    <Border Grid.Column="0"
                                            Width="40"
                                            Height="40"
                                            CornerRadius="10"
                                            Background="{DynamicResource BrushPrimary}"
                                            Margin="0,0,14,0"
                                            VerticalAlignment="Center">
                                        <Path Data="{StaticResource IconCheckIn}"
                                              Fill="{DynamicResource BrushTextWhite}"
                                              Width="18"
                                              Height="18"
                                              Stretch="Uniform"
                                              HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                                    </Border>

                                    <!-- Info -->
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="{Binding Name}"
                                                       FontSize="14"
                                                       FontWeight="Bold"
                                                       Foreground="{DynamicResource BrushTextPrimary}"
                                                       VerticalAlignment="Center"/>
                                            <Border CornerRadius="4"
                                                    Background="{DynamicResource BrushPrimaryLight}"
                                                    Padding="6,2"
                                                    Margin="8,0,0,0"
                                                    VerticalAlignment="Center">
                                                <TextBlock Text="{Binding Code}"
                                                           FontSize="10"
                                                           FontWeight="Bold"
                                                           Foreground="{DynamicResource BrushPrimary}"/>
                                            </Border>
                                        </StackPanel>

                                        <TextBlock Text="{Binding Address}"
                                                   FontSize="12"
                                                   Foreground="{DynamicResource BrushTextSecondary}"
                                                   Margin="0,3,0,0"/>

                                        <StackPanel Orientation="Horizontal" Margin="0,3,0,0">
                                            <TextBlock Text="Capacidad: "
                                                       FontSize="11"
                                                       FontWeight="SemiBold"
                                                       Foreground="{DynamicResource BrushTextMuted}"/>
                                            <TextBlock Text="{Binding TotalCapacity, StringFormat='{}{0} celdas'}"
                                                       FontSize="11"
                                                       FontWeight="Bold"
                                                       Foreground="{DynamicResource BrushSuccess}"/>
                                        </StackPanel>
                                    </StackPanel>

                                    <!-- Action Arrow -->
                                    <Border Grid.Column="2"
                                            Width="32"
                                            Height="32"
                                            CornerRadius="16"
                                            Background="{DynamicResource BrushSurfaceBackground}"
                                            BorderBrush="{DynamicResource BrushBorderMedium}"
                                            BorderThickness="1"
                                            VerticalAlignment="Center">
                                        <Path Data="{StaticResource IconChevronRight}"
                                              Fill="{DynamicResource BrushTextPrimary}"
                                              Width="12"
                                              Height="12"
                                              Stretch="Uniform"
                                              HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                                    </Border>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>

            <!-- 4. Footer Actions -->
            <Grid Grid.Row="3">
                <Button Content="Cancelar Inicio de Sesión"
                        Style="{StaticResource OutlineButtonStyle}"
                        HorizontalAlignment="Right"
                        Padding="18,8"
                        Click="OnCancelClicked"/>
            </Grid>
        </Grid>
    </Border>
</Window>
