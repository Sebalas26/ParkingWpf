<UserControl x:Class="Parking.Views.CheckInView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:conv="clr-namespace:Parking.Core.Converters"
             xmlns:enums="clr-namespace:Parking.Core.Enums"
             mc:Ignorable="d"
             d:DesignHeight="950" d:DesignWidth="1180"
             UseLayoutRounding="True"
             SnapsToDevicePixels="True"
             TextOptions.TextFormattingMode="Display"
             TextOptions.TextRenderingMode="ClearType"
             RenderOptions.ClearTypeHint="Enabled"
             RenderOptions.BitmapScalingMode="HighQuality">

    <UserControl.Resources>
        <conv:CurrencyConverter x:Key="CurrencyConv"/>
        <conv:VehicleTypeToStringConverter x:Key="VehicleTypeStrConv"/>
        <conv:VehicleTypeToIconConverter x:Key="VehicleIconConv"/>
        <conv:BooleanToVisibilityConverter x:Key="BoolToVis"/>
        <conv:EqualityToBooleanConverter x:Key="EqualityConv"/>

        <!-- Estilo de Selector de Categoría con Estado Activo / Seleccionado Evidente -->
        <Style x:Key="CategoryOptionRadioButton" TargetType="RadioButton">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Margin" Value="4"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="CardBorder"
                                Background="{DynamicResource BrushSurfaceBackground}"
                                BorderBrush="{DynamicResource BrushBorderMedium}"
                                BorderThickness="1.5"
                                CornerRadius="12"
                                Padding="14,12"
                                SnapsToDevicePixels="True">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <!-- Icon Container -->
                                <Border x:Name="IconContainer"
                                        Grid.Column="0"
                                        Width="40" Height="40"
                                        CornerRadius="8"
                                        Background="#F1F5F9"
                                        Margin="0,0,12,0"
                                        VerticalAlignment="Center">
                                    <Path x:Name="IconPath"
                                          Data="{Binding VehicleType, Converter={StaticResource VehicleIconConv}}"
                                          Fill="{DynamicResource BrushPrimary}"
                                          Width="20" Height="20"
                                          Stretch="Uniform"
                                          HorizontalAlignment="Center"
                                          VerticalAlignment="Center"/>
                                </Border>

                                <!-- Text -->
                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <TextBlock x:Name="TitleText"
                                               Text="{Binding DisplayName}"
                                               FontWeight="Bold"
                                               FontSize="13"
                                               Foreground="{DynamicResource BrushTextPrimary}"/>
                                    <TextBlock x:Name="RateText"
                                               Text="{Binding HourlyRate, Converter={StaticResource CurrencyConv}, StringFormat='{}{0} / hora'}"
                                               FontSize="12"
                                               FontWeight="Bold"
                                               Foreground="{DynamicResource BrushPrimary}"
                                               Margin="0,3,0,0"/>
                                </StackPanel>

                                <!-- Checkmark badge when selected -->
                                <Border x:Name="CheckBadge"
                                        Grid.Column="2"
                                        Width="22" Height="22"
                                        CornerRadius="11"
                                        Background="{DynamicResource BrushPrimary}"
                                        Visibility="Collapsed"
                                        VerticalAlignment="Center"
                                        Margin="8,0,0,0">
                                    <Path Data="{StaticResource IconCheck}"
                                          Fill="{DynamicResource BrushTextWhite}"
                                          Width="12" Height="12"
                                          Stretch="Uniform"
                                          HorizontalAlignment="Center"
                                          VerticalAlignment="Center"/>
                                </Border>
                            </Grid>
                        </Border>

                        <ControlTemplate.Triggers>
                            <!-- Hover state -->
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="CardBorder" Property="BorderBrush" Value="{DynamicResource BrushPrimary}"/>
                                <Setter TargetName="CardBorder" Property="Background" Value="#F8FAFC"/>
                            </Trigger>

                            <!-- Selected / Checked state -->
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="CardBorder" Property="Background" Value="#EBF6F8"/>
                                <Setter TargetName="CardBorder" Property="BorderBrush" Value="{DynamicResource BrushPrimary}"/>
                                <Setter TargetName="CardBorder" Property="BorderThickness" Value="2.5"/>
                                <Setter TargetName="IconContainer" Property="Background" Value="{DynamicResource BrushPrimary}"/>
                                <Setter TargetName="IconPath" Property="Fill" Value="{DynamicResource BrushTextWhite}"/>
                                <Setter TargetName="TitleText" Property="Foreground" Value="{DynamicResource BrushPrimary}"/>
                                <Setter TargetName="TitleText" Property="FontWeight" Value="Black"/>
                                <Setter TargetName="CheckBadge" Property="Visibility" Value="Visible"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Estilo de Tecla Virtual Táctil -->
        <Style x:Key="TouchKeyButton" TargetType="Button">
            <Setter Property="Background" Value="{DynamicResource BrushSurfaceBackground}"/>
            <Setter Property="Foreground" Value="{DynamicResource BrushTextPrimary}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BrushBorderMedium}"/>
            <Setter Property="BorderThickness" Value="1.5"/>
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Height" Value="46"/>
            <Setter Property="Margin" Value="3"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8"
                                SnapsToDevicePixels="True">
                            <Border.Effect>
                                <DropShadowEffect BlurRadius="4" Direction="270" ShadowDepth="1" Opacity="0.06" Color="#0B3C49"/>
                            </Border.Effect>
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="{DynamicResource BrushPrimary}"/>
                                <Setter Property="Foreground" Value="{DynamicResource BrushTextWhite}"/>
                                <Setter TargetName="border" Property="BorderBrush" Value="{DynamicResource BrushPrimary}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Background" Value="{DynamicResource BrushSidebarActive}"/>
                                <Setter Property="Foreground" Value="{DynamicResource BrushTextWhite}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="TouchKeyActionButton" TargetType="Button" BasedOn="{StaticResource TouchKeyButton}">
            <Setter Property="Background" Value="#F1F5F9"/>
            <Setter Property="Foreground" Value="{DynamicResource BrushPrimary}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BrushBorderMedium}"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="Black"/>
        </Style>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <Grid Margin="24">
            <!-- Tarjeta Central de Registro de Entrada de Vehículo (Centrada con Márgenes Laterales) -->
            <Border Background="{DynamicResource BrushSurfaceBackground}"
                    BorderBrush="{DynamicResource BrushBorderMedium}"
                    BorderThickness="1"
                    CornerRadius="16"
                    Padding="32"
                    MaxWidth="960"
                    HorizontalAlignment="Center"
                    SnapsToDevicePixels="True">
                <StackPanel>
                    <!-- Header -->
                    <Grid Margin="0,0,0,24">
                        <StackPanel>
                            <TextBlock Text="Registro de Entrada de Vehículo" FontSize="22" FontWeight="Bold" Foreground="{DynamicResource BrushTextPrimary}"/>
                            <TextBlock Text="Capture la placa del vehículo, seleccione la categoría tarifaria y emita el tiquete de ingreso" FontSize="13" Foreground="{DynamicResource BrushTextMuted}" Margin="0,4,0,0"/>
                        </StackPanel>
                    </Grid>

                    <!-- Feedback Alert -->
                    <Border Visibility="{Binding HasFeedback, Converter={StaticResource BoolToVis}}"
                            CornerRadius="10"
                            Padding="16,12"
                            Margin="0,0,0,20">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="Background" Value="{DynamicResource BrushSuccessBg}"/>
                                <Setter Property="BorderBrush" Value="{DynamicResource BrushSuccess}"/>
                                <Setter Property="BorderThickness" Value="1"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsSuccessFeedback}" Value="False">
                                        <Setter Property="Background" Value="{DynamicResource BrushDangerBg}"/>
                                        <Setter Property="BorderBrush" Value="{DynamicResource BrushDanger}"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <TextBlock Text="{Binding FeedbackMessage}" FontSize="13" FontWeight="Bold" TextWrapping="Wrap">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Foreground" Value="{DynamicResource BrushSuccess}"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsSuccessFeedback}" Value="False">
                                            <Setter Property="Foreground" Value="{DynamicResource BrushDanger}"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </Border>

                    <!-- Input Gigante de Placa con Botón de Teclado Táctil -->
                    <Border Background="#F8FAFC"
                            BorderBrush="{DynamicResource BrushBorderMedium}"
                            BorderThickness="1"
                            CornerRadius="18"
                            Padding="24,20"
                            Margin="0,0,0,24">
                        <StackPanel>
                            <!-- Header de Placa con Botón de Teclado -->
                            <Grid Margin="0,0,0,14">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                                    <Border Background="{DynamicResource BrushPrimary}" Width="26" Height="26" CornerRadius="6" Margin="0,0,10,0" VerticalAlignment="Center">
                                        <Path Data="{StaticResource IconCar}" Fill="{DynamicResource BrushTextWhite}" Width="14" Height="14" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <TextBlock Text="DIGITE LA PLACA DEL VEHÍCULO *" FontSize="14" FontWeight="Black" Foreground="{DynamicResource BrushPrimary}" VerticalAlignment="Center"/>
                                </StackPanel>

                                <!-- Botón Teclado Táctil -->
                                <Button Grid.Column="1"
                                        Command="{Binding ToggleVirtualKeyboardCommand}"
                                        Style="{StaticResource SecondaryButton}"
                                        Padding="12,6"
                                        ToolTip="Abrir o cerrar teclado virtual para pantalla táctil">
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <Path Data="{StaticResource IconKeyboard}" Fill="{DynamicResource BrushPrimary}" Width="16" Height="16" Stretch="Uniform" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                        <TextBlock Text="Teclado Táctil" FontSize="12" FontWeight="Bold" Foreground="{DynamicResource BrushPrimary}" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Button>
                            </Grid>

                            <!-- Input Masivo Panorámico -->
                            <TextBox Text="{Binding PlateNumber, UpdateSourceTrigger=PropertyChanged}"
                                     Style="{StaticResource PlateInputTextBox}"
                                     Margin="0,0,0,8"/>

                            <!-- Banner de Suscriptor Mensual Activo -->
                            <Border Visibility="{Binding IsMonthlySubscriber, Converter={StaticResource BoolToVis}}"
                                    Background="{DynamicResource BrushSuccessBg}"
                                    BorderBrush="{DynamicResource BrushSuccess}"
                                    BorderThickness="1.5"
                                    CornerRadius="10"
                                    Padding="14,10"
                                    Margin="0,0,0,10">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <Border Grid.Column="0" Width="26" Height="26" CornerRadius="13" Background="{DynamicResource BrushSuccess}" Margin="0,0,10,0" VerticalAlignment="Center">
                                        <Path Data="{StaticResource IconCheck}" Fill="{DynamicResource BrushTextWhite}" Width="12" Height="12" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                        <TextBlock Text="VEHÍCULO CON MENSUALIDAD ACTIVA" FontWeight="Black" FontSize="12" Foreground="{DynamicResource BrushSuccess}"/>
                                        <TextBlock FontSize="11" Foreground="{DynamicResource BrushTextPrimary}">
                                            <Run Text="Abonado: " FontWeight="SemiBold"/>
                                            <Run Text="{Binding ActiveSubscription.CustomerName}" FontWeight="Bold"/>
                                            <Run Text=" • Doc: "/>
                                            <Run Text="{Binding ActiveSubscription.CustomerDocument}"/>
                                            <Run Text=" • Vence: "/>
                                            <Run Text="{Binding ActiveSubscription.EndDate, StringFormat='{}{0:yyyy-MM-dd}'}" FontWeight="Bold"/>
                                        </TextBlock>
                                    </StackPanel>
                                    <Border Grid.Column="2" Background="{DynamicResource BrushSuccess}" CornerRadius="6" Padding="8,4" VerticalAlignment="Center">
                                        <TextBlock Text="TARIFA $0.00" FontSize="11" FontWeight="Black" Foreground="{DynamicResource BrushTextWhite}"/>
                                    </Border>
                                </Grid>
                            </Border>

                            <TextBlock Text="💡 Las letras y números ingresados se convertirán automáticamente a mayúsculas"
                                       FontSize="12"
                                       FontWeight="SemiBold"
                                       Foreground="{DynamicResource BrushTextMuted}"
                                       HorizontalAlignment="Center"/>

                            <!-- Teclado Virtual en Pantalla (Desplegable / Táctil) -->
                            <Border Visibility="{Binding IsVirtualKeyboardVisible, Converter={StaticResource BoolToVis}}"
                                    Background="#EDF2F7"
                                    BorderBrush="{DynamicResource BrushBorderMedium}"
                                    BorderThickness="1"
                                    CornerRadius="12"
                                    Padding="12"
                                    Margin="0,14,0,0">
                                <StackPanel>
                                    <!-- Fila de Números -->
                                    <UniformGrid Columns="10" Rows="1">
                                        <Button Content="1" Style="{StaticResource TouchKeyButton}" Command="{Binding AppendVirtualKeyCommand}" CommandParameter="1"/>
                                        <Button Content="2" Style="{StaticResource TouchKeyButton}" Command="{Binding AppendVirtualKeyCommand}" CommandParameter="2"/>
                                        <Button Content="3" Style="{StaticResource TouchKeyButton}" Command="{Binding AppendVirtualKeyCommand}" CommandParameter="3"/>
                                        <Button Content="4" Style="{StaticResource TouchKeyButton}" Command="{Binding AppendVirtualKeyCommand}" CommandParameter="4"/>
                                        <Button Content="5" Style="{StaticResource TouchKeyButton}" Command="{Binding AppendVirtualKeyCommand}" CommandParameter="5"/>
                                        <Button Content="6" Style="{StaticResource TouchKeyButton}" Command="{Binding AppendVirtualKeyCommand}" CommandParameter="6"/>
                                        <Button Content="7" Style="{StaticResource TouchKeyButton}" Command="{Binding AppendVirtualKeyCommand}" CommandParameter="7"/>
                                        <Button Content="8" Style="{StaticResource TouchKeyButton}" Command="{Binding AppendVirtualKeyCommand}" CommandParameter="8"/>
                                        <Button Content="9" Style="{StaticResource TouchKeyButton}" Command="{Binding AppendVirtualKeyCommand}" CommandParameter="9"/>
                                        <Button Content="0" Style="{StaticResource TouchKeyButton}" Command="{Binding AppendVirtualKeyCommand}" CommandParameter="0"/>
                                    </UniformGrid>

                                    <!-- Fila Q - P -->
                                    <UniformGrid Columns="10" Rows="1">
                                        <Button Content="Q" Style="{StaticResource TouchKeyButton}" Command="{Binding AppendVirtualKeyCommand}" CommandParameter="Q"/>
                                        <Button Content="W" Style="{StaticResource TouchKeyButton}" Command="{Binding AppendVirtualKeyCommand}" CommandParameter="W"/>
                                        <Button Content="E" Style="{StaticResource TouchKeyButton}" Command="{Binding AppendVirtualKeyCommand}" CommandParameter="E"/>
                                        <Button Content="R" Style="{StaticResource TouchKeyButton}" Command="{Binding AppendVirtualKeyCommand}" CommandParameter="R"/>
                                        <Button Content="T" Style="{StaticResource TouchKeyButton}" Command="{Binding AppendVirtualKeyCommand}" CommandParameter="T"/>
                                        <Button Content="Y" Style="{StaticResource TouchKeyButton}" Command="{Binding AppendVirtualKeyCommand}" CommandParameter="Y"/>
                                        <Button Content="U" Style="{StaticResource TouchKeyButton}" Command="{Binding AppendVirtualKeyCommand}" CommandParameter="U"/>
                                        <Button Content="I" Style="{StaticResource TouchKeyButton}" Command="{Binding AppendVirtualKeyCommand}" CommandParameter="I"/>
                                        <Button Content="O" Style="{StaticResource TouchKeyButton}" Command="{Binding AppendVirtualKeyCommand}" CommandParameter="O"/>
                                        <Button Content="P" Style="{StaticResource TouchKeyButton}" Command="{Binding AppendVirtualKeyCommand}" CommandParameter="P"/>
                                    </UniformGrid>

                                    <!-- Fila A - L -->
                                    <UniformGrid Columns="9" Rows="1" Margin="20,0,20,0">
                                        <Button Content="A" Style="{StaticResource TouchKeyButton}" Command="{Binding AppendVirtualKeyCommand}" CommandParameter="A"/>
                                        <Button Content="S" Style="{StaticResource TouchKeyButton}" Command="{Binding AppendVirtualKeyCommand}" CommandParameter="S"/>
                                        <Button Content="D" Style="{StaticResource TouchKeyButton}" Command="{Binding AppendVirtualKeyCommand}" CommandParameter="D"/>
                                        <Button Content="F" Style="{StaticResource TouchKeyButton}" Command="{Binding AppendVirtualKeyCommand}" CommandParameter="F"/>
                                        <Button Content="G" Style="{StaticResource TouchKeyButton}" Command="{Binding AppendVirtualKeyCommand}" CommandParameter="G"/>
                                        <Button Content="H" Style="{StaticResource TouchKeyButton}" Command="{Binding AppendVirtualKeyCommand}" CommandParameter="H"/>
                                        <Button Content="J" Style="{StaticResource TouchKeyButton}" Command="{Binding AppendVirtualKeyCommand}" CommandParameter="J"/>
                                        <Button Content="K" Style="{StaticResource TouchKeyButton}" Command="{Binding AppendVirtualKeyCommand}" CommandParameter="K"/>
                                        <Button Content="L" Style="{StaticResource TouchKeyButton}" Command="{Binding AppendVirtualKeyCommand}" CommandParameter="L"/>
                                    </UniformGrid>

                                    <!-- Fila Z - M + Acciones -->
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="1.4*"/>
                                            <ColumnDefinition Width="7*"/>
                                            <ColumnDefinition Width="1.4*"/>
                                        </Grid.ColumnDefinitions>

                                        <Button Grid.Column="0" Content="Limpiar" Style="{StaticResource TouchKeyActionButton}" Command="{Binding AppendVirtualKeyCommand}" CommandParameter="CLEAR"/>

                                        <UniformGrid Grid.Column="1" Columns="7" Rows="1">
                                            <Button Content="Z" Style="{StaticResource TouchKeyButton}" Command="{Binding AppendVirtualKeyCommand}" CommandParameter="Z"/>
                                            <Button Content="X" Style="{StaticResource TouchKeyButton}" Command="{Binding AppendVirtualKeyCommand}" CommandParameter="X"/>
                                            <Button Content="C" Style="{StaticResource TouchKeyButton}" Command="{Binding AppendVirtualKeyCommand}" CommandParameter="C"/>
                                            <Button Content="V" Style="{StaticResource TouchKeyButton}" Command="{Binding AppendVirtualKeyCommand}" CommandParameter="V"/>
                                            <Button Content="B" Style="{StaticResource TouchKeyButton}" Command="{Binding AppendVirtualKeyCommand}" CommandParameter="B"/>
                                            <Button Content="N" Style="{StaticResource TouchKeyButton}" Command="{Binding AppendVirtualKeyCommand}" CommandParameter="N"/>
                                            <Button Content="M" Style="{StaticResource TouchKeyButton}" Command="{Binding AppendVirtualKeyCommand}" CommandParameter="M"/>
                                        </UniformGrid>

                                        <Button Grid.Column="2" Content="⌫ Borrar" Style="{StaticResource TouchKeyActionButton}" Command="{Binding AppendVirtualKeyCommand}" CommandParameter="BACKSPACE"/>
                                    </Grid>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </Border>

                    <!-- Selector de Categorías de Vehículo en Cuadrícula con Estado Seleccionado Activo -->
                    <TextBlock Text="SELECCIONE LA CATEGORÍA DE VEHÍCULO *" FontSize="12" FontWeight="Bold" Foreground="{DynamicResource BrushTextMuted}" Margin="0,0,0,10"/>
                    <ItemsControl ItemsSource="{Binding AvailableRates}" Margin="0,0,0,24">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <UniformGrid Columns="2" Rows="2"/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <RadioButton Style="{StaticResource CategoryOptionRadioButton}"
                                             GroupName="VehicleCategoryOptions"
                                             Command="{Binding DataContext.SelectVehicleTypeCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                             CommandParameter="{Binding VehicleType}">
                                    <RadioButton.IsChecked>
                                        <MultiBinding Converter="{StaticResource EqualityConv}" Mode="OneWay">
                                            <Binding Path="VehicleType"/>
                                            <Binding Path="DataContext.SelectedVehicleType" RelativeSource="{RelativeSource AncestorType=UserControl}"/>
                                        </MultiBinding>
                                    </RadioButton.IsChecked>
                                </RadioButton>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <!-- Teléfono y Observaciones -->
                    <Grid Margin="0,0,0,24">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="1*"/>
                            <ColumnDefinition Width="1.5*"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0" Margin="0,0,12,0">
                            <TextBlock Text="TELÉFONO DEL CONDUCTOR (OPCIONAL)" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource BrushTextMuted}" Margin="0,0,0,6"/>
                            <TextBox Text="{Binding PhoneNumber, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource ModernTextBox}" Height="44"/>
                        </StackPanel>

                        <StackPanel Grid.Column="1" Margin="12,0,0,0">
                            <TextBlock Text="OBSERVACIONES / NOTAS (OPCIONAL)" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource BrushTextMuted}" Margin="0,0,0,6"/>
                            <TextBox Text="{Binding Notes, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource ModernTextBox}" Height="44"/>
                        </StackPanel>
                    </Grid>

                    <!-- Botones de Acción -->
                    <Grid Margin="0,8,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="2.5*"/>
                            <ColumnDefinition Width="1*"/>
                        </Grid.ColumnDefinitions>

                        <Button Grid.Column="0"
                                Command="{Binding RegisterAndPrintCommand}"
                                Style="{StaticResource ModernButton}"
                                Height="56"
                                Margin="0,0,14,0">
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                <Path Data="{StaticResource IconReceipt}" Fill="{DynamicResource BrushTextWhite}" Width="20" Height="20" Stretch="Uniform" Margin="0,0,10,0"/>
                                <TextBlock Text="Registrar e Imprimir Entrada" FontSize="16" FontWeight="Black" Foreground="{DynamicResource BrushTextWhite}"/>
                            </StackPanel>
                        </Button>

                        <Button Grid.Column="1"
                                Content="Limpiar Formulario"
                                Command="{Binding ClearFormCommand}"
                                Style="{StaticResource SecondaryButton}"
                                Height="56"
                                FontSize="13"
                                FontWeight="Bold"/>
                    </Grid>
                </StackPanel>
            </Border>
        </Grid>
    </ScrollViewer>
</UserControl>
