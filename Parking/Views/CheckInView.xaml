<UserControl x:Class="Parking.Views.CheckInView"
              xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
              xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
              xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
              xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
              xmlns:conv="clr-namespace:Parking.Core.Converters"
              xmlns:enums="clr-namespace:Parking.Core.Enums"
              mc:Ignorable="d"
              d:DesignHeight="700" d:DesignWidth="1000">

    <UserControl.Resources>
        <conv:CurrencyConverter x:Key="CurrencyConv"/>
        <conv:VehicleTypeToBadgeColorConverter x:Key="VehicleBadgeConv"/>
        <conv:VehicleTypeToStringConverter x:Key="VehicleTypeStrConv"/>
        <conv:BooleanToVisibilityConverter x:Key="BoolToVis"/>
    </UserControl.Resources>

    <Grid Margin="24">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="1.3*"/>
            <ColumnDefinition Width="1*"/>
        </Grid.ColumnDefinitions>

        <Border Grid.Column="0"
                Style="{StaticResource ModernCard}"
                Margin="0,0,16,0">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <Grid Margin="0,0,0,20">
                        <StackPanel>
                            <TextBlock Text="Registro de Entrada de Vehículo" Style="{StaticResource TextHeaderMedium}"/>
                            <TextBlock Text="Capture los datos del vehículo, asigne la bahía y emita el tiquete de ingreso" Style="{StaticResource TextBodySecondary}" Margin="0,4,0,0"/>
                        </StackPanel>
                    </Grid>

                    <Border Background="{DynamicResource BrushSuccessBg}"
                            BorderBrush="{DynamicResource BrushSuccess}"
                            BorderThickness="1"
                            CornerRadius="8"
                            Padding="14,10"
                            Margin="0,0,0,16"
                            Visibility="{Binding HasFeedback, Converter={StaticResource BoolToVis}}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Path Grid.Column="0" Data="{StaticResource IconCheck}" Fill="{DynamicResource BrushSuccess}" Width="16" Height="16" Stretch="Uniform" Margin="0,0,10,0" VerticalAlignment="Center"/>
                            <TextBlock Grid.Column="1" Text="{Binding FeedbackMessage}" Foreground="{DynamicResource BrushSuccess}" FontSize="12" FontWeight="SemiBold" TextWrapping="Wrap" VerticalAlignment="Center"/>
                        </Grid>
                    </Border>

                    <TextBlock Text="NÚMERO DE PLACA" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource BrushTextMuted}" Margin="0,0,0,6"/>
                    <TextBox Text="{Binding PlateNumber, UpdateSourceTrigger=PropertyChanged}"
                             Style="{StaticResource PlateInputTextBox}"
                             Margin="0,0,0,18"/>

                    <TextBlock Text="SELECCIONAR CATEGORÍA DE VEHÍCULO" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource BrushTextMuted}" Margin="0,0,0,10"/>
                    <ItemsControl ItemsSource="{Binding AvailableRates}" Margin="0,0,0,18">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <UniformGrid Columns="3" Rows="2"/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Button Command="{Binding DataContext.SelectVehicleTypeCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                        CommandParameter="{Binding VehicleType}"
                                        Margin="4"
                                        Padding="0"
                                        Style="{StaticResource SecondaryButton}"
                                        HorizontalContentAlignment="Stretch"
                                        VerticalContentAlignment="Stretch">
                                    <Border CornerRadius="8" Padding="12,10" Background="Transparent">
                                        <StackPanel HorizontalAlignment="Center">
                                            <TextBlock Text="{Binding DisplayName}" FontWeight="Bold" FontSize="13" Foreground="{DynamicResource BrushTextPrimary}" HorizontalAlignment="Center"/>
                                            <TextBlock Text="{Binding HourlyRate, Converter={StaticResource CurrencyConv}, StringFormat='{}{0}/h'}"
                                                       FontSize="12"
                                                       FontWeight="SemiBold"
                                                       Foreground="{DynamicResource BrushCyan}"
                                                       HorizontalAlignment="Center"
                                                       Margin="0,3,0,0"/>
                                            <TextBlock Text="{Binding GracePeriodMinutes, StringFormat='{}{0} min gracia'}"
                                                       FontSize="10"
                                                       Foreground="{DynamicResource BrushTextMuted}"
                                                       HorizontalAlignment="Center"
                                                       Margin="0,2,0,0"/>
                                        </StackPanel>
                                    </Border>
                                </Button>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <Grid Margin="0,0,0,18">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0" Margin="0,0,8,0">
                            <TextBlock Text="TELÉFONO DEL CONDUCTOR / CLIENTE (OPCIONAL)" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource BrushTextMuted}" Margin="0,0,0,6"/>
                            <TextBox Text="{Binding PhoneNumber, UpdateSourceTrigger=PropertyChanged}"
                                     Style="{StaticResource ModernTextBox}"/>
                        </StackPanel>

                        <StackPanel Grid.Column="1" Margin="8,0,0,0">
                            <TextBlock Text="RESUMEN DE TARIFA" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource BrushTextMuted}" Margin="0,0,0,6"/>
                            <Border Background="{DynamicResource BrushInputBackground}" CornerRadius="8" Padding="12,10" BorderBrush="{DynamicResource BrushBorderSubtle}" BorderThickness="1">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding CurrentRate.DisplayName}" Foreground="{DynamicResource BrushTextPrimary}" FontWeight="Bold" FontSize="12" Margin="0,0,8,0"/>
                                    <TextBlock Text="{Binding CurrentRate.HourlyRate, Converter={StaticResource CurrencyConv}, StringFormat='- {0}/hora'}" Foreground="{DynamicResource BrushPrimary}" FontSize="12"/>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </Grid>

                    <TextBlock Text="OBSERVACIONES / NOTAS (OPCIONAL)" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource BrushTextMuted}" Margin="0,0,0,6"/>
                    <TextBox Text="{Binding Notes, UpdateSourceTrigger=PropertyChanged}"
                             Style="{StaticResource ModernTextBox}"
                             Height="60"
                             AcceptsReturn="True"
                             TextWrapping="Wrap"
                             Margin="0,0,0,24"/>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="2*"/>
                            <ColumnDefinition Width="1*"/>
                        </Grid.ColumnDefinitions>

                        <Button Grid.Column="0"
                                Command="{Binding RegisterAndPrintCommand}"
                                Style="{StaticResource ModernButton}"
                                Height="46"
                                Margin="0,0,10,0">
                            <Button.ContentTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal">
                                        <Path Data="{StaticResource IconReceipt}" Fill="{DynamicResource BrushTextWhite}" Width="16" Height="16" Stretch="Uniform" Margin="0,0,8,0"/>
                                        <TextBlock Text="Registrar e Imprimir Tiquete" FontSize="14" FontWeight="Bold" Foreground="{DynamicResource BrushTextWhite}" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </DataTemplate>
                            </Button.ContentTemplate>
                        </Button>

                        <Button Grid.Column="1"
                                Content="Limpiar"
                                Command="{Binding ClearFormCommand}"
                                Style="{StaticResource SecondaryButton}"
                                Height="46"/>
                    </Grid>
                </StackPanel>
            </ScrollViewer>
        </Border>

        <Border Grid.Column="1"
                Style="{StaticResource ModernCard}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <Grid Grid.Row="0" Margin="0,0,0,16">
                    <StackPanel>
                        <TextBlock Text="Entradas Recientes del Turno" Style="{StaticResource TextHeaderSmall}"/>
                        <TextBlock Text="Vehículos registrados durante la sesión activa actual" Style="{StaticResource TextCaption}" Margin="0,2,0,0"/>
                    </StackPanel>
                </Grid>

                <ItemsControl Grid.Row="1" ItemsSource="{Binding RecentEntries}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Background="{DynamicResource BrushSurfaceElevated}"
                                    BorderBrush="{DynamicResource BrushBorderSubtle}"
                                    BorderThickness="1"
                                    CornerRadius="8"
                                    Padding="14,10"
                                    Margin="0,0,0,10">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <Border Grid.Column="0"
                                            Width="34"
                                            Height="34"
                                            CornerRadius="8"
                                            Background="{Binding VehicleType, Converter={StaticResource VehicleBadgeConv}}"
                                            Margin="0,0,12,0"
                                            VerticalAlignment="Center">
                                        <Path Data="{StaticResource IconCar}" Fill="{DynamicResource BrushTextWhite}" Width="16" Height="16" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>

                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding PlateNumber}" FontFamily="{StaticResource FontFamilyMonospace}" FontWeight="Bold" FontSize="15" Foreground="{DynamicResource BrushTextPrimary}"/>
                                        <TextBlock Text="{Binding EntryTime, StringFormat='{}Registrado a las {0:HH:mm:ss}'}" FontSize="11" Foreground="{DynamicResource BrushTextSecondary}"/>
                                    </StackPanel>

                                    <StackPanel Grid.Column="2" HorizontalAlignment="Right" VerticalAlignment="Center">
                                        <Border Background="{DynamicResource BrushSurfaceLight}" BorderBrush="{DynamicResource BrushBorderSubtle}" BorderThickness="1" CornerRadius="6" Padding="8,3" HorizontalAlignment="Right">
                                            <TextBlock Text="{Binding BayNumber, StringFormat='{}Bahía {0}'}" FontWeight="Bold" FontSize="11" Foreground="{DynamicResource BrushPrimary}"/>
                                        </Border>
                                        <TextBlock Text="{Binding HourlyRate, Converter={StaticResource CurrencyConv}, StringFormat='{}{0}/h'}" FontSize="11" Foreground="{DynamicResource BrushCyan}" HorizontalAlignment="Right" Margin="0,2,0,0"/>
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </Grid>
        </Border>
    </Grid>
</UserControl>
