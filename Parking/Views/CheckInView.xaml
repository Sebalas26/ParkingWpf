<UserControl x:Class="Parking.Views.CheckInView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:conv="clr-namespace:Parking.Core.Converters"
             xmlns:enums="clr-namespace:Parking.Core.Enums"
             mc:Ignorable="d"
             d:DesignHeight="900" d:DesignWidth="1280"
             UseLayoutRounding="True"
             SnapsToDevicePixels="True"
             TextOptions.TextFormattingMode="Display"
             TextOptions.TextRenderingMode="ClearType"
             RenderOptions.ClearTypeHint="Enabled"
             RenderOptions.BitmapScalingMode="HighQuality">

    <UserControl.Resources>
        <conv:CurrencyConverter x:Key="CurrencyConv"/>
        <conv:VehicleTypeToStringConverter x:Key="VehicleTypeStrConv"/>
        <conv:VehicleTypeToIconConverter x:Key="VehicleIconConv"/>
        <conv:BooleanToVisibilityConverter x:Key="BoolToVis"/>
        <conv:EqualityToBooleanConverter x:Key="EqualityConv"/>

        <!-- Estilo de Selector de Categoría con Estado Activo / Seleccionado Evidente -->
        <Style x:Key="CategoryOptionRadioButton" TargetType="RadioButton">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Margin" Value="0,0,10,10"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="CardBorder"
                                Background="{DynamicResource BrushSurfaceBackground}"
                                BorderBrush="{DynamicResource BrushBorderMedium}"
                                BorderThickness="1.5"
                                CornerRadius="12"
                                Padding="14,12"
                                MinHeight="68"
                                SnapsToDevicePixels="True">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <!-- Icon Container -->
                                <Border x:Name="IconContainer"
                                        Grid.Column="0"
                                        Width="44" Height="44"
                                        CornerRadius="10"
                                        Background="#F1F5F9"
                                        Margin="0,0,12,0"
                                        VerticalAlignment="Center">
                                    <Path x:Name="IconPath"
                                          Data="{Binding VehicleType, Converter={StaticResource VehicleIconConv}}"
                                          Fill="{DynamicResource BrushPrimary}"
                                          Width="22" Height="22"
                                          Stretch="Uniform"
                                          HorizontalAlignment="Center"
                                          VerticalAlignment="Center"/>
                                </Border>

                                <!-- Text -->
                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <TextBlock x:Name="TitleText"
                                               Text="{Binding DisplayName}"
                                               FontWeight="Bold"
                                               FontSize="15"
                                               Foreground="{DynamicResource BrushTextPrimary}"
                                               TextTrimming="CharacterEllipsis"/>
                                    <TextBlock x:Name="RateText"
                                               Text="{Binding HourRate, Converter={StaticResource CurrencyConv}, StringFormat='{}{0} / hora'}"
                                               FontSize="13"
                                               FontWeight="Bold"
                                               Foreground="{DynamicResource BrushPrimary}"
                                               Margin="0,3,0,0"/>
                                </StackPanel>

                                <!-- Checkmark badge when selected -->
                                <Border x:Name="CheckBadge"
                                        Grid.Column="2"
                                        Width="22" Height="22"
                                        CornerRadius="11"
                                        Background="{DynamicResource BrushPrimary}"
                                        Visibility="Collapsed"
                                        VerticalAlignment="Center"
                                        Margin="8,0,0,0">
                                    <Path Data="{StaticResource IconCheck}"
                                          Fill="{DynamicResource BrushTextWhite}"
                                          Width="11" Height="11"
                                          Stretch="Uniform"
                                          HorizontalAlignment="Center"
                                          VerticalAlignment="Center"/>
                                </Border>
                            </Grid>
                        </Border>

                        <ControlTemplate.Triggers>
                            <!-- Hover state -->
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="CardBorder" Property="BorderBrush" Value="{DynamicResource BrushPrimary}"/>
                                <Setter TargetName="CardBorder" Property="Background" Value="#F8FAFC"/>
                            </Trigger>

                            <!-- Selected / Checked state -->
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="CardBorder" Property="Background" Value="#EBF6F8"/>
                                <Setter TargetName="CardBorder" Property="BorderBrush" Value="{DynamicResource BrushPrimary}"/>
                                <Setter TargetName="CardBorder" Property="BorderThickness" Value="2"/>
                                <Setter TargetName="IconContainer" Property="Background" Value="{DynamicResource BrushPrimary}"/>
                                <Setter TargetName="IconPath" Property="Fill" Value="{DynamicResource BrushTextWhite}"/>
                                <Setter TargetName="TitleText" Property="Foreground" Value="{DynamicResource BrushPrimary}"/>
                                <Setter TargetName="TitleText" Property="FontWeight" Value="Black"/>
                                <Setter TargetName="CheckBadge" Property="Visibility" Value="Visible"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Estilo de Tecla Virtual Táctil -->
        <Style x:Key="TouchKeyButton" TargetType="Button">
            <Setter Property="Background" Value="{DynamicResource BrushSurfaceBackground}"/>
            <Setter Property="Foreground" Value="{DynamicResource BrushTextPrimary}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BrushBorderMedium}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontSize" Value="17"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Height" Value="40"/>
            <Setter Property="Margin" Value="2"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6"
                                SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="{DynamicResource BrushPrimary}"/>
                                <Setter Property="Foreground" Value="{DynamicResource BrushTextWhite}"/>
                                <Setter TargetName="border" Property="BorderBrush" Value="{DynamicResource BrushPrimary}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Background" Value="{DynamicResource BrushSidebarItemActive}"/>
                                <Setter Property="Foreground" Value="{DynamicResource BrushTextWhite}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="TouchKeyActionButton" TargetType="Button" BasedOn="{StaticResource TouchKeyButton}">
            <Setter Property="Background" Value="#F1F5F9"/>
            <Setter Property="Foreground" Value="{DynamicResource BrushPrimary}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BrushBorderMedium}"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="Black"/>
        </Style>
    </UserControl.Resources>

    <!-- Grid Principal Responsive en 2 Columnas (100% del Ancho de Pantalla) -->
    <Grid Margin="20">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="1.35*" MinWidth="480"/>
            <ColumnDefinition Width="1*" MinWidth="360"/>
        </Grid.ColumnDefinitions>

        <!-- ========================================================================= -->
        <!-- COLUMNA IZQUIERDA: Formulario Principal de Captura e Ingreso -->
        <!-- ========================================================================= -->
        <Border Grid.Column="0"
                Style="{StaticResource ModernCard}"
                Margin="0,0,16,0"
                Padding="22">
            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <StackPanel>


                    <!-- 2. Alerta de Feedback (Informativo / Advertencia en Amarillo Institucional) -->
                    <Border Visibility="{Binding HasFeedback, Converter={StaticResource BoolToVis}}"
                            CornerRadius="10"
                            Padding="14,10"
                            Margin="0,0,0,16">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="Background" Value="{DynamicResource BrushSuccessBg}"/>
                                <Setter Property="BorderBrush" Value="{DynamicResource BrushSuccess}"/>
                                <Setter Property="BorderThickness" Value="1"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsSuccessFeedback}" Value="False">
                                        <Setter Property="Background" Value="{DynamicResource BrushWarningBg}"/>
                                        <Setter Property="BorderBrush" Value="{DynamicResource BrushWarning}"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <TextBlock Text="{Binding FeedbackMessage}" FontSize="14" FontWeight="Bold" TextWrapping="Wrap">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Foreground" Value="{DynamicResource BrushSuccessText}"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsSuccessFeedback}" Value="False">
                                            <Setter Property="Foreground" Value="{DynamicResource BrushWarningText}"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </Border>

                    <!-- 3. Caja Panorámica de Placa -->
                    <Border Background="#F8FAFC"
                            BorderBrush="{DynamicResource BrushBorderMedium}"
                            BorderThickness="1"
                            CornerRadius="14"
                            Padding="18,14"
                            Margin="0,0,0,16">
                        <StackPanel>
                            <!-- Header de Placa con Botón Teclado -->
                            <Grid Margin="0,0,0,10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                                    <Border Background="{DynamicResource BrushPrimary}" Width="24" Height="24" CornerRadius="6" Margin="0,0,8,0" VerticalAlignment="Center">
                                        <Path Data="{StaticResource IconCar}" Fill="{DynamicResource BrushTextWhite}" Width="13" Height="13" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <TextBlock Text="DIGITE LA PLACA DEL VEHÍCULO *" FontSize="14" FontWeight="Black" Foreground="{DynamicResource BrushPrimary}" VerticalAlignment="Center"/>
                                </StackPanel>

                                <!-- Botón Teclado Táctil -->
                                <Button Grid.Column="1"
                                        Command="{Binding ToggleVirtualKeyboardCommand}"
                                        Style="{StaticResource SecondaryButton}"
                                        Padding="10,4"
                                        ToolTip="Abrir o cerrar teclado virtual para pantalla táctil">
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <Path Data="{StaticResource IconKeyboard}" Fill="{DynamicResource BrushPrimary}" Width="14" Height="14" Stretch="Uniform" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                        <TextBlock Text="Teclado Táctil" FontSize="13" FontWeight="Bold" Foreground="{DynamicResource BrushPrimary}" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Button>
                            </Grid>

                            <!-- Input Masivo de Placa -->
                            <TextBox x:Name="PlateTextBox"
                                     Text="{Binding PlateNumber, UpdateSourceTrigger=PropertyChanged}"
                                     Style="{StaticResource PlateInputTextBox}"
                                     Height="160"
                                     FontSize="90"
                                     KeyDown="PlateTextBox_KeyDown"
                                     Margin="0,0,0,6">
                                <TextBox.InputBindings>
                                    <KeyBinding Key="Return" Command="{Binding RegisterAndPrintCommand}"/>
                                    <KeyBinding Key="Enter" Command="{Binding RegisterAndPrintCommand}"/>
                                </TextBox.InputBindings>
                            </TextBox>

                            <!-- Banner de Suscriptor Mensual Activo -->
                            <Border Visibility="{Binding IsMonthlySubscriber, Converter={StaticResource BoolToVis}}"
                                    Background="{DynamicResource BrushSuccessBg}"
                                    BorderBrush="{DynamicResource BrushSuccess}"
                                    BorderThickness="1.5"
                                    CornerRadius="8"
                                    Padding="12,8"
                                    Margin="0,4,0,8">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <Border Grid.Column="0" Width="22" Height="22" CornerRadius="11" Background="{DynamicResource BrushSuccess}" Margin="0,0,8,0" VerticalAlignment="Center">
                                        <Path Data="{StaticResource IconCheck}" Fill="{DynamicResource BrushTextWhite}" Width="10" Height="10" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                        <TextBlock Text="VEHÍCULO CON MENSUALIDAD ACTIVA" FontWeight="Black" FontSize="13" Foreground="{DynamicResource BrushSuccessText}"/>
                                        <TextBlock FontSize="12" Foreground="{DynamicResource BrushTextPrimary}">
                                            <Run Text="Abonado: " FontWeight="SemiBold"/>
                                            <Run Text="{Binding ActiveSubscription.CustomerName, Mode=OneWay}" FontWeight="Bold"/>
                                            <Run Text=" • Doc: "/>
                                            <Run Text="{Binding ActiveSubscription.CustomerDocument, Mode=OneWay}"/>
                                            <Run Text=" • Vence: "/>
                                            <Run Text="{Binding ActiveSubscription.EndDate, StringFormat='{}{0:yyyy-MM-dd}'}" FontWeight="Bold"/>
                                        </TextBlock>
                                    </StackPanel>
                                    <Border Grid.Column="2" Background="{DynamicResource BrushSuccess}" CornerRadius="6" Padding="6,3" VerticalAlignment="Center">
                                        <TextBlock Text="TARIFA $0.00" FontSize="12" FontWeight="Black" Foreground="{DynamicResource BrushTextWhite}"/>
                                    </Border>
                                </Grid>
                            </Border>

                            <!-- Banner de Placa Bloqueada / Lista Negra (Alerta Destacada) -->
                            <Border Visibility="{Binding IsPlateBlocked, Converter={StaticResource BoolToVis}}"
                                    Background="#FEF2F2"
                                    BorderBrush="{DynamicResource BrushDanger}"
                                    BorderThickness="2"
                                    CornerRadius="8"
                                    Padding="14,10"
                                    Margin="0,4,0,8">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <Border Grid.Column="0" Width="26" Height="26" CornerRadius="13" Background="{DynamicResource BrushDanger}" Margin="0,0,10,0" VerticalAlignment="Center">
                                        <Path Data="{StaticResource IconLock}" Fill="{DynamicResource BrushTextWhite}" Width="12" Height="12" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="⛔ VEHÍCULO BLOQUEADO (INGRESO RESTRINGIDO)" FontWeight="Black" FontSize="13" Foreground="{DynamicResource BrushDanger}"/>
                                            <Border Background="{DynamicResource BrushDanger}" CornerRadius="4" Padding="6,1" Margin="8,0,0,0" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding BlockedIncidentType, FallbackValue='LISTA NEGRA'}" FontSize="11" FontWeight="Black" Foreground="{DynamicResource BrushTextWhite}"/>
                                            </Border>
                                        </StackPanel>
                                        <TextBlock FontSize="12" Foreground="{DynamicResource BrushTextPrimary}" Margin="0,2,0,0" TextWrapping="Wrap">
                                            <Run Text="Motivo: " FontWeight="Bold" Foreground="{DynamicResource BrushDanger}"/>
                                            <Run Text="{Binding BlockedDescription, Mode=OneWay}"/>
                                        </TextBlock>
                                    </StackPanel>
                                    <Border Grid.Column="2" Background="#FEE2E2" BorderBrush="{DynamicResource BrushDanger}" BorderThickness="1" CornerRadius="6" Padding="8,4" VerticalAlignment="Center">
                                        <TextBlock Text="BLOQUEADO" FontSize="11" FontWeight="Black" Foreground="{DynamicResource BrushDanger}"/>
                                    </Border>
                                </Grid>
                            </Border>

                            <!-- Teclado Virtual en Pantalla (Desplegable) -->
                            <Border Visibility="{Binding IsVirtualKeyboardVisible, Converter={StaticResource BoolToVis}}"
                                    Background="#EDF2F7"
                                    BorderBrush="{DynamicResource BrushBorderMedium}"
                                    BorderThickness="1"
                                    CornerRadius="10"
                                    Padding="8"
                                    Margin="0,10,0,0">
                                <StackPanel>
                                    <!-- Fila de Números -->
                                    <UniformGrid Columns="10" Rows="1">
                                        <Button Content="1" Style="{StaticResource TouchKeyButton}" Command="{Binding AppendVirtualKeyCommand}" CommandParameter="1"/>
                                        <Button Content="2" Style="{StaticResource TouchKeyButton}" Command="{Binding AppendVirtualKeyCommand}" CommandParameter="2"/>
                                        <Button Content="3" Style="{StaticResource TouchKeyButton}" Command="{Binding AppendVirtualKeyCommand}" CommandParameter="3"/>
                                        <Button Content="4" Style="{StaticResource TouchKeyButton}" Command="{Binding AppendVirtualKeyCommand}" CommandParameter="4"/>
                                        <Button Content="5" Style="{StaticResource TouchKeyButton}" Command="{Binding AppendVirtualKeyCommand}" CommandParameter="5"/>
                                        <Button Content="6" Style="{StaticResource TouchKeyButton}" Command="{Binding AppendVirtualKeyCommand}" CommandParameter="6"/>
                                        <Button Content="7" Style="{StaticResource TouchKeyButton}" Command="{Binding AppendVirtualKeyCommand}" CommandParameter="7"/>
                                        <Button Content="8" Style="{StaticResource TouchKeyButton}" Command="{Binding AppendVirtualKeyCommand}" CommandParameter="8"/>
                                        <Button Content="9" Style="{StaticResource TouchKeyButton}" Command="{Binding AppendVirtualKeyCommand}" CommandParameter="9"/>
                                        <Button Content="0" Style="{StaticResource TouchKeyButton}" Command="{Binding AppendVirtualKeyCommand}" CommandParameter="0"/>
                                    </UniformGrid>

                                    <!-- Fila Q - P -->
                                    <UniformGrid Columns="10" Rows="1">
                                        <Button Content="Q" Style="{StaticResource TouchKeyButton}" Command="{Binding AppendVirtualKeyCommand}" CommandParameter="Q"/>
                                        <Button Content="W" Style="{StaticResource TouchKeyButton}" Command="{Binding AppendVirtualKeyCommand}" CommandParameter="W"/>
                                        <Button Content="E" Style="{StaticResource TouchKeyButton}" Command="{Binding AppendVirtualKeyCommand}" CommandParameter="E"/>
                                        <Button Content="R" Style="{StaticResource TouchKeyButton}" Command="{Binding AppendVirtualKeyCommand}" CommandParameter="R"/>
                                        <Button Content="T" Style="{StaticResource TouchKeyButton}" Command="{Binding AppendVirtualKeyCommand}" CommandParameter="T"/>
                                        <Button Content="Y" Style="{StaticResource TouchKeyButton}" Command="{Binding AppendVirtualKeyCommand}" CommandParameter="Y"/>
                                        <Button Content="U" Style="{StaticResource TouchKeyButton}" Command="{Binding AppendVirtualKeyCommand}" CommandParameter="U"/>
                                        <Button Content="I" Style="{StaticResource TouchKeyButton}" Command="{Binding AppendVirtualKeyCommand}" CommandParameter="I"/>
                                        <Button Content="O" Style="{StaticResource TouchKeyButton}" Command="{Binding AppendVirtualKeyCommand}" CommandParameter="O"/>
                                        <Button Content="P" Style="{StaticResource TouchKeyButton}" Command="{Binding AppendVirtualKeyCommand}" CommandParameter="P"/>
                                    </UniformGrid>

                                    <!-- Fila A - L -->
                                    <UniformGrid Columns="9" Rows="1" Margin="14,0,14,0">
                                        <Button Content="A" Style="{StaticResource TouchKeyButton}" Command="{Binding AppendVirtualKeyCommand}" CommandParameter="A"/>
                                        <Button Content="S" Style="{StaticResource TouchKeyButton}" Command="{Binding AppendVirtualKeyCommand}" CommandParameter="S"/>
                                        <Button Content="D" Style="{StaticResource TouchKeyButton}" Command="{Binding AppendVirtualKeyCommand}" CommandParameter="D"/>
                                        <Button Content="F" Style="{StaticResource TouchKeyButton}" Command="{Binding AppendVirtualKeyCommand}" CommandParameter="F"/>
                                        <Button Content="G" Style="{StaticResource TouchKeyButton}" Command="{Binding AppendVirtualKeyCommand}" CommandParameter="G"/>
                                        <Button Content="H" Style="{StaticResource TouchKeyButton}" Command="{Binding AppendVirtualKeyCommand}" CommandParameter="H"/>
                                        <Button Content="J" Style="{StaticResource TouchKeyButton}" Command="{Binding AppendVirtualKeyCommand}" CommandParameter="J"/>
                                        <Button Content="K" Style="{StaticResource TouchKeyButton}" Command="{Binding AppendVirtualKeyCommand}" CommandParameter="K"/>
                                        <Button Content="L" Style="{StaticResource TouchKeyButton}" Command="{Binding AppendVirtualKeyCommand}" CommandParameter="L"/>
                                    </UniformGrid>

                                    <!-- Fila Z - M + Acciones -->
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="1.3*"/>
                                            <ColumnDefinition Width="7*"/>
                                            <ColumnDefinition Width="1.3*"/>
                                        </Grid.ColumnDefinitions>

                                        <Button Grid.Column="0" Content="Limpiar" Style="{StaticResource TouchKeyActionButton}" Command="{Binding AppendVirtualKeyCommand}" CommandParameter="CLEAR"/>

                                        <UniformGrid Grid.Column="1" Columns="7" Rows="1">
                                            <Button Content="Z" Style="{StaticResource TouchKeyButton}" Command="{Binding AppendVirtualKeyCommand}" CommandParameter="Z"/>
                                            <Button Content="X" Style="{StaticResource TouchKeyButton}" Command="{Binding AppendVirtualKeyCommand}" CommandParameter="X"/>
                                            <Button Content="C" Style="{StaticResource TouchKeyButton}" Command="{Binding AppendVirtualKeyCommand}" CommandParameter="C"/>
                                            <Button Content="V" Style="{StaticResource TouchKeyButton}" Command="{Binding AppendVirtualKeyCommand}" CommandParameter="V"/>
                                            <Button Content="B" Style="{StaticResource TouchKeyButton}" Command="{Binding AppendVirtualKeyCommand}" CommandParameter="B"/>
                                            <Button Content="N" Style="{StaticResource TouchKeyButton}" Command="{Binding AppendVirtualKeyCommand}" CommandParameter="N"/>
                                            <Button Content="M" Style="{StaticResource TouchKeyButton}" Command="{Binding AppendVirtualKeyCommand}" CommandParameter="M"/>
                                        </UniformGrid>

                                        <Button Grid.Column="2" Content="⌫ Borrar" Style="{StaticResource TouchKeyActionButton}" Command="{Binding AppendVirtualKeyCommand}" CommandParameter="BACKSPACE"/>
                                    </Grid>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </Border>

                    <!-- 4. Selector de Categorías de Vehículo (ComboBox Moderno) -->
                    <TextBlock Text="SELECCIONE LA CATEGORÍA DE VEHÍCULO *" FontSize="13" FontWeight="Bold" Foreground="{DynamicResource BrushTextMuted}" Margin="0,0,0,8"/>
                    
                    <!-- Banner de Advertencia cuando NO hay tarifas en BD (Empty State) -->
                    <Border Visibility="{Binding HasConfiguredRates, Converter={StaticResource BoolToVis}, ConverterParameter=Invert}"
                            Background="{DynamicResource BrushWarningBg}"
                            BorderBrush="{DynamicResource BrushWarning}"
                            BorderThickness="1.5"
                            CornerRadius="10"
                            Padding="16,14"
                            Margin="0,0,0,16">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Border Grid.Column="0" Width="36" Height="36" CornerRadius="18" Background="{DynamicResource BrushWarning}" Margin="0,0,12,0" VerticalAlignment="Center">
                                <Path Data="{StaticResource IconWarning}" Fill="{DynamicResource BrushTextWhite}" Width="16" Height="16" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock Text="TARIFAS VEHICULARES SIN CONFIGURAR EN ESTA SEDE" FontWeight="Black" FontSize="14" Foreground="{DynamicResource BrushWarningText}"/>
                                <TextBlock Text="No existen tipos de vehículos ni tarifas configuradas para la sede activa. Para habilitar el ingreso, registre las tarifas de esta sede en el catálogo correspondiente."
                                           FontSize="13" Foreground="{DynamicResource BrushTextPrimary}" TextWrapping="Wrap" Margin="0,2,0,0"/>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- ComboBox Selector de Tipo de Vehículo -->
                    <ComboBox ItemsSource="{Binding AvailableRates}"
                              SelectedItem="{Binding SelectedRate, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                              IsEnabled="{Binding HasConfiguredRates}"
                              Style="{StaticResource ModernComboBox}"
                              Height="54"
                              Margin="0,0,0,16">
                        <ComboBox.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="0,2">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <!-- Ícono del Vehículo -->
                                    <Border Grid.Column="0" Width="34" Height="34" CornerRadius="8" Background="#F1F5F9" Margin="0,0,10,0" VerticalAlignment="Center">
                                        <Path Data="{Binding VehicleType, Converter={StaticResource VehicleIconConv}}"
                                              Fill="{DynamicResource BrushPrimary}"
                                              Width="16" Height="16"
                                              Stretch="Uniform"
                                              HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                                    </Border>

                                    <!-- Nombre del Vehículo -->
                                    <TextBlock Grid.Column="1"
                                               Text="{Binding DisplayName}"
                                               FontWeight="Bold"
                                               FontSize="14"
                                               Foreground="{DynamicResource BrushTextPrimary}"
                                               VerticalAlignment="Center"/>

                                    <!-- Tarifa por Hora en Badge -->
                                    <Border Grid.Column="2"
                                            Background="#EBF6F8"
                                            CornerRadius="6"
                                            Padding="8,3"
                                            Margin="8,0,0,0"
                                            VerticalAlignment="Center">
                                        <TextBlock Text="{Binding HourRate, Converter={StaticResource CurrencyConv}, StringFormat='{}{0} / hora'}"
                                                   FontSize="12"
                                                   FontWeight="Bold"
                                                   Foreground="{DynamicResource BrushPrimary}"/>
                                    </Border>
                                </Grid>
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>

                    <!-- 5. Teléfono y Observaciones (Perfectamente Espaciados) -->
                    <Grid Margin="0,0,0,18">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="1*"/>
                            <ColumnDefinition Width="1.4*"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0" Margin="0,0,8,0">
                            <TextBlock Text="TELÉFONO DEL CONDUCTOR (OPCIONAL)" FontSize="12" FontWeight="Bold" Foreground="{DynamicResource BrushTextMuted}" Margin="0,0,0,4"/>
                            <TextBox Text="{Binding PhoneNumber, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource ModernTextBox}" Height="38"/>
                        </StackPanel>

                        <StackPanel Grid.Column="1" Margin="8,0,0,0">
                            <TextBlock Text="OBSERVACIONES / NOTAS (OPCIONAL)" FontSize="12" FontWeight="Bold" Foreground="{DynamicResource BrushTextMuted}" Margin="0,0,0,4"/>
                            <TextBox Text="{Binding Notes, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource ModernTextBox}" Height="38"/>
                        </StackPanel>
                    </Grid>

                    <!-- 6. Botones de Acción -->
                    <Grid Margin="0,4,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="2.4*"/>
                            <ColumnDefinition Width="1*"/>
                        </Grid.ColumnDefinitions>

                        <Button Grid.Column="0"
                                Command="{Binding RegisterAndPrintCommand}"
                                Height="48"
                                Margin="0,0,10,0">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource ModernButton}">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsPlateBlocked}" Value="True">
                                            <Setter Property="IsEnabled" Value="False"/>
                                            <Setter Property="Opacity" Value="0.45"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                <Path Data="{StaticResource IconReceipt}" Fill="{DynamicResource BrushTextWhite}" Width="16" Height="16" Stretch="Uniform" Margin="0,0,8,0"/>
                                <TextBlock Text="Registrar e Imprimir Entrada" FontSize="16" FontWeight="Black" Foreground="{DynamicResource BrushTextWhite}"/>
                            </StackPanel>
                        </Button>

                        <Button Grid.Column="1"
                                Content="Limpiar Formulario"
                                Command="{Binding ClearFormCommand}"
                                Style="{StaticResource SecondaryButton}"
                                Height="48"
                                FontSize="14"
                                FontWeight="Bold"/>
                    </Grid>
                </StackPanel>
            </ScrollViewer>
        </Border>

        <!-- ========================================================================= -->
        <!-- COLUMNA DERECHA: Panel de Monitoreo en Vivo, Tarifa Activa y Entradas -->
        <!-- ========================================================================= -->
        <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel>
                <!-- 1. Tarjeta de Tarifa Vigente Seleccionada -->
                <Border Style="{StaticResource ModernCard}" Padding="18" Margin="0,0,0,14">
                    <StackPanel>
                        <Grid Margin="0,0,0,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                                <Path Data="{StaticResource IconCreditCard}" Fill="{DynamicResource BrushPrimary}" Width="14" Height="14" Stretch="Uniform" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                <TextBlock Text="Tarifa Activa Seleccionada" FontSize="15" FontWeight="Bold" Foreground="{DynamicResource BrushTextPrimary}" VerticalAlignment="Center"/>
                            </StackPanel>
                            <Border Grid.Column="1" Background="#F1F5F9" CornerRadius="6" Padding="6,2">
                                <TextBlock Text="{Binding CurrentRate.DisplayName}" FontSize="12" FontWeight="Bold" Foreground="{DynamicResource BrushPrimary}"/>
                            </Border>
                        </Grid>

                        <!-- Píldoras de Desglose Tarifario -->
                        <Grid Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="1*"/>
                                <ColumnDefinition Width="1*"/>
                                <ColumnDefinition Width="1*"/>
                            </Grid.ColumnDefinitions>

                            <Border Grid.Column="0" Background="#F8FAFC" BorderBrush="{DynamicResource BrushBorderSubtle}" BorderThickness="1" CornerRadius="8" Padding="8,6" Margin="0,0,4,0">
                                <StackPanel HorizontalAlignment="Center">
                                    <TextBlock Text="POR MINUTO" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource BrushTextMuted}" HorizontalAlignment="Center"/>
                                    <TextBlock Text="{Binding CurrentRate.MinuteRate, Converter={StaticResource CurrencyConv}}" FontSize="15" FontWeight="Black" Foreground="{DynamicResource BrushTextPrimary}" HorizontalAlignment="Center" Margin="0,2,0,0"/>
                                </StackPanel>
                            </Border>

                            <Border Grid.Column="1" Background="#F8FAFC" BorderBrush="{DynamicResource BrushBorderSubtle}" BorderThickness="1" CornerRadius="8" Padding="8,6" Margin="2,0,2,0">
                                <StackPanel HorizontalAlignment="Center">
                                    <TextBlock Text="POR HORA" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource BrushTextMuted}" HorizontalAlignment="Center"/>
                                    <TextBlock Text="{Binding CurrentRate.HourRate, Converter={StaticResource CurrencyConv}}" FontSize="15" FontWeight="Black" Foreground="{DynamicResource BrushPrimary}" HorizontalAlignment="Center" Margin="0,2,0,0"/>
                                </StackPanel>
                            </Border>

                            <Border Grid.Column="2" Background="#F8FAFC" BorderBrush="{DynamicResource BrushBorderSubtle}" BorderThickness="1" CornerRadius="8" Padding="8,6" Margin="4,0,0,0">
                                <StackPanel HorizontalAlignment="Center">
                                    <TextBlock Text="DÍA COMPLETO" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource BrushTextMuted}" HorizontalAlignment="Center"/>
                                    <TextBlock Text="{Binding CurrentRate.FullDayRate, Converter={StaticResource CurrencyConv}}" FontSize="15" FontWeight="Black" Foreground="{DynamicResource BrushTextPrimary}" HorizontalAlignment="Center" Margin="0,2,0,0"/>
                                </StackPanel>
                            </Border>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- 2. Tarjeta de Ocupación en Tiempo Real -->
                <Border Style="{StaticResource ModernCard}" Padding="18" Margin="0,0,0,14">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,0,10">
                            <Path Data="{StaticResource IconCar}" Fill="{DynamicResource BrushPrimary}" Width="14" Height="14" Stretch="Uniform" Margin="0,0,6,0" VerticalAlignment="Center"/>
                            <TextBlock Text="Ocupación de Parqueadero" FontSize="15" FontWeight="Bold" Foreground="{DynamicResource BrushTextPrimary}" VerticalAlignment="Center"/>
                        </StackPanel>

                        <Grid Margin="0,0,0,6">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="1*"/>
                                <ColumnDefinition Width="1*"/>
                            </Grid.ColumnDefinitions>

                            <Border Grid.Column="0" Background="#DCFCE7" CornerRadius="8" Padding="10,6" Margin="0,0,4,0">
                                <StackPanel>
                                    <TextBlock Text="DISPONIBLES" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource BrushSuccessText}"/>
                                    <TextBlock Text="{Binding Occupancy.AvailableSlots, StringFormat='{}{0} cupos'}" FontSize="16" FontWeight="Black" Foreground="{DynamicResource BrushSuccessText}"/>
                                </StackPanel>
                            </Border>

                            <Border Grid.Column="1" Background="#FEF3C7" CornerRadius="8" Padding="10,6" Margin="4,0,0,0">
                                <StackPanel>
                                    <TextBlock Text="OCUPADOS" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource BrushWarningText}"/>
                                    <TextBlock Text="{Binding Occupancy.OccupiedSlots, StringFormat='{}{0} vehículos'}" FontSize="16" FontWeight="Black" Foreground="{DynamicResource BrushWarningText}"/>
                                </StackPanel>
                            </Border>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- 3. Tarjeta de Entradas Recientes en el Turno -->
                <Border Style="{StaticResource ModernCard}" Padding="18">
                    <StackPanel>
                        <Grid Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                                <Path Data="{StaticResource IconReceipt}" Fill="{DynamicResource BrushPrimary}" Width="14" Height="14" Stretch="Uniform" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                <TextBlock Text="Últimos Vehículos Ingresados" FontSize="15" FontWeight="Bold" Foreground="{DynamicResource BrushTextPrimary}" VerticalAlignment="Center"/>
                            </StackPanel>
                            <Border Grid.Column="1" Background="#F1F5F9" CornerRadius="6" Padding="6,2">
                                <TextBlock Text="Turno Activo" FontSize="12" FontWeight="Bold" Foreground="{DynamicResource BrushTextSecondary}"/>
                            </Border>
                        </Grid>

                        <!-- ItemsControl de Entradas Recientes -->
                        <ItemsControl ItemsSource="{Binding RecentEntries}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="#F8FAFC" BorderBrush="{DynamicResource BrushBorderSubtle}" BorderThickness="1" CornerRadius="8" Padding="10,6" Margin="0,0,0,6">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>

                                            <Border Grid.Column="0" Width="26" Height="26" CornerRadius="6" Background="{DynamicResource BrushPrimary}" Margin="0,0,8,0" VerticalAlignment="Center">
                                                <Path Data="{Binding VehicleType, Converter={StaticResource VehicleIconConv}}" Fill="{DynamicResource BrushTextWhite}" Width="12" Height="12" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Border>

                                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding PlateNumber}" FontFamily="{StaticResource FontFamilyMonospace}" FontSize="15" FontWeight="Black" Foreground="{DynamicResource BrushTextPrimary}"/>
                                                <TextBlock Text="{Binding VehicleType, Converter={StaticResource VehicleTypeStrConv}}" FontSize="12" Foreground="{DynamicResource BrushTextSecondary}"/>
                                            </StackPanel>

                                            <StackPanel Grid.Column="2" VerticalAlignment="Center" HorizontalAlignment="Right">
                                                <TextBlock Text="{Binding EntryTime, StringFormat='{}{0:HH:mm:ss}'}" FontSize="13" FontWeight="Bold" Foreground="{DynamicResource BrushPrimary}" HorizontalAlignment="Right"/>
                                                <TextBlock Text="{Binding TicketNumber}" FontSize="11" Foreground="{DynamicResource BrushTextMuted}" HorizontalAlignment="Right"/>
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
