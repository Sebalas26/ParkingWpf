<Window x:Class="Parking.Views.ReceiptPreviewDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:conv="clr-namespace:Parking.Core.Converters"
        mc:Ignorable="d"
        Title="Vista Previa del Tiquete"
        WindowStartupLocation="CenterOwner"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="#B3000000"
        ShowInTaskbar="False"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Display"
        TextOptions.TextRenderingMode="ClearType">

    <Window.Resources>
        <conv:CurrencyConverter x:Key="CurrencyConv"/>
        <conv:VehicleTypeToStringConverter x:Key="VehicleTypeStrConv"/>
        <conv:BooleanToVisibilityConverter x:Key="BoolToVis"/>
        <conv:BooleanToVisibilityConverter x:Key="InverseBoolToVis" Invert="True"/>
        <conv:NullToVisibilityConverter x:Key="NullToVis"/>
        <conv:Base64ToImageConverter x:Key="Base64ToImageConv"/>
    </Window.Resources>

    <Grid Background="Transparent">
        <Border Width="{Binding DialogWindowWidth}"
                MaxHeight="680"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Margin="24"
                Background="{DynamicResource BrushAppBackground}"
                BorderBrush="{DynamicResource BrushBorderMedium}"
                BorderThickness="1"
                CornerRadius="16"
                Padding="20">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- 1. Header Area -->
                <Grid Grid.Row="0" Margin="0,0,0,12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                        <Path Data="{StaticResource IconReceipt}" Fill="{DynamicResource BrushPrimary}" Width="16" Height="16" Stretch="Uniform" Margin="0,0,8,0"/>
                        <TextBlock Text="Vista Previa de Tiquete Térmico" FontSize="14" FontWeight="Bold" Foreground="{DynamicResource BrushTextPrimary}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                        <Button Command="{Binding TogglePaperWidthCommand}"
                                Background="#DCFCE7"
                                BorderBrush="#86EFAC"
                                BorderThickness="1"
                                Cursor="Hand"
                                Padding="6,2"
                                ToolTip="Clic para alternar formato (58 mm ⇄ 80 mm)"
                                VerticalAlignment="Center">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border Background="{TemplateBinding Background}"
                                            BorderBrush="{TemplateBinding BorderBrush}"
                                            BorderThickness="{TemplateBinding BorderThickness}"
                                            CornerRadius="4"
                                            Padding="{TemplateBinding Padding}">
                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                </ControlTemplate>
                            </Button.Template>
                            <TextBlock Text="{Binding PaperWidthBadgeText}" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource BrushPrimary}"/>
                        </Button>
                    </StackPanel>
                    <Button Grid.Column="1"
                            HorizontalAlignment="Right"
                            Command="{Binding CloseCommand}"
                            Style="{StaticResource SecondaryButton}"
                            Padding="4"
                            Width="26"
                            Height="26">
                        <Path Data="{StaticResource IconClose}" Fill="{DynamicResource BrushTextSecondary}" Width="10" Height="10" Stretch="Uniform"/>
                    </Button>
                </Grid>

                <!-- 2. Thermal Ticket Paper Container (Estilo POS Blanco y Negro) -->
                <ScrollViewer Grid.Row="1"
                              MaxHeight="490"
                              VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled"
                              Margin="0,0,0,12">
                    <Border Width="{Binding PaperContainerWidth}"
                            HorizontalAlignment="Center"
                            Background="#FFFFFF"
                            BorderBrush="{DynamicResource BrushBorderMedium}"
                            BorderThickness="1"
                            CornerRadius="0"
                            Padding="0,18">
                        <Grid x:Name="TicketPrintableContent" Width="{Binding PrintableContentWidth}" HorizontalAlignment="Center" Margin="0,0" Background="#FFFFFF">
                            <Border Padding="{Binding TicketPrintablePadding}">
                                <Grid>

                                    <!-- ============================================================= -->
                                    <!-- A. PLANTILLA RECIBO DE PAGO POS ESTÁNDAR                      -->
                                    <!-- ============================================================= -->
                                    <StackPanel Visibility="{Binding IsStandardExitReceipt, Converter={StaticResource BoolToVis}}"
                                                HorizontalAlignment="Stretch" Margin="0,0">

                                <!-- 1. Encabezado de Empresa / Sede -->
                                <Image Source="{Binding BranchLogoBase64, Converter={StaticResource Base64ToImageConv}}"
                                       MaxHeight="{Binding LogoMaxHeight}"
                                       MaxWidth="{Binding LogoMaxWidth}"
                                       Stretch="Uniform"
                                       HorizontalAlignment="Center"
                                       Margin="0,0,0,8"
                                       RenderOptions.BitmapScalingMode="HighQuality"
                                       Visibility="{Binding BranchLogoBase64, Converter={StaticResource NullToVis}}"/>
                                <TextBlock Text="{Binding BranchName}" FontSize="{Binding MonospaceTitleFontSize, FallbackValue=13}" FontWeight="Bold" FontFamily="{StaticResource FontFamilyMonospace}" Foreground="#000000" HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap"/>
                                <TextBlock Text="{Binding BranchNit}" FontSize="{Binding MonospaceFontSize, FallbackValue=11}" FontFamily="{StaticResource FontFamilyMonospace}" Foreground="#000000" HorizontalAlignment="Center" TextAlignment="Center" Margin="0,1"/>
                                <TextBlock Text="{Binding BranchAddress}" FontSize="{Binding MonospaceFontSize, FallbackValue=11}" FontFamily="{StaticResource FontFamilyMonospace}" Foreground="#000000" HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap" Margin="0,1"/>
                                <TextBlock Text="{Binding BranchPhone}" FontSize="{Binding MonospaceFontSize, FallbackValue=11}" FontFamily="{StaticResource FontFamilyMonospace}" Foreground="#000000" HorizontalAlignment="Center" TextAlignment="Center" Margin="0,1,0,4"/>
                                <TextBlock Text="{Binding BranchSchedule}"
                                           Visibility="{Binding HasBranchSchedule, Converter={StaticResource BoolToVis}}"
                                           FontSize="{Binding MonospaceFontSize, FallbackValue=9.5}"
                                           FontFamily="{StaticResource FontFamilyMonospace}"
                                           Foreground="#000000"
                                           HorizontalAlignment="Center"
                                           TextAlignment="Center"
                                           TextWrapping="Wrap"
                                           Margin="0,1,0,6"/>

                                <!-- Línea divisoria continua -->
                                <Rectangle Height="1" Fill="#000000" HorizontalAlignment="Stretch" Margin="6,0,6,8"/>

                                <!-- 2. Recibo POS y Consecutivo -->
                                <Grid Margin="0,0,0,4">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="RECIBO DE CAJA / POS:" FontSize="{Binding TicketHeaderFontSize, FallbackValue=11}" FontWeight="Bold" FontFamily="{StaticResource FontFamilyMonospace}" Foreground="#000000"/>
                                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding InvoiceNumberText}" FontSize="{Binding TicketNumberFontSize, FallbackValue=13}" FontWeight="Bold" FontFamily="{StaticResource FontFamilyMonospace}" Foreground="#000000"/>
                                    </StackPanel>
                                </Grid>

                                <!-- Fecha y Hora -->
                                <Grid Margin="0,2,0,4">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="FECHA:   " FontSize="{Binding MonospaceFontSize, FallbackValue=11}" FontWeight="Bold" FontFamily="{StaticResource FontFamilyMonospace}" Foreground="#000000"/>
                                    <TextBlock Grid.Column="1" Text="{Binding InvoiceDateStr}" FontSize="{Binding MonospaceFontSize, FallbackValue=11}" FontWeight="Bold" FontFamily="{StaticResource FontFamilyMonospace}" Foreground="#000000"/>
                                    <TextBlock Grid.Column="2" Text="{Binding InvoiceTimeStr}" FontSize="{Binding MonospaceFontSize, FallbackValue=11}" FontWeight="Bold" FontFamily="{StaticResource FontFamilyMonospace}" Foreground="#000000"/>
                                </Grid>

                                <!-- Cliente, NIT, Dir -->
                                <Grid Margin="0,1">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" MinWidth="55"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="CLIENTE:" FontSize="{Binding MonospaceFontSize, FallbackValue=11}" FontWeight="Bold" FontFamily="{StaticResource FontFamilyMonospace}" Foreground="#000000" Margin="0,0,4,0"/>
                                    <TextBlock Grid.Column="1" Text="{Binding CustomerName}" FontSize="{Binding MonospaceFontSize, FallbackValue=11}" FontWeight="Bold" FontFamily="{StaticResource FontFamilyMonospace}" Foreground="#000000" TextWrapping="Wrap"/>
                                </Grid>

                                <Grid Margin="0,1">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" MinWidth="55"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="{Binding CustomerIdTypeLabel}" FontSize="{Binding MonospaceFontSize, FallbackValue=11}" FontWeight="Bold" FontFamily="{StaticResource FontFamilyMonospace}" Foreground="#000000" Margin="0,0,4,0"/>
                                    <TextBlock Grid.Column="1" Text="{Binding CustomerNit}" FontSize="{Binding MonospaceFontSize, FallbackValue=11}" FontWeight="Bold" FontFamily="{StaticResource FontFamilyMonospace}" Foreground="#000000"/>
                                </Grid>

                                <Grid Margin="0,1,0,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" MinWidth="55"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="DIR:" FontSize="{Binding MonospaceFontSize, FallbackValue=11}" FontWeight="Bold" FontFamily="{StaticResource FontFamilyMonospace}" Foreground="#000000" Margin="0,0,4,0"/>
                                    <TextBlock Grid.Column="1" Text="{Binding CustomerAddress}" FontSize="{Binding MonospaceFontSize, FallbackValue=11}" FontWeight="Bold" FontFamily="{StaticResource FontFamilyMonospace}" Foreground="#000000" TextWrapping="Wrap"/>
                                </Grid>                                <!-- 3. Bloque Central de la Placa -->
                                <Border BorderBrush="#000000" BorderThickness="2" CornerRadius="4" Padding="6,4" HorizontalAlignment="Center" Margin="0,4,0,4">
                                    <TextBlock Text="{Binding Ticket.PlateNumber, StringFormat='{}PLACA:  {0}'}"
                                               FontSize="{Binding PlateFontSize, FallbackValue=15}"
                                               FontWeight="Black"
                                               FontFamily="{StaticResource FontFamilyMonospace}"
                                               Foreground="#000000"
                                               HorizontalAlignment="Center"/>
                                </Border>

                                <!-- Tipo de Vehículo y Tarifa -->
                                <StackPanel HorizontalAlignment="Center" Margin="0,0,0,6">
                                    <TextBlock Text="{Binding VehicleTypeName, StringFormat='{}VEHÍCULO: {0}'}" FontSize="{Binding MonospaceFontSize, FallbackValue=11}" FontWeight="Bold" FontFamily="{StaticResource FontFamilyMonospace}" Foreground="#000000" HorizontalAlignment="Center"/>
                                    <TextBlock Text="{Binding FormattedRateText}" FontSize="{Binding MonospaceFontSize, FallbackValue=11}" FontWeight="Bold" FontFamily="{StaticResource FontFamilyMonospace}" Foreground="#000000" HorizontalAlignment="Center" Margin="0,1,0,0" Visibility="{Binding FormattedRateText, Converter={StaticResource NullToVis}}"/>
                                </StackPanel>

                                <!-- Entrada, Salida, Tiempo -->
                                <Grid Margin="0,1">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="ENTRADA:" FontSize="{Binding MonospaceFontSize, FallbackValue=11}" FontFamily="{StaticResource FontFamilyMonospace}" Foreground="#000000"/>
                                    <TextBlock Grid.Column="1" Text="{Binding EntryTimeStr}" FontSize="{Binding MonospaceFontSize, FallbackValue=11}" FontFamily="{StaticResource FontFamilyMonospace}" Foreground="#000000" Margin="6,0,0,0"/>
                                    <TextBlock Grid.Column="2" Text="{Binding EntryDateStr}" FontSize="{Binding MonospaceFontSize, FallbackValue=11}" FontFamily="{StaticResource FontFamilyMonospace}" Foreground="#000000"/>
                                </Grid>

                                <Grid Margin="0,1">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="SALIDA: " FontSize="{Binding MonospaceFontSize, FallbackValue=11}" FontFamily="{StaticResource FontFamilyMonospace}" Foreground="#000000"/>
                                    <TextBlock Grid.Column="1" Text="{Binding ExitTimeStr}" FontSize="{Binding MonospaceFontSize, FallbackValue=11}" FontFamily="{StaticResource FontFamilyMonospace}" Foreground="#000000" Margin="6,0,0,0"/>
                                    <TextBlock Grid.Column="2" Text="{Binding ExitDateStr}" FontSize="{Binding MonospaceFontSize, FallbackValue=11}" FontFamily="{StaticResource FontFamilyMonospace}" Foreground="#000000"/>
                                </Grid>

                                <Grid Margin="0,1,0,6">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="TIEMPO: " FontSize="{Binding MonospaceFontSize, FallbackValue=11}" FontFamily="{StaticResource FontFamilyMonospace}" Foreground="#000000"/>
                                    <TextBlock Grid.Column="1" Text="{Binding DurationMinutesStr}" FontSize="{Binding MonospaceFontSize, FallbackValue=11}" FontFamily="{StaticResource FontFamilyMonospace}" Foreground="#000000" HorizontalAlignment="Right" Margin="0,0,4,0"/>
                                </Grid>

                                <!-- Recargo Tiquete Extraviado si aplica -->
                                <Grid Margin="0,1,0,2" Visibility="{Binding HasLostTicketSurcharge, Converter={StaticResource BoolToVis}}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="TIQUETE EXTRAVIADO:" FontSize="{Binding MonospaceFontSize, FallbackValue=11}" FontWeight="Bold" FontFamily="{StaticResource FontFamilyMonospace}" Foreground="#000000"/>
                                    <TextBlock Grid.Column="1" Text="{Binding LostTicketFeeText}" FontSize="{Binding MonospaceFontSize, FallbackValue=11}" FontWeight="Bold" FontFamily="{StaticResource FontFamilyMonospace}" Foreground="#000000"/>
                                </Grid>

                                <Rectangle Height="1" Fill="#000000" HorizontalAlignment="Stretch" Margin="0,0,0,6"/>

                                <!-- 4. Liquidación Económica (Subtotal, Convenio, Descuento, Base Gravable, IVA 19%, TOTAL) -->
                                <Grid Margin="0,2" Visibility="{Binding HasDiscount, Converter={StaticResource BoolToVis}}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="SUBTOTAL:" FontSize="{Binding MonospaceFontSize, FallbackValue=11}" FontWeight="Bold" FontFamily="{StaticResource FontFamilyMonospace}" Foreground="#000000"/>
                                    <TextBlock Grid.Column="1" Text="{Binding SubtotalStr, StringFormat='{}${0}'}" FontSize="{Binding MonospaceFontSize, FallbackValue=11}" FontWeight="Bold" FontFamily="{StaticResource FontFamilyMonospace}" Foreground="#000000"/>
                                </Grid>

                                <Grid Margin="0,2">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="CONVENIO:" FontSize="{Binding MonospaceFontSize, FallbackValue=11}" FontWeight="Bold" FontFamily="{StaticResource FontFamilyMonospace}" Foreground="#000000"/>
                                    <TextBlock Grid.Column="1" Text="{Binding AgreementDisplayName}" FontSize="{Binding MonospaceFontSize, FallbackValue=11}" FontWeight="Bold" FontFamily="{StaticResource FontFamilyMonospace}" Foreground="#000000"/>
                                </Grid>

                                <Grid Margin="0,2">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="DESCUENTO:" FontSize="{Binding MonospaceFontSize, FallbackValue=11}" FontFamily="{StaticResource FontFamilyMonospace}" Foreground="#000000"/>
                                    <TextBlock Grid.Column="1" Text="{Binding DiscountAmountStr}" FontSize="{Binding MonospaceFontSize, FallbackValue=11}" FontFamily="{StaticResource FontFamilyMonospace}" Foreground="#000000"/>
                                </Grid>

                                <Grid Margin="0,2">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="BASE GRAVABLE:" FontSize="{Binding MonospaceFontSize, FallbackValue=11}" FontWeight="Bold" FontFamily="{StaticResource FontFamilyMonospace}" Foreground="#000000"/>
                                    <TextBlock Grid.Column="1" Text="{Binding BaseGravableStr}" FontSize="{Binding MonospaceFontSize, FallbackValue=11}" FontWeight="Bold" FontFamily="{StaticResource FontFamilyMonospace}" Foreground="#000000"/>
                                </Grid>

                                <Grid Margin="0,2">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="  IVA 19%" FontSize="{Binding MonospaceFontSize, FallbackValue=11}" FontFamily="{StaticResource FontFamilyMonospace}" Foreground="#000000"/>
                                    <TextBlock Grid.Column="1" Text="{Binding Iva19Str}" FontSize="{Binding MonospaceFontSize, FallbackValue=11}" FontFamily="{StaticResource FontFamilyMonospace}" Foreground="#000000"/>
                                </Grid>

                                <!-- Línea discontinua a la derecha -->
                                <TextBlock Text="-----------------------" FontSize="{Binding MonospaceFontSize, FallbackValue=11}" FontFamily="{StaticResource FontFamilyMonospace}" Foreground="#000000" HorizontalAlignment="Right" Margin="0,1"/>

                                <Grid Margin="0,2,0,4">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="TOTAL:" FontSize="{Binding MonospaceTitleFontSize, FallbackValue=13}" FontWeight="Black" FontFamily="{StaticResource FontFamilyMonospace}" Foreground="#000000"/>
                                    <TextBlock Grid.Column="1" Text="{Binding TotalStr}" FontSize="{Binding MonospaceTitleFontSize, FallbackValue=13}" FontWeight="Black" FontFamily="{StaticResource FontFamilyMonospace}" Foreground="#000000"/>
                                </Grid>

                                <!-- Pagado -->
                                <Grid Margin="0,1" Visibility="{Binding HasAmountPaid, Converter={StaticResource BoolToVis}}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="PAGADO:" FontSize="{Binding MonospaceFontSize, FallbackValue=11}" FontFamily="{StaticResource FontFamilyMonospace}" Foreground="#000000"/>
                                    <TextBlock Grid.Column="1" Text="{Binding AmountPaidStr, StringFormat='{}${0}'}" FontSize="{Binding MonospaceFontSize, FallbackValue=11}" FontFamily="{StaticResource FontFamilyMonospace}" Foreground="#000000"/>
                                </Grid>

                                <!-- Cambio -->
                                <Grid Margin="0,1,0,6" Visibility="{Binding HasChange, Converter={StaticResource BoolToVis}}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="CAMBIO:" FontSize="{Binding MonospaceFontSize, FallbackValue=11}" FontFamily="{StaticResource FontFamilyMonospace}" Foreground="#000000"/>
                                    <TextBlock Grid.Column="1" Text="{Binding ChangeGivenStr, StringFormat='{}${0}'}" FontSize="{Binding MonospaceFontSize, FallbackValue=11}" FontFamily="{StaticResource FontFamilyMonospace}" Foreground="#000000"/>
                                </Grid>

                                <!-- Atendido Por -->
                                <Grid Margin="0,2,0,4">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="Atendido por: " FontSize="{Binding MonospaceFontSize, FallbackValue=11}" FontFamily="{StaticResource FontFamilyMonospace}" Foreground="#000000"/>
                                    <TextBlock Grid.Column="1" Text="{Binding AttendedBy}" FontSize="{Binding MonospaceFontSize, FallbackValue=11}" FontWeight="Bold" FontFamily="{StaticResource FontFamilyMonospace}" Foreground="#000000" TextWrapping="Wrap"/>
                                </Grid>

                                <Rectangle Height="1" Fill="#000000" HorizontalAlignment="Stretch" Margin="0,2,0,6"/>

                                <!-- 5. QR Code Centrado -->
                                <Image Source="{Binding ConsultationQrCodeImage}"
                                       Width="{Binding QrCodeWidth}" Height="{Binding QrCodeWidth}"
                                       Stretch="Uniform"
                                       RenderOptions.BitmapScalingMode="NearestNeighbor"
                                       HorizontalAlignment="Center"
                                       Margin="0,4,0,6"/>

                                <Rectangle Height="1" Fill="#000000" HorizontalAlignment="Stretch" Margin="0,0,0,4"/>

                                <!-- 6. Forma de Pago -->
                                <TextBlock Text="{Binding PaymentMethodName, StringFormat='{}FORMA DE PAGO: {0}'}"
                                           FontSize="11"
                                           FontFamily="{StaticResource FontFamilyMonospace}"
                                           Foreground="#000000"
                                           HorizontalAlignment="Center"
                                           Margin="0,2,0,6"/>

                                <!-- Información Adicional y Póliza -->
                                <StackPanel Visibility="{Binding HasTicketPolicyOrAdditionalInfo, Converter={StaticResource BoolToVis}}" Margin="0,2,0,4">
                                    <Rectangle Height="1" Fill="#000000" HorizontalAlignment="Stretch" Margin="0,2,0,4"/>
                                    <TextBlock Text="{Binding TicketPolicy}"
                                               Visibility="{Binding HasTicketPolicy, Converter={StaticResource BoolToVis}}"
                                               FontSize="8.5" FontWeight="Bold"
                                               FontFamily="{StaticResource FontFamilyMonospace}"
                                               Foreground="#000000" TextAlignment="Center" TextWrapping="Wrap" Margin="0,1"/>
                                    <TextBlock Text="{Binding TicketAdditionalInfo}"
                                               Visibility="{Binding HasTicketAdditionalInfo, Converter={StaticResource BoolToVis}}"
                                               FontSize="8"
                                               FontFamily="{StaticResource FontFamilyMonospace}"
                                               Foreground="#000000" TextAlignment="Center" TextWrapping="Wrap" Margin="0,1,0,2"/>
                                </StackPanel>

                                <!-- Margen inferior extra (~1mm) para evitar corte del cabezal térmico -->
                                <Rectangle Height="4" Fill="Transparent" HorizontalAlignment="Stretch"/>

                            </StackPanel>

                            <!-- ============================================================= -->
                            <!-- B. PLANTILLA TIQUETE DE INGRESO (CHECK-IN)                    -->
                            <!-- ============================================================= -->
                            <StackPanel Visibility="{Binding IsEntryTicket, Converter={StaticResource BoolToVis}}"
                                        HorizontalAlignment="Stretch" Margin="0,0">

                                <!-- Encabezado de Empresa / Sede -->
                                <Image Source="{Binding BranchLogoBase64, Converter={StaticResource Base64ToImageConv}}"
                                       MaxHeight="{Binding LogoMaxHeight}"
                                       MaxWidth="{Binding LogoMaxWidth}"
                                       Stretch="Uniform"
                                       HorizontalAlignment="Center"
                                       Margin="0,0,0,8"
                                       RenderOptions.BitmapScalingMode="HighQuality"
                                       Visibility="{Binding BranchLogoBase64, Converter={StaticResource NullToVis}}"/>
                                <TextBlock Text="{Binding BranchName}" FontSize="{Binding MonospaceTitleFontSize, FallbackValue=13}" FontWeight="Bold" FontFamily="{StaticResource FontFamilyMonospace}" Foreground="#000000" HorizontalAlignment="Center" TextWrapping="Wrap" TextAlignment="Center"/>
                                <TextBlock Text="{Binding BranchNit}" FontSize="{Binding MonospaceFontSize, FallbackValue=10}" FontFamily="{StaticResource FontFamilyMonospace}" Foreground="#000000" HorizontalAlignment="Center" Margin="0,1" TextWrapping="Wrap" TextAlignment="Center"/>
                                <TextBlock Text="{Binding BranchAddress}" FontSize="{Binding MonospaceFontSize, FallbackValue=10}" FontFamily="{StaticResource FontFamilyMonospace}" Foreground="#000000" HorizontalAlignment="Center" Margin="0,1" TextWrapping="Wrap" TextAlignment="Center"/>
                                <TextBlock Text="{Binding BranchPhone}" FontSize="{Binding MonospaceFontSize, FallbackValue=10}" FontFamily="{StaticResource FontFamilyMonospace}" Foreground="#000000" HorizontalAlignment="Center" Margin="0,1,0,4" TextWrapping="Wrap" TextAlignment="Center"/>
                                <TextBlock Text="{Binding BranchSchedule}"
                                           Visibility="{Binding HasBranchSchedule, Converter={StaticResource BoolToVis}}"
                                           FontSize="{Binding MonospaceFontSize, FallbackValue=9.5}"
                                           FontFamily="{StaticResource FontFamilyMonospace}"
                                           Foreground="#000000"
                                           HorizontalAlignment="Center"
                                           TextAlignment="Center"
                                           TextWrapping="Wrap"
                                           Margin="0,1,0,6"/>

                                <!-- Línea divisoria continua -->
                                <Rectangle Height="1" Fill="#000000" HorizontalAlignment="Stretch" Margin="6,0,6,8"/>

                                <!-- Tiquete de Entrada y Consecutivo -->
                                <Grid Margin="0,0,0,4">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="Tiquete #:" FontSize="{Binding TicketHeaderFontSize, FallbackValue=11}" FontWeight="Bold" FontFamily="{StaticResource FontFamilyMonospace}" Foreground="#000000"/>
                                    <TextBlock Grid.Column="1" Text="{Binding InvoiceNumberText}" FontSize="{Binding TicketNumberFontSize, FallbackValue=13}" FontWeight="Bold" FontFamily="{StaticResource FontFamilyMonospace}" Foreground="#000000"/>
                                </Grid>

                                <!-- Fecha y Hora contiguas -->
                                <StackPanel Orientation="Horizontal" Margin="0,2,0,6">
                                    <TextBlock Text="FECHA: " FontSize="{Binding MonospaceFontSize, FallbackValue=10}" FontWeight="Bold" FontFamily="{StaticResource FontFamilyMonospace}" Foreground="#000000"/>
                                    <TextBlock Text="{Binding InvoiceDateStr}" FontSize="{Binding MonospaceFontSize, FallbackValue=10}" FontWeight="Bold" FontFamily="{StaticResource FontFamilyMonospace}" Foreground="#000000" Margin="0,0,8,0"/>
                                    <TextBlock Text="{Binding InvoiceTimeStr}" FontSize="{Binding MonospaceFontSize, FallbackValue=10}" FontWeight="Bold" FontFamily="{StaticResource FontFamilyMonospace}" Foreground="#000000"/>
                                </StackPanel>

                                <!-- Placa del Vehículo -->
                                <Border BorderBrush="#000000" BorderThickness="2" CornerRadius="4" Padding="6,4" HorizontalAlignment="Center" Margin="0,4,0,4">
                                    <TextBlock Text="{Binding Ticket.PlateNumber, StringFormat='{}PLACA:  {0}'}"
                                               FontSize="{Binding PlateFontSize, FallbackValue=14}"
                                               FontWeight="Black"
                                               FontFamily="{StaticResource FontFamilyMonospace}"
                                               Foreground="#000000"
                                               HorizontalAlignment="Center"/>
                                </Border>

                                <!-- Tipo de Vehículo y Tarifa -->
                                <StackPanel HorizontalAlignment="Center" Margin="0,0,0,6">
                                    <TextBlock Text="{Binding VehicleTypeName, StringFormat='{}VEHÍCULO: {0}'}" FontSize="{Binding MonospaceFontSize, FallbackValue=10}" FontWeight="Bold" FontFamily="{StaticResource FontFamilyMonospace}" Foreground="#000000" HorizontalAlignment="Center" TextWrapping="Wrap" TextAlignment="Center"/>
                                    <TextBlock Text="{Binding FormattedRateText}" FontSize="{Binding MonospaceFontSize, FallbackValue=10}" FontWeight="Bold" FontFamily="{StaticResource FontFamilyMonospace}" Foreground="#000000" HorizontalAlignment="Center" Margin="0,1,0,0" Visibility="{Binding FormattedRateText, Converter={StaticResource NullToVis}}" TextWrapping="Wrap" TextAlignment="Center"/>
                                </StackPanel>

                                <!-- Código de Barras / QR -->
                                <Image Source="{Binding BarcodeImage}"
                                       Width="{Binding BarcodeWidth}" Height="80"
                                       Stretch="Uniform"
                                       RenderOptions.BitmapScalingMode="NearestNeighbor"
                                       HorizontalAlignment="Center"
                                       Margin="0,4,0,8"/>

                                <Rectangle Height="1" Fill="#000000" HorizontalAlignment="Stretch" Margin="0,4,0,6"/>

                                <!-- Atendido por -->
                                <TextBlock Text="{Binding AttendedBy, StringFormat='{}Atendido por: {0}'}"
                                           FontSize="{Binding MonospaceFontSize, FallbackValue=10}"
                                           FontFamily="{StaticResource FontFamilyMonospace}"
                                           Foreground="#000000"
                                           HorizontalAlignment="Center"
                                           TextWrapping="Wrap"
                                           TextAlignment="Center"
                                           Margin="0,2,0,4"/>

                                <TextBlock Text="Conserve este tiquete para retirar su vehículo." FontSize="{Binding MonospaceFontSize, FallbackValue=8.5}" TextWrapping="Wrap" TextAlignment="Center" FontFamily="{StaticResource FontFamilyMonospace}" Foreground="#000000" HorizontalAlignment="Center" Margin="0,1,0,6"/>

                                <!-- Información Adicional y Póliza -->
                                <StackPanel Visibility="{Binding HasTicketPolicyOrAdditionalInfo, Converter={StaticResource BoolToVis}}" Margin="0,2,0,4">
                                    <Rectangle Height="1" Fill="#000000" HorizontalAlignment="Stretch" Margin="0,2,0,4"/>
                                    <TextBlock Text="{Binding TicketPolicy}"
                                               Visibility="{Binding HasTicketPolicy, Converter={StaticResource BoolToVis}}"
                                               FontSize="8.5" FontWeight="Bold"
                                               FontFamily="{StaticResource FontFamilyMonospace}"
                                               Foreground="#000000" TextAlignment="Center" TextWrapping="Wrap" Margin="0,1"/>
                                    <TextBlock Text="{Binding TicketAdditionalInfo}"
                                               Visibility="{Binding HasTicketAdditionalInfo, Converter={StaticResource BoolToVis}}"
                                               FontSize="8"
                                               FontFamily="{StaticResource FontFamilyMonospace}"
                                               Foreground="#000000" TextAlignment="Center" TextWrapping="Wrap" Margin="0,1,0,2"/>
                                </StackPanel>

                                <Rectangle Height="1" Fill="#000000" HorizontalAlignment="Stretch" Margin="0,2,0,6"/>

                                <!-- Código QR de Consulta en Línea para el Cliente -->
                                <TextBlock Text="CONSULTE SU VEHÍCULO EN LÍNEA"
                                           FontSize="{Binding MonospaceFontSize, FallbackValue=9.5}"
                                           FontWeight="Bold"
                                           FontFamily="{StaticResource FontFamilyMonospace}"
                                           Foreground="#000000"
                                           HorizontalAlignment="Center"
                                           TextWrapping="Wrap"
                                           TextAlignment="Center"
                                           Margin="0,2,0,2"/>

                                <TextBlock Text="Escanee con la cámara de su celular:"
                                           FontSize="{Binding MonospaceFontSize, FallbackValue=8.5}"
                                           FontFamily="{StaticResource FontFamilyMonospace}"
                                           Foreground="#000000"
                                           HorizontalAlignment="Center"
                                           TextWrapping="Wrap"
                                           TextAlignment="Center"
                                           Margin="0,0,0,4"/>

                                <Image Source="{Binding ConsultationQrCodeImage}"
                                       Width="{Binding QrCodeWidth}" Height="{Binding QrCodeWidth}"
                                       Stretch="Uniform"
                                       RenderOptions.BitmapScalingMode="NearestNeighbor"
                                       HorizontalAlignment="Center"
                                       Margin="0,2,0,3"/>

                                <TextBlock Text="Estado, tiempo y cobro en tiempo real"
                                           FontSize="{Binding MonospaceFontSize, FallbackValue=8}"
                                           FontFamily="{StaticResource FontFamilyMonospace}"
                                           Foreground="#000000"
                                           HorizontalAlignment="Center"
                                           TextWrapping="Wrap"
                                           TextAlignment="Center"
                                           Margin="0,0,0,6"/>

                                <!-- Margen inferior extra (~1mm) para evitar corte del cabezal térmico -->
                                <Rectangle Height="4" Fill="Transparent" HorizontalAlignment="Stretch"/>

                            </StackPanel>

                            <!-- ============================================================= -->
                            <!-- B. PLANTILLA FACTURA DE VENTA ELECTRÓNICA (RESOLUCIÓN FVM)    -->
                            <!-- ============================================================= -->
                            <StackPanel Visibility="{Binding IsFvmInvoice, Converter={StaticResource BoolToVis}}"
                                        HorizontalAlignment="Stretch" Margin="0,0">
                                
                                <!-- 1. Encabezado de Empresa / Sede -->
                                <Image Source="{Binding BranchLogoBase64, Converter={StaticResource Base64ToImageConv}}"
                                       MaxHeight="{Binding LogoMaxHeight}"
                                       MaxWidth="{Binding LogoMaxWidth}"
                                       Stretch="Uniform"
                                       HorizontalAlignment="Center"
                                       Margin="0,0,0,8"
                                       RenderOptions.BitmapScalingMode="HighQuality"
                                       Visibility="{Binding BranchLogoBase64, Converter={StaticResource NullToVis}}"/>
                                <TextBlock Text="{Binding BranchName}" FontSize="{Binding MonospaceTitleFontSize, FallbackValue=13}" FontWeight="Bold" FontFamily="{StaticResource FontFamilyMonospace}" Foreground="#000000" HorizontalAlignment="Center" TextWrapping="Wrap" TextAlignment="Center"/>
                                <TextBlock Text="{Binding BranchNit}" FontSize="{Binding MonospaceFontSize, FallbackValue=10}" FontFamily="{StaticResource FontFamilyMonospace}" Foreground="#000000" HorizontalAlignment="Center" Margin="0,1" TextWrapping="Wrap" TextAlignment="Center"/>
                                <TextBlock Text="{Binding BranchAddress}" FontSize="{Binding MonospaceFontSize, FallbackValue=10}" FontFamily="{StaticResource FontFamilyMonospace}" Foreground="#000000" HorizontalAlignment="Center" Margin="0,1" TextWrapping="Wrap" TextAlignment="Center"/>
                                <TextBlock Text="{Binding BranchPhone}" FontSize="{Binding MonospaceFontSize, FallbackValue=10}" FontFamily="{StaticResource FontFamilyMonospace}" Foreground="#000000" HorizontalAlignment="Center" Margin="0,1,0,4" TextWrapping="Wrap" TextAlignment="Center"/>
                                <TextBlock Text="{Binding BranchSchedule}"
                                           Visibility="{Binding HasBranchSchedule, Converter={StaticResource BoolToVis}}"
                                           FontSize="{Binding MonospaceFontSize, FallbackValue=9.5}"
                                           FontFamily="{StaticResource FontFamilyMonospace}"
                                           Foreground="#000000"
                                           HorizontalAlignment="Center"
                                           TextAlignment="Center"
                                           TextWrapping="Wrap"
                                           Margin="0,1,0,6"/>

                                <!-- Línea divisoria continua -->
                                <Rectangle Height="1" Fill="#000000" HorizontalAlignment="Stretch" Margin="6,0,6,8"/>

                                <!-- 2. Factura de Venta Electrónica y Consecutivo -->
                                <Grid Margin="0,0,0,4">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="FACTURA DE VENTA:" FontSize="{Binding TicketHeaderFontSize, FallbackValue=11}" FontWeight="Bold" FontFamily="{StaticResource FontFamilyMonospace}" Foreground="#000000"/>
                                        <TextBlock Text="ELECTRONICA" FontSize="{Binding TicketHeaderFontSize, FallbackValue=11}" FontWeight="Bold" FontFamily="{StaticResource FontFamilyMonospace}" Foreground="#000000"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding InvoicePrefix, StringFormat='{}{0}-'}" FontSize="{Binding TicketNumberFontSize, FallbackValue=13}" FontWeight="Bold" FontFamily="{StaticResource FontFamilyMonospace}" Foreground="#000000" Margin="0,0,8,0"/>
                                        <TextBlock Text="{Binding InvoiceNumberStr}" FontSize="{Binding TicketNumberFontSize, FallbackValue=13}" FontWeight="Bold" FontFamily="{StaticResource FontFamilyMonospace}" Foreground="#000000"/>
                                    </StackPanel>
                                </Grid>

                                <!-- Fecha y Hora -->
                                <Grid Margin="0,2,0,4">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="FECHA:   " FontSize="{Binding MonospaceFontSize, FallbackValue=10}" FontWeight="Bold" FontFamily="{StaticResource FontFamilyMonospace}" Foreground="#000000"/>
                                    <TextBlock Grid.Column="1" Text="{Binding InvoiceDateStr}" FontSize="{Binding MonospaceFontSize, FallbackValue=10}" FontWeight="Bold" FontFamily="{StaticResource FontFamilyMonospace}" Foreground="#000000"/>
                                    <TextBlock Grid.Column="2" Text="{Binding InvoiceTimeStr}" FontSize="{Binding MonospaceFontSize, FallbackValue=10}" FontWeight="Bold" FontFamily="{StaticResource FontFamilyMonospace}" Foreground="#000000"/>
                                </Grid>

                                <!-- Cliente, NIT, Dir -->
                                <Grid Margin="0,1">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="CLIENTE: " FontSize="{Binding MonospaceFontSize, FallbackValue=10}" FontWeight="Bold" FontFamily="{StaticResource FontFamilyMonospace}" Foreground="#000000"/>
                                    <TextBlock Grid.Column="1" Text="{Binding CustomerName}" FontSize="{Binding MonospaceFontSize, FallbackValue=10}" FontWeight="Bold" FontFamily="{StaticResource FontFamilyMonospace}" Foreground="#000000" TextWrapping="Wrap"/>
                                </Grid>

                                <Grid Margin="0,1">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="{Binding CustomerIdTypeLabel, StringFormat='{}{0}: '}" FontSize="{Binding MonospaceFontSize, FallbackValue=10}" FontWeight="Bold" FontFamily="{StaticResource FontFamilyMonospace}" Foreground="#000000"/>
                                    <TextBlock Grid.Column="1" Text="{Binding CustomerNit}" FontSize="{Binding MonospaceFontSize, FallbackValue=10}" FontWeight="Bold" FontFamily="{StaticResource FontFamilyMonospace}" Foreground="#000000" TextWrapping="Wrap"/>
                                </Grid>

                                <Grid Margin="0,1,0,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="DIR: " FontSize="{Binding MonospaceFontSize, FallbackValue=10}" FontWeight="Bold" FontFamily="{StaticResource FontFamilyMonospace}" Foreground="#000000"/>
                                    <TextBlock Grid.Column="1" Text="{Binding CustomerAddress}" FontSize="{Binding MonospaceFontSize, FallbackValue=10}" FontWeight="Bold" FontFamily="{StaticResource FontFamilyMonospace}" Foreground="#000000" TextWrapping="Wrap"/>
                                </Grid>

                                <!-- 3. Bloque Central de la Placa -->
                                <Border BorderBrush="#000000" BorderThickness="2" CornerRadius="4" Padding="6,4" HorizontalAlignment="Center" Margin="0,4,0,4">
                                    <TextBlock Text="{Binding Ticket.PlateNumber, StringFormat='{}PLACA:  {0}'}"
                                               FontSize="{Binding PlateFontSize, FallbackValue=14}"
                                               FontWeight="Black"
                                               FontFamily="{StaticResource FontFamilyMonospace}"
                                               Foreground="#000000"
                                               HorizontalAlignment="Center"/>
                                </Border>

                                <!-- Tipo de Vehículo y Tarifa -->
                                <StackPanel HorizontalAlignment="Center" Margin="0,0,0,6">
                                    <TextBlock Text="{Binding VehicleTypeName, StringFormat='{}VEHÍCULO: {0}'}" FontSize="{Binding MonospaceFontSize, FallbackValue=10}" FontWeight="Bold" FontFamily="{StaticResource FontFamilyMonospace}" Foreground="#000000" HorizontalAlignment="Center" TextWrapping="Wrap" TextAlignment="Center"/>
                                    <TextBlock Text="{Binding FormattedRateText}" FontSize="{Binding MonospaceFontSize, FallbackValue=10}" FontWeight="Bold" FontFamily="{StaticResource FontFamilyMonospace}" Foreground="#000000" HorizontalAlignment="Center" Margin="0,1,0,0" Visibility="{Binding FormattedRateText, Converter={StaticResource NullToVis}}" TextWrapping="Wrap" TextAlignment="Center"/>
                                </StackPanel>

                                <!-- Entrada, Salida, Tiempo -->
                                <Grid Margin="0,1">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="ENTRADA:" FontSize="{Binding MonospaceFontSize, FallbackValue=10}" FontFamily="{StaticResource FontFamilyMonospace}" Foreground="#000000"/>
                                    <TextBlock Grid.Column="1" Text="{Binding EntryTimeStr}" FontSize="{Binding MonospaceFontSize, FallbackValue=10}" FontFamily="{StaticResource FontFamilyMonospace}" Foreground="#000000" Margin="10,0,0,0"/>
                                    <TextBlock Grid.Column="2" Text="{Binding EntryDateStr}" FontSize="{Binding MonospaceFontSize, FallbackValue=10}" FontFamily="{StaticResource FontFamilyMonospace}" Foreground="#000000"/>
                                </Grid>

                                <Grid Margin="0,1">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="SALIDA: " FontSize="{Binding MonospaceFontSize, FallbackValue=10}" FontFamily="{StaticResource FontFamilyMonospace}" Foreground="#000000"/>
                                    <TextBlock Grid.Column="1" Text="{Binding ExitTimeStr}" FontSize="{Binding MonospaceFontSize, FallbackValue=10}" FontFamily="{StaticResource FontFamilyMonospace}" Foreground="#000000" Margin="10,0,0,0"/>
                                    <TextBlock Grid.Column="2" Text="{Binding ExitDateStr}" FontSize="{Binding MonospaceFontSize, FallbackValue=10}" FontFamily="{StaticResource FontFamilyMonospace}" Foreground="#000000"/>
                                </Grid>

                                <Grid Margin="0,1,0,6">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="TIEMPO: " FontSize="{Binding MonospaceFontSize, FallbackValue=10}" FontFamily="{StaticResource FontFamilyMonospace}" Foreground="#000000"/>
                                    <TextBlock Grid.Column="1" Text="{Binding DurationMinutesStr}" FontSize="{Binding MonospaceFontSize, FallbackValue=10}" FontFamily="{StaticResource FontFamilyMonospace}" Foreground="#000000" HorizontalAlignment="Right" Margin="0,0,10,0"/>
                                </Grid>

                                <!-- Recargo Tiquete Extraviado si aplica -->
                                <Grid Margin="0,1,0,2" Visibility="{Binding HasLostTicketSurcharge, Converter={StaticResource BoolToVis}}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="TIQUETE EXTRAVIADO:" FontSize="{Binding MonospaceFontSize, FallbackValue=10}" FontWeight="Bold" FontFamily="{StaticResource FontFamilyMonospace}" Foreground="#000000"/>
                                    <TextBlock Grid.Column="1" Text="{Binding LostTicketFeeText}" FontSize="{Binding MonospaceFontSize, FallbackValue=10}" FontWeight="Bold" FontFamily="{StaticResource FontFamilyMonospace}" Foreground="#000000"/>
                                </Grid>

                                <Rectangle Height="1" Fill="#000000" HorizontalAlignment="Stretch" Margin="0,0,0,6"/>

                                <!-- 4. Liquidación Fiscal (Subtotal, Convenio, Descuento, Base Gravable, IVA 19%, TOTAL) -->
                                <Grid Margin="0,2" Visibility="{Binding HasDiscount, Converter={StaticResource BoolToVis}}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="SUBTOTAL:" FontSize="{Binding MonospaceFontSize, FallbackValue=10}" FontWeight="Bold" FontFamily="{StaticResource FontFamilyMonospace}" Foreground="#000000"/>
                                    <TextBlock Grid.Column="1" Text="{Binding SubtotalStr, StringFormat='{}${0}'}" FontSize="{Binding MonospaceFontSize, FallbackValue=10}" FontWeight="Bold" FontFamily="{StaticResource FontFamilyMonospace}" Foreground="#000000"/>
                                </Grid>

                                <Grid Margin="0,2">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="CONVENIO:" FontSize="{Binding MonospaceFontSize, FallbackValue=10}" FontWeight="Bold" FontFamily="{StaticResource FontFamilyMonospace}" Foreground="#000000"/>
                                    <TextBlock Grid.Column="1" Text="{Binding AgreementDisplayName}" FontSize="{Binding MonospaceFontSize, FallbackValue=10}" FontWeight="Bold" FontFamily="{StaticResource FontFamilyMonospace}" Foreground="#000000"/>
                                </Grid>

                                <Grid Margin="0,2">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="DESCUENTO:" FontSize="{Binding MonospaceFontSize, FallbackValue=10}" FontFamily="{StaticResource FontFamilyMonospace}" Foreground="#000000"/>
                                    <TextBlock Grid.Column="1" Text="{Binding DiscountAmountStr}" FontSize="{Binding MonospaceFontSize, FallbackValue=10}" FontFamily="{StaticResource FontFamilyMonospace}" Foreground="#000000"/>
                                </Grid>

                                <Grid Margin="0,2">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="BASE GRAVABLE:" FontSize="{Binding MonospaceFontSize, FallbackValue=10}" FontWeight="Bold" FontFamily="{StaticResource FontFamilyMonospace}" Foreground="#000000"/>
                                    <TextBlock Grid.Column="1" Text="{Binding BaseGravableStr}" FontSize="{Binding MonospaceFontSize, FallbackValue=10}" FontWeight="Bold" FontFamily="{StaticResource FontFamilyMonospace}" Foreground="#000000"/>
                                </Grid>

                                <Grid Margin="0,2">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="  IVA 19%" FontSize="{Binding MonospaceFontSize, FallbackValue=10}" FontFamily="{StaticResource FontFamilyMonospace}" Foreground="#000000"/>
                                    <TextBlock Grid.Column="1" Text="{Binding Iva19Str}" FontSize="{Binding MonospaceFontSize, FallbackValue=10}" FontFamily="{StaticResource FontFamilyMonospace}" Foreground="#000000"/>
                                </Grid>

                                <!-- Línea discontinua a la derecha -->
                                <TextBlock Text="-----------------------" FontSize="{Binding MonospaceFontSize, FallbackValue=10}" FontFamily="{StaticResource FontFamilyMonospace}" Foreground="#000000" HorizontalAlignment="Right" Margin="0,1"/>

                                <Grid Margin="0,2,0,6">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="TOTAL:" FontSize="{Binding MonospaceTitleFontSize, FallbackValue=13}" FontWeight="Black" FontFamily="{StaticResource FontFamilyMonospace}" Foreground="#000000"/>
                                    <TextBlock Grid.Column="1" Text="{Binding TotalStr}" FontSize="{Binding MonospaceTitleFontSize, FallbackValue=13}" FontWeight="Black" FontFamily="{StaticResource FontFamilyMonospace}" Foreground="#000000"/>
                                </Grid>

                                <!-- Pagado -->
                                <Grid Margin="0,1" Visibility="{Binding HasAmountPaid, Converter={StaticResource BoolToVis}}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="PAGADO:" FontSize="{Binding MonospaceFontSize, FallbackValue=10}" FontFamily="{StaticResource FontFamilyMonospace}" Foreground="#000000"/>
                                    <TextBlock Grid.Column="1" Text="{Binding AmountPaidStr, StringFormat='{}${0}'}" FontSize="{Binding MonospaceFontSize, FallbackValue=10}" FontFamily="{StaticResource FontFamilyMonospace}" Foreground="#000000"/>
                                </Grid>

                                <!-- Cambio -->
                                <Grid Margin="0,1,0,6" Visibility="{Binding HasChange, Converter={StaticResource BoolToVis}}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="CAMBIO:" FontSize="{Binding MonospaceFontSize, FallbackValue=10}" FontFamily="{StaticResource FontFamilyMonospace}" Foreground="#000000"/>
                                    <TextBlock Grid.Column="1" Text="{Binding ChangeGivenStr, StringFormat='{}${0}'}" FontSize="{Binding MonospaceFontSize, FallbackValue=10}" FontFamily="{StaticResource FontFamilyMonospace}" Foreground="#000000"/>
                                </Grid>

                                <!-- Atendido Por -->
                                <Grid Margin="0,2,0,4">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="Atendido por: " FontSize="{Binding MonospaceFontSize, FallbackValue=10}" FontFamily="{StaticResource FontFamilyMonospace}" Foreground="#000000"/>
                                    <TextBlock Grid.Column="1" Text="{Binding AttendedBy}" FontSize="{Binding MonospaceFontSize, FallbackValue=10}" FontWeight="Bold" FontFamily="{StaticResource FontFamilyMonospace}" Foreground="#000000" TextWrapping="Wrap"/>
                                </Grid>

                                <Rectangle Height="1" Fill="#000000" HorizontalAlignment="Stretch" Margin="0,2,0,6"/>

                                <!-- 5. QR Code Centrado -->
                                <Image Source="{Binding ConsultationQrCodeImage}"
                                       Width="{Binding QrCodeWidth}" Height="{Binding QrCodeWidth}"
                                       Stretch="Uniform"
                                       RenderOptions.BitmapScalingMode="NearestNeighbor"
                                       HorizontalAlignment="Center"
                                       Margin="0,4,0,6"/>

                                <Rectangle Height="1" Fill="#000000" HorizontalAlignment="Stretch" Margin="0,0,0,4"/>

                                <!-- 6. Forma de Pago -->
                                <TextBlock Text="{Binding PaymentMethodName, StringFormat='{}FORMA DE PAGO: {0}'}"
                                           FontSize="{Binding MonospaceFontSize, FallbackValue=10}"
                                           FontFamily="{StaticResource FontFamilyMonospace}"
                                           Foreground="#000000"
                                           HorizontalAlignment="Center"
                                           Margin="0,2"/>

                                <Rectangle Height="1" Fill="#000000" HorizontalAlignment="Stretch" Margin="0,4,0,4"/>

                                <!-- 7. CUFE -->
                                <TextBlock Text="{Binding Cufe, StringFormat='{}CUFE: {0}'}"
                                           FontSize="8"
                                           FontFamily="{StaticResource FontFamilyMonospace}"
                                           Foreground="#000000"
                                           TextWrapping="Wrap"
                                           Margin="0,2,0,8"/>

                                <!-- 8. Resolución DIAN y Pólizas -->
                                <TextBlock Text="{Binding DianResolutionText}" FontSize="8.5" FontFamily="{StaticResource FontFamilyMonospace}" Foreground="#000000" HorizontalAlignment="Center" TextWrapping="Wrap" TextAlignment="Center" Margin="0,1"/>
                                <TextBlock Text="{Binding DianRangeText}" FontSize="8.5" FontFamily="{StaticResource FontFamilyMonospace}" Foreground="#000000" HorizontalAlignment="Center" TextWrapping="Wrap" TextAlignment="Center" Margin="0,1"/>
                                
                                <StackPanel Visibility="{Binding HasTicketPolicyOrAdditionalInfo, Converter={StaticResource BoolToVis}}" Margin="0,4,0,4">
                                    <Rectangle Height="1" Fill="#000000" HorizontalAlignment="Stretch" Margin="0,2,0,4"/>
                                    <TextBlock Text="{Binding TicketPolicy}"
                                               Visibility="{Binding HasTicketPolicy, Converter={StaticResource BoolToVis}}"
                                               FontSize="8.5" FontWeight="Bold"
                                               FontFamily="{StaticResource FontFamilyMonospace}"
                                               Foreground="#000000" TextAlignment="Center" TextWrapping="Wrap" Margin="0,1"/>
                                    <TextBlock Text="{Binding TicketAdditionalInfo}"
                                               Visibility="{Binding HasTicketAdditionalInfo, Converter={StaticResource BoolToVis}}"
                                               FontSize="8"
                                               FontFamily="{StaticResource FontFamilyMonospace}"
                                               Foreground="#000000" TextAlignment="Center" TextWrapping="Wrap" Margin="0,1,0,2"/>
                                </StackPanel>

                                <!-- Margen inferior extra (~1mm) para evitar corte del cabezal térmico -->
                                <Rectangle Height="4" Fill="Transparent" HorizontalAlignment="Stretch"/>

                            </StackPanel>

                            <!-- ============================================================= -->
                            <!-- D. PLANTILLA COMPROBANTE DE CIERRE DE CAJA (ON PARKING STYLE) -->
                            <!-- ============================================================= -->
                            <StackPanel Visibility="{Binding IsShiftCloseReceipt, Converter={StaticResource BoolToVis}}"
                                        HorizontalAlignment="Stretch" Margin="0,0">

                                <!-- 1. Encabezado de Empresa / Sede -->
                                <Image Source="{Binding BranchLogoBase64, Converter={StaticResource Base64ToImageConv}}"
                                       MaxHeight="{Binding LogoMaxHeight}"
                                       MaxWidth="{Binding LogoMaxWidth}"
                                       Stretch="Uniform"
                                       HorizontalAlignment="Center"
                                       Margin="0,0,0,8"
                                       RenderOptions.BitmapScalingMode="HighQuality"
                                       Visibility="{Binding BranchLogoBase64, Converter={StaticResource NullToVis}}"/>
                                <TextBlock Text="{Binding BranchName}" FontSize="{Binding MonospaceTitleFontSize, FallbackValue=13}" FontWeight="Bold" FontFamily="{StaticResource FontFamilyMonospace}" Foreground="#000000" HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap"/>
                                <TextBlock Text="{Binding BranchNit}" FontSize="{Binding MonospaceFontSize, FallbackValue=11}" FontFamily="{StaticResource FontFamilyMonospace}" Foreground="#000000" HorizontalAlignment="Center" TextAlignment="Center" Margin="0,1"/>
                                <TextBlock Text="{Binding BranchAddress}" FontSize="{Binding MonospaceFontSize, FallbackValue=11}" FontFamily="{StaticResource FontFamilyMonospace}" Foreground="#000000" HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap" Margin="0,1"/>
                                <TextBlock Text="{Binding BranchPhone}" FontSize="{Binding MonospaceFontSize, FallbackValue=11}" FontFamily="{StaticResource FontFamilyMonospace}" Foreground="#000000" HorizontalAlignment="Center" TextAlignment="Center" Margin="0,1,0,6"/>

                                <!-- Línea divisoria continua -->
                                <Rectangle Height="1" Fill="#000000" HorizontalAlignment="Stretch" Margin="6,0,6,8"/>

                                <!-- 2. Título de Cierre y Turno -->
                                <TextBlock Text="REPORTE DE CIERRE" FontSize="{Binding MonospaceTitleFontSize, FallbackValue=12}" FontWeight="Bold" FontFamily="{StaticResource FontFamilyMonospace}" Foreground="#000000" HorizontalAlignment="Center"/>
                                <TextBlock Text="{Binding ShiftIdText}" FontSize="{Binding MonospaceFontSize, FallbackValue=11}" FontWeight="Bold" FontFamily="{StaticResource FontFamilyMonospace}" Foreground="#000000" HorizontalAlignment="Center" Margin="0,1,0,6"/>

                                <Rectangle Height="1" Fill="#000000" HorizontalAlignment="Stretch" Margin="0,0,0,6"/>

                                <!-- 3. Datos del Turno -->
                                <Grid Margin="0,1">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="CAJERO: " FontSize="{Binding MonospaceFontSize, FallbackValue=9.5}" FontWeight="Bold" FontFamily="{StaticResource FontFamilyMonospace}" Foreground="#000000" Margin="0,0,4,0"/>
                                    <TextBlock Grid.Column="1" Text="{Binding CashierName}" FontSize="{Binding MonospaceFontSize, FallbackValue=9.5}" FontWeight="Bold" FontFamily="{StaticResource FontFamilyMonospace}" Foreground="#000000" TextWrapping="Wrap"/>
                                </Grid>
                                <Grid Margin="0,1">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="INICIO: " FontSize="{Binding MonospaceFontSize, FallbackValue=9.5}" FontFamily="{StaticResource FontFamilyMonospace}" Foreground="#000000" Margin="0,0,4,0"/>
                                    <TextBlock Grid.Column="1" FontSize="{Binding MonospaceFontSize, FallbackValue=9.5}" FontFamily="{StaticResource FontFamilyMonospace}" Foreground="#000000">
                                        <Run Text="{Binding ShiftStartDateStr, Mode=OneWay}"/>
                                        <Run Text=" "/>
                                        <Run Text="{Binding ShiftStartTimeStr, Mode=OneWay}"/>
                                    </TextBlock>
                                </Grid>
                                <Grid Margin="0,1">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="FIN:    " FontSize="{Binding MonospaceFontSize, FallbackValue=9.5}" FontFamily="{StaticResource FontFamilyMonospace}" Foreground="#000000" Margin="0,0,4,0"/>
                                    <TextBlock Grid.Column="1" FontSize="{Binding MonospaceFontSize, FallbackValue=9.5}" FontFamily="{StaticResource FontFamilyMonospace}" Foreground="#000000">
                                        <Run Text="{Binding ShiftEndDateStr, Mode=OneWay}"/>
                                        <Run Text=" "/>
                                        <Run Text="{Binding ShiftEndTimeStr, Mode=OneWay}"/>
                                    </TextBlock>
                                </Grid>
                                <Grid Margin="0,1,0,6">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="DURACIÓN: " FontSize="{Binding MonospaceFontSize, FallbackValue=9.5}" FontFamily="{StaticResource FontFamilyMonospace}" Foreground="#000000" Margin="0,0,4,0"/>
                                    <TextBlock Grid.Column="1" Text="{Binding ShiftDurationStr}" FontSize="{Binding MonospaceFontSize, FallbackValue=9.5}" FontFamily="{StaticResource FontFamilyMonospace}" Foreground="#000000"/>
                                </Grid>

                                <Rectangle Height="1" Fill="#000000" HorizontalAlignment="Stretch" Margin="0,0,0,6"/>

                                <!-- 4. Ingresos por Servicio -->
                                <TextBlock Text="INGRESOS POR SERVICIO" FontSize="{Binding MonospaceFontSize, FallbackValue=10}" FontWeight="Bold" FontFamily="{StaticResource FontFamilyMonospace}" Foreground="#000000" Margin="0,0,0,4"/>
                                <Grid Margin="0,1">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="Parqueos:" FontSize="{Binding MonospaceFontSize, FallbackValue=9.5}" FontFamily="{StaticResource FontFamilyMonospace}" Foreground="#000000"/>
                                    <TextBlock Grid.Column="1" Text="{Binding ShiftParqueosAmountStr}" FontSize="{Binding MonospaceFontSize, FallbackValue=9.5}" FontWeight="Bold" FontFamily="{StaticResource FontFamilyMonospace}" Foreground="#000000"/>
                                </Grid>
                                <Grid Margin="0,1,0,6">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" FontSize="{Binding MonospaceFontSize, FallbackValue=9.5}" FontFamily="{StaticResource FontFamilyMonospace}" Foreground="#000000">
                                        <Run Text="Mensualidades ("/>
                                        <Run Text="{Binding ShiftMensualidadesCount, Mode=OneWay}"/>
                                        <Run Text="):"/>
                                    </TextBlock>
                                    <TextBlock Grid.Column="1" Text="{Binding ShiftMensualidadesAmountStr}" FontSize="{Binding MonospaceFontSize, FallbackValue=9.5}" FontWeight="Bold" FontFamily="{StaticResource FontFamilyMonospace}" Foreground="#000000"/>
                                </Grid>

                                <Rectangle Height="1" Fill="#000000" HorizontalAlignment="Stretch" Margin="0,0,0,6"/>

                                <!-- 5. Movimientos de Caja Menor -->
                                <TextBlock Text="MOVIMIENTOS DE CAJA" FontSize="{Binding MonospaceFontSize, FallbackValue=10}" FontWeight="Bold" FontFamily="{StaticResource FontFamilyMonospace}" Foreground="#000000" Margin="0,0,0,4"/>
                                <Grid Margin="0,1">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="(+) Ingresos Efectivo:" FontSize="{Binding MonospaceFontSize, FallbackValue=9.5}" FontFamily="{StaticResource FontFamilyMonospace}" Foreground="#000000"/>
                                    <TextBlock Grid.Column="1" Text="{Binding ShiftCashInflowsStr}" FontSize="{Binding MonospaceFontSize, FallbackValue=9.5}" FontFamily="{StaticResource FontFamilyMonospace}" Foreground="#000000"/>
                                </Grid>
                                <Grid Margin="0,1,0,6">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="(-) Salidas / Retiros:" FontSize="{Binding MonospaceFontSize, FallbackValue=9.5}" FontFamily="{StaticResource FontFamilyMonospace}" Foreground="#000000"/>
                                    <TextBlock Grid.Column="1" Text="{Binding ShiftCashOutflowsStr}" FontSize="{Binding MonospaceFontSize, FallbackValue=9.5}" FontFamily="{StaticResource FontFamilyMonospace}" Foreground="#000000"/>
                                </Grid>

                                <Rectangle Height="1" Fill="#000000" HorizontalAlignment="Stretch" Margin="0,0,0,6"/>

                                <!-- 6. Resumen Financiero -->
                                <TextBlock Text="RESUMEN FINANCIERO" FontSize="{Binding MonospaceFontSize, FallbackValue=10}" FontWeight="Bold" FontFamily="{StaticResource FontFamilyMonospace}" Foreground="#000000" Margin="0,0,0,4"/>
                                <Grid Margin="0,1">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="Subtotal Bruto:" FontSize="{Binding MonospaceFontSize, FallbackValue=9.5}" FontFamily="{StaticResource FontFamilyMonospace}" Foreground="#000000"/>
                                    <TextBlock Grid.Column="1" Text="{Binding ShiftGrossSubtotalStr}" FontSize="{Binding MonospaceFontSize, FallbackValue=9.5}" FontFamily="{StaticResource FontFamilyMonospace}" Foreground="#000000"/>
                                </Grid>
                                <Grid Margin="0,1">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" FontSize="{Binding MonospaceFontSize, FallbackValue=9.5}" FontFamily="{StaticResource FontFamilyMonospace}" Foreground="#000000" TextWrapping="Wrap">
                                        <Run Text="Convenios / Descuentos ("/>
                                        <Run Text="{Binding ShiftDiscountTicketsCount, Mode=OneWay}"/>
                                        <Run Text="):"/>
                                    </TextBlock>
                                    <TextBlock Grid.Column="1" Text="{Binding ShiftDiscountsStr}" FontSize="{Binding MonospaceFontSize, FallbackValue=9.5}" FontFamily="{StaticResource FontFamilyMonospace}" Foreground="#000000"/>
                                </Grid>
                                <Grid Margin="0,1">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="Subtotal con Descuento:" FontSize="{Binding MonospaceFontSize, FallbackValue=9.5}" FontFamily="{StaticResource FontFamilyMonospace}" Foreground="#000000" TextWrapping="Wrap"/>
                                    <TextBlock Grid.Column="1" Text="{Binding ShiftDiscountedSubtotalStr}" FontSize="{Binding MonospaceFontSize, FallbackValue=9.5}" FontFamily="{StaticResource FontFamilyMonospace}" Foreground="#000000"/>
                                </Grid>
                                <Grid Margin="0,1">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="Base Gravable (TG):" FontSize="{Binding MonospaceFontSize, FallbackValue=9.5}" FontFamily="{StaticResource FontFamilyMonospace}" Foreground="#000000" TextWrapping="Wrap"/>
                                    <TextBlock Grid.Column="1" Text="{Binding ShiftTaxBaseStr}" FontSize="{Binding MonospaceFontSize, FallbackValue=9.5}" FontFamily="{StaticResource FontFamilyMonospace}" Foreground="#000000"/>
                                </Grid>
                                <Grid Margin="0,1">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="IVA (19%):" FontSize="{Binding MonospaceFontSize, FallbackValue=9.5}" FontFamily="{StaticResource FontFamilyMonospace}" Foreground="#000000"/>
                                    <TextBlock Grid.Column="1" Text="{Binding ShiftIva19Str}" FontSize="{Binding MonospaceFontSize, FallbackValue=9.5}" FontFamily="{StaticResource FontFamilyMonospace}" Foreground="#000000"/>
                                </Grid>

                                <Rectangle Height="1" Fill="#000000" HorizontalAlignment="Stretch" Margin="0,2,0,4"/>
                                <Grid Margin="0,2,0,6">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="TOTAL CIERRE:" FontSize="{Binding MonospaceTitleFontSize, FallbackValue=12}" FontWeight="Black" FontFamily="{StaticResource FontFamilyMonospace}" Foreground="#000000"/>
                                    <TextBlock Grid.Column="1" Text="{Binding ShiftTotalRevenueStr}" FontSize="{Binding MonospaceTitleFontSize, FallbackValue=12}" FontWeight="Black" FontFamily="{StaticResource FontFamilyMonospace}" Foreground="#000000"/>
                                </Grid>
                                <Rectangle Height="1" Fill="#000000" HorizontalAlignment="Stretch" Margin="0,0,0,6"/>

                                <!-- 7. Medios de Pago -->
                                <TextBlock Text="MEDIOS DE PAGO" FontSize="{Binding MonospaceFontSize, FallbackValue=10}" FontWeight="Bold" FontFamily="{StaticResource FontFamilyMonospace}" Foreground="#000000" Margin="0,0,0,4"/>
                                <ItemsControl ItemsSource="{Binding ShiftPaymentMethods}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Grid Margin="0,1">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Grid.Column="0" FontSize="{Binding DataContext.MonospaceFontSize, RelativeSource={RelativeSource AncestorType=ItemsControl}, FallbackValue=9.5}" FontFamily="{StaticResource FontFamilyMonospace}" Foreground="#000000">
                                                    <Run Text="• "/>
                                                    <Run Text="{Binding Name, Mode=OneWay}"/>
                                                    <Run Text=":"/>
                                                </TextBlock>
                                                <TextBlock Grid.Column="1" Text="{Binding TotalCollectedStr}" FontSize="{Binding DataContext.MonospaceFontSize, RelativeSource={RelativeSource AncestorType=ItemsControl}, FallbackValue=9.5}" FontWeight="Bold" FontFamily="{StaticResource FontFamilyMonospace}" Foreground="#000000"/>
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>

                                <Rectangle Height="1" Fill="#000000" HorizontalAlignment="Stretch" Margin="0,0,0,6"/>

                                <!-- 8. Vehículos y Ocupación -->
                                <TextBlock Text="VEHÍCULOS Y OCUPACIÓN" FontSize="{Binding MonospaceFontSize, FallbackValue=10}" FontWeight="Bold" FontFamily="{StaticResource FontFamilyMonospace}" Foreground="#000000" Margin="0,0,0,4"/>
                                <Grid Margin="0,1">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="Vehículos Salidos:" FontSize="{Binding MonospaceFontSize, FallbackValue=9.5}" FontFamily="{StaticResource FontFamilyMonospace}" Foreground="#000000"/>
                                    <TextBlock Grid.Column="1" Text="{Binding ShiftVehiclesExitedCount}" FontSize="{Binding MonospaceFontSize, FallbackValue=9.5}" FontWeight="Bold" FontFamily="{StaticResource FontFamilyMonospace}" Foreground="#000000"/>
                                </Grid>
                                <Grid Margin="0,1,0,6">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="Vehículos en Patio:" FontSize="{Binding MonospaceFontSize, FallbackValue=9.5}" FontFamily="{StaticResource FontFamilyMonospace}" Foreground="#000000"/>
                                    <TextBlock Grid.Column="1" Text="{Binding ShiftVehiclesInYardCount}" FontSize="{Binding MonospaceFontSize, FallbackValue=9.5}" FontWeight="Bold" FontFamily="{StaticResource FontFamilyMonospace}" Foreground="#000000"/>
                                </Grid>

                                <Rectangle Height="1" Fill="#000000" HorizontalAlignment="Stretch" Margin="0,0,0,6"/>

                                <!-- 9. Arqueo y Cuadre de Caja -->
                                <TextBlock Text="ARQUEO Y CUADRE DE CAJA" FontSize="{Binding MonospaceFontSize, FallbackValue=10}" FontWeight="Bold" FontFamily="{StaticResource FontFamilyMonospace}" Foreground="#000000" Margin="0,0,0,4"/>
                                <Grid Margin="0,1">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="Base Inicial:" FontSize="{Binding MonospaceFontSize, FallbackValue=9.5}" FontFamily="{StaticResource FontFamilyMonospace}" Foreground="#000000"/>
                                    <TextBlock Grid.Column="1" Text="{Binding ShiftBaseAmountStr}" FontSize="{Binding MonospaceFontSize, FallbackValue=9.5}" FontFamily="{StaticResource FontFamilyMonospace}" Foreground="#000000"/>
                                </Grid>
                                <Grid Margin="0,1">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="Total Esperado:" FontSize="{Binding MonospaceFontSize, FallbackValue=9.5}" FontFamily="{StaticResource FontFamilyMonospace}" Foreground="#000000"/>
                                    <TextBlock Grid.Column="1" Text="{Binding ShiftExpectedCashStr}" FontSize="{Binding MonospaceFontSize, FallbackValue=9.5}" FontWeight="Bold" FontFamily="{StaticResource FontFamilyMonospace}" Foreground="#000000"/>
                                </Grid>
                                <Grid Margin="0,1">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="Total Contado:" FontSize="{Binding MonospaceFontSize, FallbackValue=9.5}" FontFamily="{StaticResource FontFamilyMonospace}" Foreground="#000000"/>
                                    <TextBlock Grid.Column="1" Text="{Binding ShiftActualCashStr}" FontSize="{Binding MonospaceFontSize, FallbackValue=9.5}" FontWeight="Bold" FontFamily="{StaticResource FontFamilyMonospace}" Foreground="#000000"/>
                                </Grid>
                                <Grid Margin="0,1">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="Diferencia:" FontSize="{Binding MonospaceFontSize, FallbackValue=9.5}" FontWeight="Bold" FontFamily="{StaticResource FontFamilyMonospace}" Foreground="#000000"/>
                                    <TextBlock Grid.Column="1" Text="{Binding ShiftDifferenceStr}" FontSize="{Binding MonospaceFontSize, FallbackValue=9.5}" FontWeight="Bold" FontFamily="{StaticResource FontFamilyMonospace}" Foreground="#000000"/>
                                </Grid>
                                <Grid Margin="0,1,0,6">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="Estado Arqueo:" FontSize="{Binding MonospaceFontSize, FallbackValue=9.5}" FontWeight="Bold" FontFamily="{StaticResource FontFamilyMonospace}" Foreground="#000000"/>
                                    <TextBlock Grid.Column="1" Text="{Binding ShiftArqueoStatusText}" FontSize="{Binding MonospaceFontSize, FallbackValue=10}" FontWeight="Black" FontFamily="{StaticResource FontFamilyMonospace}" Foreground="#000000"/>
                                </Grid>

                                <Rectangle Height="1" Fill="#000000" HorizontalAlignment="Stretch" Margin="0,0,0,6"/>

                                <!-- 10. Observaciones -->
                                <StackPanel Visibility="{Binding HasShiftNotes, Converter={StaticResource BoolToVis}}" Margin="0,0,0,6">
                                    <TextBlock Text="OBSERVACIONES:" FontSize="{Binding MonospaceFontSize, FallbackValue=9.5}" FontWeight="Bold" FontFamily="{StaticResource FontFamilyMonospace}" Foreground="#000000"/>
                                    <TextBlock Text="{Binding ShiftNotes}" FontSize="{Binding MonospaceFontSize, FallbackValue=9}" FontFamily="{StaticResource FontFamilyMonospace}" Foreground="#000000" TextWrapping="Wrap" Margin="0,2,0,6"/>
                                    <Rectangle Height="1" Fill="#000000" HorizontalAlignment="Stretch" Margin="0,0,0,6"/>
                                </StackPanel>

                                <!-- 11. Firmas y Pie -->
                                <StackPanel HorizontalAlignment="Center" Margin="0,14,0,8">
                                    <TextBlock Text="___________________________" FontSize="{Binding MonospaceFontSize, FallbackValue=9.5}" FontFamily="{StaticResource FontFamilyMonospace}" Foreground="#000000" HorizontalAlignment="Center"/>
                                    <TextBlock Text="Firma Responsable de Caja" FontSize="{Binding MonospaceFontSize, FallbackValue=9.5}" FontWeight="Bold" FontFamily="{StaticResource FontFamilyMonospace}" Foreground="#000000" HorizontalAlignment="Center" Margin="0,2,0,1"/>
                                    <TextBlock Text="C.C. _____________________" FontSize="{Binding MonospaceFontSize, FallbackValue=9}" FontFamily="{StaticResource FontFamilyMonospace}" Foreground="#000000" HorizontalAlignment="Center"/>
                                </StackPanel>

                                <TextBlock Text="ParkingFlow POS" FontSize="{Binding MonospaceFontSize, FallbackValue=9.5}" FontWeight="Bold" FontFamily="{StaticResource FontFamilyMonospace}" Foreground="#000000" HorizontalAlignment="Center" Margin="0,4,0,1"/>
                                <TextBlock Text="Software de Gestión y Control" FontSize="{Binding MonospaceFontSize, FallbackValue=8.5}" FontFamily="{StaticResource FontFamilyMonospace}" Foreground="#000000" HorizontalAlignment="Center" Margin="0,0,0,8"/>

                                <!-- Margen inferior extra (~1mm) para evitar corte del cabezal térmico -->
                                <Rectangle Height="4" Fill="Transparent" HorizontalAlignment="Stretch"/>

                            </StackPanel>

                                </Grid>
                            </Border>
                        </Grid>
                    </Border>
                </ScrollViewer>

                <!-- 3. Bottom Action Buttons -->
                <Grid Grid.Row="2">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" Orientation="Vertical" VerticalAlignment="Center">
                        <!-- Impresora Detectada -->
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Path Data="{StaticResource IconPrint}" 
                                  Fill="{DynamicResource BrushTextSecondary}" 
                                  Width="12" Height="12" Stretch="Uniform" Margin="0,0,6,0"/>
                            <TextBlock Text="{Binding DetectedPrinterName, StringFormat='{}Impresora: {0}'}" 
                                       Foreground="{DynamicResource BrushTextSecondary}" 
                                       FontSize="11" 
                                       FontWeight="SemiBold"
                                       VerticalAlignment="Center"/>
                        </StackPanel>

                        <!-- Mensaje de Estado / Éxito -->
                        <StackPanel Orientation="Horizontal" 
                                    VerticalAlignment="Center" 
                                    Margin="0,2,0,0"
                                    Visibility="{Binding PrintSuccess, Converter={StaticResource BoolToVis}}">
                            <Path Data="{StaticResource IconCheck}" Fill="{DynamicResource BrushSuccess}" Width="12" Height="12" Stretch="Uniform" Margin="0,0,4,0"/>
                            <TextBlock Text="{Binding PrintStatusMessage, FallbackValue='Tiquete enviado a impresión'}" 
                                       Foreground="{DynamicResource BrushSuccess}" 
                                       FontSize="11" 
                                       FontWeight="Bold"
                                       VerticalAlignment="Center"/>
                        </StackPanel>
                    </StackPanel>

                    <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Command="{Binding PrintTicketCommand}"
                                Style="{StaticResource ModernButton}"
                                Margin="0,0,8,0"
                                Padding="16,6">
                            <Button.ContentTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal">
                                        <Path Data="{StaticResource IconPrint}" Fill="{DynamicResource BrushTextWhite}" Width="13" Height="13" Stretch="Uniform" Margin="0,0,6,0"/>
                                        <TextBlock Text="Imprimir Tiquete" Foreground="{DynamicResource BrushTextWhite}" FontWeight="Bold" FontSize="12" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </DataTemplate>
                            </Button.ContentTemplate>
                        </Button>
                        <Button Content="Cerrar"
                                Command="{Binding CloseCommand}"
                                Style="{StaticResource SecondaryButton}"
                                Padding="16,6"
                                FontSize="12"/>
                    </StackPanel>
                </Grid>
            </Grid>
        </Border>
    </Grid>
</Window>
