<Window x:Class="Parking.Views.ShiftHandoverAuthDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="Entrega de Turno y Recepción de Caja"
        Width="490"
        SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Display"
        TextOptions.TextRenderingMode="ClearType"
        KeyDown="Window_KeyDown">

    <Border Margin="16"
            Background="{DynamicResource BrushSurfaceBackground}"
            BorderBrush="{DynamicResource BrushBorderMedium}"
            BorderThickness="1"
            CornerRadius="16"
            Padding="24"
            SnapsToDevicePixels="True">
        <Border.Effect>
            <DropShadowEffect BlurRadius="24" ShadowDepth="6" Direction="270" Opacity="0.18" Color="#0B3C49"/>
        </Border.Effect>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- 1. Header Section -->
            <Grid Grid.Row="0" Margin="0,0,0,16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0"
                        Width="44"
                        Height="44"
                        CornerRadius="22"
                        Background="{DynamicResource BrushPrimaryLight}"
                        Margin="0,0,14,0"
                        VerticalAlignment="Center">
                    <Path Data="{StaticResource IconUser}"
                          Fill="{DynamicResource BrushPrimary}"
                          Width="20"
                          Height="20"
                          Stretch="Uniform"
                          HorizontalAlignment="Center"
                          VerticalAlignment="Center"/>
                </Border>

                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <TextBlock Text="Entrega y Recepción de Turno"
                               FontSize="16"
                               FontWeight="Bold"
                               Foreground="{DynamicResource BrushTextPrimary}"/>
                    <TextBlock Text="Firma digital para traspaso de custodia de caja"
                               FontSize="11"
                               Foreground="{DynamicResource BrushTextMuted}"
                               Margin="0,2,0,0"/>
                </StackPanel>

                <Button Grid.Column="2"
                        Click="CancelButton_Click"
                        Style="{StaticResource SecondaryButton}"
                        Padding="4"
                        Width="28"
                        Height="28"
                        VerticalAlignment="Top"
                        ToolTip="Cancelar (Esc)">
                    <Path Data="{StaticResource IconClose}" Fill="{DynamicResource BrushTextSecondary}" Width="10" Height="10" Stretch="Uniform"/>
                </Button>
            </Grid>

            <!-- 2. Operators Transfer Overview -->
            <Border Grid.Row="1"
                    Background="{DynamicResource BrushAppBackground}"
                    BorderBrush="{DynamicResource BrushBorderSubtle}"
                    BorderThickness="1"
                    CornerRadius="12"
                    Padding="14"
                    Margin="0,0,0,14">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="1*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="1*"/>
                    </Grid.ColumnDefinitions>

                    <!-- Outgoing Operator -->
                    <StackPanel Grid.Column="0">
                        <TextBlock Text="OPERADOR SALIENTE" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource BrushTextMuted}"/>
                        <TextBlock x:Name="OutgoingOperatorText" Text="Administrador" FontSize="13" FontWeight="Bold" Foreground="{DynamicResource BrushTextPrimary}" Margin="0,3,0,0"/>
                        <TextBlock Text="Entrega la caja" FontSize="10" Foreground="{DynamicResource BrushTextSecondary}"/>
                    </StackPanel>

                    <!-- Arrow Separator -->
                    <TextBlock Grid.Column="1" Text="➔" FontSize="18" FontWeight="Bold" Foreground="{DynamicResource BrushPrimary}" VerticalAlignment="Center" Margin="12,0"/>

                    <!-- Incoming Operator -->
                    <StackPanel Grid.Column="2">
                        <TextBlock Text="OPERADOR RECEPTOR" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource BrushTextMuted}"/>
                        <TextBlock x:Name="IncomingOperatorText" Text="Carlos Gómez" FontSize="13" FontWeight="Bold" Foreground="{DynamicResource BrushPrimary}" Margin="0,3,0,0"/>
                        <TextBlock x:Name="IncomingUsernameText" Text="(@cgomez)" FontSize="10" Foreground="{DynamicResource BrushTextSecondary}"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- 3. Cash Transfer Amount Banner -->
            <Border Grid.Row="2"
                    Background="{DynamicResource BrushSurfaceElevated}"
                    BorderBrush="{DynamicResource BrushBorderMedium}"
                    BorderThickness="1"
                    CornerRadius="10"
                    Padding="14,10"
                    Margin="0,0,0,16">
                <Grid>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="EFECTIVO A ENTREGAR EN GAVETA" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource BrushTextMuted}"/>
                        <TextBlock x:Name="CashAmountText" Text="$0" FontSize="20" FontWeight="Black" Foreground="{DynamicResource BrushSuccess}" Margin="0,2,0,0"/>
                    </StackPanel>
                    <Border HorizontalAlignment="Right" VerticalAlignment="Center" Width="32" Height="32" CornerRadius="16" Background="{DynamicResource BrushSuccessBg}">
                        <Path Data="{StaticResource IconCash}" Fill="{DynamicResource BrushSuccess}" Width="14" Height="14" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                </Grid>
            </Border>

            <!-- 4. Receiver Password Field & Error Banner -->
            <StackPanel Grid.Row="3" Margin="0,0,0,20">
                <TextBlock Text="CONTRASEÑA DEL OPERADOR RECEPTOR *"
                           FontSize="10"
                           FontWeight="Bold"
                           Foreground="{DynamicResource BrushTextMuted}"
                           Margin="0,0,0,6"/>

                <PasswordBox x:Name="ReceiverPasswordBox"
                             Style="{StaticResource ModernPasswordBox}"
                             Height="42"
                             FontSize="15"
                             PasswordChar="●"
                             KeyDown="ReceiverPasswordBox_KeyDown"/>

                <TextBlock Text="El operador receptor debe ingresar su clave personal para firmar y asumir la sesión."
                           FontSize="10"
                           Foreground="{DynamicResource BrushTextSecondary}"
                           Margin="0,4,0,0"/>

                <!-- Error message banner -->
                <Border x:Name="ErrorBannerBorder"
                        Background="{DynamicResource BrushDangerBg}"
                        CornerRadius="8"
                        Padding="12,8"
                        Margin="0,10,0,0"
                        Visibility="Collapsed">
                    <TextBlock x:Name="ErrorMessageTextBlock"
                               Text="Contraseña incorrecta. Por favor intente nuevamente."
                               Foreground="{DynamicResource BrushDanger}"
                               FontSize="11"
                               FontWeight="Bold"
                               TextWrapping="Wrap"/>
                </Border>
            </StackPanel>

            <!-- 5. Action Buttons -->
            <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="Cancelar"
                        Click="CancelButton_Click"
                        Style="{StaticResource SecondaryButton}"
                        Padding="18,9"
                        Margin="0,0,10,0"
                        IsCancel="True"/>

                <Button x:Name="ConfirmAuthButton"
                        Content="Confirmar y Recibir Turno"
                        Click="ConfirmAuthButton_Click"
                        Style="{StaticResource ModernButton}"
                        Padding="22,9"
                        IsDefault="True"/>
            </StackPanel>
        </Grid>
    </Border>
</Window>
