<UserControl x:Class="Parking.Views.RecentEntriesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:conv="clr-namespace:Parking.Core.Converters"
             mc:Ignorable="d"
             d:DesignHeight="850" d:DesignWidth="1180">

    <UserControl.Resources>
        <conv:CurrencyConverter x:Key="CurrencyConv"/>
        <conv:VehicleTypeToStringConverter x:Key="VehicleTypeStrConv"/>
        <conv:VehicleTypeToIconConverter x:Key="VehicleIconConv"/>
        <conv:BooleanToVisibilityConverter x:Key="BoolToVis"/>
    </UserControl.Resources>

    <Grid Margin="24">
        <Border Style="{StaticResource ModernCard}" Padding="24">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- Header -->
                <Grid Grid.Row="0" Margin="0,0,0,20">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0">
                        <TextBlock Text="Entradas Registradas en el Turno" FontSize="20" FontWeight="Bold" Foreground="{DynamicResource BrushTextPrimary}"/>
                        <TextBlock Text="Listado operativo de tiquetes emitidos y vehículos activos en la sesión actual" FontSize="12" Foreground="{DynamicResource BrushTextMuted}" Margin="0,4,0,0"/>
                    </StackPanel>

                    <Border Grid.Column="1" Background="#E0F2FE" CornerRadius="12" Padding="14,6" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal">
                            <Ellipse Width="8" Height="8" Fill="{DynamicResource BrushPrimary}" Margin="0,0,8,0" VerticalAlignment="Center"/>
                            <TextBlock Text="{Binding TotalEntriesCount, StringFormat='{}{0} Vehículos en Turno'}"
                                       FontSize="12"
                                       FontWeight="Bold"
                                       Foreground="{DynamicResource BrushPrimary}"
                                       VerticalAlignment="Center"/>
                        </StackPanel>
                    </Border>
                </Grid>

                <!-- Search & Actions Bar -->
                <Grid Grid.Row="1" Margin="0,0,0,18">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="340"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <!-- Search Box -->
                    <TextBox Grid.Column="0"
                             Text="{Binding SearchQuery, UpdateSourceTrigger=PropertyChanged}"
                             Style="{StaticResource SearchPillTextBox}"/>

                    <!-- Refresh Button -->
                    <Button Grid.Column="2"
                            Command="{Binding LoadEntriesCommand}"
                            Style="{StaticResource SecondaryButton}"
                            Padding="14,8">
                        <StackPanel Orientation="Horizontal">
                            <Path Data="{StaticResource IconRefresh}" Fill="{DynamicResource BrushTextPrimary}" Width="13" Height="13" Stretch="Uniform" Margin="0,0,8,0" VerticalAlignment="Center"/>
                            <TextBlock Text="Actualizar Lista" FontWeight="SemiBold" FontSize="12" Foreground="{DynamicResource BrushTextPrimary}" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                </Grid>

                <!-- DataGrid of Recent Entries -->
                <DataGrid Grid.Row="2"
                          ItemsSource="{Binding Entries}"
                          Style="{StaticResource ModernDataGrid}">
                    <DataGrid.Columns>
                        <!-- Placa -->
                        <DataGridTemplateColumn Header="PLACA" Width="1.4*">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding PlateNumber}"
                                               FontFamily="{StaticResource FontFamilyMonospace}"
                                               FontWeight="Black"
                                               FontSize="15"
                                               Foreground="{DynamicResource BrushTextPrimary}"
                                               VerticalAlignment="Center"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <!-- Tipo de Vehículo -->
                        <DataGridTemplateColumn Header="CATEGORÍA" Width="1.6*">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <Border Width="26" Height="26" CornerRadius="6" Background="{DynamicResource BrushPrimary}" Margin="0,0,10,0">
                                            <Path Data="{Binding VehicleType, Converter={StaticResource VehicleIconConv}}"
                                                  Fill="{DynamicResource BrushTextWhite}"
                                                  Width="13" Height="13"
                                                  Stretch="Uniform"
                                                  HorizontalAlignment="Center"
                                                  VerticalAlignment="Center"/>
                                        </Border>
                                        <TextBlock Text="{Binding VehicleType, Converter={StaticResource VehicleTypeStrConv}}"
                                                   FontSize="12"
                                                   FontWeight="SemiBold"
                                                   Foreground="{DynamicResource BrushTextPrimary}"
                                                   VerticalAlignment="Center"/>
                                    </StackPanel>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <!-- Número de Tiquete -->
                        <DataGridTextColumn Header="TIQUETE #" Binding="{Binding TicketNumber}" Width="1.2*"/>

                        <!-- Hora de Ingreso -->
                        <DataGridTextColumn Header="HORA INGRESO" Binding="{Binding EntryTime, StringFormat='{}{0:yyyy-MM-dd HH:mm:ss}'}" Width="1.4*"/>

                        <!-- Tiempo Transcurrido -->
                        <DataGridTemplateColumn Header="TIEMPO EN PATIO" Width="1.3*">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <Path Data="{StaticResource IconClock}" Fill="{DynamicResource BrushTextSecondary}" Width="12" Height="12" Stretch="Uniform" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                        <TextBlock Text="{Binding FormattedDuration}"
                                                   FontWeight="SemiBold"
                                                   FontSize="12"
                                                   Foreground="{DynamicResource BrushTextPrimary}"
                                                   VerticalAlignment="Center"/>
                                    </StackPanel>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <!-- Valor Cobrado / Acumulado -->
                        <DataGridTemplateColumn Header="VALOR ACUMULADO" Width="1.3*">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding CurrentEstimatedAmount, Converter={StaticResource CurrencyConv}}"
                                               FontWeight="Black"
                                               FontSize="13"
                                               Foreground="{DynamicResource BrushSuccess}"
                                               VerticalAlignment="Center"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <!-- Operador -->
                        <DataGridTextColumn Header="OPERADOR EN TURNO" Binding="{Binding OperatorName}" Width="1.3*"/>

                        <!-- Acción: Reimprimir -->
                        <DataGridTemplateColumn Header="ACCIONES" Width="1.4*">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Button Command="{Binding DataContext.ReprintTicketCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                            CommandParameter="{Binding}"
                                            Style="{StaticResource SecondaryButton}"
                                            Padding="10,5"
                                            VerticalAlignment="Center">
                                        <StackPanel Orientation="Horizontal">
                                            <Path Data="{StaticResource IconReceipt}" Fill="{DynamicResource BrushPrimary}" Width="12" Height="12" Stretch="Uniform" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                            <TextBlock Text="Reimprimir Tiquete" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource BrushPrimary}" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </Button>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>
            </Grid>
        </Border>
    </Grid>
</UserControl>
