<Window x:Class="Parking.Views.ReceiptPreviewDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:conv="clr-namespace:Parking.Core.Converters"
        mc:Ignorable="d"
        Title="Vista Previa del Tiquete"
        WindowStartupLocation="CenterOwner"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="#B3000000"
        ShowInTaskbar="False"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Display"
        TextOptions.TextRenderingMode="ClearType">

    <Window.Resources>
        <conv:CurrencyConverter x:Key="CurrencyConv"/>
        <conv:VehicleTypeToStringConverter x:Key="VehicleTypeStrConv"/>
        <conv:BooleanToVisibilityConverter x:Key="BoolToVis"/>
        <conv:NullToVisibilityConverter x:Key="NullToVis"/>
    </Window.Resources>

    <Grid Background="Transparent">
        <Border Width="490"
                MaxHeight="660"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Margin="24"
                Background="{DynamicResource BrushAppBackground}"
                BorderBrush="{DynamicResource BrushBorderMedium}"
                BorderThickness="1"
                CornerRadius="16"
                Padding="20">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- 1. Header Area -->
            <Grid Grid.Row="0" Margin="0,0,0,12">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Path Data="{StaticResource IconReceipt}" Fill="{DynamicResource BrushPrimary}" Width="16" Height="16" Stretch="Uniform" Margin="0,0,8,0"/>
                    <TextBlock Text="Vista Previa de Tiquete Térmico" FontSize="14" FontWeight="Bold" Foreground="{DynamicResource BrushTextPrimary}"/>
                </StackPanel>
                <Button HorizontalAlignment="Right"
                        Command="{Binding CloseCommand}"
                        Style="{StaticResource SecondaryButton}"
                        Padding="4"
                        Width="26"
                        Height="26">
                    <Path Data="{StaticResource IconClose}" Fill="{DynamicResource BrushTextSecondary}" Width="10" Height="10" Stretch="Uniform"/>
                </Button>
            </Grid>

            <!-- 2. Thermal Ticket Paper Container (Estilo POS Blanco y Negro) -->
            <Border Grid.Row="1"
                    Background="#FFFFFF"
                    BorderBrush="{DynamicResource BrushBorderMedium}"
                    BorderThickness="1"
                    CornerRadius="0"
                    Padding="16,20"
                    Margin="0,0,0,12"
                    MaxHeight="480">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel HorizontalAlignment="Stretch" Margin="0,0">
                        <!-- TÍTULO DE MARCA ENCABEZADO -->
                        <TextBlock Text="PARKING - FLOW"
                                   FontSize="20"
                                   FontWeight="Black"
                                   FontFamily="Raleway, Segoe UI, sans-serif"
                                   Foreground="#000000"
                                   HorizontalAlignment="Center"
                                   Margin="0,0,0,10"/>

                        <!-- CÓDIGO DE BARRAS CODE 128 (SÓLO EN ENTRADA) -->
                        <Image Source="{Binding BarcodeImage}"
                               Width="280" Height="85"
                               Stretch="Uniform"
                               RenderOptions.BitmapScalingMode="NearestNeighbor"
                               HorizontalAlignment="Center"
                               Margin="0,0,0,12"
                               Visibility="{Binding IsEntryTicket, Converter={StaticResource BoolToVis}}"/>

                        <!-- ENCABEZADO DE EMPRESA / SEDE DINÁMICA -->
                        <TextBlock Text="{Binding BranchName}" FontSize="16" FontWeight="Black" FontFamily="{StaticResource FontFamilyMonospace}" Foreground="#000000" HorizontalAlignment="Center"/>
                        <TextBlock Text="{Binding BranchNit}" FontSize="13" FontFamily="{StaticResource FontFamilyMonospace}" Foreground="#000000" HorizontalAlignment="Center"/>
                        <TextBlock Text="{Binding BranchAddress}" FontSize="13" FontFamily="{StaticResource FontFamilyMonospace}" Foreground="#000000" HorizontalAlignment="Center" Margin="0,0,0,6"/>

                        <!-- ============================================== -->
                        <!-- 1. CASO ENTRADA DE VEHÍCULO                    -->
                        <!-- ============================================== -->
                        <StackPanel Visibility="{Binding IsEntryTicket, Converter={StaticResource BoolToVis}}">
                            <TextBlock Text="****************************************" FontSize="14" FontFamily="{StaticResource FontFamilyMonospace}" Foreground="#000000" HorizontalAlignment="Center" Margin="0,4"/>

                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,2">
                                <TextBlock Text="TIQUETE No: " FontSize="14" FontFamily="{StaticResource FontFamilyMonospace}" Foreground="#000000"/>
                                <TextBlock Text="{Binding Ticket.TicketNumber}" FontSize="14" FontFamily="{StaticResource FontFamilyMonospace}" Foreground="#000000" FontWeight="Bold"/>
                            </StackPanel>

                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,2">
                                <TextBlock Text="FECHA: " FontSize="14" FontFamily="{StaticResource FontFamilyMonospace}" Foreground="#000000"/>
                                <TextBlock Text="{Binding Ticket.EntryTime, StringFormat='{}{0:yyyy/MM/dd HH:mm:ss}'}" FontSize="14" FontFamily="{StaticResource FontFamilyMonospace}" Foreground="#000000"/>
                            </StackPanel>
                            
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,2,0,8">
                                <TextBlock Text="VEHICULO: " FontSize="14" FontFamily="{StaticResource FontFamilyMonospace}" Foreground="#000000"/>
                                <TextBlock Text="{Binding Ticket.VehicleType, Converter={StaticResource VehicleTypeStrConv}}" FontSize="14" FontWeight="Bold" FontFamily="{StaticResource FontFamilyMonospace}" Foreground="#000000"/>
                            </StackPanel>

                            <!-- INVERTED PLATE TEXT (Fondo negro, letras blancas) -->
                            <Border Background="#000000" HorizontalAlignment="Center" Padding="16,4" Margin="0,4,0,8">
                                <TextBlock Text="{Binding Ticket.PlateNumber}" FontSize="28" FontWeight="Black" FontFamily="{StaticResource FontFamilyMonospace}" Foreground="#FFFFFF"/>
                            </Border>

                            <TextBlock Text="****************************************" FontSize="14" FontFamily="{StaticResource FontFamilyMonospace}" Foreground="#000000" HorizontalAlignment="Center" Margin="0,4"/>
                            
                            <!-- TEXTO DE TARIFA DEL VEHÍCULO -->
                            <TextBlock Text="{Binding FormattedRateText}" FontSize="13" FontWeight="Bold" FontFamily="{StaticResource FontFamilyMonospace}" Foreground="#000000" HorizontalAlignment="Center" Margin="0,2"/>

                            <!-- QR DE CONSULTA EN LÍNEA -->
                            <Image Source="{Binding ConsultationQrCodeImage}"
                                   Width="110" Height="110"
                                   Stretch="Uniform"
                                   RenderOptions.BitmapScalingMode="NearestNeighbor"
                                   HorizontalAlignment="Center"
                                   Margin="0,6,0,2"/>
                            <TextBlock Text="CONSULTE SU ESTADO EN LÍNEA" FontSize="11" FontWeight="Bold" FontFamily="{StaticResource FontFamilyMonospace}" Foreground="#000000" HorizontalAlignment="Center" Margin="0,1,0,8"/>
                        </StackPanel>

                        <!-- ============================================== -->
                        <!-- 2. CASO SALIDA TIPO 1: RESOLUCIÓN FVM          -->
                        <!-- ============================================== -->
                        <StackPanel Visibility="{Binding IsFvmInvoice, Converter={StaticResource BoolToVis}}" HorizontalAlignment="Center">
                            <!-- 2 filas de separación -->
                            <Border Height="22"/>

                            <!-- TIQUETE No -->
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" Margin="0,2">
                                <TextBlock Text="TIQUETE No: " FontSize="14" FontFamily="{StaticResource FontFamilyMonospace}" Foreground="#000000"/>
                                <TextBlock Text="{Binding Ticket.TicketNumber}" FontSize="14" FontFamily="{StaticResource FontFamilyMonospace}" Foreground="#000000" FontWeight="Bold"/>
                            </StackPanel>

                            <!-- ENTRADA -->
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" Margin="0,2">
                                <TextBlock Text="ENTRADA: " FontSize="13" FontFamily="{StaticResource FontFamilyMonospace}" Foreground="#000000"/>
                                <TextBlock Text="{Binding Ticket.EntryTime, StringFormat='{}{0:yyyy/MM/dd HH:mm:ss}'}" FontSize="13" FontFamily="{StaticResource FontFamilyMonospace}" Foreground="#000000"/>
                            </StackPanel>

                            <!-- SALIDA -->
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" Margin="0,2">
                                <TextBlock Text="SALIDA: " FontSize="13" FontFamily="{StaticResource FontFamilyMonospace}" Foreground="#000000"/>
                                <TextBlock Text="{Binding Ticket.ExitTime, StringFormat='{}{0:yyyy/MM/dd HH:mm:ss}'}" FontSize="13" FontFamily="{StaticResource FontFamilyMonospace}" Foreground="#000000"/>
                            </StackPanel>

                            <!-- VEHICULO -->
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" Margin="0,2">
                                <TextBlock Text="VEHICULO: " FontSize="13" FontFamily="{StaticResource FontFamilyMonospace}" Foreground="#000000"/>
                                <TextBlock Text="{Binding Ticket.VehicleType, Converter={StaticResource VehicleTypeStrConv}}" FontSize="13" FontWeight="Bold" FontFamily="{StaticResource FontFamilyMonospace}" Foreground="#000000"/>
                            </StackPanel>

                            <!-- PLACA (debajo de vehiculo) -->
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" Margin="0,2">
                                <TextBlock Text="PLACA: " FontSize="15" FontWeight="Bold" FontFamily="{StaticResource FontFamilyMonospace}" Foreground="#000000"/>
                                <TextBlock Text="{Binding Ticket.PlateNumber}" FontSize="15" FontWeight="Black" FontFamily="{StaticResource FontFamilyMonospace}" Foreground="#000000"/>
                            </StackPanel>

                            <!-- TARIFA -->
                            <TextBlock Text="{Binding FormattedRateText}" FontSize="13" FontFamily="{StaticResource FontFamilyMonospace}" Foreground="#000000" HorizontalAlignment="Left" Margin="0,2"/>

                            <!-- MEDIO DE PAGO ELEGIDO -->
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" Margin="0,2">
                                <TextBlock Text="MEDIO DE PAGO: " FontSize="13" FontFamily="{StaticResource FontFamilyMonospace}" Foreground="#000000"/>
                                <TextBlock Text="{Binding PaymentMethodDisplayName}" FontSize="13" FontWeight="Bold" FontFamily="{StaticResource FontFamilyMonospace}" Foreground="#000000"/>
                            </StackPanel>

                            <!-- CONVENIO (SI ELIGIÓ) -->
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" Margin="0,2" Visibility="{Binding HasAgreement, Converter={StaticResource BoolToVis}}">
                                <TextBlock Text="CONVENIO: " FontSize="13" FontFamily="{StaticResource FontFamilyMonospace}" Foreground="#000000"/>
                                <TextBlock Text="{Binding AgreementDisplayName}" FontSize="13" FontWeight="Bold" FontFamily="{StaticResource FontFamilyMonospace}" Foreground="#000000"/>
                            </StackPanel>

                            <!-- VALOR QUE PAGÓ -->
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" Margin="0,2">
                                <TextBlock Text="VALOR PAGADO: " FontSize="15" FontWeight="Bold" FontFamily="{StaticResource FontFamilyMonospace}" Foreground="#000000"/>
                                <TextBlock Text="{Binding FormattedTotalPaid}" FontSize="15" FontWeight="Black" FontFamily="{StaticResource FontFamilyMonospace}" Foreground="#000000"/>
                            </StackPanel>

                            <!-- % DE IVA -->
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" Margin="0,2">
                                <TextBlock Text="% IVA: " FontSize="13" FontFamily="{StaticResource FontFamilyMonospace}" Foreground="#000000"/>
                                <TextBlock Text="{Binding IvaPercentageText}" FontSize="13" FontWeight="Bold" FontFamily="{StaticResource FontFamilyMonospace}" Foreground="#000000"/>
                            </StackPanel>

                            <!-- 2 filas de separación -->
                            <Border Height="22"/>

                            <!-- DATOS FACTURA ELECTRÓNICA -->
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" Margin="0,2">
                                <TextBlock Text="CLIENTE: " FontSize="13" FontFamily="{StaticResource FontFamilyMonospace}" Foreground="#000000"/>
                                <TextBlock Text="{Binding CustomerName}" FontSize="13" FontWeight="Bold" FontFamily="{StaticResource FontFamilyMonospace}" Foreground="#000000"/>
                            </StackPanel>

                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" Margin="0,2">
                                <TextBlock Text="{Binding CustomerDocument}" FontSize="13" FontWeight="Bold" FontFamily="{StaticResource FontFamilyMonospace}" Foreground="#000000"/>
                            </StackPanel>

                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" Margin="0,2">
                                <TextBlock Text="FACTURA DE VENTA: " FontSize="13" FontFamily="{StaticResource FontFamilyMonospace}" Foreground="#000000"/>
                                <TextBlock Text="{Binding InvoiceNumberText}" FontSize="13" FontWeight="Black" FontFamily="{StaticResource FontFamilyMonospace}" Foreground="#000000"/>
                            </StackPanel>

                            <!-- 2 filas de separación -->
                            <Border Height="14"/>

                            <!-- QR DE FACTURA ELECTRÓNICA AL FINAL DE ETIQUETA -->
                            <Image Source="{Binding ElectronicInvoiceQrImage}"
                                   Width="115" Height="115"
                                   Stretch="Uniform"
                                   RenderOptions.BitmapScalingMode="NearestNeighbor"
                                   HorizontalAlignment="Center"
                                   Margin="0,4,0,2"/>
                            <TextBlock Text="FACTURA ELECTRÓNICA DE VENTA" FontSize="10" FontWeight="Bold" FontFamily="{StaticResource FontFamilyMonospace}" Foreground="#000000" HorizontalAlignment="Center" Margin="0,1,0,4"/>
                        </StackPanel>

                        <!-- ============================================== -->
                        <!-- 3. CASO SALIDA TIPO 2: ESTÁNDAR / NO FVM       -->
                        <!-- ============================================== -->
                        <StackPanel Visibility="{Binding IsStandardExitReceipt, Converter={StaticResource BoolToVis}}" HorizontalAlignment="Center">
                            <!-- 2 filas de separación -->
                            <Border Height="22"/>

                            <!-- TIQUETE No -->
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" Margin="0,2">
                                <TextBlock Text="TIQUETE No: " FontSize="14" FontFamily="{StaticResource FontFamilyMonospace}" Foreground="#000000"/>
                                <TextBlock Text="{Binding Ticket.TicketNumber}" FontSize="14" FontFamily="{StaticResource FontFamilyMonospace}" Foreground="#000000" FontWeight="Bold"/>
                            </StackPanel>

                            <!-- ENTRADA -->
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" Margin="0,2">
                                <TextBlock Text="ENTRADA: " FontSize="13" FontFamily="{StaticResource FontFamilyMonospace}" Foreground="#000000"/>
                                <TextBlock Text="{Binding Ticket.EntryTime, StringFormat='{}{0:yyyy/MM/dd HH:mm:ss}'}" FontSize="13" FontFamily="{StaticResource FontFamilyMonospace}" Foreground="#000000"/>
                            </StackPanel>

                            <!-- SALIDA -->
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" Margin="0,2">
                                <TextBlock Text="SALIDA: " FontSize="13" FontFamily="{StaticResource FontFamilyMonospace}" Foreground="#000000"/>
                                <TextBlock Text="{Binding Ticket.ExitTime, StringFormat='{}{0:yyyy/MM/dd HH:mm:ss}'}" FontSize="13" FontFamily="{StaticResource FontFamilyMonospace}" Foreground="#000000"/>
                            </StackPanel>

                            <!-- VEHICULO -->
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" Margin="0,2">
                                <TextBlock Text="VEHICULO: " FontSize="13" FontFamily="{StaticResource FontFamilyMonospace}" Foreground="#000000"/>
                                <TextBlock Text="{Binding Ticket.VehicleType, Converter={StaticResource VehicleTypeStrConv}}" FontSize="13" FontWeight="Bold" FontFamily="{StaticResource FontFamilyMonospace}" Foreground="#000000"/>
                            </StackPanel>

                            <!-- PLACA (debajo de vehiculo) -->
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" Margin="0,2">
                                <TextBlock Text="PLACA: " FontSize="15" FontWeight="Bold" FontFamily="{StaticResource FontFamilyMonospace}" Foreground="#000000"/>
                                <TextBlock Text="{Binding Ticket.PlateNumber}" FontSize="15" FontWeight="Black" FontFamily="{StaticResource FontFamilyMonospace}" Foreground="#000000"/>
                            </StackPanel>

                            <!-- TARIFA -->
                            <TextBlock Text="{Binding FormattedRateText}" FontSize="13" FontFamily="{StaticResource FontFamilyMonospace}" Foreground="#000000" HorizontalAlignment="Left" Margin="0,2"/>

                            <!-- MEDIO DE PAGO ELEGIDO -->
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" Margin="0,2">
                                <TextBlock Text="MEDIO DE PAGO: " FontSize="13" FontFamily="{StaticResource FontFamilyMonospace}" Foreground="#000000"/>
                                <TextBlock Text="{Binding PaymentMethodDisplayName}" FontSize="13" FontWeight="Bold" FontFamily="{StaticResource FontFamilyMonospace}" Foreground="#000000"/>
                            </StackPanel>

                            <!-- CONVENIO (SI ELIGIÓ) -->
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" Margin="0,2" Visibility="{Binding HasAgreement, Converter={StaticResource BoolToVis}}">
                                <TextBlock Text="CONVENIO: " FontSize="13" FontFamily="{StaticResource FontFamilyMonospace}" Foreground="#000000"/>
                                <TextBlock Text="{Binding AgreementDisplayName}" FontSize="13" FontWeight="Bold" FontFamily="{StaticResource FontFamilyMonospace}" Foreground="#000000"/>
                            </StackPanel>

                            <!-- VALOR QUE PAGÓ -->
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" Margin="0,2">
                                <TextBlock Text="VALOR PAGADO: " FontSize="15" FontWeight="Bold" FontFamily="{StaticResource FontFamilyMonospace}" Foreground="#000000"/>
                                <TextBlock Text="{Binding FormattedTotalPaid}" FontSize="15" FontWeight="Black" FontFamily="{StaticResource FontFamilyMonospace}" Foreground="#000000"/>
                            </StackPanel>

                            <!-- % DE IVA -->
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" Margin="0,2">
                                <TextBlock Text="% IVA: " FontSize="13" FontFamily="{StaticResource FontFamilyMonospace}" Foreground="#000000"/>
                                <TextBlock Text="{Binding IvaPercentageText}" FontSize="13" FontWeight="Bold" FontFamily="{StaticResource FontFamilyMonospace}" Foreground="#000000"/>
                            </StackPanel>
                        </StackPanel>

                    </StackPanel>
                </ScrollViewer>
            </Border>

            <!-- 3. Bottom Action Buttons -->
            <Grid Grid.Row="2">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" Visibility="{Binding PrintSuccess, Converter={StaticResource BoolToVis}}">
                    <Path Data="{StaticResource IconCheck}" Fill="{DynamicResource BrushSuccess}" Width="14" Height="14" Stretch="Uniform" Margin="0,0,6,0"/>
                    <TextBlock Text="Tiquete enviado a impresión" Foreground="{DynamicResource BrushSuccess}" FontSize="11" VerticalAlignment="Center"/>
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Command="{Binding PrintTicketCommand}"
                            Style="{StaticResource ModernButton}"
                            Margin="0,0,8,0"
                            Padding="16,6">
                        <Button.ContentTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal">
                                    <Path Data="{StaticResource IconPrint}" Fill="{DynamicResource BrushTextWhite}" Width="13" Height="13" Stretch="Uniform" Margin="0,0,6,0"/>
                                    <TextBlock Text="Imprimir Tiquete" Foreground="{DynamicResource BrushTextWhite}" FontWeight="Bold" FontSize="12" VerticalAlignment="Center"/>
                                </StackPanel>
                            </DataTemplate>
                        </Button.ContentTemplate>
                    </Button>
                    <Button Content="Cerrar"
                            Command="{Binding CloseCommand}"
                            Style="{StaticResource SecondaryButton}"
                            Padding="16,6"
                            FontSize="12"/>
                </StackPanel>
            </Grid>
        </Grid>
    </Border>
    </Grid>
</Window>
