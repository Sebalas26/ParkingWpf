<Window x:Class="ParkFlow.Updater.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Actualizador ParkFlow"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="True"
        Width="460" Height="240">

    <Border Background="#111827"
            BorderBrush="#374151"
            BorderThickness="1.5"
            CornerRadius="16"
            Padding="24"
            SnapsToDevicePixels="True">
        <Border.Effect>
            <DropShadowEffect BlurRadius="25" ShadowDepth="6" Direction="270" Opacity="0.35" Color="#000000"/>
        </Border.Effect>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Encabezado -->
            <StackPanel Grid.Row="0" Margin="0,0,0,16">
                <TextBlock Text="Actualizando ParkFlow"
                           FontSize="18"
                           FontWeight="Bold"
                           Foreground="#F9FAFB"/>
                <TextBlock x:Name="TxtStatus"
                           Text="Preparando componentes..."
                           FontSize="13"
                           Foreground="#9CA3AF"
                           Margin="0,4,0,0"/>
            </StackPanel>

            <!-- Detalle / Animación -->
            <StackPanel Grid.Row="1" VerticalAlignment="Center">
                <ProgressBar x:Name="ProgressBarUpdate"
                             Height="8"
                             IsIndeterminate="True"
                             Foreground="#10B981"
                             Background="#1F2937"
                             BorderThickness="0"/>
            </StackPanel>

            <!-- Pie de mensaje -->
            <TextBlock Grid.Row="2"
                       Text="Por favor no apague el equipo ni desconecte la terminal."
                       FontSize="11"
                       Foreground="#6B7280"
                       HorizontalAlignment="Center"
                       Margin="0,10,0,0"/>
        </Grid>
    </Border>
</Window>
