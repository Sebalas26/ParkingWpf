<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- ============================================================================== -->
    <!-- PALETA INSTITUCIONAL OFICIAL: PARK POINT (Tu punto de llegada)                 -->
    <!-- Verde Park Point: #00867A | Grafito: #1E2A2F | Gris Concreto: #B9B9B9          -->
    <!-- Blanco: #FFFFFF | Amarillo: #FFC107                                            -->
    <!-- ============================================================================== -->

    <!-- Fondos y Superficies -->
    <Color x:Key="ColorAppBackground">#F4F6F7</Color>
    <Color x:Key="ColorSurfaceBackground">#FFFFFF</Color>
    <Color x:Key="ColorSurfaceElevatedBackground">#FFFFFF</Color>
    <Color x:Key="ColorSurfaceLight">#EAF2F1</Color>
    <Color x:Key="ColorInputBackground">#FFFFFF</Color>
    
    <!-- Sidebar y Navegación (Grafito & Verde Park Point) -->
    <Color x:Key="ColorSidebarBackground">#1E2A2F</Color>
    <Color x:Key="ColorSidebarItemActive">#00867A</Color>
    <Color x:Key="ColorSidebarText">#B9B9B9</Color>
    <Color x:Key="ColorSidebarTextActive">#FFFFFF</Color>
    
    <!-- Bordes -->
    <Color x:Key="ColorBorderSubtle">#E2E8F0</Color>
    <Color x:Key="ColorBorderMedium">#B9B9B9</Color>
    <Color x:Key="ColorBorderFocused">#00867A</Color>

    <!-- Marca Primaria: Verde Park Point (#00867A) -->
    <Color x:Key="ColorPrimary">#00867A</Color>
    <Color x:Key="ColorPrimaryHover">#006E64</Color>
    <Color x:Key="ColorPrimaryActive">#00574F</Color>
    <Color x:Key="ColorPrimaryLight">#E0F2F1</Color>
    <Color x:Key="ColorPrimaryGlow">#2200867A</Color>

    <!-- Tablas y Grids -->
    <Color x:Key="ColorTableHeaderBackground">#F8FAFA</Color>
    <Color x:Key="ColorTableRowHover">#F0F7F6</Color>
    <Color x:Key="ColorTableRowSelected">#E0F2F1</Color>

    <!-- Éxito / Validados -->
    <Color x:Key="ColorSuccess">#00867A</Color>
    <Color x:Key="ColorSuccessHover">#006E64</Color>
    <Color x:Key="ColorSuccessBg">#E0F2F1</Color>
    <Color x:Key="ColorSuccessText">#00574F</Color>

    <!-- Advertencia / Alerta / Énfasis: Amarillo Park Point (#FFC107) -->
    <Color x:Key="ColorWarning">#FFC107</Color>
    <Color x:Key="ColorWarningHover">#E0A800</Color>
    <Color x:Key="ColorWarningBg">#FFF8E1</Color>
    <Color x:Key="ColorWarningText">#8A6D00</Color>

    <!-- Peligro / Cancelaciones -->
    <Color x:Key="ColorDanger">#DC2626</Color>
    <Color x:Key="ColorDangerHover">#B91C1C</Color>
    <Color x:Key="ColorDangerBg">#FEE2E2</Color>
    <Color x:Key="ColorDangerText">#991B1B</Color>

    <!-- Acentos Secundarios -->
    <Color x:Key="ColorCyan">#00A896</Color>
    <Color x:Key="ColorViolet">#1E2A2F</Color>

    <!-- Tipografía y Textos -->
    <Color x:Key="ColorTextPrimary">#1E2A2F</Color>
    <Color x:Key="ColorTextSecondary">#5A6E75</Color>
    <Color x:Key="ColorTextMuted">#8D9FA5</Color>
    <Color x:Key="ColorTextWhite">#FFFFFF</Color>

    <!-- Brushes Sólidos -->
    <SolidColorBrush x:Key="BrushAppBackground" Color="{StaticResource ColorAppBackground}"/>
    <SolidColorBrush x:Key="BrushSurfaceBackground" Color="{StaticResource ColorSurfaceBackground}"/>
    <SolidColorBrush x:Key="BrushSurfaceElevated" Color="{StaticResource ColorSurfaceElevatedBackground}"/>
    <SolidColorBrush x:Key="BrushSurfaceLight" Color="{StaticResource ColorSurfaceLight}"/>
    <SolidColorBrush x:Key="BrushInputBackground" Color="{StaticResource ColorInputBackground}"/>
    <SolidColorBrush x:Key="BrushSidebarBackground" Color="{StaticResource ColorSidebarBackground}"/>
    <SolidColorBrush x:Key="BrushSidebarItemActive" Color="{StaticResource ColorSidebarItemActive}"/>
    <SolidColorBrush x:Key="BrushSidebarText" Color="{StaticResource ColorSidebarText}"/>
    <SolidColorBrush x:Key="BrushSidebarTextActive" Color="{StaticResource ColorSidebarTextActive}"/>

    <SolidColorBrush x:Key="BrushBorderSubtle" Color="{StaticResource ColorBorderSubtle}"/>
    <SolidColorBrush x:Key="BrushBorderMedium" Color="{StaticResource ColorBorderMedium}"/>
    <SolidColorBrush x:Key="BrushBorderFocused" Color="{StaticResource ColorBorderFocused}"/>

    <SolidColorBrush x:Key="BrushPrimary" Color="{StaticResource ColorPrimary}"/>
    <SolidColorBrush x:Key="BrushPrimaryHover" Color="{StaticResource ColorPrimaryHover}"/>
    <SolidColorBrush x:Key="BrushPrimaryActive" Color="{StaticResource ColorPrimaryActive}"/>
    <SolidColorBrush x:Key="BrushPrimaryLight" Color="{StaticResource ColorPrimaryLight}"/>
    <SolidColorBrush x:Key="BrushPrimaryGlow" Color="{StaticResource ColorPrimaryGlow}"/>

    <SolidColorBrush x:Key="BrushTableHeaderBackground" Color="{StaticResource ColorTableHeaderBackground}"/>
    <SolidColorBrush x:Key="BrushTableRowHover" Color="{StaticResource ColorTableRowHover}"/>
    <SolidColorBrush x:Key="BrushTableRowSelected" Color="{StaticResource ColorTableRowSelected}"/>

    <SolidColorBrush x:Key="BrushSuccess" Color="{StaticResource ColorSuccess}"/>
    <SolidColorBrush x:Key="BrushSuccessHover" Color="{StaticResource ColorSuccessHover}"/>
    <SolidColorBrush x:Key="BrushSuccessBg" Color="{StaticResource ColorSuccessBg}"/>
    <SolidColorBrush x:Key="BrushSuccessText" Color="{StaticResource ColorSuccessText}"/>

    <SolidColorBrush x:Key="BrushWarning" Color="{StaticResource ColorWarning}"/>
    <SolidColorBrush x:Key="BrushWarningHover" Color="{StaticResource ColorWarningHover}"/>
    <SolidColorBrush x:Key="BrushWarningBg" Color="{StaticResource ColorWarningBg}"/>
    <SolidColorBrush x:Key="BrushWarningText" Color="{StaticResource ColorWarningText}"/>

    <SolidColorBrush x:Key="BrushDanger" Color="{StaticResource ColorDanger}"/>
    <SolidColorBrush x:Key="BrushDangerHover" Color="{StaticResource ColorDangerHover}"/>
    <SolidColorBrush x:Key="BrushDangerBg" Color="{StaticResource ColorDangerBg}"/>
    <SolidColorBrush x:Key="BrushDangerText" Color="{StaticResource ColorDangerText}"/>

    <SolidColorBrush x:Key="BrushCyan" Color="{StaticResource ColorCyan}"/>
    <SolidColorBrush x:Key="BrushViolet" Color="{StaticResource ColorViolet}"/>

    <SolidColorBrush x:Key="BrushTextPrimary" Color="{StaticResource ColorTextPrimary}"/>
    <SolidColorBrush x:Key="BrushTextSecondary" Color="{StaticResource ColorTextSecondary}"/>
    <SolidColorBrush x:Key="BrushTextMuted" Color="{StaticResource ColorTextMuted}"/>
    <SolidColorBrush x:Key="BrushTextWhite" Color="{StaticResource ColorTextWhite}"/>

    <!-- Gradientes Institucionales Park Point -->
    <LinearGradientBrush x:Key="BrushBrandGradient" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#00867A" Offset="0"/>
        <GradientStop Color="#00A896" Offset="0.5"/>
        <GradientStop Color="#1E2A2F" Offset="1"/>
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="BrushCardHeaderGradient" StartPoint="0,0" EndPoint="1,0">
        <GradientStop Color="#1E2A2F" Offset="0"/>
        <GradientStop Color="#00867A" Offset="1"/>
    </LinearGradientBrush>

</ResourceDictionary>
